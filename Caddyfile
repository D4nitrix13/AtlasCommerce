# Caddyfile — AtlasCommerce local (multi-instancia, single host)
# ------------------------------------------------------------
# Cubre las 6 instancias (3 prod + 3 dev). Cada instancia Docker
# corre con IPs fijas en su red dedicada (prod) o con bind mounts
# publicando puertos en el host (dev).
#
# Producción (IPs fijas en redes Docker bridge):
#   - panda-estampados  (Panda Estampados + Kitsune Store, misma instancia)
#     red panda-estampados (172.21.0.0/24)
#     app=172.21.0.20:8000  frontend=172.21.0.21:4321
#   - mm-boutique    (single-tenant: MM Boutique)
#     red mm-boutique  (172.22.0.0/24)
#     app=172.22.0.20:8000  frontend=172.22.0.21:4321
#   - morales-store  (single-tenant: Morales Store)
#     red morales-store (172.23.0.0/24)
#     app=172.23.0.20:8000  frontend=172.23.0.21:4321
#
# Development (puertos publicados en el host):
#   - panda-estampados-dev: frontend=5321 (5321→4321)
#   - mm-boutique-dev:       frontend=6321 (6321→4321)
#   - morals-store-dev:      frontend=7321 (7321→4321)
#   Los dev usan bind mounts + xdebug, con BD aislada por tienda.
#   Los puertos son distintos entre sí (y entre los prod) para que las
#   3 dev puedan correr en paralelo sin conflicto.
#
# Reglas:
#   *.panda-estampados.com -> backend/frontend panda-estampados (prod)
#                                o panda-estampados-dev según cual esté Up
#   *.kitsune.com           -> backend/frontend panda-estampados
#   *.mm-boutique.com       -> backend/frontend mm-boutique (prod)
#                                o mm-boutique-dev según cual esté Up
#   *.morales-store.com     -> backend/frontend morales-store (prod)
#                                o morals-store-dev según cual esté Up
#   /api/* en cualquier host -> backend de la instancia correspondiente
#   cualquier otro host -> 404
#
# Para activar dev:
#   1) ./scripts/docker-stack.sh start development (o start dev)
#   2) Los handles dev abajo enrutarán a localhost:<puerto_publicado>
#   Para parar dev y volver a prod: ./scripts/docker-stack.sh stop development
#
# Antes de usar:
#   1) sudo cp Caddyfile /etc/caddy/Caddyfile
#   2) Agregar entradas en /etc/hosts (ver bloque al final).
#   3) sudo caddy validate --config /etc/caddy/Caddyfile
#      sudo systemctl restart caddy
{
	auto_https off
	admin off
}
# IMPORTANTE: `admin off` deshabilita la admin API de Caddy
# (http://localhost:2019/load). Por eso NO usamos `systemctl reload`
# (ExecReload llama a /load y falla). Ver scripts/setup-local.sh:
# después de cambiar este archivo hay que hacer
#   sudo systemctl restart caddy.service
# NUNCA `sudo systemctl reload caddy` con esta config.

# ===============================================================
# Listener único en :80 con TODOS los handles (prod + dev)
# ===============================================================
# Orden importante: los handles más específicos (dev) van primero
# para que no queden atrapados por los matchers más generales (prod).
# Si tenés prod y dev corriendo al mismo tiempo, ganará dev.
# Si solo tenés prod corriendo, los handles de dev fallarán con 502
# hasta que levantes dev.
http:// {
	# ===============================================================
	# Security headers (defense-in-depth, R1 review 2026-08-15).
	# Aplican a TODAS las responses proxy'd por Caddy (api + frontend).
	# ===============================================================

	# Clickjacking protection: previene que el sitio sea embebido en iframes
	# de terceros. SAMEORIGIN permite iframes del mismo sitio (necesario
	# para algunos admin tools de Astro pero NO permite terceros).
	header X-Frame-Options "SAMEORIGIN"

	# MIME sniffing protection: fuerza al browser a respetar el Content-Type
	# declarado por el servidor, previene interpretación alternativa de
	# archivos como ejecutables.
	header X-Content-Type-Options "nosniff"

	# Referrer policy: solo envía el origin (no el path completo) cuando
	# el usuario navega cross-origin. Previene leak de URLs internas en
	# analytics de terceros.
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Permissions policy: deshabilita features del browser que NO usamos
	# (geolocation, microphone, camera en storefront). Reduce superficie
	# de ataque si XSS bypass logra ejecutar JS.
	header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

	# XSS Protection (legacy, IE/older Safari): activa el filtro XSS del
	# browser aunque sea deprecated. Defense-in-depth.
	header X-XSS-Protection "1; mode=block"

	# Strict-Transport-Security (HSTS): fuerza HTTPS por 1 año incluyendo
	# subdomains. Solo aplica cuando el request es HTTPS. En dev (HTTP)
	# es no-op (Caddy no emite el header en HTTP).
	# max-age=31536000 (1 año), includeSubDomains, preload-ready
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Content-Security-Policy: política estricta para el FRONTEND (Astro).
	# Permite scripts/styles del mismo origen + unsafe-inline para Astro
	# (Astro usa inline styles para SSR), imágenes self+data: para avatars,
	# sin object/frame embedding cross-origin.
	# Nota: para /api/* responses el navegador NO aplica CSP (CSP es para
	# HTML responses, no JSON), pero el header se envía igual — el browser
	# lo ignora para non-HTML content types.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"

	# Referrer-Policy ya está arriba. Strict-Transport-Security abajo para
	# tener todos los headers de seguridad juntos (no repetir).

	# ===============================================================
	# Edge rate limiting (NOT IMPLEMENTED — requires caddy-ratelimit plugin)
	# ===============================================================
	# Defense-in-depth: rate limit per-IP a nivel de edge (Caddy) ANTES
	# de que el request llegue al backend. Complementa los RateLimiter
	# de Laravel (PR #6 cluster 3 Sanctum) con bloqueo DDoS early.
	#
	# R1 review 2026-08-15 noted this. Para activarlo, compilar Caddy
	# con el plugin `caddy-ratelimit`:
	#   $ xcaddy build --with github.com/mholt/caddy-ratelimit
	# Y luego descomentar el bloque de abajo:
	#
	# @auth_login path /api/auth/login /api/auth/2fa/verify-totp-login /api/auth/recovery-codes/regenerate
	# rate_limit @auth_login auth_login_zone 5r/m
	#
	# @auth_password_reset path /api/auth/forgot-password /api/auth/reset-password
	# rate_limit @auth_password_reset auth_password_reset_zone 3r/h
	#
	# @api_general path /api/*
	# not path /api/auth/login /api/auth/2fa/verify-totp-login /api/auth/recovery-codes/regenerate /api/auth/forgot-password /api/auth/reset-password
	# rate_limit @api_general api_default_zone 60r/m

	# -----------------------------------------------------------
	# DEVELOPMENT — puertos publicados en el host
	# -----------------------------------------------------------

	# Panda + Kitsune dev (mismo stack dev multi-tenant)
	@panda_dev_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@panda_dev host admin.panda-estampados.com www.panda-estampados.com panda-estampados.com admin.kitsune.com www.kitsune.com kitsune.com
	handle @panda_dev_api {
		reverse_proxy localhost:9000
	}
	handle @panda_dev {
		reverse_proxy localhost:5321
	}

	# MM Boutique dev
	@mm_dev_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@mm_dev host admin.mm-boutique.com www.mm-boutique.com mm-boutique.com
	handle @mm_dev_api {
		reverse_proxy localhost:10000
	}
	handle @mm_dev {
		reverse_proxy localhost:6321
	}

	# Morales Store dev
	@morales_dev_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@morales_dev host admin.morales-store.com www.morales-store.com morales-store.com
	handle @morales_dev_api {
		reverse_proxy localhost:11000
	}
	handle @morales_dev {
		reverse_proxy localhost:7321
	}

	# -----------------------------------------------------------
	# PRODUCCIÓN — IPs fijas en redes Docker bridge
	# -----------------------------------------------------------

	# Panda + Kitsune (mismo deploy: red 172.21.0.0/24)
	@panda_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@panda host panda-estampados.com www.panda-estampados.com admin.panda-estampados.com
	handle @panda_api {
		reverse_proxy 172.21.0.20:8000
	}
	handle @panda {
		reverse_proxy 172.21.0.21:4321
	}

	@kitsune host kitsune.com www.kitsune.com admin.kitsune.com
	handle @kitsune {
		reverse_proxy 172.21.0.21:4321
	}

	# MM Boutique (instancia propia: red 172.22.0.0/24)
	@mm_boutique_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@mm_boutique host mm-boutique.com www.mm-boutique.com admin.mm-boutique.com
	handle @mm_boutique_api {
		reverse_proxy 172.22.0.20:8000
	}
	handle @mm_boutique {
		reverse_proxy 172.22.0.21:4321
	}

	# Morales Store (instancia propia: red 172.23.0.0/24)
	@morales_api path /api/* /sanctum/* /livewire/* /broadcasting/auth
	@morales host morales-store.com www.morales-store.com admin.morales-store.com
	handle @morales_api {
		reverse_proxy 172.23.0.20:8000
	}
	handle @morales {
		reverse_proxy 172.23.0.21:4321
	}

	# Catch-all
	respond "Not found" 404
}

# ===============================================================
# Entradas /etc/hosts
# ===============================================================
# Pegar este bloque al final de /etc/hosts con sudo:
#
#   127.0.0.1  panda-estampados.com
#   127.0.0.1  www.panda-estampados.com
#   127.0.0.1  admin.panda-estampados.com
#   127.0.0.1  kitsune.com
#   127.0.0.1  www.kitsune.com
#   127.0.0.1  admin.kitsune.com
#   127.0.0.1  mm-boutique.com
#   127.0.0.1  www.mm-boutique.com
#   127.0.0.1  admin.mm-boutique.com
#   127.0.0.1  morales-store.com
#   127.0.0.1  www.morales-store.com
#   127.0.0.1  admin.morales-store.com
#
# Después:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl restart caddy
