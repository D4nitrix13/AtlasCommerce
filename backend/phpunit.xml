<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app</directory>
        </include>
        <exclude>
            <directory suffix="Factory.php">database/factories</directory>
            <directory suffix="Seeder.php">database/seeders</directory>
            <file>app/Console/Kernel.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
          Tests DEBEN correr contra una DB aislada: `RefreshDatabase`
          hace TRUNCATE y este repo tiene cuatro instancias con datos
          reales.

          OJO, este comentario antes afirmaba que phpunit.xml tiene
          prioridad sobre el `.env`. ES FALSO. Los `<env>` de PHPUnit
          NO pisan una variable ya exportada por el entorno salvo con
          force="true", asi que cuando los tests corren dentro del
          container de una instancia gana el DB_DATABASE de esa
          instancia y RefreshDatabase vacia la base de DESARROLLO.
          Eso losing los datos tres veces.

          La proteccion real no es este bloque sino `tests/bootstrap.php`,
          que aborta el proceso antes de abrir una conexion si la base
          no termina en `_test`. Este valor es solo el default para
          correr tests fuera de los containers.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="panda-estampados-and-kitsune_test" force="false"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>

        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
          Métricas Prometheus en memoria. El adapter InMemory acumula
          los counters en el proceso PHP, suficiente para que los tests
          verifiquen que el registry se popula y que /metrics renderiza
          el formato correcto. Evita la dependencia de phpredis en
          entornos donde la extensión no está disponible y desacopla
          los tests del servicio Redis (CI tiene Redis pero los tests
          no lo necesitan — el Producer no es parte de la superficie
          bajo prueba).
        -->
        <env name="METRICS_STORAGE" value="inmemory"/>
        <!--
          Hosts que Sanctum trata como stateful (cookie auth). En tests
          necesitamos el .test para que EnsureFrontendRequestsAreStateful
          agregue StartSession y dispare CSRF validation.
        -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:3000,localhost:4321,panda-estampados.test,www.panda-estampados.test,admin.panda-estampados.test,kitsune.test,www.kitsune.test,admin.kitsune.test"/>
    </php>
</phpunit>
