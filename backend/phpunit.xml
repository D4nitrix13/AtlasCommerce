<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app</directory>
        </include>
        <exclude>
            <directory suffix="Factory.php">database/factories</directory>
            <directory suffix="Seeder.php">database/seeders</directory>
            <file>app/Console/Kernel.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
          Tests DEBEN correr contra una DB aislada para que el trait
          `RefreshDatabase` no wipee la dev DB. Forzamos DB_DATABASE
          aquí (phpunit.xml tiene prioridad sobre el `.env` cuando se
          corre via `phpunit` o `php artisan test`).
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="panda-estampados-and-kitsune_test"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>

        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
          Hosts que Sanctum trata como stateful (cookie auth). En tests
          necesitamos el .test para que EnsureFrontendRequestsAreStateful
          agregue StartSession y dispare CSRF validation.
        -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:3000,localhost:4321,panda-estampados.test,www.panda-estampados.test,admin.panda-estampados.test,kitsune.test,www.kitsune.test,admin.kitsune.test"/>
    </php>
</phpunit>
