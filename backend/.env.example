APP_NAME="AtlasCommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Para producción, se recomienda `json` (output Loki-friendly con
# request_id/trace_id/span_id en cada línea). Mantener `stack`+`single`
# en dev por compatibilidad con tail -f.
# LOG_CHANNEL=json

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=store
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum token TTL in minutes (default 7 days = 10080). Sets expires_at on issued tokens.
SANCTUM_EXPIRATION_MINUTES=10080

# Sanctum stateful hosts: requests from these domains receive httpOnly
# session cookies (CR2 — closes XSS token theft via localStorage).
# Mantener en sync con `backend/config/cors.php` `allowed_origins`.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:4321,panda-estampados.test,www.panda-estampados.test,admin.panda-estampados.test,kitsune.test,www.kitsune.test,admin.kitsune.test,mm-boutique.test,www.mm-boutique.test,admin.mm-boutique.test,morales-store.test,www.morales-store.test,admin.morales-store.test,panda-estampados.com,www.panda-estampados.com,admin.panda-estampados.com,kitsune.com,www.kitsune.com,admin.kitsune.com,mm-boutique.com,www.mm-boutique.com,admin.mm-boutique.com,morales-store.com,www.morales-store.com,admin.morales-store.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# RF-OBS-132 — Fase 13 Observabilidad PR3: configuración de Prometheus.
# En PRODUCCIÓN usar 'redis' (requiere REDIS_HOST accesible). En dev
# local con un solo worker php-fpm se puede usar 'apcu' o 'inmemory'.
METRICS_STORAGE=redis
METRICS_NAMESPACE=atlascommerce
# Si se quiere separar Redis de métricas del cache general:
# METRICS_REDIS_HOST=redis
# METRICS_REDIS_PORT=6379
# METRICS_REDIS_DB=0

# RF-OBS-133 — Fase 13 Observabilidad PR4: tracing OpenTelemetry.
# En PRODUCCIÓN setear OTEL_ENABLED=true + OTEL_EXPORTER_OTLP_ENDPOINT.
# En dev, mantener OTEL_ENABLED=false (noop exporter, cero overhead).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atlascommerce-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER=noop
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# RF-OBS-134 — Fase 13 Observabilidad PR5: error tracking con Sentry.
# Dejar SENTRY_LARAVEL_DSN=null en dev (no captura nada). En
# producción, setear el DSN del proyecto Sentry correspondiente.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=development

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@store.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TWO_FACTOR_EMAIL_OTP_DIGITS=6
TWO_FACTOR_EMAIL_OTP_EXPIRES_MINUTES=10
TWO_FACTOR_EMAIL_OTP_MAX_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODES_COUNT=8
TWO_FACTOR_RECOVERY_CODES_PREFIX=STORE

# OAuth social login (Google + Facebook). Dejar vacíos en dev si no se
# configuraron los providers; el redirect endpoint responde 503
# (oauth_provider_not_configured) sin tumbar el resto del flujo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Override absoluto del base para construir la callback URL
# (`{base}/api/auth/social/{provider}/callback`). Si queda vacío, el
# controller usa `$request->getSchemeAndHttpHost()` para mantener el
# host actual (multi-tenant: cada tenant registra su propia callback).
OAUTH_REDIRECT_BASE_URL=
