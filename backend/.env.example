APP_NAME=Ecommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=store
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@store.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TWO_FACTOR_EMAIL_OTP_DIGITS=6
TWO_FACTOR_EMAIL_OTP_EXPIRES_MINUTES=10
TWO_FACTOR_EMAIL_OTP_MAX_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODES_COUNT=8
TWO_FACTOR_RECOVERY_CODES_PREFIX=STORE

BRAND_DEFAULT_LOGO_PATH=images/shared/brand/app-logo.webp
BRAND_DEFAULT_FAVICON_PATH=images/shared/brand/favicon.webp
BRAND_DEFAULT_COVER_IMAGE_PATH=images/shared/placeholders/store-cover-placeholder.webp
BRAND_DEFAULT_OG_IMAGE_PATH=images/shared/placeholders/store-og-placeholder.webp
BRAND_DEFAULT_PRIMARY_COLOR="#111827"
BRAND_DEFAULT_SECONDARY_COLOR="#f97316"
BRAND_SUPPORT_EMAIL=support@example.com

DEFAULT_STORE_SLUG=panda-estampados
STORE_RESOLUTION_MODE=domain
