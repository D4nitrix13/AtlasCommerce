includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7

    paths:
        - app
        - routes
        - database
        - config

    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
        - _ide_helper.php (?)
        - _ide_helper_models.php (?)
        - .phpstorm.meta.php (?)
        - database/seeders
        - database/factories
        - database/migrations

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Factories y seeders están excluidos del análisis estricto
        - identifier: missingType.generics
          paths:
              - app/Models
        # Modelos de Eloquent: las relaciones son inferidas por Larastan
        - identifier: missingType.iterableValue
        # Codigo usa ?-> donde sabe que no es null (redundante pero correcto).
        # 9 ocurrencias, ninguna bug real.
        - identifier: nullsafe.neverNull
        # Eloquent: properties definidas via $casts o columnas adicionales
        # que Larastan no infiere. 59 ocurrencias en Models.
        - identifier: property.notFound
          paths:
              - app/Models
        # Arrays que ya son list, no necesitan array_values().
        - identifier: arrayValues.list
        # Expresiones booleanas redundantes (e.g. !!$value cuando $value es bool).
        - identifier: booleanNot.alwaysTrue
        # Method noObject en cadena de llamadas (e.g. ShipmentService).
        - identifier: method.nonObject
        # Templates de Generics que no se pueden resolver estaticamente.
        - identifier: generics.lessTypes
        - identifier: generics.notSubtype
        # method.unresolvableReturnType: ocurre en metodos que devuelven
        # tipo basado en propiedades dinamicas (e.g. Eloquent $appends).
        - identifier: method.unresolvableReturnType
        # return.unusedType: PHPDoc return con tipo extra que PHP no usa.
        - identifier: return.unusedType
        # argument.unknown: callable que Larastan no puede resolver.
        - identifier: argument.unknown
        # argument.templateType: template types en llamadas a metodos genericos.
        - identifier: argument.templateType
        # argument.unresolvableType: tipo que no se puede resolver en el call site.
        - identifier: argument.unresolvableType
        # PHPDoc param que no existe en la firma (e.g. en clases que
        # implementan interfaces pero con firma distinta).
        - identifier: parameter.notFound
        # Property solo escrita (se asigna pero nunca se lee).
        - identifier: property.onlyWritten
        # env() fuera de config/ es regla de Larastan pero se acepta en
        # commands de artisan por diseño.
        - identifier: larastan.noEnvCallsOutsideOfConfig
          paths:
              - app/Console
        # Clases skeleton que aun no estan implementadas (TASKS.md: 7/90 models).
        # Cuando se implementen, quitar estos ignoreErrors.
        - message: "#Class App\\\\Models\\\\Sales\\\\Shipment not found#"
        - message: "#Class App\\\\Models\\\\Sales\\\\Payment not found#"
        - message: "#Class App\\\\Models\\\\Catalog\\\\BelongsToMany not found#"
        - message: "#Class App\\\\Models\\\\Customization\\\\DesignLayer not found#"
        - message: "#Class App\\\\Models\\\\Currency not found#"
        - message: "#App\\\\Models\\\\ReturnRequestItem#"
        # Metodos custom en Models (relaciones, traits HasSlug, metodos de
        # 2FA, OAuth, etc.) que Larastan no detecta.
        - message: "#Call to an undefined method Laravel\\\\Socialite\\\\Contracts\\\\Provider::redirectUrl\\(\\)#"
        - message: "#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Model::isEnabled\\(\\)#"
        - message: "#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Model::permissions\\(\\)#"
        - message: "#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Model::getSlugSource\\(\\)#"
        - message: "#Call to an undefined method Illuminate\\\\Database\\\\Eloquent\\\\Model::items\\(\\)#"
        - identifier: method.notFound
          paths:
              - app/Http/Controllers
              - app/Http/Resources
              - app/Services
        # JsonResource::toArray() retorna array|Arrayable|JsonSerializable
        # por diseño de Laravel, pero el PHPDoc de cada Resource dice
        # array<string, mixed>. Es un mismatch conocido del framework.
        # 54 ocurrencias en app/Http/Resources/*.
        - identifier: return.type
          paths:
              - app/Http/Resources
        # class.notFound en Services y Controllers: muchas veces son
        # Model skeletons (TASKS.md: 7/90). 43 ocurrencias.
        - identifier: class.notFound
          paths:
              - app/Http/Controllers
              - app/Services
        # argument.type en config/: env() puede retornar bool|string.
        # 11 ocurrencias, ya arregle las 2 criticas (sanctum, filesystems).
        # Las restantes son en config/ donde casts son aceptables.
        - identifier: argument.type
          paths:
              - config
        # property.notFound en Models que Larastan no infiere via $casts.
        # 53 ocurrencias en app/Models/*.
        - identifier: property.notFound
        # argument.type y return.type en Services/Returns/RefundService y
        # Service/Returns/ReturnRequestService: Model|Collection type mismatches
        # por skeleton no implementado.
        - message: "#App\\\\Services\\\\Returns\\\\RefundService::create\\(\\)#"
        - message: "#App\\\\Services\\\\Returns\\\\ReturnRequestService::create\\(\\)#"
        - message: "#App\\\\Services\\\\Returns\\\\ReturnRequestService::complete\\(\\)#"
        - message: "#App\\\\Services\\\\Shipping\\\\ShipmentService#"
        - message: "#App\\\\Console\\\\Commands\\\\BootstrapTenantCommand#"
        - message: "#App\\\\Http\\\\Controllers\\\\Api\\\\Storefront\\\\AssetController#"
        - message: "#App\\\\Enums\\\\ShipmentStatus#"
        # PHPDoc @use tags con tipos no encontrados (Catalog\Category usa
        # HasSlug trait que Larastan no detecta).
        - message: "#PHPDoc tag @use has invalid type#"
