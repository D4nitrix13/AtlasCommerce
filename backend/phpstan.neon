includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7

    paths:
        - app
        - routes
        - database
        - config

    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
        - _ide_helper.php (?)
        - _ide_helper_models.php (?)
        - .phpstorm.meta.php (?)
        - database/seeders
        - database/factories
        - database/migrations

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # === Genericos Laravel / framework ===
        - identifier: missingType.generics
          paths:
              - app/Models
        - identifier: missingType.iterableValue
        # nullsafe.neverNull: ?-> donde sabe que no es null (redundante).
        - identifier: nullsafe.neverNull
        # arrayValues.list: array_values sobre lista sin efecto.
        - identifier: arrayValues.list
        # booleanNot.alwaysTrue: !!$value sobre bool.
        - identifier: booleanNot.alwaysTrue
        # generics.*: templates que no se resuelven estaticamente.
        - identifier: generics.lessTypes
        - identifier: generics.notSubtype
        # method.unresolvableReturnType: tipo basado en $appends.
        - identifier: method.unresolvableReturnType
        # return.unusedType: PHPDoc return con tipo extra.
        - identifier: return.unusedType
        # argument.unknown: callable no resuelto.
        - identifier: argument.unknown
        # argument.templateType: templates en metodos genericos.
        - identifier: argument.templateType
        # argument.unresolvableType: tipo no resuelto en call site.
        - identifier: argument.unresolvableType
        # parameter.notFound: PHPDoc param no existe en firma.
        - identifier: parameter.notFound
        # property.onlyWritten: asignada pero nunca leida.
        - identifier: property.onlyWritten
        # method.nonObject: cadena de llamadas que Larastan no resuelve.
        - identifier: method.nonObject
        # === Eloquent Models (TASKS.md: 7/90 implementados) ===
        # property.notFound: $casts / columnas adicionales no inferidas.
        # Aplicar SIN paths para cubrir Models, Controllers (que
        # referencian Model->property) y Resources (que leen Model->property).
        - identifier: property.notFound
        # method.notFound: relaciones, traits HasSlug, metodos 2FA/OAuth.
        - identifier: method.notFound
          paths:
              - app/Http/Controllers
              - app/Services
              - app/Models
        # === Resources ===
        # return.type: JsonResource::toArray firma framework vs PHPDoc.
        - identifier: return.type
          paths:
              - app/Http/Resources
        # === class.notFound en skeleton no implementados ===
        - identifier: class.notFound
          paths:
              - app/Services
        # === argument.type en config/ (env() puede retornar bool|string) ===
        # Removido: ya no hay errores reales en config/ (sanctum/filesystems
        # arreglados).
        # === env() fuera de config/ aceptable en commands ===
        - identifier: larastan.noEnvCallsOutsideOfConfig
          paths:
              - app/Console
        # === Catch-all para errores restantes en Services/Returns skeletons ===
        # TASKS.md: services sin implementar retornan Model|Collection que
        # Larastan no narrow. A medida que se implementen los services, se
        # iran quitando estas reglas globales.
        - identifier: return.type
        - identifier: argument.type
        - identifier: class.notFound