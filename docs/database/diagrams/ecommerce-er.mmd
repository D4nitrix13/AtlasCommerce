erDiagram
    %% =====================================================================
    %% AtlasCommerce — ER diagram (regenerated 2026-10-01)
    %% 
    %% Source of truth: `Schema::create` calls in
    %%   backend/database/migrations/**/*.php
    %%   backend/packages/atlas-commerce-plugin-erp/database/migrations/*.php
    %% 
    %% Stats (verified via grep over all `Schema::create('name', ...)` and
    %% `Schema::create(table: 'name', ...)` migrations):
    %%   * 85 live tables (post-drop)
    %%   * 1 dropped table (erp_connections — removed 2026-08-10)
    %%   * ~10 ALTER additions (tax_rate on stores, shipping_cents /
    %%     refunded_cents / shipping_zone_id on invoices, store_id /
    %%     base_cost_cents on shipping_zones, GDPR fields on customers,
    %%     preferred_recovery_method on users, two_factor_settings.secret
    %%     widened to text).
    %% 
    %% Multi-tenancy: `store_id` is present on operational tables; the
    %%   `BelongsToStore` global scope filters per request and PostgreSQL
    %%   RLS policies (see `2026_08_02_000003_enable_row_level_security.php`)
    %%   enforce isolation at the DB level.
    %% 
    %% Money: all monetary amounts end in `_cents` (bigInteger). The only
    %%   exceptions are `exchange_rate_snapshot` (decimal(18,8)) and
    %%   coupon/promotion value/percentage (decimal(12,2)).
    %% 
    %% Naming convention: snake_case (English) to match Laravel tables.
    %% Mermaid renders entity names in uppercase visually.
    %% 
    %% Diff vs. previous diagram:
    %%   + sessions, social_account, passkeys, rfq_requests, bulk_cart_items
    %%     (new tables not present in the old 73-entity diagram)
    %%   + ALTER columns noted above
    %%   − erp_connections (dropped; was a legacy plugin table, never used)
    %% =====================================================================

    %% ============== 1. INFRASTRUCTURE ==============

    cache {
        string key PK
        mediumText value
        bigInteger expiration "indexed"
    }

    cache_locks {
        string key PK
        string owner
        bigInteger expiration "indexed"
    }

    jobs {
        bigint id PK
        string queue "indexed"
        longText payload
        unsignedSmallInt attempts
        unsignedInteger reserved_at "nullable"
        unsignedInteger created_at
    }

    job_batches {
        string id PK
        string name
        int total_jobs
        int pending_jobs
        int failed_jobs
        longText failed_job_ids
        mediumText options "nullable"
        int cancelled_at "nullable"
        int created_at
        int finished_at "nullable"
    }

    failed_jobs {
        bigint id PK
        string uuid UK
        string connection
        string queue
        longText payload
        longText exception
        timestamp failed_at "useCurrent"
    }

    media {
        bigint id PK
        morphs model
        uuid uuid "nullable, unique"
        string collection_name
        string name
        string file_name
        string mime_type "nullable"
        string disk
        string conversions_disk "nullable"
        bigInteger size
        json manipulations
        json custom_properties
        json generated_conversions
        json responsive_images
        unsignedInteger order_column "nullable, indexed"
        timestamp created_at "nullable"
        timestamp updated_at "nullable"
    }

    personal_access_tokens {
        bigint id PK
        morphs tokenable
        text name
        string token "64, unique"
        text abilities "nullable"
        timestamp last_used_at "nullable"
        timestamp expires_at "nullable, indexed"
        timestamp updated_at
    }

    passkeys {
        bigint id PK
        bigint user_id FK
        string name
        string credential_id UK
        json credential
        timestamp last_used_at "nullable"
        timestamp updated_at
    }

    sessions {
        string id PK
        bigint user_id FK "nullable, indexed"
        string ip_address "45 chars, nullable"
        text user_agent "nullable"
        longText payload
        int last_activity "indexed"
    }

    %% ============== 2. AUTH ==============

    users {
        bigint id PK
        bigint role_id FK "nullable"
        string first_name "80"
        string last_name "80"
        string email "150, unique"
        timestamp email_verified_at "nullable"
        string password
        string phone "30, nullable"
        boolean is_active "default true"
        timestamp registered_at "useCurrent"
        timestamp password_changed_at "nullable, indexed"
        timestamp last_login_at "nullable, indexed"
        string last_login_ip "45, nullable"
        unsignedInteger failed_login_attempts "default 0"
        timestamp locked_until "nullable, indexed"
        string preferred_recovery_method "20, default email, indexed. CHECK: email|2fa|recovery_codes"
        string remember_token "nullable"
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at "soft delete"
    }

    roles {
        bigint id PK
        string name "80, unique"
        string slug "100, unique"
        text description "nullable"
        boolean is_active "default true, indexed"
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at "soft delete"
    }

    permissions {
        bigint id PK
        string name "100"
        string slug "120, unique"
        string module "80, indexed"
        text description "nullable"
        timestamp created_at
        timestamp updated_at
    }

    permission_role {
        bigint id PK
        bigint role_id FK
        bigint permission_id FK
        timestamp created_at
        timestamp updated_at
    }

    password_reset_tokens {
        bigint id PK
        bigint user_id FK "nullable"
        string email "indexed"
        string token_hash
        timestamp expires_at "indexed"
        timestamp used_at "nullable, indexed"
        string request_ip "45, nullable"
        text user_agent "nullable"
        timestamp created_at
        timestamp updated_at
    }

    two_factor_settings {
        bigint id PK
        bigint user_id FK "unique (1:1)"
        text secret "was string(255); widened to text 2026-08-13"
        timestamp enabled_at "nullable, indexed"
        timestamp last_used_at "nullable"
        timestamp recovery_codes_generated_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    otp_challenges {
        bigint id PK
        bigint user_id FK
        string type "30: totp|email_otp|recovery_code"
        string code_hash "255"
        json context "nullable"
        timestamp expires_at "indexed"
        timestamp consumed_at "nullable"
        unsignedInteger attempts "default 0"
        timestamp created_at
        timestamp updated_at
    }

    recovery_codes {
        bigint id PK
        bigint user_id FK
        string code_hash "255"
        timestamp used_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    social_accounts {
        bigint id PK
        bigint user_id FK
        string provider "16: google|facebook"
        string provider_user_id "128"
        timestamp created_at
        timestamp updated_at
    }

