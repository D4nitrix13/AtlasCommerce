@startuml 8.2.3 - Diagrama de Clases (Clientes y Marketing, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Cliente con su dirección y listas de deseos.

class Cliente {
  - id: UUID
  - userId: UUID
  - firstName: String
  - lastName: String
  - email: String
  + anonimizar(): void
  + solicitarEliminacion(): void
  + activar(): void
  + desactivar(): void
}

class Direccion {
  - id: UUID
  - clienteId: UUID
  - addressType: String
  - country: String
  - detailedAddress: String
  + marcarComoPrincipal(): void
  + esPrincipal(): Boolean
  + formatearCompleta(): String
}

class ListaDeseos {
  - id: UUID
  - clienteId: UUID
  - tiendaId: UUID
  - nombre: String
  - visibilidad: VisibilidadLista
  + agregarProducto(productoId: UUID): void
  + eliminarProducto(productoId: UUID): void
  + cambiarVisibilidad(nueva: VisibilidadLista): void
  + esPublica(): Boolean
}

class ItemListaDeseos {
  - id: UUID
  - listaDeseosId: UUID
  - productoId: UUID
  - anadidoEn: DateTime
  + obtenerProducto(): Producto
}

Cliente "1" *-- "*" Direccion
Cliente "1" *-- "*" ListaDeseos
ListaDeseos "1" *-- "*" ItemListaDeseos

@enduml
