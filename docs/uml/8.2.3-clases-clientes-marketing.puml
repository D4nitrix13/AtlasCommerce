@startuml 8.2.3 - Diagrama de Clases (Clientes y Marketing)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' ============================================================
' 8.2.3 — CLIENTES Y MARKETING
' Paquetes: Clientes + Marketing
' ============================================================

package "Clientes" {

  class Cliente {
    - id: UUID
    - userId: UUID
    - customerType: TipoCliente
    - identityDocument: String
    - firstName: String
    - lastName: String
    - email: String
    - phone: String
    - isActive: Boolean
    - registeredAt: DateTime
    - anonymizedAt: DateTime
    - deletionRequestedAt: DateTime
    + isAnonymized(): Boolean
    + hasPendingDeletionToken(): Boolean
    + getFullNameAttribute(): String
    + anonimizar(): void
    + solicitarEliminacion(): void
    + activar(): void
    + desactivar(): void
  }

  enum TipoCliente {
    MINORISTA
    MAYORISTA
    CORPORATIVO
    + descripcion(): String
    + esMayorista(): Boolean
    + requiereAprobacion(): Boolean
  }

  class Direccion {
    - id: UUID
    - clienteId: UUID
    - addressType: String
    - country: String
    - department: String
    - municipality: String
    - detailedAddress: String
    - reference: String
    - isPrimary: Boolean
    + marcarComoPrincipal(): void
    + esPrincipal(): Boolean
    + formatearCompleta(): String
  }

  class ClienteTienda {
    - id: UUID
    - clienteId: UUID
    - tiendaId: UUID
    - customerType: TipoCliente
    - active: Boolean
    - createdAt: DateTime
    + activar(): void
    + desactivar(): void
    + cambiarTipo(tipo: TipoCliente): void
  }
}

package "Marketing" {

  class ListaDeseos {
    - id: UUID
    - clienteId: UUID
    - tiendaId: UUID
    - nombre: String
    - visibilidad: VisibilidadLista
    - fechaCreacion: DateTime
    + agregarProducto(productoId: UUID): void
    + eliminarProducto(productoId: UUID): void
    + esPublica(): Boolean
    + cambiarVisibilidad(nueva: VisibilidadLista): void
  }

  enum VisibilidadLista {
    PRIVADA
    PUBLICA
    COMPARTIDA_CON_ENLACE
    + descripcion(): String
    + esPublica(): Boolean
    + esCompartible(): Boolean
  }

  class ItemListaDeseos {
    - id: UUID
    - listaDeseosId: UUID
    - productoId: UUID
    - anadidoEn: DateTime
    + obtenerProducto(): Producto
  }

  class Cupon {
    - id: UUID
    - tiendaId: UUID
    - codigo: String
    - tipoDescuento: TipoDescuento
    - valorCents: Integer
    - fechaExpiracion: Date
    - usosMaximos: Integer
    - usosActuales: Integer
    - isActive: Boolean
    + esValido(): Boolean
    + calcularDescuento(montoCents: Integer): Integer
    + registrarUso(): Boolean
    + activar(): void
    + desactivar(): void
  }

  enum TipoDescuento {
    PORCENTAJE
    MONTO_FIJO
    + descripcion(): String
    + calcularDescuento(montoCents: Integer, valor: Integer): Integer
  }

  class Promocion {
    - id: UUID
    - tiendaId: UUID
    - nombre: String
    - descripcion: String
    - fechaInicio: Date
    - fechaFin: Date
    - condiciones: JSON
    - isActive: Boolean
    + esVigente(): Boolean
    + calcularDescuento(items: List<ItemCarrito>): Integer
    + activar(): void
    + desactivar(): void
  }

  class CuponUso {
    - id: UUID
    - cuponId: UUID
    - clienteId: UUID
    - pedidoId: UUID
    - usedAt: DateTime
    + obtenerCupon(): Cupon
    + obtenerCliente(): Cliente
    + obtenerPedido(): Pedido
  }
}

' ============================================================
' RELACIONES — CLIENTES
' ============================================================
Usuario "1" --> "0..1" Cliente : "vinculado a"
Cliente "1" *-- "*" Direccion : "direcciones"
Cliente "*" -- "*" Tienda : "vinculado vía"
ClienteTienda "*" --> "1" Cliente
ClienteTienda "*" --> "1" Tienda
Cliente "*" --> "1" TipoCliente

' ============================================================
' RELACIONES — MARKETING
' ============================================================
Cliente "1" *-- "*" ListaDeseos
ListaDeseos "*" --> "1" Tienda
ListaDeseos "*" --> "1" VisibilidadLista
ListaDeseos "1" *-- "*" ItemListaDeseos
ItemListaDeseos "*" --> "1" Producto
Tienda "1" *-- "*" Cupon
Cupon "*" --> "1" TipoDescuento
Tienda "1" *-- "*" Promocion
Cupon "1" *-- "*" CuponUso
CuponUso "*" --> "1" Cliente
CuponUso "*" --> "1" Pedido

@enduml
