@startuml 8.2.1 - Diagrama de Clases (Núcleo del Sistema, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Núcleo: tenant (Tienda + DominioTienda) y acceso (Usuario, Rol, Permiso).

class Tienda {
  - id: UUID
  - currencyId: UUID
  - nombre: String
  - slug: String
  - isActive: Boolean
  + activarModoMantenimiento(): void
  + desactivarModoMantenimiento(): void
  + primaryDomain(): DominioTienda
}

class DominioTienda {
  - id: UUID
  - tiendaId: UUID
  - domain: String
  - isPrimary: Boolean
  - verifiedAt: DateTime
  + marcarComoPrimario(): void
  + verificar(): void
  + desactivar(): void
}

class Usuario {
  - id: UUID
  - roleId: UUID
  - firstName: String
  - email: String
  - isActive: Boolean
  + habilitarSegundoFactor(metodo: String): void
  + desactivarSegundoFactor(): void
  + cambiarContrasena(nuevaContrasena: String): void
  + registrarAcceso(): void
}

class Rol {
  - id: UUID
  - nombre: String
  - slug: String
  - descripcion: String
  - isActive: Boolean
  + asignarPermiso(permisoId: UUID): void
  + revocarPermiso(permisoId: UUID): void
  + activar(): void
  + desactivar(): void
}

class Permiso {
  - id: UUID
  - nombre: String
  - slug: String
  - modulo: String
  - descripcion: String
  + esDeModulo(modulo: String): Boolean
}

Tienda "1" *-- "*" DominioTienda
Usuario "*" --> "*" Rol : "asignado vía"
Rol "*" --> "*" Permiso : "otorga"
Usuario "*" -- "*" Tienda : "asignado vía"

@enduml
