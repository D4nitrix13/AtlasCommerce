@startuml 8.2.1 - Diagrama de Clases (Núcleo del Sistema)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' ============================================================
' 8.2.1 — NÚCLEO DEL SISTEMA
' Paquetes: Núcleo Multitenant + Identidad y Acceso
' ============================================================

package "Núcleo Multitenant" {

  class Tienda <<aggregate root>> {
    - id: UUID
    - currencyId: UUID
    - nombre: String
    - slug: String
    - logoPath: String
    - faviconPath: String
    - email: String
    - phone: String
    - whatsapp: String
    - primaryColor: String
    - secondaryColor: String
    - taxRate: Decimal
    - maintenanceMode: Boolean
    - isActive: Boolean
    + hasFeature(slug: String): Boolean
    + primaryDomain(): DominioTienda
    + obtenerConfiguracion(clave: String): String
    + activarModoMantenimiento(): void
    + desactivarModoMantenimiento(): void
  }

  class DominioTienda {
    - id: UUID
    - tiendaId: UUID
    - domain: String
    - isPrimary: Boolean
    - isActive: Boolean
    - verifiedAt: DateTime
    + marcarComoPrimario(): void
    + verificar(): void
    + desactivar(): void
  }

  class ConfiguracionTienda {
    - id: UUID
    - tiendaId: UUID
    - clave: String
    - valor: String
    - tipoDato: String
    - isPublic: Boolean
    + obtenerValor(): String
    + esValorBooleano(): Boolean
    + serializar(): String
  }

  class StoreFeature {
    - id: UUID
    - tiendaId: UUID
    - slug: String
    - isActive: Boolean
    + activar(): void
    + desactivar(): void
  }

  class StoreTheme {
    - id: UUID
    - tiendaId: UUID
    - shortName: String
    - logoPath: String
    - accentColor: String
    - primaryColor: String
    - supportEmail: String
    - tokens: JSON
    + regenerarTokens(): void
    + obtenerColor(nombre: String): String
  }

  class Moneda {
    - id: UUID
    - codigoISO: String
    - nombre: String
    - simbolo: String
    - decimalPlaces: Integer
    - isPrimary: Boolean
    - isActive: Boolean
    + latestRate(): TasaCambio
    + activar(): void
    + desactivar(): void
    + formatear(montoCents: Integer): String
  }

  class TasaCambio {
    - id: UUID
    - monedaOrigenId: UUID
    - monedaDestinoId: UUID
    - value: Decimal
    - fechaVigencia: Date
    + calcularInversa(): Decimal
    + esValida(): Boolean
  }

  class Impuesto {
    - id: UUID
    - tiendaId: UUID
    - nombre: String
    - porcentaje: Decimal
    - tipoContribuyente: TipoContribuyente
    - retencionIRPorcentaje: Decimal
    - activo: Boolean
    + calcularImpuesto(montoBase: Decimal): Decimal
    + aplicar(subtotal: Decimal): Decimal
  }

  enum TipoContribuyente {
    B2C_MINORISTA
    B2B_MAYORISTA
    AMBOS
    + descripcion(): String
    + requiereRetencionIR(): Boolean
    + aplicaA(tipoCliente: TipoCliente): Boolean
  }
}

package "Identidad y Acceso" {

  class Usuario {
    - id: UUID
    - roleId: UUID
    - firstName: String
    - lastName: String
    - email: String
    - password: String
    - phone: String
    - isActive: Boolean
    - emailVerifiedAt: DateTime
    - twoFactorEnabled: Boolean
    - registeredAt: DateTime
    - lastLoginAt: DateTime
    + getFullNameAttribute(): String
    + hasTwoFactorEnabled(): Boolean
    + hasAccessToStore(storeId: Integer): Boolean
    + hasPermission(slug: String): Boolean
    + habilitarSegundoFactor(metodo: String): void
    + desactivarSegundoFactor(): void
    + verificarContrasena(contrasena: String): Boolean
    + cambiarContrasena(nuevaContrasena: String): void
    + marcarCorreoVerificado(): void
    + registrarAcceso(): void
  }

  class CredencialSegundoFactor {
    - id: UUID
    - usuarioId: UUID
    - metodo: TipoSegundoFactor
    - secret: String
    - enabledAt: DateTime
    - lastUsedAt: DateTime
    - recoveryCodesGeneratedAt: DateTime
    + isEnabled(): Boolean
    + validarCodigo(codigo: String): Boolean
    + habilitar(): void
    + deshabilitar(): void
    + regenerarCodigosRecuperacion(): void
  }

  enum TipoSegundoFactor {
    OTP_EMAIL
    TOTP
    + descripcion(): String
    + requiereDispositivoFisico(): Boolean
    + requiereConexionInternet(): Boolean
  }

  class CodigoRecuperacion {
    - id: UUID
    - usuarioId: UUID
    - codigoHash: String
    - usadoEn: DateTime
    - creadoEn: DateTime
    + marcarUsado(): void
    + esValido(): Boolean
  }

  class CuentaSocial {
    - id: UUID
    - usuarioId: UUID
    - provider: String
    - idExterno: String
    - datosExtra: JSON
    + obtenerAvatarUrl(): String
    + desvincular(): void
  }

  class TokenResetContrasena {
    - id: UUID
    - usuarioId: UUID
    - email: String
    - tokenHash: String
    - expiraEn: DateTime
    - usadoEn: DateTime
    - requestIp: String
    - userAgent: String
    + isValid(): Boolean
    + marcarComoUsado(): void
    + esExpirado(): Boolean
  }

  class OtpChallenge {
    - id: UUID
    - usuarioId: UUID
    - type: String
    - codeHash: String
    - context: JSON
    - expiresAt: DateTime
    - consumedAt: DateTime
    - attempts: Integer
    + isUsable(): Boolean
    + isExpired(): Boolean
    + isExhausted(): Boolean
    + validar(codigo: String): Boolean
    + consumir(): void
    + incrementarIntento(): void
  }

  class Rol {
    - id: UUID
    - nombre: String
    - slug: String
    - descripcion: String
    - isActive: Boolean
    + asignarPermiso(permisoId: UUID): void
    + revocarPermiso(permisoId: UUID): void
    + tienePermiso(slug: String): Boolean
    + activar(): void
    + desactivar(): void
  }

  class Permiso {
    - id: UUID
    - nombre: String
    - slug: String
    - modulo: String
    - descripcion: String
    + esDeModulo(modulo: String): Boolean
  }

  class UsuarioTienda {
    - id: UUID
    - usuarioId: UUID
    - tiendaId: UUID
    - rolId: UUID
    - activo: Boolean
    - asignadoEn: DateTime
    + activar(): void
    + desactivar(): void
    + cambiarRol(rolId: UUID): void
  }

  class BitacoraAuditoria {
    - id: UUID
    - usuarioId: UUID
    - tiendaId: UUID
    - accion: String
    - modulo: String
    - entidad: String
    - entidadId: UUID
    - datosAnteriores: JSON
    - datosNuevos: JSON
    - ipOrigen: String
    - ocurridoEn: DateTime
    + obtenerCambios(): Map
    + compararCon(otro: BitacoraAuditoria): Map
  }
}

' ============================================================
' RELACIONES — NÚCLEO MULTITENANT
' ============================================================
Tienda "1" *-- "many" DominioTienda
Tienda "1" *-- "many" ConfiguracionTienda
Tienda "1" *-- "many" StoreFeature
Tienda "1" --> "0..1" StoreTheme
Tienda "1" --> "1" Moneda : "moneda por defecto"
Tienda "1" *-- "many" Impuesto
TasaCambio "many" --> "1" Moneda : "moneda origen y destino"
Impuesto "many" --> "1" TipoContribuyente

' ============================================================
' RELACIONES — IDENTIDAD Y ACCESO
' ============================================================
Usuario "1" --> "0..1" CredencialSegundoFactor
CredencialSegundoFactor "many" --> "1" TipoSegundoFactor
Usuario "1" *-- "many" CodigoRecuperacion
Usuario "1" *-- "many" CuentaSocial
Usuario "1" *-- "many" TokenResetContrasena
Usuario "1" *-- "many" OtpChallenge
Usuario "many" --> "many" Rol : "asignado vía"
Rol "many" --> "many" Permiso : "otorga"
Usuario "many" -- "many" Tienda : "asignado vía"
UsuarioTienda "*" --> "1" Usuario : "empleado"
UsuarioTienda "*" --> "1" Tienda
UsuarioTienda "*" --> "1" Rol : "rol específico en tienda"
Usuario "1" --> "many" BitacoraAuditoria
BitacoraAuditoria "*" --> "1" Tienda

@enduml
