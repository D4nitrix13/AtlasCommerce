@startuml 9.1 - Diagrama Entidad-Relacion (nucleo del sistema)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction

' ============================================================
' 9.1 — DISENO DE LA BASE DE DATOS: DIAGRAMA ENTIDAD-RELACION
' Nucleo de 16 entidades del sistema AtlasCommerce.
' Fuente de verdad: backend/database/migrations/** (PostgreSQL 18).
' ============================================================
' Convenciones graficas:
'   <<PK>>   clave primaria (todas BIGSERIAL, no UUID)
'   <<FK>>   clave foranea declarada con constrained()
'   --       separador de grupos de campos dentro de la entidad
'   Multiplicidades explicitas en AMBOS extremos de cada relacion.
'
' Los atributos y las claves foraneas se expresan en espanol
' academico. Cada entidad declara su tabla fisica real como alias
' PlantUML, y la equivalencia completa entre el nombre academico y
' la columna fisica en ingles esta al final del diagrama.
' ============================================================

' ============================================================
' MULTI-TENANCIA
' ============================================================

package "MULTI-TENANCIA" {

  entity "TIENDA" as stores {
    * id : BIGSERIAL <<PK>>
    --
    moneda_id : BIGINT <<FK>>
    --
    nombre : VARCHAR(160)
    slug : VARCHAR(160)
    ruta_logo : VARCHAR(255)
    ruta_favicon : VARCHAR(255)
    ruta_imagen_portada : VARCHAR(255)
    ruta_imagen_compartida : VARCHAR(255)
    correo : VARCHAR(150)
    telefono : VARCHAR(30)
    whatsapp : VARCHAR(30)
    direccion : TEXT
    descripcion : TEXT
    color_primario : VARCHAR(20)
    color_secundario : VARCHAR(20)
    tasa_impuesto : DECIMAL(5,2)
    modo_mantenimiento : BOOLEAN
    activo : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "TIENDA_DOMINIO" as store_domains {
    * id : BIGSERIAL <<PK>>
    --
    tienda_id : BIGINT <<FK>>
    --
    dominio : VARCHAR(255)
    tipo : VARCHAR(20)
    ruta_base : VARCHAR(255)
    redirigir_a_principal : BOOLEAN
    es_principal : BOOLEAN
    activo : BOOLEAN
    verificado_en : TIMESTAMP
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
  }
}

' ============================================================
' IDENTIDAD Y ACCESO
' ============================================================

package "IDENTIDAD Y ACCESO" {

  entity "USUARIO" as users {
    * id : BIGSERIAL <<PK>>
    --
    rol_id : BIGINT <<FK>>
    --
    nombre : VARCHAR(80)
    apellido : VARCHAR(80)
    correo : VARCHAR(150)
    correo_verificado_en : TIMESTAMP
    contrasena : VARCHAR(255)
    telefono : VARCHAR(30)
    activo : BOOLEAN
    registrado_en : TIMESTAMP
    contrasena_cambiada_en : TIMESTAMP
    ultimo_inicio_sesion_en : TIMESTAMP
    ip_ultimo_inicio_sesion : VARCHAR(45)
    intentos_fallidos : INTEGER
    bloqueado_hasta : TIMESTAMP
    metodo_recuperacion_preferido : VARCHAR(20)
    token_recordatorio : VARCHAR(100)
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "ROL" as roles {
    * id : BIGSERIAL <<PK>>
    --
    nombre : VARCHAR(80)
    slug : VARCHAR(100)
    descripcion : TEXT
    activo : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }
}

' ============================================================
' CLIENTE
' ============================================================

package "CLIENTE" {

  entity "CLIENTE" as customers {
    * id : BIGSERIAL <<PK>>
    --
    usuario_id : BIGINT <<FK>>
    --
    tipo_cliente : VARCHAR(50)
    documento_identidad : VARCHAR(80)
    nombre : VARCHAR(80)
    apellido : VARCHAR(80)
    correo : VARCHAR(150)
    telefono : VARCHAR(30)
    registrado_en : TIMESTAMP
    activo : BOOLEAN
    anonimizado_en : TIMESTAMP
    eliminacion_solicitada_en : TIMESTAMP
    hash_token_eliminacion : VARCHAR(64)
    token_eliminacion_expira_en : TIMESTAMP
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "CLIENTE_DIRECCION" as customer_addresses {
    * id : BIGSERIAL <<PK>>
    --
    cliente_id : BIGINT <<FK>>
    --
    tipo_direccion : VARCHAR(50)
    pais : VARCHAR(80)
    departamento : VARCHAR(100)
    municipio : VARCHAR(100)
    direccion_detallada : TEXT
    referencia : TEXT
    es_principal : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }
}

' ============================================================
' CATALOGO
' ============================================================

package "CATALOGO" {

  entity "CATEGORIA" as categories {
    * id : BIGSERIAL <<PK>>
    --
    categoria_padre_id : BIGINT <<FK>>
    --
    nombre : VARCHAR(120)
    slug : VARCHAR(150)
    descripcion : TEXT
    ruta_imagen : VARCHAR(255)
    activo : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "MARCA" as brands {
    * id : BIGSERIAL <<PK>>
    --
    nombre : VARCHAR(120)
    slug : VARCHAR(150)
    descripcion : TEXT
    url_logo : VARCHAR(255)
    activo : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "PRODUCTO" as products {
    * id : BIGSERIAL <<PK>>
    --
    categoria_id : BIGINT <<FK>>
    marca_id : BIGINT <<FK>>
    moneda_id : BIGINT <<FK>>
    --
    nombre : VARCHAR(160)
    slug : VARCHAR(180)
    descripcion : TEXT
    sku : VARCHAR(120)
    precio_base_centavos : BIGINT
    costo_centavos : BIGINT
    activo : BOOLEAN
    publicado_en : TIMESTAMP
    tiene_estado : BOOLEAN
    tiene_tallas : BOOLEAN
    es_exclusivo : BOOLEAN
    es_para_zurdos : BOOLEAN
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "PRODUCTO_VARIANTE" as product_variants {
    * id : BIGSERIAL <<PK>>
    --
    producto_id : BIGINT <<FK>>
    talla_id : BIGINT <<FK>>
    --
    nombre : VARCHAR(160)
    sku : VARCHAR(120)
    precio_centavos : BIGINT
    costo_centavos : BIGINT
    codigo_barras : VARCHAR(120)
    activo : BOOLEAN
    acabado_slug : VARCHAR(64)
    etiqueta_acabado : VARCHAR(120)
    color_acabado : VARCHAR(9)
    estado_producto : VARCHAR(16)
    existencias : INTEGER
    lateralidad : VARCHAR(16)
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "INVENTARIO" as inventories {
    * id : BIGSERIAL <<PK>>
    --
    almacen_id : BIGINT <<FK>>
    producto_id : BIGINT <<FK>>
    variante_id : BIGINT <<FK>>
    --
    stock_actual : INTEGER
    stock_minimo : INTEGER
    stock_reservado : INTEGER
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
  }
}

' ============================================================
' OPERACIONES
' ============================================================

package "OPERACIONES" {

  entity "PEDIDO" as orders {
    * id : BIGSERIAL <<PK>>
    --
    cliente_id : BIGINT <<FK>>
    tienda_id : BIGINT <<FK>>
    moneda_id : BIGINT <<FK>>
    direccion_envio_id : BIGINT <<FK>>
    canal_venta_id : BIGINT <<FK>>
    usuario_creador_id : BIGINT <<FK>>
    --
    numero_pedido : VARCHAR(80)
    subtotal_centavos : BIGINT
    descuento_centavos : BIGINT
    impuesto_centavos : BIGINT
    envio_centavos : BIGINT
    total_centavos : BIGINT
    tasa_cambio_congelada : NUMERIC(18,8)
    total_moneda_base_centavos : BIGINT
    estado : VARCHAR(50)
    pedido_en : TIMESTAMP
    notas : TEXT
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "DETALLE_PEDIDO" as order_items {
    * id : BIGSERIAL <<PK>>
    --
    pedido_id : BIGINT <<FK>>
    producto_id : BIGINT <<FK>>
    variante_id : BIGINT <<FK>>
    diseno_personalizado_id : BIGINT <<FK>>
    --
    cantidad : INTEGER
    precio_unitario_centavos : BIGINT
    descuento_centavos : BIGINT
    subtotal_centavos : BIGINT
    nombre_producto_congelado : VARCHAR(160)
    sku_producto_congelado : VARCHAR(120)
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
  }

  entity "ENVIO" as shipments {
    * id : BIGSERIAL <<PK>>
    --
    pedido_id : BIGINT <<FK>>
    moneda_id : BIGINT <<FK>>
    empresa_envio_id : BIGINT <<FK>>
    zona_envio_id : BIGINT <<FK>>
    --
    codigo_seguimiento : VARCHAR(160)
    url_seguimiento : VARCHAR(255)
    estado_ultimo_evento : VARCHAR(80)
    ubicacion_ultimo_evento : VARCHAR(255)
    ultimo_evento_en : TIMESTAMP
    costo_envio_centavos : BIGINT
    estado : VARCHAR(50)
    enviado_en : TIMESTAMP
    entregado_en : TIMESTAMP
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }
}

' ============================================================
' FINANZAS
' ============================================================

package "FINANZAS" {

  entity "PAGO" as payments {
    * id : BIGSERIAL <<PK>>
    --
    cliente_id : BIGINT <<FK>>
    tienda_id : BIGINT <<FK>>
    moneda_id : BIGINT <<FK>>
    metodo_pago_id : BIGINT <<FK>>
    --
    monto_centavos : BIGINT
    tasa_cambio_congelada : NUMERIC(18,8)
    referencia : VARCHAR(160)
    estado : VARCHAR(50)
    pagado_en : TIMESTAMP
    notas : TEXT
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }

  entity "FACTURA" as invoices {
    * id : BIGSERIAL <<PK>>
    --
    cliente_id : BIGINT <<FK>>
    tienda_id : BIGINT <<FK>>
    moneda_id : BIGINT <<FK>>
    pedido_id : BIGINT <<FK>>
    canal_venta_id : BIGINT <<FK>>
    usuario_emisor_id : BIGINT <<FK>>
    zona_envio_id : BIGINT <<FK>>
    --
    numero_factura : VARCHAR(80)
    subtotal_centavos : BIGINT
    descuento_centavos : BIGINT
    impuesto_centavos : BIGINT
    envio_centavos : BIGINT
    total_centavos : BIGINT
    reembolsado_centavos : BIGINT
    tasa_cambio_congelada : NUMERIC(18,8)
    estado_pago : VARCHAR(50)
    estado_factura : VARCHAR(50)
    emitida_en : TIMESTAMP
    vence_en : TIMESTAMP
    notas : TEXT
    creado_en : TIMESTAMP
    actualizado_en : TIMESTAMP
    eliminado_en : TIMESTAMP
  }
}

' ============================================================
' RELACIONES — MULTI-TENANCIA
'   TIENDA es la raiz del multi-tenant: delimita los dominios que
'   resuelven a la tienda y delimita los documentos transaccionales.
' ============================================================
stores "1" -- "0..*" store_domains : "tienda_id"
stores "1" -- "0..*" orders : "tienda_id"
stores "1" -- "0..*" payments : "tienda_id"
stores "1" -- "0..*" invoices : "tienda_id"

' ============================================================
' RELACIONES — IDENTIDAD Y ACCESO
'   usuario_creador_id y usuario_emisor_id documentan la trazabilidad
'   del operador administrativo que creo el documento.
' ============================================================
roles "1" -- "0..*" users : "rol_id"
users "1" -- "0..1" customers : "usuario_id"
users "1" -- "0..*" orders : "usuario_creador_id (trazabilidad)"
users "1" -- "0..*" invoices : "usuario_emisor_id (trazabilidad)"

' ============================================================
' RELACIONES — CLIENTE
'   CLIENTE no tiene tienda_id: la pertenencia a una tienda se
'   resuelve por la tabla puente customer_stores (N:N, externa).
' ============================================================
customers "1" -- "0..*" customer_addresses : "cliente_id"
customers "1" -- "0..*" orders : "cliente_id"
customers "1" -- "0..*" payments : "cliente_id"
customers "1" -- "0..*" invoices : "cliente_id"
customer_addresses "0..1" -- "0..*" orders : "direccion_envio_id"

' ============================================================
' RELACIONES — CATALOGO
'   categoria_padre_id es auto-referencia nullable: la jerarquia
'   de categorias es recursiva y una raiz tiene categoria_padre_id NULL.
' ============================================================
categories "1" -- "0..*" products : "categoria_id"
categories "0..1" -- "0..*" categories : "categoria_padre_id (auto-ref)"
brands "0..1" -- "0..*" products : "marca_id"
products "1" -- "0..*" product_variants : "producto_id"
products "1" -- "0..*" order_items : "producto_id"
products "1" -- "0..*" inventories : "producto_id"
product_variants "0..1" -- "0..*" order_items : "variante_id"
product_variants "0..1" -- "0..*" inventories : "variante_id"

' ============================================================
' RELACIONES — OPERACIONES
' ============================================================
orders "1" -- "0..*" order_items : "pedido_id"
orders "1" -- "0..*" shipments : "pedido_id"
orders "0..1" -- "0..*" invoices : "pedido_id"

' ============================================================
' RELACIONES — FINANZAS
'   PAGO NO tiene pedido_id: se vincula con FACTURA mediante la
'   tabla puente invoice_payments (N:M), de modo que un pago puede
'   cubrir varias facturas y una factura varios pagos.
' ============================================================
payments "*" -- "0..*" invoices : "invoice_payments (tabla puente N:M)"

' ============================================================
' NOTAS — CLAVES FORANEAS EXTERNAS
' Las siguientes claves foraneas apuntan a tablas que quedan fuera
' del nucleo de 16 entidades y por eso NO se dibujan como entidad:
'   currencies (moneda)      <- stores, products, orders, payments,
'                               invoices, shipments
'   payment_methods          <- payments
'   sales_channels           <- orders, invoices
'   shipping_companies       <- shipments
'   shipping_zones           <- invoices, shipments
'   warehouses               <- inventories
'   product_sizes            <- product_variants
'   custom_designs           <- order_items
' Tablas puente (pivots) externas:
'   invoice_payments         PAGO <-> FACTURA (N:M)
'   customer_stores          CLIENTE <-> TIENDA (N:N)
' ============================================================
' NOTAS — REGLAS DE INTEGRIDAD
'   ON DELETE RESTRICT: tienda, cliente, categoria, marca, moneda,
'                       metodo de pago y producto no pueden borrarse
'                       si existen pedidos, pagos, facturas o stock.
'   ON DELETE CASCADE:  lineas de pedido, envios, variantes e
'                       inventarios se eliminan con su padre.
'   ON DELETE SET NULL: la FK queda en NULL (usuario, variante,
'                       diseno, canal, zona de envio, direccion).
'   Aislamiento multi-tenant: RLS activo sobre orders, invoices y
'                       payments; el resto se filtra por middleware.
' ============================================================
' EQUIVALENCIA — NOMBRE ACADEMICO / COLUMNA FISICA
'   La base de datos guarda los nombres en ingles. La tabla fisica
'   de cada entidad es su alias PlantUML. Correspondencias:
'
'   TIENDA.nombre / slug / correo / tasa_impuesto
'                    -> stores.name / slug / email / tax_rate
'   TIENDA_DOMINIO.tienda_id / dominio
'                    -> store_domains.store_id / domain
'   USUARIO.rol_id / correo / contrasena / bloqueado_hasta
'                    -> users.role_id / email / password / locked_until
'   ROL.nombre / descripcion / activo
'                    -> roles.name / description / is_active
'   CLIENTE.usuario_id / tipo_cliente / documento_identidad / correo
'                    -> customers.user_id / customer_type /
'                       identity_document / email
'   CLIENTE_DIRECCION.cliente_id / direccion_detallada / es_principal
'                    -> customer_addresses.customer_id /
'                       detailed_address / is_primary
'   CATEGORIA.categoria_padre_id / nombre
'                    -> categories.parent_id / name
'   MARCA.nombre / url_logo
'                    -> brands.name / logo_url
'   PRODUCTO.categoria_id / marca_id / precio_base_centavos
'                    -> products.category_id / brand_id / base_price_cents
'   PRODUCTO_VARIANTE.producto_id / talla_id / precio_centavos
'                    -> product_variants.product_id / size_id / price_cents
'   INVENTARIO.almacen_id / variante_id / stock_actual
'                    -> inventories.warehouse_id / product_variant_id /
'                       current_stock
'   PEDIDO.cliente_id / tienda_id / direccion_envio_id /
'   usuario_creador_id / numero_pedido / total_centavos / estado
'                    -> orders.customer_id / store_id /
'                       shipping_address_id / user_creator_id /
'                       order_number / total_cents / status
'   DETALLE_PEDIDO.pedido_id / variante_id / cantidad /
'   precio_unitario_centavos
'                    -> order_items.order_id / product_variant_id /
'                       quantity / unit_price_cents
'   ENVIO.pedido_id / empresa_envio_id / zona_envio_id /
'   codigo_seguimiento / costo_envio_centavos / enviado_en
'                    -> shipments.order_id / shipping_company_id /
'                       shipping_zone_id / tracking_code /
'                       shipping_cost_cents / shipped_at
'   PAGO.cliente_id / metodo_pago_id / monto_centavos / pagado_en
'                    -> payments.customer_id / payment_method_id /
'                       amount_cents / paid_at
'   FACTURA.pedido_id / usuario_emisor_id / numero_factura /
'   reembolsado_centavos / estado_pago / estado_factura / emitida_en
'                    -> invoices.order_id / user_issuer_id /
'                       invoice_number / refunded_cents /
'                       payment_status / invoice_status / issued_at
'
'   Los campos created_at, updated_at y deleted_at se nombran
'   creado_en, actualizado_en y eliminado_en en todo el diagrama.
' ============================================================

@enduml