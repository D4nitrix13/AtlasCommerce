@startuml 9.1 - Diagrama Entidad-Relacion (nucleo del sistema)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction

' ============================================================
' 9.1 — DISENO DE LA BASE DE DATOS: DIAGRAMA ENTIDAD-RELACION
' Nucleo de 16 entidades del sistema AtlasCommerce.
' Fuente de verdad: backend/database/migrations/** (PostgreSQL 18).
' ============================================================
' Convenciones graficas:
'   <<PK>>   clave primaria (todas BIGSERIAL, no UUID)
'   <<FK>>   clave foranea declarada con constrained()
'   --       separador de grupos de campos dentro de la entidad
'   Multiplicidades explicitas en AMBOS extremos de cada relacion.
'   Cada entidad declara su tabla fisica real como alias PlantUML
'   para trazabilidad con docs/database/README.md.
' ============================================================

' ============================================================
' MULTI-TENANCIA
' ============================================================

package "MULTI-TENANCIA" {

  entity "TIENDA" as stores {
    * id : BIGSERIAL <<PK>>
    --
    currency_id : BIGINT <<FK>>
    --
    name : VARCHAR(160)
    slug : VARCHAR(160)
    logo_path : VARCHAR(255)
    favicon_path : VARCHAR(255)
    cover_image_path : VARCHAR(255)
    og_image_path : VARCHAR(255)
    email : VARCHAR(150)
    phone : VARCHAR(30)
    whatsapp : VARCHAR(30)
    address : TEXT
    description : TEXT
    primary_color : VARCHAR(20)
    secondary_color : VARCHAR(20)
    tax_rate : DECIMAL(5,2)
    maintenance_mode : BOOLEAN
    is_active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "TIENDA_DOMINIO" as store_domains {
    * id : BIGSERIAL <<PK>>
    --
    store_id : BIGINT <<FK>>
    --
    domain : VARCHAR(255)
    type : VARCHAR(20)
    base_path : VARCHAR(255)
    redirect_to_primary : BOOLEAN
    is_primary : BOOLEAN
    is_active : BOOLEAN
    verified_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }
}

' ============================================================
' IDENTIDAD Y ACCESO
' ============================================================

package "IDENTIDAD Y ACCESO" {

  entity "USUARIO" as users {
    * id : BIGSERIAL <<PK>>
    --
    role_id : BIGINT <<FK>>
    --
    first_name : VARCHAR(80)
    last_name : VARCHAR(80)
    email : VARCHAR(150)
    email_verified_at : TIMESTAMP
    password : VARCHAR(255)
    phone : VARCHAR(30)
    is_active : BOOLEAN
    registered_at : TIMESTAMP
    password_changed_at : TIMESTAMP
    last_login_at : TIMESTAMP
    last_login_ip : VARCHAR(45)
    failed_login_attempts : INTEGER
    locked_until : TIMESTAMP
    preferred_recovery_method : VARCHAR(20)
    remember_token : VARCHAR(100)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "ROL" as roles {
    * id : BIGSERIAL <<PK>>
    --
    name : VARCHAR(80)
    slug : VARCHAR(100)
    description : TEXT
    is_active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }
}

' ============================================================
' CLIENTE
' ============================================================

package "CLIENTE" {

  entity "CLIENTE" as customers {
    * id : BIGSERIAL <<PK>>
    --
    user_id : BIGINT <<FK>>
    --
    customer_type : VARCHAR(50)
    identity_document : VARCHAR(80)
    first_name : VARCHAR(80)
    last_name : VARCHAR(80)
    email : VARCHAR(150)
    phone : VARCHAR(30)
    registered_at : TIMESTAMP
    is_active : BOOLEAN
    anonymized_at : TIMESTAMP
    deletion_requested_at : TIMESTAMP
    deletion_token_hash : VARCHAR(64)
    deletion_token_expires_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "CLIENTE_DIRECCION" as customer_addresses {
    * id : BIGSERIAL <<PK>>
    --
    customer_id : BIGINT <<FK>>
    --
    address_type : VARCHAR(50)
    country : VARCHAR(80)
    department : VARCHAR(100)
    municipality : VARCHAR(100)
    detailed_address : TEXT
    reference : TEXT
    is_primary : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }
}

' ============================================================
' CATALOGO
' ============================================================

package "CATALOGO" {

  entity "CATEGORIA" as categories {
    * id : BIGSERIAL <<PK>>
    --
    parent_id : BIGINT <<FK>>
    --
    name : VARCHAR(120)
    slug : VARCHAR(150)
    description : TEXT
    image_path : VARCHAR(255)
    is_active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "MARCA" as brands {
    * id : BIGSERIAL <<PK>>
    --
    name : VARCHAR(120)
    slug : VARCHAR(150)
    description : TEXT
    logo_url : VARCHAR(255)
    is_active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "PRODUCTO" as products {
    * id : BIGSERIAL <<PK>>
    --
    category_id : BIGINT <<FK>>
    brand_id : BIGINT <<FK>>
    currency_id : BIGINT <<FK>>
    --
    name : VARCHAR(160)
    slug : VARCHAR(180)
    description : TEXT
    sku : VARCHAR(120)
    base_price_cents : BIGINT
    cost_cents : BIGINT
    is_active : BOOLEAN
    published_at : TIMESTAMP
    has_condition : BOOLEAN
    has_sizes : BOOLEAN
    is_exclusive : BOOLEAN
    is_left_handed : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "PRODUCTO_VARIANTE" as product_variants {
    * id : BIGSERIAL <<PK>>
    --
    product_id : BIGINT <<FK>>
    size_id : BIGINT <<FK>>
    --
    name : VARCHAR(160)
    sku : VARCHAR(120)
    price_cents : BIGINT
    cost_cents : BIGINT
    barcode : VARCHAR(120)
    is_active : BOOLEAN
    finish_slug : VARCHAR(64)
    finish_label : VARCHAR(120)
    finish_hex : VARCHAR(9)
    condition : VARCHAR(16)
    stock : INTEGER
    handedness : VARCHAR(16)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "INVENTARIO" as inventories {
    * id : BIGSERIAL <<PK>>
    --
    warehouse_id : BIGINT <<FK>>
    product_id : BIGINT <<FK>>
    product_variant_id : BIGINT <<FK>>
    --
    current_stock : INTEGER
    minimum_stock : INTEGER
    reserved_stock : INTEGER
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }
}

' ============================================================
' OPERACIONES
' ============================================================

package "OPERACIONES" {

  entity "PEDIDO" as orders {
    * id : BIGSERIAL <<PK>>
    --
    customer_id : BIGINT <<FK>>
    store_id : BIGINT <<FK>>
    currency_id : BIGINT <<FK>>
    shipping_address_id : BIGINT <<FK>>
    sales_channel_id : BIGINT <<FK>>
    user_creator_id : BIGINT <<FK>>
    --
    order_number : VARCHAR(80)
    subtotal_cents : BIGINT
    discount_cents : BIGINT
    tax_cents : BIGINT
    shipping_cents : BIGINT
    total_cents : BIGINT
    exchange_rate_snapshot : NUMERIC(18,8)
    total_in_base_currency_cents : BIGINT
    status : VARCHAR(50)
    ordered_at : TIMESTAMP
    notes : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "DETALLE_PEDIDO" as order_items {
    * id : BIGSERIAL <<PK>>
    --
    order_id : BIGINT <<FK>>
    product_id : BIGINT <<FK>>
    product_variant_id : BIGINT <<FK>>
    custom_design_id : BIGINT <<FK>>
    --
    quantity : INTEGER
    unit_price_cents : BIGINT
    discount_cents : BIGINT
    subtotal_cents : BIGINT
    product_name_snapshot : VARCHAR(160)
    product_sku_snapshot : VARCHAR(120)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "ENVIO" as shipments {
    * id : BIGSERIAL <<PK>>
    --
    order_id : BIGINT <<FK>>
    currency_id : BIGINT <<FK>>
    shipping_company_id : BIGINT <<FK>>
    shipping_zone_id : BIGINT <<FK>>
    --
    tracking_code : VARCHAR(160)
    tracking_url : VARCHAR(255)
    last_event_status : VARCHAR(80)
    last_event_location : VARCHAR(255)
    last_event_at : TIMESTAMP
    shipping_cost_cents : BIGINT
    status : VARCHAR(50)
    shipped_at : TIMESTAMP
    delivered_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }
}

' ============================================================
' FINANZAS
' ============================================================

package "FINANZAS" {

  entity "PAGO" as payments {
    * id : BIGSERIAL <<PK>>
    --
    customer_id : BIGINT <<FK>>
    store_id : BIGINT <<FK>>
    currency_id : BIGINT <<FK>>
    payment_method_id : BIGINT <<FK>>
    --
    amount_cents : BIGINT
    exchange_rate_snapshot : NUMERIC(18,8)
    reference : VARCHAR(160)
    status : VARCHAR(50)
    paid_at : TIMESTAMP
    notes : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }

  entity "FACTURA" as invoices {
    * id : BIGSERIAL <<PK>>
    --
    customer_id : BIGINT <<FK>>
    store_id : BIGINT <<FK>>
    currency_id : BIGINT <<FK>>
    order_id : BIGINT <<FK>>
    sales_channel_id : BIGINT <<FK>>
    user_issuer_id : BIGINT <<FK>>
    shipping_zone_id : BIGINT <<FK>>
    --
    invoice_number : VARCHAR(80)
    subtotal_cents : BIGINT
    discount_cents : BIGINT
    tax_cents : BIGINT
    shipping_cents : BIGINT
    total_cents : BIGINT
    refunded_cents : BIGINT
    exchange_rate_snapshot : NUMERIC(18,8)
    payment_status : VARCHAR(50)
    invoice_status : VARCHAR(50)
    issued_at : TIMESTAMP
    due_at : TIMESTAMP
    notes : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
  }
}

' ============================================================
' RELACIONES — MULTI-TENANCIA
'   TIENDA es la raiz del multi-tenant: delimita los dominios que
'   resuelven a la tienda y delimita los documentos transaccionales.
' ============================================================
stores "1" -- "0..*" store_domains : "store_id"
stores "1" -- "0..*" orders : "store_id"
stores "1" -- "0..*" payments : "store_id"
stores "1" -- "0..*" invoices : "store_id"

' ============================================================
' RELACIONES — IDENTIDAD Y ACCESO
'   user_creator_id y user_issuer_id documentan la trazabilidad
'   del operador administrativo que creo el documento.
' ============================================================
roles "1" -- "0..*" users : "role_id"
users "1" -- "0..1" customers : "user_id"
users "1" -- "0..*" orders : "user_creator_id (trazabilidad)"
users "1" -- "0..*" invoices : "user_issuer_id (trazabilidad)"

' ============================================================
' RELACIONES — CLIENTE
'   CLIENTE no tiene store_id: la pertenencia a una tienda se
'   resuelve por la tabla puente customer_stores (N:N, externa).
' ============================================================
customers "1" -- "0..*" customer_addresses : "customer_id"
customers "1" -- "0..*" orders : "customer_id"
customers "1" -- "0..*" payments : "customer_id"
customers "1" -- "0..*" invoices : "customer_id"
customer_addresses "0..1" -- "0..*" orders : "shipping_address_id"

' ============================================================
' RELACIONES — CATALOGO
'   categories.parent_id es auto-referencia nullable: la jerarquia
'   de categorias es recursiva y una raiz tiene parent_id NULL.
' ============================================================
categories "1" -- "0..*" products : "category_id"
categories "0..1" -- "0..*" categories : "parent_id (auto-referencia)"
brands "0..1" -- "0..*" products : "brand_id"
products "1" -- "0..*" product_variants : "product_id"
products "1" -- "0..*" order_items : "product_id"
products "1" -- "0..*" inventories : "product_id"
product_variants "0..1" -- "0..*" order_items : "product_variant_id"
product_variants "0..1" -- "0..*" inventories : "product_variant_id"

' ============================================================
' RELACIONES — OPERACIONES
' ============================================================
orders "1" -- "0..*" order_items : "order_id"
orders "1" -- "0..*" shipments : "order_id"
orders "0..1" -- "0..*" invoices : "order_id"

' ============================================================
' RELACIONES — FINANZAS
'   PAGO NO tiene order_id: se vincula con FACTURA mediante la
'   tabla puente invoice_payments (N:M), de modo que un pago puede
'   cubrir varias facturas y una factura varios pagos.
' ============================================================
payments "*" -- "0..*" invoices : "invoice_payments (tabla puente N:M)"

' ============================================================
' NOTAS — CLAVES FORANEAS EXTERNAS
' Las siguientes claves foraneas apuntan a tablas que quedan fuera
' del nucleo de 16 entidades y por eso NO se dibujan como entidad:
'   currencies           <- stores, products, orders, payments,
'                           invoices, shipments
'   payment_methods      <- payments
'   sales_channels       <- orders, invoices
'   shipping_companies   <- shipments
'   shipping_zones       <- invoices, shipments
'   warehouses           <- inventories
'   product_sizes        <- product_variants
'   custom_designs       <- order_items
' Tablas puente (pivots) externas:
'   invoice_payments     PAGO <-> FACTURA (N:M)
'   customer_stores      CLIENTE <-> TIENDA (N:N)
' ============================================================
' NOTAS — REGLAS DE INTEGRIDAD
'   ON DELETE RESTRICT: tienda, cliente, categoria, marca, moneda,
'                       metodo de pago y producto no pueden borrarse
'                       si existen pedidos, pagos, facturas o stock.
'   ON DELETE CASCADE:  lineas de pedido, envios, variantes e
'                       inventarios se eliminan con su padre.
'   ON DELETE SET NULL: la FK queda en NULL (usuario, variante,
'                       diseno, canal, zona de envio, direccion).
'   Aislamiento multi-tenant: RLS activo sobre orders, invoices y
'                       payments; el resto se filtra por middleware.
' ============================================================

@enduml