@startuml 8.2.5 - Diagrama de Clases (Pagos y Envíos, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Pago con su método y transacción; envío por empresa de transporte.

class Pago {
  - id: UUID
  - clienteId: UUID
  - paymentMethodId: UUID
  - tiendaId: UUID
  - amountCents: Integer
  + marcarCompletado(): void
  + marcarFallido(motivo: String): void
  + calcularMontoConComision(): Integer
}

class MetodoPago {
  - id: UUID
  - tiendaId: UUID
  - pasarelaPagoId: UUID
  - nombre: String
  - tipo: TipoMetodoPago
  + activar(): void
  + desactivar(): void
  + calcularComision(montoCents: Integer): Integer
}

class TransaccionPago {
  - id: UUID
  - pagoId: UUID
  - pasarelaPagoId: UUID
  - referenciaPasarela: String
  - estadoDevuelto: String
  + obtenerRespuestaCruda(): JSON
  + fueExitosa(): Boolean
}

class Envio {
  - id: UUID
  - orderId: UUID
  - shippingCompanyId: UUID
  - shippingZoneId: UUID
  - trackingCode: String
  + marcarEnviado(guia: String): void
  + marcarEntregado(): void
  + marcarDevuelto(): void
}

class EmpresaEnvio {
  - id: UUID
  - nombre: String
  - urlRastreo: String
  - phone: String
  - email: String
  + activar(): void
  + desactivar(): void
  + obtenerUrlRastreo(guia: String): String
}

Pago "*" --> "1" MetodoPago
Pago "1" *-- "*" TransaccionPago
Envio "*" --> "1" EmpresaEnvio

@enduml
