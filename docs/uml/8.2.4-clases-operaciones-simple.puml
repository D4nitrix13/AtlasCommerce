@startuml 8.2.4 - Diagrama de Clases (Operaciones: Carrito, Pedidos, Inventario, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Operaciones: carrito y pedido con sus líneas.

class Carrito {
  - id: UUID
  - clienteId: UUID
  - tiendaId: UUID
  - currencyId: UUID
  - status: EstadoCarrito
  + agregarItem(productoId: UUID, cantidad: Integer): ItemCarrito
  + removerItem(itemId: UUID): void
  + vaciar(): void
  + convertirAPedido(): Pedido
}

class ItemCarrito {
  - id: UUID
  - carritoId: UUID
  - productoId: UUID
  - varianteId: UUID
  - cantidad: Integer
  + calcularSubtotal(): Integer
  + cambiarCantidad(nueva: Integer): void
}

class Pedido {
  - id: UUID
  - tiendaId: UUID
  - clienteId: UUID
  - orderNumber: String
  - status: EstadoPedido
  + confirmarPago(): void
  + cancelar(motivo: String): void
  + marcarEnProduccion(): void
  + marcarEnviado(guia: String, empresaId: UUID): void
}

class LineaPedido {
  - id: UUID
  - pedidoId: UUID
  - productoId: UUID
  - varianteId: UUID
  - cantidad: Integer
  + calcularSubtotal(): Integer
}

Carrito "1" *-- "*" ItemCarrito
Carrito "1" --> "0..1" Pedido : "se convierte en"
Pedido "1" *-- "*" LineaPedido

@enduml
