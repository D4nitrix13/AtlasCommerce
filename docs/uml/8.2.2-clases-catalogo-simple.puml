@startuml 8.2.2 - Diagrama de Clases (Catálogo, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Catálogo: Producto y sus especializaciones, con marca, categoría y variantes.

abstract class Producto {
  - id: UUID
  - categoryId: UUID
  - brandId: UUID
  - currencyId: UUID
  - name: String
  + calcularPrecio(tiendaId: UUID): Decimal
  + calcularPrecioMayorista(cantidad: Integer): Decimal
  + publicar(): void
  + despublicar(): void
}

class ProductoSimple {
  - peso: Decimal
  + calcularCostoEnvio(): Decimal
}

class VarianteProducto {
  - id: UUID
  - productId: UUID
  - sku: String
  - nameVariant: String
  - priceCents: Integer
  + calcularPrecioConAtributos(): Decimal
  + activar(): void
  + desactivar(): void
}

class Marca {
  - id: UUID
  - nombre: String
  - slug: String
  - logoUrl: String
  - isActive: Boolean
  + activar(): void
  + desactivar(): void
  + contarProductos(): Integer
}

class Categoria {
  - id: UUID
  - categoriaPadreId: UUID
  - nombre: String
  - slug: String
  - nivelJerarquia: Integer
  + obtenerHijos(): List<Categoria>
  + obtenerAncestros(): List<Categoria>
  + activar(): void
  + desactivar(): void
}

Producto <|-- ProductoSimple
Producto "*" --> "1" Marca
Producto "*" --> "1" Categoria
Categoria "*" --> "0..1" Categoria : "categoría padre"
Producto "1" *-- "*" VarianteProducto

@enduml
