@startuml 8.2 - Diagrama de Clases (Módulo Pedidos, Vista Reducida)
skinparam classAttributeIconSize 0
hide circle
hide methods

package "Módulo de Pedidos" {

  class Carrito {
    - id: UUID
    - clienteId: UUID
    - tiendaId: UUID
    - estado: EstadoCarrito
    - subtotal: Decimal
    - total: Decimal
  }

  enum EstadoCarrito {
    ACTIVO
    CONVERTIDO
    ABANDONADO
  }

  class ItemCarrito {
    - id: UUID
    - carritoId: UUID
    - productoId: UUID
    - varianteId: UUID
    - cantidad: Integer
    - precioUnitario: Decimal
  }

  class Pedido {
    - id: UUID
    - tiendaId: UUID
    - clienteId: UUID
    - numeroPedido: String
    - estado: EstadoPedido
    - subtotal: Decimal
    - impuestos: Decimal
    - costoEnvio: Decimal
    - total: Decimal
    - direccionEnvioId: UUID
    - usuarioCreadorId: UUID
    - motivoCancelacion: String
    - creadoEn: DateTime
  }

  enum EstadoPedido {
    PENDIENTE_PAGO
    PAGADO
    CONFIRMADO
    EN_PRODUCCION
    PREPARADO_ENVIO
    ENVIADO
    ENTREGADO
    CANCELADO
    DEVUELTO
    REEMBOLSADO
  }

  class LineaPedido {
    - id: UUID
    - pedidoId: UUID
    - productoId: UUID
    - varianteId: UUID
    - cantidad: Integer
    - precioUnitario: Decimal
    - subtotal: Decimal
  }

  class Pago {
    - id: UUID
    - pedidoId: UUID
    - metodoPagoId: UUID
    - monto: Decimal
    - estado: EstadoPago
    - creadoEn: DateTime
  }

  enum EstadoPago {
    PENDIENTE
    APROBADO
    RECHAZADO
    REEMBOLSADO
  }

  class TransaccionPago {
    - id: UUID
    - pagoId: UUID
    - pasarelaPagoId: UUID
    - referenciaPasarela: String
    - estadoDevuelto: String
    - webhookRecibidoEn: DateTime
  }

  class Factura {
    - id: UUID
    - pedidoId: UUID
    - numeroFactura: String
    - urlPDF: String
    - emitidaEn: DateTime
    - usuarioEmisorId: UUID
  }

  class Envio {
    - id: UUID
    - pedidoId: UUID
    - empresaEnvioId: UUID
    - numeroGuia: String
    - estado: EstadoEnvio
    - costo: Decimal
  }

  enum EstadoEnvio {
    PENDIENTE
    EN_TRANSITO
    ENTREGADO
    DEVUELTO
  }

  class CierreCaja {
    - id: UUID
    - tiendaId: UUID
    - fecha: Date
    - montoEsperadoEfectivo: Decimal
    - montoEsperadoPasarela: Decimal
    - montoReportadoEfectivo: Decimal
    - montoReportadoPasarela: Decimal
    - diferencia: Decimal
    - estado: EstadoCierreCaja
    - validadoPorUsuarioId: UUID
  }

  enum EstadoCierreCaja {
    PENDIENTE
    VALIDADO
    RECHAZADO
  }

  class Devolucion {
    - id: UUID
    - pedidoId: UUID
    - tipoResolucion: TipoResolucionDevolucion
    - estado: EstadoDevolucion
    - montoReembolsado: Decimal
  }

  enum TipoResolucionDevolucion {
    REEMBOLSO_DINERO
    CAMBIO_PRODUCTO
    NOTA_CREDITO
  }

  enum EstadoDevolucion {
    SOLICITADA
    APROBADA
    RECHAZADA
    REEMBOLSADA
  }
}

' --- Relaciones del módulo ---
Carrito --> EstadoCarrito
Carrito "1" *-- "many" ItemCarrito
Carrito "1" --> "1" Pedido : "se convierte en"

Pedido --> EstadoPedido
Pedido "1" *-- "many" LineaPedido
Pedido "1" *-- "many" Pago
Pedido "1" -- "0..1" Factura
Pedido "1" *-- "many" Envio
Pedido "1" *-- "many" Devolucion

Pago --> EstadoPago
Pago "1" *-- "many" TransaccionPago

Envio --> EstadoEnvio

Devolucion --> EstadoDevolucion
Devolucion --> TipoResolucionDevolucion

Pedido "many" -- "1" CierreCaja : "agrupado en"
CierreCaja --> EstadoCierreCaja

@enduml
