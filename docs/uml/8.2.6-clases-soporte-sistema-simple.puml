@startuml 8.2.6 - Diagrama de Clases (Soporte, Devoluciones, Sistema, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Soporte y devoluciones, ligados al pedido y sus líneas.

class Pedido {
  - id: UUID
  - tiendaId: UUID
  - clienteId: UUID
  - orderNumber: String
  - status: EstadoPedido
  + confirmarPago(): void
  + cancelar(motivo: String): void
  + marcarEnProduccion(): void
  + marcarEnviado(guia: String, empresaId: UUID): void
}

class TicketSoporte {
  - id: UUID
  - tiendaId: UUID
  - clienteId: UUID
  - pedidoId: UUID
  - subject: String
  + asignar(usuarioId: UUID): void
  + cerrar(usuarioId: UUID): void
  + reabrir(motivo: String): void
  + escalar(): void
}

class Devolucion {
  - id: UUID
  - tiendaId: UUID
  - pedidoId: UUID
  - clienteId: UUID
  - motivo: String
  + aprobar(): void
  + rechazar(motivo: String): void
  + marcarRecibida(): void
}

class ItemDevolucion {
  - id: UUID
  - devolucionId: UUID
  - lineaPedidoId: UUID
  - cantidad: Integer
  - motivoDetallado: String
  + obtenerLineaPedido(): LineaPedido
  + calcularMontoTotal(): Integer
}

class LineaPedido {
  - id: UUID
  - pedidoId: UUID
  - productoId: UUID
  - varianteId: UUID
  - cantidad: Integer
  + calcularSubtotal(): Integer
}

TicketSoporte "*" --> "0..1" Pedido
Pedido "1" *-- "*" Devolucion
Devolucion "1" *-- "*" ItemDevolucion
ItemDevolucion "*" --> "1" LineaPedido

@enduml
