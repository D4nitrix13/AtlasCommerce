@startuml 8.3 - Actividad: Control de Stock
|Operador de tienda|
start

if (¿Tipo de operación?) then (Modificación de stock)
  :Selecciona producto (variante), almacén y tipo de movimiento;
  :Ingresa cantidad, motivo y referencia;

  |Sistema AtlasCommerce|
  :Validar operación (incluye chequeo de stock para SALIDA);

  if (¿Es ajuste por inventario físico?) then (sí)
    :Calcular diferencia (stock físico - stock actual);
    :Crear MovimientoInventario AJUSTE con la diferencia;
  else (Registro manual)
    :Crear MovimientoInventario (ENTRADA / SALIDA);
  endif

  :Actualizar RegistroInventario.stockActual (alerta si queda bajo mínimo);

  |Operador de tienda|
  stop
else (Consulta de stock bajo)

  |Sistema AtlasCommerce|
  :Listar productos con stockActual < stockMinimo;

  |Operador de tienda|
  :Visualizar lista de alertas;
  stop
endif
@enduml
