' ============================================================
' RELACIONES — NÚCLEO MULTITENANT
' ============================================================
Tienda "1" *-- "many" DominioTienda
Tienda "1" *-- "many" ConfiguracionTienda
Tienda "1" *-- "many" StoreTheme
Tienda "1" --> "1" Moneda
Tienda "1" *-- "many" Impuesto
Moneda "1" --> "many" TasaCambio
TasaCambio --> "2" Moneda
Impuesto --> "1" TipoContribuyente

' ============================================================
' RELACIONES — IDENTIDAD Y ACCESO
' ============================================================
Usuario "1" --> "0..1" CredencialSegundoFactor
CredencialSegundoFactor --> "1" TipoSegundoFactor
Usuario "1" *-- "many" CodigoRecuperacion
Usuario "1" *-- "many" CuentaSocial
Usuario "1" *-- "many" TokenResetContrasena
Usuario "many" --> "many" Rol : "asignado vía"
Rol "many" --> "many" Permiso : "otorga"
Usuario "many" -- "many" Tienda : "asignado vía"
UsuarioTienda "*" --> "1" Usuario
UsuarioTienda "*" --> "1" Tienda
UsuarioTienda "*" --> "1" Rol
Usuario "1" --> "many" BitacoraAuditoria
BitacoraAuditoria "*" --> "1" Tienda

' ============================================================
' RELACIONES — CLIENTES
' ============================================================
Usuario "1" --> "0..1" Cliente
Cliente "1" *-- "many" Direccion
Cliente "many" -- "many" Tienda : "vinculado vía"
ClienteTienda "*" --> "1" Cliente
ClienteTienda "*" --> "1" Tienda
Cliente --> "1" TipoCliente

' ============================================================
' RELACIONES — CATÁLOGO
' ============================================================
Producto <|-- ProductoSimple
Producto <|-- ProductoPersonalizable
Producto "many" --> "1" Marca
Producto "many" --> "1" Categoria
Categoria "many" --> "0..1" Categoria : "padre"
Producto "1" *-- "many" VarianteProducto
Producto "1" *-- "many" ImagenProducto
Producto "1" *-- "many" PrecioMayorista
Producto "many" -- "many" Atributo : "definido vía"
ValorAtributo "*" --> "1" Atributo
Producto "many" -- "many" Tienda : "publicado vía"
ProductoTienda "*" --> "1" Producto
ProductoTienda "*" --> "1" Tienda
ProductoPersonalizable --> "many" TecnicaImpresion

' ============================================================
' RELACIONES — PERSONALIZACIÓN
' ============================================================
ProductoPersonalizable "1" *-- "many" OpcionPersonalizacion
ProductoPersonalizable "1" *-- "many" AreaImpresion
OpcionPersonalizacion --> "1" TipoOpcionPersonalizacion
