@startuml 8.2 - Diagrama de Clases (Sistema Completo)
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageStyle rectangle
hide circle
hide methods

' ============================================================
' NÚCLEO MULTITENANT
' ============================================================
package "Núcleo Multitenant" {

  class Tienda <<aggregate root>> {
    - id: UUID
    - nombre: String
    - slug: String
    - dominioPrincipal: String
    - monedaPorDefecto: Moneda
    - temaVisual: String
    - impuestoPorDefecto: Impuesto
    - activa: Boolean
    - fechaCreacion: DateTime
    + obtenerConfiguracion(clave: String): String
  }

  class DominioTienda {
    - id: UUID
    - tiendaId: UUID
    - dominio: String
    - esPrimario: Boolean
    - activo: Boolean
  }

  class ConfiguracionTienda {
    - id: UUID
    - tiendaId: UUID
    - clave: String
    - valor: String
    - tipoDato: String
  }

  class StoreTheme {
    - id: UUID
    - tiendaId: UUID
    - nombre: String
    - colorPrimario: String
    - colorSecundario: String
    - colorAcento: String
    - fuenteFamilia: String
    - cssPersonalizado: String
    - activo: Boolean
  }

  class Moneda {
    - id: UUID
    - codigoISO: String
    - nombre: String
    - simbolo: String
  }

  class TasaCambio {
    - id: UUID
    - monedaOrigenId: UUID
    - monedaDestinoId: UUID
    - tasa: Decimal
    - fechaVigencia: Date
  }

  class Impuesto {
    - id: UUID
    - tiendaId: UUID
    - nombre: String
    - porcentaje: Decimal
    - tipoContribuyente: TipoContribuyente
    - retencionIRPorcentaje: Decimal
    - activo: Boolean
  }

  enum TipoContribuyente {
    B2C_MINORISTA
    B2B_MAYORISTA
    AMBOS
  }
}

' ============================================================
' IDENTIDAD Y ACCESO
' ============================================================
package "Identidad y Acceso" {

  class Usuario {
    - id: UUID
    - correo: String
