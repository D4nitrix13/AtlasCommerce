@startuml 8.2.2 - Diagrama de Clases (Catálogo)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' ============================================================
' 8.2.2 — CATÁLOGO
' Paquetes: Catálogo + Personalización
' ============================================================

package "Catálogo" {

  class Marca {
    - id: UUID
    - nombre: String
    - slug: String
    - descripcion: String
    - logoUrl: String
    - isActive: Boolean
    + activar(): void
    + desactivar(): void
    + contarProductos(): Integer
  }

  class Categoria {
    - id: UUID
    - nombre: String
    - slug: String
    - categoriaPadreId: UUID
    - nivelJerarquia: Integer
    - descripcion: String
    - imagenPath: String
    - isActive: Boolean
    + esRaiz(): Boolean
    + obtenerHijos(): List<Categoria>
    + obtenerAncestros(): List<Categoria>
    + activar(): void
    + desactivar(): void
  }

  abstract class Producto <<abstract>> {
    - id: UUID
    - categoryId: UUID
    - brandId: UUID
    - currencyId: UUID
    - name: String
    - slug: String
    - description: String
    - sku: String
    - basePriceCents: Integer
    - costCents: Integer
    - isActive: Boolean
    - publishedAt: DateTime
    + calcularPrecio(tiendaId: UUID): Decimal
    + calcularPrecioMayorista(cantidad: Integer): Decimal
    + publicar(): void
    + despublicar(): void
    + activar(): void
    + desactivar(): void
    + scopeActive(query): Query
    + scopePublished(query): Query
    + scopeByCategory(query, categoryId: Integer): Query
    + scopeByBrand(query, brandId: Integer): Query
  }

  class ProductoSimple {
    - peso: Decimal
    + calcularCostoEnvio(): Decimal
  }

  class ProductoPersonalizable {
    - tiempoProduccionDias: Integer
    - requiereAprobacionDiseno: Boolean
    - tecnicasPermitidas: List<TecnicaImpresion>
    + tiempoEstimadoProduccion(): Integer
    + agregarOpcion(opcion: OpcionPersonalizacion): void
    + eliminarOpcion(opcionId: UUID): void
  }

  class VarianteProducto {
    - id: UUID
    - productId: UUID
    - sku: String
    - nameVariant: String
    - priceCents: Integer
    - costCents: Integer
    - barcode: String
    - isActive: Boolean
    + calcularPrecioConAtributos(): Decimal
    + activar(): void
    + desactivar(): void
  }

  class ImagenProducto {
    - id: UUID
    - productId: UUID
    - imageUrl: String
    - altText: String
    - sortOrder: Integer
    - isPrimary: Boolean
    + marcarComoPrincipal(): void
    + reordenar(nuevoOrden: Integer): void
  }

  class Atributo {
    - id: UUID
    - nombre: String
    - slug: String
    - type: String
    - isFilterable: Boolean
    - isRequired: Boolean
    + esFiltrable(): Boolean
    + esRequerido(): Boolean
  }

  class ValorAtributo {
    - id: UUID
    - atributoId: UUID
    - productId: UUID
    - valor: String
    + obtenerAtributo(): Atributo
  }

  class PrecioMayorista {
    - id: UUID
    - productId: UUID
    - storeId: UUID
    - minQty: Integer
    - priceCents: Integer
    + aplicaPara(cantidad: Integer): Boolean
    + calcularDescuento(cantidad: Integer): Integer
  }

  class ProductoTienda {
    - id: UUID
    - productId: UUID
    - storeId: UUID
    - slug: String
    - publicTitle: String
    - publicPriceCents: Integer
    - publicDescription: String
    - metaTitle: String
    - metaDescription: String
    - ogImageUrl: String
    - isVisible: Boolean
    - isFeatured: Boolean
    - sortOrder: Integer
    - publishedAt: DateTime
    - unpublishedAt: DateTime
    + publicar(): void
    + despublicar(): void
    + marcarComoDestacado(): void
    + quitarDestacado(): void
    + generarSlug(): String
  }
}

package "Personalización" {

  class OpcionPersonalizacion {
    - id: UUID
    - productId: UUID
    - nombre: String
    - tipoOpcion: TipoOpcionPersonalizacion
    - obligatorio: Boolean
    - costoAdicionalCents: Integer
    - orden: Integer
    + esObligatoria(): Boolean
    + calcularCostoTotal(cantidadOpciones: Integer): Integer
  }

  enum TipoOpcionPersonalizacion {
    TEXTO_PERSONALIZADO
    IMAGEN_SUBIDA
    SELECCION_COLOR
    SELECCION_POSICION
    ESTAMPADO
    SUBLIMACION
    BORDADO
    DTF
    VINIL_TEXTIL
  }

  enum TecnicaImpresion {
    ESTAMPADO
    SUBLIMACION
    BORDADO
    DTF
    VINIL_TEXTIL
  }

  class AreaImpresion {
    - id: UUID
    - productId: UUID
    - tecnica: TecnicaImpresion
    - nombre: String
    - anchoMM: Decimal
    - altoMM: Decimal
    - urlPlantilla: String
    - coloresMaximos: Integer
    + calcularArea(): Decimal
    + obtenerUrlPlantilla(): String
  }

  class DisenoPersonalizado {
    - id: UUID
    - orderItemId: UUID
    - opcionPersonalizacionId: UUID
    - areaImpresionId: UUID
    - valorIngresado: String
    - archivoSubidoId: UUID
    - aprobadaPorOperador: Boolean
    - fechaAprobacion: DateTime
    + validarDiseno(): Boolean
    + aprobar(operadorId: UUID): void
    + rechazar(motivo: String): void
  }
}

' ============================================================
' RELACIONES — CATÁLOGO
' ============================================================
Producto <|-- ProductoSimple
Producto <|-- ProductoPersonalizable
Producto "many" --> "1" Marca : "marca"
Producto "many" --> "1" Categoria : "categoría"
Categoria "many" --> "0..1" Categoria : "categoría padre"
Producto "1" *-- "many" VarianteProducto
Producto "1" *-- "many" ImagenProducto
Producto "1" *-- "many" PrecioMayorista
Producto "many" -- "many" Atributo : "definido vía"
ValorAtributo "*" --> "1" Atributo
ValorAtributo "*" --> "1" Producto
Producto "many" -- "many" Tienda : "publicado vía"
ProductoTienda "*" --> "1" Producto
ProductoTienda "*" --> "1" Tienda
ProductoPersonalizable "1" --> "many" TecnicaImpresion : "permite"

' ============================================================
' RELACIONES — PERSONALIZACIÓN
' ============================================================
ProductoPersonalizable "1" *-- "many" OpcionPersonalizacion
ProductoPersonalizable "1" *-- "many" AreaImpresion
OpcionPersonalizacion "many" --> "1" TipoOpcionPersonalizacion
AreaImpresion "many" --> "1" TecnicaImpresion

@enduml
