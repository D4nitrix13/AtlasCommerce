@startuml 8.2.6 - Diagrama de Clases (Soporte, Devoluciones, Sistema)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' ============================================================
' 8.2.6 — SOPORTE, DEVOLUCIONES Y SISTEMA
' Paquetes: Soporte + Devoluciones + Sistema
' ============================================================

package "Soporte" {

  class TicketSoporte {
    - id: UUID
    - tiendaId: UUID
    - clienteId: UUID
    - pedidoId: UUID
    - subject: String
    - description: String
    - status: EstadoTicket
    - priority: PrioridadTicket
    - metodoAsignacion: MetodoAsignacion
    - asignadoAUsuarioId: UUID
    - abiertoEn: DateTime
    - cerradoEn: DateTime
    + asignar(usuarioId: UUID): void
    + cerrar(usuarioId: UUID): void
    + reabrir(motivo: String): void
    + escalar(): void
    + tiempoRespuesta(): Duration
    + agregarMensaje(contenido: String, autorId: UUID): MensajeTicket
  }

  enum EstadoTicket {
    ABIERTO
    EN_PROGRESO
    ESPERANDO_CLIENTE
    RESUELTO
    CERRADO
    + descripcion(): String
    + esFinal(): Boolean
  }

  enum PrioridadTicket {
    BAJA
    MEDIA
    ALTA
    URGENTE
    + descripcion(): String
    + tiempoRespuestaHoras(): Integer
  }

  enum MetodoAsignacion {
    ROUND_ROBIN
    MANUAL_POR_SUPERVISOR
    AUTOMATICA_POR_TIENDA
    + descripcion(): String
    + requiereIntervencionHumana(): Boolean
  }

  class MensajeTicket {
    - id: UUID
    - ticketId: UUID
    - autorId: UUID
    - contenido: String
    - adjuntoUrl: String
    - enviadoEn: DateTime
    + obtenerAutor(): Usuario
    + obtenerTicket(): TicketSoporte
  }

  class PreguntaProducto {
    - id: UUID
    - productoId: UUID
    - clienteId: UUID
    - pregunta: String
    - respuesta: String
    - respondidaPorUsuarioId: UUID
    - estado: EstadoPregunta
    - creadaEn: DateTime
    - respondidaEn: DateTime
    + responder(contenido: String, usuarioId: UUID): void
    + rechazar(motivo: String): void
    + esPendiente(): Boolean
  }

  enum EstadoPregunta {
    PENDIENTE
    RESPONDIDA
    RECHAZADA
    + descripcion(): String
    + esFinal(): Boolean
  }

  class ResenaProducto {
    - id: UUID
    - productoId: UUID
    - clienteId: UUID
    - pedidoId: UUID
    - calificacion: Integer
    - comentario: String
    - aprobada: Boolean
    - moderadaPorUsuarioId: UUID
    - creadaEn: DateTime
    + aprobar(moderadorId: UUID): void
    + rechazar(moderadorId: UUID, motivo: String): void
    + esAprobada(): Boolean
  }
}

package "Devoluciones" {

  class Devolucion {
    - id: UUID
    - tiendaId: UUID
    - pedidoId: UUID
    - clienteId: UUID
    - motivo: String
    - tipoResolucion: TipoResolucionDevolucion
    - status: EstadoDevolucion
    - montoReembolsadoCents: Integer
    - requestedAt: DateTime
    - resolvedAt: DateTime
    + totalAmountCents(): Integer
    + aprobar(): void
    + rechazar(motivo: String): void
    + marcarRecibida(): void
    + crearReembolso(): Reembolso
  }

  enum TipoResolucionDevolucion {
    REEMBOLSO_DINERO
    CAMBIO_PRODUCTO
    NOTA_CREDITO
    + descripcion(): String
    + requiereReembolso(): Boolean
  }

  enum EstadoDevolucion {
    SOLICITADA
    APROBADA
    RECHAZADA
    RECIBIDA
    REEMBOLSADA
    + descripcion(): String
    + esFinal(): Boolean
  }

  class ItemDevolucion {
    - id: UUID
    - devolucionId: UUID
    - lineaPedidoId: UUID
    - cantidad: Integer
    - motivoDetallado: String
    - amountCents: Integer
    + obtenerLineaPedido(): LineaPedido
    + calcularMontoTotal(): Integer
  }

  class Reembolso {
    - id: UUID
    - pagoId: UUID
    - montoCents: Integer
    - motivo: String
    - referenciaPasarela: String
    - status: EstadoReembolso
    - procesadoEn: DateTime
    + procesar(referencia: String): void
    + marcarRechazado(motivo: String): void
    + obtenerPago(): Pago
  }

  enum EstadoReembolso {
    SOLICITADO
    APROBADO
    PROCESADO
    RECHAZADO
    + descripcion(): String
    + esFinal(): Boolean
  }
}

package "Sistema" {

  class Respaldo {
    - id: UUID
    - nombreArchivo: String
    - tipoRespaldo: TipoRespaldo
    - status: EstadoRespaldo
    - tamanoBytes: BigInt
    - urlAlmacenamiento: String
    - cifradoCon: String
    - frecuencia: FrecuenciaRespaldo
    - retencionDias: Integer
    - fechaExpiracion: Date
    - creadoEn: DateTime
    - restauradoEn: DateTime
    + ejecutar(): void
    + restaurar(): void
    + verificarIntegridad(): Boolean
    + eliminar(): void
  }

  enum TipoRespaldo {
    COMPLETO
    INCREMENTAL
    + descripcion(): String
    + incluyeDatosHistoricos(): Boolean
  }

  enum EstadoRespaldo {
    EN_PROGRESO
    COMPLETADO
    FALLIDO
    + descripcion(): String
    + esFinal(): Boolean
  }

  enum FrecuenciaRespaldo {
    DIARIO
    SEMANAL
    MENSUAL
    MANUAL
    + descripcion(): String
    + esAutomatica(): Boolean
  }

  class Notificacion {
    - id: UUID
    - usuarioId: UUID
    - tiendaId: UUID
    - tipo: TipoNotificacion
    - titulo: String
    - mensaje: String
    - datos: JSON
    - leida: Boolean
    - leidaEn: DateTime
    - enviadaEn: DateTime
    + marcarComoLeida(): void
    + enviar(usuarioId: UUID, datos: JSON): void
    + esNoLeida(): Boolean
  }

  enum TipoNotificacion {
    PEDIDO_CREADO
    PEDIDO_PAGADO
    PEDIDO_ENVIADO
    STOCK_BAJO
    TICKET_ASIGNADO
    PROMOCION
    SISTEMA
    + descripcion(): String
    + requiereAccionUsuario(): Boolean
  }
}

' ============================================================
' RELACIONES — SOPORTE
' ============================================================
Cliente "1" *-- "*" TicketSoporte
Tienda "1" *-- "*" TicketSoporte
TicketSoporte "*" --> "0..1" Pedido : "asociado a"
TicketSoporte "*" --> "1" EstadoTicket
TicketSoporte "*" --> "1" PrioridadTicket
TicketSoporte "*" --> "1" MetodoAsignacion
TicketSoporte "*" --> "0..1" Usuario : "asignado a"
TicketSoporte "1" *-- "*" MensajeTicket
MensajeTicket "*" --> "1" Usuario : "autor"
Producto "1" *-- "*" PreguntaProducto
Cliente "1" *-- "*" PreguntaProducto
PreguntaProducto "*" --> "1" EstadoPregunta
Producto "1" *-- "*" ResenaProducto
Cliente "1" *-- "*" ResenaProducto
ResenaProducto "*" --> "0..1" Pedido

' ============================================================
' RELACIONES — DEVOLUCIONES
' ============================================================
Pedido "1" *-- "*" Devolucion
Devolucion "*" --> "1" Cliente
Devolucion "*" --> "1" EstadoDevolucion
Devolucion "*" --> "1" TipoResolucionDevolucion
Devolucion "1" *-- "*" ItemDevolucion
ItemDevolucion "*" --> "1" LineaPedido
Pago "1" *-- "*" Reembolso
Reembolso "*" --> "1" EstadoReembolso

' ============================================================
' RELACIONES — SISTEMA
' ============================================================
Respaldo "*" --> "1" TipoRespaldo
Respaldo "*" --> "1" EstadoRespaldo
Respaldo "*" --> "1" FrecuenciaRespaldo
Usuario "1" *-- "*" Notificacion
Tienda "1" *-- "*" Notificacion
Notificacion "*" --> "1" TipoNotificacion

@enduml
