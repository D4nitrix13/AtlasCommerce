@startuml 8.2 - Diagrama de Clases (Módulo Pedidos, Vista Reducida, simplificado)
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageStyle rectangle
hide circle

' Módulo Pedidos: el pedido como raíz de líneas, pago, envío y devolución.

class Pedido {
  - id: UUID
  - tiendaId: UUID
  - clienteId: UUID
  - numeroPedido: String
  - estado: EstadoPedido
  + confirmarPago(): void
  + cancelar(motivo: String): void
  + marcarEnProduccion(): void
  + marcarEnviado(guia: String, empresaId: UUID): void
}

class LineaPedido {
  - id: UUID
  - pedidoId: UUID
  - productoId: UUID
  - varianteId: UUID
  - cantidad: Integer
  + calcularSubtotal(): Integer
}

class Pago {
  - id: UUID
  - pedidoId: UUID
  - metodoPagoId: UUID
  - monto: Decimal
  - estado: EstadoPago
  + marcarCompletado(): void
  + marcarFallido(motivo: String): void
  + calcularMontoConComision(): Integer
}

class Envio {
  - id: UUID
  - pedidoId: UUID
  - empresaEnvioId: UUID
  - numeroGuia: String
  - estado: EstadoEnvio
  + marcarEnviado(guia: String): void
  + marcarEntregado(): void
  + marcarDevuelto(): void
}

class Devolucion {
  - id: UUID
  - pedidoId: UUID
  - tipoResolucion: TipoResolucionDevolucion
  - estado: EstadoDevolucion
  - montoReembolsado: Decimal
  + aprobar(): void
  + rechazar(motivo: String): void
  + marcarRecibida(): void
}

Pedido "1" *-- "*" LineaPedido
Pedido "1" *-- "*" Pago
Pedido "1" *-- "*" Envio
Pedido "1" *-- "*" Devolucion

@enduml
