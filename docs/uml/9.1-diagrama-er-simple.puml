@startuml 9.1 - Diagrama Entidad-Relacion (nucleo esencial)
skinparam classAttributeIconSize 0
skinparam classFontSize 15
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 390
top to bottom direction

' ============================================================
' 9.1 — DIAGRAMA ENTIDAD-RELACION (NUCLEO ESENCIAL)
'
' Version de solo 8 entidades para lectura rapida en A4 vertical.
' Recorta la version de 16 entidades (9.1-diagrama-er.puml) dejando
' unicamente el recorrido central de la venta:
'
'   TIENDA -> CATALOGO -> CLIENTE -> PEDIDO -> PAGO -> FACTURA
'                    \-> INVENTARIO
'
' Cada entidad conserva su clave primaria y sus claves foraneas
' internas, mas uno o dos campos representativos. Las claves
' foraneas hacia tablas externas (moneda, metodo de pago, almacen)
' no se dibujan: se listan en la nota final.
'
'   <<PK>>   clave primaria (BIGSERIAL)
'   <<FK>>   clave foranea
'
' Los atributos se expresan en espanol academico. El nombre fisico
' de cada columna es el ingles que usa la migracion; la tabla
' equivalente esta al final del diagrama.
' ============================================================

' ============================================================
' MULTI-TENANCIA
' ============================================================

package "MULTI-TENANCIA" {

  entity "TIENDA" as stores {
    * id : BIGSERIAL <<PK>>
    nombre : VARCHAR(160)
    slug : VARCHAR(160)
  }
}

' ============================================================
' ACTORES
' ============================================================

package "CLIENTE" {

  entity "CLIENTE" as customers {
    * id : BIGSERIAL <<PK>>
    correo : VARCHAR(150)
    tipo_cliente : VARCHAR(50)
  }
}

' ============================================================
' CATALOGO
' ============================================================

package "CATALOGO" {

  entity "PRODUCTO" as products {
    * id : BIGSERIAL <<PK>>
    codigo : VARCHAR(120)
    precio_base : BIGINT
  }

  entity "INVENTARIO" as inventories {
    * id : BIGSERIAL <<PK>>
    stock_actual : INTEGER
  }
}

' ============================================================
' TRANSACCION
' ============================================================

package "TRANSACCION" {

  entity "PEDIDO" as orders {
    * id : BIGSERIAL <<PK>>
    numero_pedido : VARCHAR(80)
    estado : VARCHAR(50)
    total : BIGINT
  }

  entity "DETALLE_PEDIDO" as order_items {
    * id : BIGSERIAL <<PK>>
    cantidad : INTEGER
    precio_unitario : BIGINT
  }
}

' ============================================================
' FINANZAS
' ============================================================

package "FINANZAS" {

  entity "PAGO" as payments {
    * id : BIGSERIAL <<PK>>
    monto : BIGINT
    estado : VARCHAR(50)
  }

  entity "FACTURA" as invoices {
    * id : BIGSERIAL <<PK>>
    numero_factura : VARCHAR(80)
    estado_factura : VARCHAR(50)
  }
}

' ============================================================
' RELACIONES
' ============================================================

stores "1" -- "0..*" orders : "id_tienda"
stores "1" -- "0..*" payments : "id_tienda"
stores "1" -- "0..*" invoices : "id_tienda"

customers "1" -- "0..*" orders : "id_cliente"
customers "1" -- "0..*" payments : "id_cliente"
customers "1" -- "0..*" invoices : "id_cliente"

products "1" -- "0..*" order_items : "id_producto"
products "1" -- "0..*" inventories : "id_producto"

orders "1" -- "0..*" order_items : "id_pedido"
orders "0..1" -- "0..*" invoices : "id_pedido"

'   PAGO no tiene id_pedido: se vincula con FACTURA mediante la
'   tabla puente invoice_payments (N:M, un pago puede cubrir
'   varias facturas).
payments "*" -- "0..*" invoices : "invoice_payments (N:M)"

' ============================================================
' NOTA — ENTIDADES OMITIDAS POR SIMPLIFICACION
'
' La version completa de 16 entidades esta en
' 9.1-diagrama-er.puml. Las siguientes siguen existiendo en la base
' de datos y conservan su clave foranea, pero se omiten aqui:
'
'   TIENDA_DOMINIO, USUARIO, ROL, CLIENTE_DIRECCION, CATEGORIA,
'   MARCA, PRODUCTO_VARIANTE, ENVIO
'
'   PEDIDO.id_direccion_envio    -> CLIENTE_DIRECCION
'   PEDIDO.id_usuario_creador    -> USUARIO
'   PRODUCTO.id_categoria        -> CATEGORIA
'   PRODUCTO.id_marca            -> MARCA
'   INVENTARIO.id_variante       -> PRODUCTO_VARIANTE
'
' Las columnas existen; no se dibujan para no recargar el diagrama.
'
'   CLIENTE no tiene id_tienda: su vinculo con TIENDA es N:N
'   mediante la tabla puente customer_stores.
'   ENVIO no tiene id_tienda: la tienda se deriva de PEDIDO.
'
'   Los montos se almacenan en centavos (BIGINT) para evitar
'   errores de punto flotante.
' ============================================================
'
'   CLAVES FORANEAS EXTERNAS (no se dibujan):
'   currencies (moneda), payment_methods (metodo de pago),
'   warehouses (almacen), sales_channels (canal de venta),
'   shipping_companies y shipping_zones (envio).
'
'   EQUIVALENCIA CON LA BASE DE DATOS:
'   TIENDA.nombre            -> stores.name
'   TIENDA.slug              -> stores.slug
'   CLIENTE.correo           -> customers.email
'   CLIENTE.tipo_cliente     -> customers.customer_type
'   PRODUCTO.codigo          -> products.sku
'   PRODUCTO.precio_base     -> products.base_price_cents
'   INVENTARIO.stock_actual  -> inventories.current_stock
'   PEDIDO.numero_pedido     -> orders.order_number
'   PEDIDO.estado            -> orders.status
'   PEDIDO.total             -> orders.total_cents
'   DETALLE_PEDIDO.cantidad  -> order_items.quantity
'   DETALLE_PEDIDO.precio_unitario -> order_items.unit_price_cents
'   PAGO.monto               -> payments.amount_cents
'   PAGO.estado              -> payments.status
'   FACTURA.numero_factura   -> invoices.invoice_number
'   FACTURA.estado_factura   -> invoices.invoice_status
' ============================================================

@enduml