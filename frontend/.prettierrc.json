{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "printWidth": 100
      }
    },
    {
      "files": "*.ts",
      "options": {
        "printWidth": 100,
        "singleQuote": true
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "printWidth": 100,
        "singleQuote": true
      }
    }
  ]
}
