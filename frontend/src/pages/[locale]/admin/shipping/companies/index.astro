---
/**
 * Transportistas — admin (F5.6).
 *
 * Tabla de carriers (5 items del mock: DHL, FedEx, Cargo Expreso local,
 * UPS, pickup en tienda). Cada fila muestra nombre + URL tracking
 * (truncada si excede) + API key enmascarada + cobertura + estado.
 *
 * Patrón Shopify Admin: la URL tracking se trunca visualmente con un
 * `title` (tooltip) del valor completo; el campo `apiKeyMasked` ya
 * viene del backend con sólo los últimos 4 caracteres (no se guarda
 * la key completa en el frontend por seguridad).
 *
 * **AGENTS.md §1**: ~190 líneas — header + tabla + masked fields.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { shippingCompanies } from '../../../../../data/shipping-mock';

const t = getServerDictionary(Astro.locals.locale);

const truncateUrl = (url: string): string => {
  if (url.length <= 40) return url;
  return `${url.slice(0, 37)}…`;
};

const hasCompanies = shippingCompanies.length > 0;
---

<AdminLayout title={`${t['admin.shipping.companies.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.shipping.companies.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.shipping.companies.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500"
    >
      <span aria-hidden="true">+</span>
      <span>{t['admin.shipping.companies.create']}</span>
    </button>
  </div>

  {hasCompanies ? (
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3">{t['admin.shipping.companies.column.name']}</th>
              <th class="px-5 py-3">{t['admin.shipping.companies.column.trackingUrl']}</th>
              <th class="px-5 py-3">{t['admin.shipping.companies.column.apiKey']}</th>
              <th class="px-5 py-3">{t['admin.shipping.companies.column.coverage']}</th>
              <th class="px-5 py-3">{t['admin.shipping.companies.column.status']}</th>
              <th class="px-5 py-3 text-right">{t['admin.shipping.companies.column.actions']}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {shippingCompanies.map((company) => (
              <tr class="group hover:bg-slate-50/50">
                <td class="px-5 py-3 font-medium text-slate-900">{company.name}</td>
                <td class="px-5 py-3">
                  {company.trackingUrl ? (
                    <a
                      href={company.trackingUrl.replace('{tracking}', 'TRACK-001')}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={company.trackingUrl}
                      class="font-mono text-xs text-slate-600 transition hover:text-slate-900 hover:underline"
                    >
                      {truncateUrl(company.trackingUrl)}
                    </a>
                  ) : (
                    <span class="text-xs text-slate-400">—</span>
                  )}
                </td>
                <td class="px-5 py-3 font-mono text-xs text-slate-700">{company.apiKeyMasked}</td>
                <td class="px-5 py-3 text-sm text-slate-700">{company.coverage}</td>
                <td class="px-5 py-3">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                      company.isActive
                        ? 'bg-emerald-100 text-emerald-700'
                        : 'bg-slate-100 text-slate-500',
                    ]}
                  >
                    {company.isActive
                      ? t['admin.shipping.companies.status.active']
                      : t['admin.shipping.companies.status.inactive']}
                  </span>
                </td>
                <td class="px-5 py-3 text-right">
                  <button
                    type="button"
                    class:list={[
                      'inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium transition focus:outline-none focus-visible:ring-2',
                      company.isActive
                        ? 'text-slate-500 hover:bg-slate-100 hover:text-rose-600 focus-visible:ring-slate-300'
                        : 'text-slate-500 hover:bg-slate-100 hover:text-emerald-600 focus-visible:ring-slate-300',
                    ]}
                    aria-label={`${company.isActive ? t['admin.shipping.companies.status.inactive'] : t['admin.shipping.companies.status.active']}: ${company.name}`}
                  >
                    {company.isActive
                      ? t['admin.shipping.companies.status.inactive']
                      : t['admin.shipping.companies.status.active']}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <p class="text-sm font-medium text-slate-700">{t['admin.shipping.companies.empty']}</p>
    </div>
  )}
</AdminLayout>
