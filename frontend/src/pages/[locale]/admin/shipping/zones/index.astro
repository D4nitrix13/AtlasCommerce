---
/**
 * Zonas de envío — admin (F5.6).
 *
 * Tabla de zonas geográficas (6 items del mock: local NI + resto NI +
 * Centroamérica + México + USA + Europa). Cada fila muestra nombre +
 * países como badges ISO-3166-1 + días estimados + costo base + estado.
 *
 * Patrón Shopify Admin: las columnas de "estimatedDays" se muestran
 * como "min-max días" (ej: "2-4") y la de "countries" como badges
 * compactos de 2 letras. Costo base con formato currency USD.
 *
 * **AGENTS.md §1**: ~190 líneas — header + tabla + badges de países.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { shippingZones } from '../../../../../data/shipping-mock';

const t = getServerDictionary(Astro.locals.locale);

const COUNTRY_BADGE = 'bg-slate-100 text-slate-700';

const formatAmount = (cents: number): string => {
  return new Intl.NumberFormat('es-NI', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 2,
  }).format(cents / 100);
};

const hasZones = shippingZones.length > 0;
---

<AdminLayout title={`${t['admin.shipping.zones.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.shipping.zones.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.shipping.zones.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500"
    >
      <span aria-hidden="true">+</span>
      <span>{t['admin.shipping.zones.create']}</span>
    </button>
  </div>

  {hasZones ? (
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3">{t['admin.shipping.zones.column.name']}</th>
              <th class="px-5 py-3">{t['admin.shipping.zones.column.countries']}</th>
              <th class="px-5 py-3 text-center">
                {t['admin.shipping.zones.column.estimatedDays']}
              </th>
              <th class="px-5 py-3 text-right">{t['admin.shipping.zones.column.baseCost']}</th>
              <th class="px-5 py-3">{t['admin.shipping.zones.column.status']}</th>
              <th class="px-5 py-3 text-right">{t['admin.shipping.zones.column.actions']}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {shippingZones.map((zone) => (
              <tr class="group hover:bg-slate-50/50">
                <td class="px-5 py-3 font-medium text-slate-900">{zone.name}</td>
                <td class="px-5 py-3">
                  <div class="flex flex-wrap gap-1">
                    {zone.countries.map((code) => (
                      <span
                        class:list={[
                          'inline-flex items-center rounded px-1.5 py-0.5 font-mono text-[10px] font-bold',
                          COUNTRY_BADGE,
                        ]}
                      >
                        {code}
                      </span>
                    ))}
                  </div>
                </td>
                <td class="px-5 py-3 text-center">
                  <span class="font-mono text-sm font-semibold text-slate-700">
                    {zone.estimatedDays}
                  </span>
                  <span class="ml-1 text-xs text-slate-500">días</span>
                </td>
                <td class="px-5 py-3 text-right font-semibold text-slate-900">
                  {formatAmount(zone.baseCostCents)}
                </td>
                <td class="px-5 py-3">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                      zone.isActive
                        ? 'bg-emerald-100 text-emerald-700'
                        : 'bg-slate-100 text-slate-500',
                    ]}
                  >
                    {zone.isActive
                      ? t['admin.shipping.zones.status.active']
                      : t['admin.shipping.zones.status.inactive']}
                  </span>
                </td>
                <td class="px-5 py-3 text-right">
                  <button
                    type="button"
                    class:list={[
                      'inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium transition focus:outline-none focus-visible:ring-2',
                      zone.isActive
                        ? 'text-slate-500 hover:bg-slate-100 hover:text-rose-600 focus-visible:ring-slate-300'
                        : 'text-slate-500 hover:bg-slate-100 hover:text-emerald-600 focus-visible:ring-slate-300',
                    ]}
                    aria-label={`${zone.isActive ? t['admin.shipping.zones.status.inactive'] : t['admin.shipping.zones.status.active']}: ${zone.name}`}
                  >
                    {zone.isActive
                      ? t['admin.shipping.zones.status.inactive']
                      : t['admin.shipping.zones.status.active']}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <p class="text-sm font-medium text-slate-700">{t['admin.shipping.zones.empty']}</p>
    </div>
  )}
</AdminLayout>
