---
import AuthLayout from "../../../../layouts/AuthLayout.astro";
import ForgotPasswordForm from "../../../../components/admin/auth/ForgotPasswordForm";
import { getServerDictionary, getServerLocale } from "../../../../i18n/server";
import { getBrandBySlug, DEFAULT_BRAND } from "../../../../config/stores";
import { themeToBrand } from "../../../../lib/theme";

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const fallbackBrand =
  getBrandBySlug(Astro.locals.tenant?.tenantSlug ?? null) ?? DEFAULT_BRAND;
const brand = themeToBrand(Astro.locals.theme, fallbackBrand);
---

<AuthLayout title={`${t["auth.passwordReset.title"]} · ${brand.name}`}>
  <div class="grid min-h-screen w-full grid-cols-1 lg:grid-cols-2">
    <aside
      class="relative isolate hidden flex-col justify-between overflow-hidden p-10 text-white lg:sticky lg:top-0 lg:h-screen lg:flex lg:p-16"
      style={`background:
        radial-gradient(ellipse 70% 50% at 20% 10%, rgba(255,255,255,0.22) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 100%, rgba(0,0,0,0.30) 0%, transparent 65%),
        linear-gradient(140deg, ${brand.accentColor} 0%, ${brand.accentHoverColor} 100%);
      `}
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.07]"
        style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 18px 18px;"
      />

      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full opacity-30 blur-3xl"
        style="background: radial-gradient(circle, rgba(255,255,255,0.5) 0%, transparent 70%);"
      />

      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 -right-24 h-80 w-80 rounded-full opacity-40 blur-3xl"
        style="background: radial-gradient(circle, rgba(0,0,0,0.55) 0%, transparent 70%);"
      />

      <div class="relative z-10 flex items-center gap-3">
        <img
          src={brand.logoPath}
          alt={brand.name}
          class="h-10 w-10 rounded-md bg-white p-1 object-contain shadow-md"
        />
        <span class="text-2xl font-bold tracking-tight drop-shadow">
          {brand.name}
        </span>
      </div>

      <div class="relative z-10 max-w-lg">
        <h2 class="text-3xl font-bold leading-tight drop-shadow md:text-5xl">
          {t["auth.passwordReset.title"]}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-white/90 drop-shadow">
          {t["auth.passwordReset.bodyEmail"]}
        </p>
      </div>

      <p class="relative z-10 text-xs text-white/70">
        © {new Date().getFullYear()} {brand.name}
      </p>
    </aside>

    <main
      class="flex items-center justify-center px-4 py-10 sm:px-10 lg:py-16"
      style={`background-color: ${brand.loginTheme.bg};`}
    >
      <div class="w-full max-w-2xl">
        <header class="mb-10 flex items-center gap-3 lg:hidden">
          <img
            src={brand.loginLogoPath}
            alt={brand.name}
            class="h-10 w-10 rounded-md bg-white object-contain p-1"
          />
          <span
            class="text-xl font-bold tracking-tight"
            style={`color: ${brand.loginTheme.text};`}
          >
            {brand.name}
          </span>
        </header>

        <div class="hidden text-center lg:block">
          <img
            src={brand.loginLogoPath}
            alt={brand.name}
            class="mx-auto mb-6 h-16 w-16 rounded-xl bg-white object-contain p-2 shadow-md"
          />
        </div>

        <ForgotPasswordForm client:load brand={brand} locale={locale} />
      </div>
    </main>
  </div>
</AuthLayout>