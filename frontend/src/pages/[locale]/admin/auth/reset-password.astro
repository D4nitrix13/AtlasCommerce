---
import AuthLayout from "../../../../layouts/AuthLayout.astro";
import ResetPasswordForm from "../../../../components/admin/auth/ResetPasswordForm";
import { getServerDictionary, getServerLocale } from "../../../../i18n/server";
import { getBrandBySlug, DEFAULT_BRAND } from "../../../../config/stores";
import { themeToBrand } from "../../../../lib/theme";

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const fallbackBrand =
  getBrandBySlug(Astro.locals.tenant?.tenantSlug ?? null) ?? DEFAULT_BRAND;
const brand = themeToBrand(Astro.locals.theme, fallbackBrand);

const emailParam = Astro.url.searchParams.get("email");
const callbackPath = Astro.url.searchParams.get("callback") ?? "/admin/dashboard";
const email = emailParam ?? "";
const showMissingEmailWarning = email === "";

const step2Intro = showMissingEmailWarning
  ? null
  : t["auth.passwordReset.step2.intro"]?.replace("{email}", email);
---

<AuthLayout title={`${t["auth.passwordReset.title"]} · ${brand.name}`}>
  <main
    class="min-h-screen px-4 py-12 sm:px-6 lg:px-8"
    style={`background-color: ${brand.loginTheme.bg}; color: ${brand.loginTheme.text};`}
  >
    <div class="mx-auto max-w-lg">
      <header class="mb-8 flex items-center gap-3">
        <img
          src={brand.loginLogoPath}
          alt={brand.name}
          class="h-8 w-8 rounded bg-white object-contain p-1"
        />
        <span class="text-sm font-semibold">{brand.name}</span>
      </header>

      <p class="mb-2 text-xs font-medium uppercase tracking-wider text-[var(--login-text-subtle)]">
        {t["auth.passwordReset.step2.label"]}
      </p>

      <h1 class="mb-4 text-2xl font-bold tracking-tight">
        {t["auth.passwordReset.step2.heading"]}
      </h1>

      {showMissingEmailWarning ? (
        <>
          <p class="mb-8 text-sm leading-relaxed text-[var(--login-text-muted)]">
            {t["auth.passwordReset.error.missingEmail"]}
          </p>
          <a
            href={`/${locale}/admin/auth/forgot-password`}
            class="text-sm font-semibold text-[var(--login-text)] underline"
          >
            ← {t["common.back"]}
          </a>
        </>
      ) : (
        <>
          <p class="mb-8 text-sm leading-relaxed text-[var(--login-text-muted)]">
            {step2Intro}
          </p>

          <ResetPasswordForm
            client:load
            brand={brand}
            email={email}
            callbackPath={callbackPath}
            locale={locale}
          />

          <div class="mt-8 border-t border-[var(--login-divider)] pt-6">
            <a
              href={`/${locale}/admin/auth/forgot-password`}
              class="text-sm text-[var(--login-text-muted)] transition hover:text-[var(--login-text)]"
            >
              ← {t["auth.passwordReset.requestNewCode"]}
            </a>
          </div>
        </>
      )}
    </div>
  </main>
</AuthLayout>