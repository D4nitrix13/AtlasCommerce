---
/**
 * Detalle de un ticket — admin (F5.5).
 *
 * Ruta dinámica `/admin/support/tickets/[id]`. Astro resuelve `id`
 * desde `Astro.params`, lo busca en el mock y renderiza:
 *   - Header con número + status + prioridad + canal + asignado
 *   - TicketThread con la conversación completa
 *   - Reply box + acciones (resolver, hold)
 *
 * **AGENTS.md §1**: ~120 líneas — header + thread + acciones.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Icon from '../../../../../components/ui/Icon.astro';
import TicketThread from '../../../../../components/admin/support/TicketThread.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import {
  supportTickets,
  type TicketStatus,
  type TicketPriority,
} from '../../../../../data/support-mock';

const t = getServerDictionary(Astro.locals.locale);

const { id } = Astro.params;
const ticket = supportTickets.find((tk) => tk.id === id);

const STATUS_BADGE: Record<TicketStatus, string> = {
  open: 'bg-amber-100 text-amber-700',
  pending: 'bg-sky-100 text-sky-700',
  hold: 'bg-slate-200 text-slate-600',
  solved: 'bg-emerald-100 text-emerald-700',
  closed: 'bg-slate-100 text-slate-500',
};

const PRIORITY_BADGE: Record<TicketPriority, string> = {
  low: 'bg-slate-50 text-slate-500',
  normal: 'bg-sky-50 text-sky-700',
  high: 'bg-amber-50 text-amber-700',
  urgent: 'bg-rose-50 text-rose-700',
};

const formatDateTime = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleString('es-NI', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });
};
---

<AdminLayout
  title={`${ticket?.ticketNumber ?? t['admin.support.tickets.detail.notFound']} | Admin`}
>
  <a
    href="/admin/support/tickets"
    class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    {t['admin.support.tickets.detail.back']}
  </a>

  {!ticket && (
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center">
      <p class="text-base font-semibold text-rose-900">
        {t['admin.support.tickets.detail.notFound']}
      </p>
    </div>
  )}

  {ticket && (
    <>
      <header class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-semibold text-slate-500">
                {ticket.ticketNumber}
              </span>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider',
                  STATUS_BADGE[ticket.status],
                ]}
              >
                {t[`admin.support.tickets.filter.${ticket.status}`]}
              </span>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider',
                  PRIORITY_BADGE[ticket.priority],
                ]}
              >
                {t[`admin.support.tickets.priority.${ticket.priority}`]}
              </span>
            </div>
            <h1 class="mt-2 text-xl font-bold tracking-tight text-slate-950">{ticket.subject}</h1>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50"
            >
              {t['admin.support.tickets.detail.hold']}
            </button>
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-emerald-700"
            >
              <span aria-hidden="true">✓</span>
              {t['admin.support.tickets.detail.resolve']}
            </button>
          </div>
        </div>

        <dl class="mt-5 grid gap-x-6 gap-y-2 border-t border-slate-100 pt-4 text-xs sm:grid-cols-4">
          <div>
            <dt class="font-medium uppercase tracking-wide text-slate-400">
              {t['admin.support.tickets.detail.meta.customer']}
            </dt>
            <dd class="mt-0.5 font-semibold text-slate-900">{ticket.customerName}</dd>
            <dd class="text-slate-500">{ticket.customerEmail}</dd>
          </div>
          <div>
            <dt class="font-medium uppercase tracking-wide text-slate-400">
              {t['admin.support.tickets.detail.meta.createdAt']}
            </dt>
            <dd class="mt-0.5 text-slate-700">{formatDateTime(ticket.createdAt)}</dd>
          </div>
          <div>
            <dt class="font-medium uppercase tracking-wide text-slate-400">
              {t['admin.support.tickets.detail.meta.channel']}
            </dt>
            <dd class="mt-0.5 text-slate-700">
              {t[`admin.support.tickets.channel.${ticket.channel}`]}
            </dd>
          </div>
          <div>
            <dt class="font-medium uppercase tracking-wide text-slate-400">
              {t['admin.support.tickets.detail.meta.assignedTo']}
            </dt>
            <dd class="mt-0.5 text-slate-700">
              {ticket.assignedTo ?? t['admin.support.tickets.detail.meta.unassigned']}
            </dd>
          </div>
        </dl>
      </header>

      <section class="mb-6">
        <TicketThread ticket={ticket} />
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <textarea
          rows="3"
          placeholder={t['admin.support.tickets.detail.replyPlaceholder']}
          class="block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        ></textarea>
        <div class="mt-3 flex items-center justify-between">
          <p class="text-xs text-slate-500">⌘+↵ para enviar</p>
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3.5 py-1.5 text-sm font-medium text-white transition hover:bg-slate-800"
          >
            <span aria-hidden="true">↩</span>
            {t['admin.support.tickets.detail.sendReply']}
          </button>
        </div>
      </section>
    </>
  )}
</AdminLayout>
