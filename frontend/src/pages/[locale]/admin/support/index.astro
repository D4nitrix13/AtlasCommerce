---
/**
 * Hub de Soporte (F5.5).
 *
 * 4 cards (tickets abiertos, preguntas pendientes, reseñas por
 * moderar, tickets urgentes) + acceso directo a secciones.
 *
 * **AGENTS.md §1**: ~110 líneas — header + 4 cards + 3 quick links.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Icon from '../../../../ui/Icon.astro';
import { getServerDictionary } from '../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface HubCard {
  href: string;
  title: string;
  hint: string;
  icon: string;
  accent: 'sky' | 'amber' | 'violet' | 'rose';
}

const cards: HubCard[] = [
  {
    href: '/admin/support/tickets',
    title: t['admin.support.hub.openTickets'],
    hint: t['admin.support.hub.openTicketsHint'],
    icon: 'chat-bubble-left-right',
    accent: 'sky',
  },
  {
    href: '/admin/support/questions',
    title: t['admin.support.hub.pendingQuestions'],
    hint: t['admin.support.hub.pendingQuestionsHint'],
    icon: 'question-mark-circle',
    accent: 'amber',
  },
  {
    href: '/admin/support/reviews',
    title: t['admin.support.hub.reviewsPending'],
    hint: t['admin.support.hub.reviewsPendingHint'],
    icon: 'star',
    accent: 'violet',
  },
  {
    href: '/admin/support/tickets',
    title: t['admin.support.hub.urgentTickets'],
    hint: t['admin.support.hub.urgentTicketsHint'],
    icon: 'bolt',
    accent: 'rose',
  },
];

const accentClass: Record<HubCard['accent'], string> = {
  sky: 'bg-sky-50 text-sky-600',
  amber: 'bg-amber-50 text-amber-600',
  violet: 'bg-violet-50 text-violet-600',
  rose: 'bg-rose-50 text-rose-600',
};
---

<AdminLayout title={`${t['admin.support.title']} | Admin`}>
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">
      {t['admin.support.title']}
    </h1>
    <p class="mt-1 text-sm text-slate-500">{t['admin.support.subtitle']}</p>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow"
        >
          <div class:list={['mb-4 grid h-10 w-10 place-items-center rounded-xl', accentClass[card.accent]]}>
            <Icon name={card.icon} class="h-5 w-5" />
          </div>
          <h2 class="text-base font-bold text-slate-950 group-hover:text-slate-700">
            {card.title}
          </h2>
          <p class="mt-1 text-sm text-slate-500">{card.hint}</p>
        </a>
      ))
    }
  </section>

  <section class="mt-6 grid gap-4 lg:grid-cols-3">
    <a
      href="/admin/support/tickets"
      class="group flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
    >
      <div>
        <h3 class="text-base font-bold text-slate-950">
          {t['admin.support.tickets.title']}
        </h3>
        <p class="mt-1 text-xs text-slate-500">12 tickets · 5 abiertos</p>
      </div>
      <Icon name="chevron-right" class="h-5 w-5 text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-700" />
    </a>
    <a
      href="/admin/support/reviews"
      class="group flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
    >
      <div>
        <h3 class="text-base font-bold text-slate-950">
          {t['admin.support.reviews.title']}
        </h3>
        <p class="mt-1 text-xs text-slate-500">20 reseñas · 8 pendientes</p>
      </div>
      <Icon name="chevron-right" class="h-5 w-5 text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-700" />
    </a>
    <a
      href="/admin/support/questions"
      class="group flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
    >
      <div>
        <h3 class="text-base font-bold text-slate-950">Preguntas</h3>
        <p class="mt-1 text-xs text-slate-500">8 sin responder</p>
      </div>
      <Icon name="chevron-right" class="h-5 w-5 text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-700" />
    </a>
  </section>
</AdminLayout>
