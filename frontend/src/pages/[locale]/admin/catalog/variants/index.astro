---
/**
 * /admin/catalog/variants — Tabla masiva de variantes (F5.3).
 *
 * Una sola tabla con todas las variantes (30 en el mock), con
 * columnas SKU / producto / color / tamaño / stock / precio. Útil
 * para revisar stock global y export a CSV sin entrar al detalle
 * de cada producto.
 *
 * Patrón similar a ProductTable pero sin checkboxes/bulk (todas las
 * acciones masivas viven en el producto padre). Las acciones
 * inline llevan al detalle del producto asociado.
 *
 * AGENTS.md §1: ~120 líneas.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Badge from '../../../../../components/ui/Badge.astro';
import FilterBar from '../../../../../components/admin/catalog/FilterBar.astro';
import { VARIANTS_MOCK, getProductById, type VariantMock } from '../../../../../data/catalog-mock';
import { getServerDictionary } from '../../../../../i18n/server';
import { adminUrl } from '../../../../../lib/path-helpers';
import { getServerLocale } from '../../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const variants: readonly VariantMock[] = VARIANTS_MOCK;
const hasVariants = variants.length > 0;

const STOCK_PILL: Record<'in_stock' | 'low_stock' | 'out_of_stock', string> = {
  in_stock: 'bg-emerald-100 text-emerald-700',
  low_stock: 'bg-amber-100 text-amber-800',
  out_of_stock: 'bg-red-100 text-red-700',
};

const STOCK_LABEL: Record<'in_stock' | 'low_stock' | 'out_of_stock', string> = {
  in_stock: t['admin.catalog.products.stock.inStock'],
  low_stock: t['admin.catalog.products.stock.lowStock'],
  out_of_stock: t['admin.catalog.products.stock.outOfStock'],
};

function stockLevel(stock: number): 'in_stock' | 'low_stock' | 'out_of_stock' {
  if (stock === 0) return 'out_of_stock';
  if (stock < 10) return 'low_stock';
  return 'in_stock';
}

function formatPrice(cents: number): string {
  return new Intl.NumberFormat(locale === 'es' ? 'es-NI' : 'en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 2,
  }).format(cents / 100);
}
---

<AdminLayout title={t['admin.catalog.variants.title']}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.catalog.variants.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.catalog.variants.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
    >
      <span aria-hidden="true">↓</span>
      {t['admin.catalog.variants.exportCsv']}
    </button>
  </div>

  <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
    <FilterBar showPriceRange={false} />

    <div class="space-y-4">
      {hasVariants ? (
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3 font-medium">{t['admin.catalog.variants.column.sku']}</th>
                <th class="px-3 py-3 font-medium">{t['admin.catalog.variants.column.product']}</th>
                <th class="px-3 py-3 font-medium">{t['admin.catalog.variants.column.color']}</th>
                <th class="px-3 py-3 font-medium">{t['admin.catalog.variants.column.size']}</th>
                <th class="px-3 py-3 text-right font-medium">
                  {t['admin.catalog.variants.column.stock']}
                </th>
                <th class="px-3 py-3 text-right font-medium">
                  {t['admin.catalog.variants.column.price']}
                </th>
                <th class="px-4 py-3 font-medium">{t['admin.catalog.variants.column.status']}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {variants.map((variant) => {
                const product = getProductById(variant.productId);
                const level = stockLevel(variant.stock);
                const productHref = product
                  ? adminUrl(locale, `/catalog/products/${product.id}`)
                  : '#';
                return (
                  <tr class="hover:bg-slate-50/50">
                    <td class="px-4 py-3 font-mono text-xs text-slate-600">{variant.sku}</td>
                    <td class="max-w-[280px] truncate px-3 py-3">
                      <a
                        href={productHref}
                        class="font-medium text-slate-900 hover:text-violet-700 hover:underline"
                      >
                        {product?.name ?? '—'}
                      </a>
                    </td>
                    <td class="px-3 py-3 text-slate-700">{variant.color}</td>
                    <td class="px-3 py-3 text-slate-700">{variant.size}</td>
                    <td class="px-3 py-3 text-right">
                      <span
                        class:list={[
                          'inline-block rounded-full px-2.5 py-0.5 text-xs font-medium',
                          STOCK_PILL[level],
                        ]}
                      >
                        {variant.stock} · {STOCK_LABEL[level]}
                      </span>
                    </td>
                    <td class="px-3 py-3 text-right font-semibold text-slate-900">
                      {formatPrice(variant.priceCents)}
                    </td>
                    <td class="px-4 py-3">
                      <Badge variant={variant.status === 'active' ? 'primary' : 'neutral'}>
                        {t[`admin.catalog.products.status.${variant.status}`]}
                      </Badge>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
          <p class="text-sm font-medium text-slate-700">{t['admin.catalog.variants.empty']}</p>
          <p class="mt-1 text-xs text-slate-500">{t['admin.catalog.variants.emptyHint']}</p>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
