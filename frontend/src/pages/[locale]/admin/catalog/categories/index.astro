---
/**
 * /admin/catalog/categories — Lista categorías con tree view (F5.3).
 *
 * Patrón: árbol jerárquico con búsqueda lateral. SearchBar lateral
 * filtra por nombre (client-side cuando se hidrate). El componente
 * CategoryTree renderiza los 2 niveles del mock (raíz + hijos).
 *
 * AGENTS.md §1: ~80 líneas.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryTree from '../../../../components/admin/catalog/CategoryTree.astro';
import Input from '../../../../components/ui/Input.astro';
import { CATEGORIES_MOCK } from '../../../../data/catalog-mock';
import { getServerDictionary } from '../../../../i18n/server';
import { adminUrl } from '../../../../lib/path-helpers';
import { getServerLocale } from '../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const categories = CATEGORIES_MOCK;
---

<AdminLayout title={t['admin.catalog.categories.title']}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.catalog.categories.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        {t['admin.catalog.categories.subtitle']}
      </p>
    </div>
    <a
      href={`${adminUrl(locale, '/catalog/categories/0')}?edit=1`}
      class="inline-flex items-center gap-2 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
    >
      <span aria-hidden="true">+</span>
      {t['admin.catalog.categories.addCategory']}
    </a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[280px_1fr]">
    <aside
      aria-label={t['admin.catalog.filters.title']}
      class="space-y-4 rounded-lg border border-slate-200 bg-white p-4"
    >
      <Input
        name="category-search"
        type="search"
        label={t['admin.catalog.common.search']}
        placeholder={t['admin.catalog.categories.searchPlaceholder']}
      />
      <p class="text-xs text-slate-500">
        {/* El drag & drop real se habilita en F5.4 cuando exista el
            endpoint PATCH /api/v1/admin/catalog/categories/{id}/move */}
        Click en un nodo para expandir / colapsar hijos.
      </p>
    </aside>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <CategoryTree categories={categories} />
    </div>
  </div>
</AdminLayout>