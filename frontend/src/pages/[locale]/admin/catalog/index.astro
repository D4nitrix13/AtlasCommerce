---
/**
 * /admin/catalog — Hub con resumen del módulo catálogo (F5.3).
 *
 * Página de entrada al bloque "Catálogo" del panel admin. Muestra 4
 * tarjetas (productos / categorías / marcas / variantes) con conteos
 * agregados del mock + CTAs a las listas detalladas.
 *
 * Patrón: composición pura (AGENTS §4) — todo el render vive en
 * sub-componentes. Esta página es la única que ve el header del hub.
 *
 * AGENTS.md §1: ~110 líneas. Bajo el límite de página (400).
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { CATALOG_HUB_SUMMARY } from '../../../../data/catalog-mock';
import { getServerDictionary } from '../../../../i18n/server';
import { adminUrl } from '../../../../lib/path-helpers';
import { getServerLocale } from '../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const HUB_CARDS = [
  {
    href: adminUrl(locale, '/catalog/products'),
    label: t['admin.catalog.hub.products'],
    hint: t['admin.catalog.hub.productsHint'],
    count: CATALOG_HUB_SUMMARY.productsCount,
    accent: 'violet',
    icon: '🛒',
  },
  {
    href: adminUrl(locale, '/catalog/categories'),
    label: t['admin.catalog.hub.categories'],
    hint: t['admin.catalog.hub.categoriesHint'],
    count: CATALOG_HUB_SUMMARY.categoriesCount,
    accent: 'sky',
    icon: '📁',
  },
  {
    href: adminUrl(locale, '/catalog/brands'),
    label: t['admin.catalog.hub.brands'],
    hint: t['admin.catalog.hub.brandsHint'],
    count: CATALOG_HUB_SUMMARY.brandsCount,
    accent: 'emerald',
    icon: '🏷️',
  },
  {
    href: adminUrl(locale, '/catalog/variants'),
    label: t['admin.catalog.hub.variants'],
    hint: t['admin.catalog.hub.variantsHint'],
    count: CATALOG_HUB_SUMMARY.variantsCount,
    accent: 'amber',
    icon: '▦',
  },
];

const ACCENT_CLASSES: Record<string, string> = {
  violet: 'bg-violet-100 text-violet-800 border-violet-200',
  sky: 'bg-sky-100 text-sky-800 border-sky-200',
  emerald: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  amber: 'bg-amber-100 text-amber-800 border-amber-200',
};
---

<AdminLayout title={t['admin.catalog.title']}>
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">{t['admin.catalog.title']}</h1>
    <p class="mt-1 text-sm text-slate-500">{t['admin.catalog.subtitle']}</p>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {HUB_CARDS.map((card) => (
      <a
        href={card.href}
        class:list={[
          'group block rounded-xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500',
          ACCENT_CLASSES[card.accent],
        ]}
      >
        <div class="flex items-start justify-between">
          <span class="text-3xl" aria-hidden="true">
            {card.icon}
          </span>
          <span class="text-3xl font-bold tracking-tight">{card.count}</span>
        </div>
        <h2 class="mt-3 text-base font-semibold text-slate-900">{card.label}</h2>
        <p class="mt-1 text-xs text-slate-600">{card.hint}</p>
        <p class="mt-3 text-xs font-medium text-slate-500 transition group-hover:text-slate-900">
          Ver más →
        </p>
      </a>
    ))}
  </section>

  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6">
    <h2 class="mb-2 text-base font-semibold text-slate-900">{t['admin.catalog.common.actions']}</h2>
    <p class="mb-4 text-xs text-slate-500">
      {/* En esta versión los CTAs llevan a las listas donde se ejecuta
          la acción de creación. El pattern de creación in-place se
          habilita cuando exista el endpoint bulk-create. */}
      Acceso rápido a las áreas del módulo catálogo.
    </p>
    <div class="flex flex-wrap gap-2">
      <a
        href={adminUrl(locale, '/catalog/products')}
        class="inline-flex items-center gap-2 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        + {t['admin.catalog.products.addProduct']}
      </a>
      <a
        href={adminUrl(locale, '/catalog/categories')}
        class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        + {t['admin.catalog.categories.addCategory']}
      </a>
      <a
        href={adminUrl(locale, '/catalog/brands')}
        class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        + {t['admin.catalog.brands.addBrand']}
      </a>
    </div>
  </section>
</AdminLayout>
