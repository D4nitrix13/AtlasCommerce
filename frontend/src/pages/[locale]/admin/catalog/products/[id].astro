---
/**
 * /admin/catalog/products/[id] — Detalle + edit producto (F5.3).
 *
 * El tab activo viene de `?tab=` (default: basics). El form
 * multipropósito se renderiza con ProductForm.
 *
 * El producto se trae del API admin (`GET /v1/admin/products/{id}`).
 * SSR: el fetch reenvía la cookie de sesión del request porque las
 * rutas admin son autenticadas y el backend no ve el navegador.
 * Las relaciones (variantes/tallas/atributos/galería) las cargan las
 * islas por su cuenta con datos reales — el form recibe solo la data
 * del producto.
 *
 * AGENTS.md §1: ~80 líneas.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import ProductForm from '../../../../../components/admin/catalog/ProductForm.astro';
import type { ProductMock, ProductStatus } from '../../../../../data/catalog-mock';
import { apiFetch } from '../../../../../lib/api';
import { getServerDictionary } from '../../../../../i18n/server';
import { adminUrl } from '../../../../../lib/path-helpers';
import { getServerLocale } from '../../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

interface AdminProductApiResponse {
  data: {
    id: number;
    name: string;
    slug: string;
    sku: string;
    description: string | null;
    category_id: number | null;
    brand_id: number | null;
    base_price_cents: number;
    cost_cents: number;
    is_active: boolean;
  };
}

const idParam = Astro.params.id;
const productId = idParam !== undefined ? Number.parseInt(idParam, 10) : NaN;

async function loadProduct(id: number): Promise<ProductMock | null> {
  try {
    const response = await apiFetch<AdminProductApiResponse>(`/v1/admin/products/${id}`, {
      origin: Astro.url.origin,
      host: Astro.url.host,
      // Rutas admin autenticadas: el SSR debe reenviar la cookie de
      // sesión Y un Origin "frontend" (Sanctum solo arranca sesión para
      // requests con Origin/Referer en SANCTUM_STATEFUL_DOMAINS). Sin
      // ambos, el backend responde 401 y el form cae a "no encontrado".
      headers: {
        Cookie: Astro.request.headers.get('cookie') ?? '',
        Origin: Astro.url.origin,
      },
    });
    const row = response.data;
    return {
      id: row.id,
      slug: row.slug,
      name: row.name,
      description: row.description ?? '',
      sku: row.sku,
      categoryId: row.category_id ?? 0,
      brandId: row.brand_id ?? 0,
      priceCents: row.base_price_cents,
      costCents: row.cost_cents,
      stock: 0,
      status: (row.is_active ? 'active' : 'draft') as ProductStatus,
      imageUrl: '/images/product-placeholder.png',
      weightKg: 0,
      updatedAt: new Date().toISOString(),
      seoTitle: '',
      seoDescription: '',
      variantIds: [],
    };
  } catch {
    return null;
  }
}

const product = Number.isFinite(productId) ? await loadProduct(productId) : null;

const tabParam = Astro.url.searchParams.get('tab');
const validTabs = ['basics', 'variants', 'media', 'pricing', 'seo'] as const;
const activeTab = (validTabs as readonly string[]).includes(tabParam ?? '')
  ? (tabParam as (typeof validTabs)[number])
  : 'basics';
---

<AdminLayout title={t['admin.catalog.products.detail.title']}>
  {product === null ? (
    <div class="rounded-xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm">
      <h1 class="text-xl font-semibold text-slate-900">
        {t['admin.catalog.products.detail.notFound']}
      </h1>
      <p class="mt-2 text-sm text-slate-500">{t['admin.catalog.common.error']}</p>
      <a
        href={adminUrl(locale, '/catalog/products')}
        class="mt-4 inline-block text-sm font-medium text-violet-700 hover:underline"
      >
        ← {t['admin.catalog.common.back']}
      </a>
    </div>
  ) : (
    <>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="mb-1 flex items-center gap-2 text-xs text-slate-500">
            <a
              href={adminUrl(locale, '/catalog/products')}
              class="hover:text-violet-700 hover:underline"
            >
              {t['admin.catalog.products.title']}
            </a>
            <span aria-hidden="true">/</span>
            <span class="truncate max-w-[280px]">{product.name}</span>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-950">{product.name}</h1>
          <p class="mt-1 font-mono text-xs text-slate-500">{product.sku}</p>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <ProductForm product={product} activeTab={activeTab} />
      </div>
    </>
  )}
</AdminLayout>
