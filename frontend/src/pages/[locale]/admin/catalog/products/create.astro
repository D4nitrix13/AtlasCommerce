---
/**
 * /admin/catalog/products/create — Crear producto (F5.3).
 *
 * Form multi-step opcional (basics → variants → media → pricing →
 * seo). Para esta primera versión el form renderiza todos los tabs
 * en la misma página con anchor navigation; cuando exista el backend,
 * se hidrata con persistencia por tab.
 *
 * El componente ProductForm encapsula los 5 tabs. Esta página es
 * composición pura (AGENTS §4): renderiza el header + el form.
 *
 * AGENTS.md §1: ~50 líneas.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ProductForm from '../../../../components/admin/catalog/ProductForm.astro';
import { getServerDictionary } from '../../../../i18n/server';
import { adminUrl } from '../../../../lib/path-helpers';
import { getServerLocale } from '../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

// Tab activo vía query string (default: basics).
const tabParam = Astro.url.searchParams.get('tab');
const validTabs = ['basics', 'variants', 'media', 'pricing', 'seo'] as const;
const activeTab = (validTabs as readonly string[]).includes(tabParam ?? '')
  ? (tabParam as (typeof validTabs)[number])
  : 'basics';
---

<AdminLayout title={t['admin.catalog.products.create.title']}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="mb-1 flex items-center gap-2 text-xs text-slate-500">
        <a
          href={adminUrl(locale, '/catalog/products')}
          class="hover:text-violet-700 hover:underline"
        >
          {t['admin.catalog.products.title']}
        </a>
        <span aria-hidden="true">/</span>
        <span>{t['admin.catalog.products.create.title']}</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.catalog.products.create.title']}
      </h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-500">
        {t['admin.catalog.products.create.subtitle']}
      </p>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <ProductForm activeTab={activeTab} />
  </div>
</AdminLayout>