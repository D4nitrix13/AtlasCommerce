---
/**
 * Movimientos de inventario — admin (F5.5).
 *
 * Lista cronológica de entradas/salidas/ajustes/transferencias
 * (20 items del mock). Tabla densa con badges por tipo, columna
 * de razón + performedBy + timestamps.
 *
 * Patrón WMS ligero: una sola tabla cronológica inversa, no agrupada
 * por producto. Para 1000+ movimientos/día se agruparía por día con
 * `<details>` o pagination; con 20 el render plano es OK.
 *
 * **AGENTS.md §1**: ~100 líneas — header + tabla + tipos de badges.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { inventoryMovements, type MovementType } from '../../../../../data/inventory-mock';

const t = getServerDictionary(Astro.locals.locale);

const TYPE_LABEL_KEY: Record<MovementType, 'admin.inventory.movements.type.entry' | 'admin.inventory.movements.type.exit' | 'admin.inventory.movements.type.adjustment' | 'admin.inventory.movements.type.transfer'> = {
  entry: 'admin.inventory.movements.type.entry',
  exit: 'admin.inventory.movements.type.exit',
  adjustment: 'admin.inventory.movements.type.adjustment',
  transfer: 'admin.inventory.movements.type.transfer',
};

const TYPE_BADGE: Record<MovementType, string> = {
  entry: 'bg-emerald-100 text-emerald-700',
  exit: 'bg-rose-100 text-rose-700',
  adjustment: 'bg-amber-100 text-amber-700',
  transfer: 'bg-sky-100 text-sky-700',
};

const formatTimestamp = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleString('es-NI', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
};

// Orden cronológico inverso (más reciente primero)
const sortedMovements = [...inventoryMovements].sort(
  (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime(),
);
---

<AdminLayout title={`${t['admin.inventory.movements.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.inventory.movements.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.inventory.movements.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
    >
      <span aria-hidden="true">↓</span>
      <span>{t['admin.inventory.movements.export']}</span>
    </button>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.type']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.product']}</th>
            <th class="px-4 py-3 text-center">{t['admin.inventory.movements.column.quantity']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.from']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.to']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.reason']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.performedBy']}</th>
            <th class="px-4 py-3">{t['admin.inventory.movements.column.createdAt']}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            sortedMovements.map((m) => (
              <tr class="group hover:bg-slate-50/50">
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                      TYPE_BADGE[m.type],
                    ]}
                  >
                    {t[TYPE_LABEL_KEY[m.type]]}
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="font-medium text-slate-900">{m.productName}</div>
                  <div class="mt-0.5 font-mono text-xs text-slate-500">{m.sku}</div>
                </td>
                <td class="px-4 py-3 text-center">
                  <span
                    class:list={[
                      'inline-flex min-w-[3rem] items-center justify-center rounded-md px-2 py-0.5 text-sm font-semibold',
                      m.quantity >= 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700',
                    ]}
                  >
                    {m.quantity >= 0 ? '+' : ''}
                    {m.quantity}
                  </span>
                </td>
                <td class="px-4 py-3 text-sm text-slate-600">
                  {m.warehouseFrom ?? '—'}
                </td>
                <td class="px-4 py-3 text-sm text-slate-600">
                  {m.warehouseTo ?? '—'}
                </td>
                <td class="px-4 py-3 text-sm text-slate-700">{m.reason}</td>
                <td class="px-4 py-3 text-sm text-slate-600">{m.performedBy}</td>
                <td class="px-4 py-3 text-xs text-slate-500">
                  <time datetime={m.createdAt}>{formatTimestamp(m.createdAt)}</time>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
