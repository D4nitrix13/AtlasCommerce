---
/**
 * Detalle de un depósito — admin (F5.5).
 *
 * Ruta dinámica `/admin/inventory/warehouses/[id]`. Astro resuelve
 * `id` desde `Astro.params`, lo busca en el mock y renderiza:
 *   - Header con nombre + status + dirección
 *   - 3 metric cards (# items, % capacidad, movimientos mes)
 *   - Segmentación del inventario por status (in/low/out)
 *   - Tabla con el stock asignado a ese depósito
 *
 * Si el id no existe, muestra un banner `notFound` (Zendesk Admin
 * pattern para URLs inválidos compartidos).
 *
 * **AGENTS.md §1**: ~120 líneas — header + métricas + tabla filtrada.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Icon from '../../../../../components/ui/Icon.astro';
import StockTable from '../../../../../components/admin/inventory/StockTable.astro';
import AdjustStockModal from '../../../../../components/admin/inventory/AdjustStockModal.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import {
  warehouses,
  stockEntries,
  inventoryMovements,
  type StockStatus,
} from '../../../../../data/inventory-mock';

const t = getServerDictionary(Astro.locals.locale);

const { id } = Astro.params;

const warehouse = warehouses.find((w) => w.id === id);

if (!warehouse) {
  // 404 message handled inline below — Astro no tiene un sistema de
  // error pages "limpio" para rutas dinámicas, así que se renderiza
  // una variante not-found con link de retorno.
}

const warehouseStock = warehouse ? stockEntries.filter((s) => s.warehouseId === warehouse.id) : [];

const segmentsByStatus: Record<StockStatus, number> = {
  in_stock: 0,
  low_stock: 0,
  out_of_stock: 0,
};

for (const entry of warehouseStock) {
  segmentsByStatus[entry.status] += 1;
}

const occupancyPercent = warehouse
  ? Math.min(100, Math.round((warehouse.itemsCount / warehouse.capacity) * 100))
  : 0;

const recentMovements = warehouse
  ? inventoryMovements
      .filter(
        (m) =>
          (m.warehouseFrom !== null && m.warehouseFrom === warehouse.name) ||
          (m.warehouseTo !== null && m.warehouseTo === warehouse.name)
      )
      .slice(0, 3)
  : [];
---

<AdminLayout
  title={`${warehouse?.name ?? t['admin.inventory.warehouses.detail.notFound']} | Admin`}
>
  {!warehouse && (
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center">
      <p class="text-base font-semibold text-rose-900">
        {t['admin.inventory.warehouses.detail.notFound']}
      </p>
      <a
        href="/admin/inventory/warehouses"
        class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-rose-700 hover:underline"
      >
        {t['admin.inventory.warehouses.detail.back']}
      </a>
    </div>
  )}

  {warehouse && (
    <>
      <a
        href="/admin/inventory/warehouses"
        class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900"
      >
        <Icon name="chevron-left" class="h-4 w-4" />
        {t['admin.inventory.warehouses.detail.back']}
      </a>

      <header class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-950">{warehouse.name}</h1>
            <p class="mt-1 text-sm text-slate-600">{warehouse.address}</p>
            <p class="mt-0.5 text-xs text-slate-500">
              {warehouse.city}, {warehouse.country} · {t['admin.inventory.warehouses.card.manager']}
              : {warehouse.managerName}
            </p>
          </div>
          <span
            class:list={[
              'shrink-0 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider',
              warehouse.isActive
                ? 'bg-emerald-100 text-emerald-700'
                : 'bg-slate-100 text-slate-500',
            ]}
          >
            {warehouse.isActive
              ? t['admin.inventory.warehouses.card.statusActive']
              : t['admin.inventory.warehouses.card.statusInactive']}
          </span>
        </div>
      </header>

      <section class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.inventory.warehouses.detail.metrics.totalItems']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">
            {warehouse.itemsCount.toLocaleString('es-NI')}
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.inventory.warehouses.detail.metrics.capacityUsed']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">{occupancyPercent}%</p>
          <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
            <div
              class:list={[
                'h-full rounded-full',
                occupancyPercent >= 90
                  ? 'bg-rose-500'
                  : occupancyPercent >= 70
                    ? 'bg-amber-500'
                    : 'bg-emerald-500',
              ]}
              style={`width:${occupancyPercent}%`}
            />
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.inventory.warehouses.detail.metrics.movementsMonth']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">{recentMovements.length}</p>
          <p class="mt-1 text-xs text-slate-500">Últimos 7 días</p>
        </div>
      </section>

      <section class="mb-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">
            {t['admin.inventory.warehouses.detail.segments.inStock']}
          </p>
          <p class="mt-2 text-2xl font-bold text-emerald-900">{segmentsByStatus.in_stock}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-700">
            {t['admin.inventory.warehouses.detail.segments.lowStock']}
          </p>
          <p class="mt-2 text-2xl font-bold text-amber-900">{segmentsByStatus.low_stock}</p>
        </div>
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-rose-700">
            {t['admin.inventory.warehouses.detail.segments.outOfStock']}
          </p>
          <p class="mt-2 text-2xl font-bold text-rose-900">{segmentsByStatus.out_of_stock}</p>
        </div>
      </section>

      <StockTable
        entries={warehouseStock}
        emptyLabel={t['admin.inventory.warehouses.detail.empty']}
      />

      <AdjustStockModal />
    </>
  )}
</AdminLayout>
