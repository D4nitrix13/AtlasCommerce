---
/**
 * Stock por producto+variante — admin (F5.5).
 *
 * Tabla con 30 stock entries del mock. Header de página + tabla
 * (`StockTable.astro`) + modal de ajuste (`AdjustStockModal.astro`).
 *
 * El patrón de stock por variante sigue Shopify Admin: una fila por
 * (producto, variante, depósito). Cuando un producto tiene N variantes
 * y M depósitos, hay N×M filas.
 *
 * **AGENTS.md §1**: ~80 líneas — header + tabla + modal.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import StockTable from '../../../../components/admin/inventory/StockTable.astro';
import AdjustStockModal from '../../../../components/admin/inventory/AdjustStockModal.astro';
import { getServerDictionary } from '../../../../i18n/server';
import { stockEntries } from '../../../../data/inventory-mock';

const t = getServerDictionary(Astro.locals.locale);
---

<AdminLayout title={`${t['admin.inventory.stock.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.inventory.stock.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.inventory.stock.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
    >
      <span aria-hidden="true">↓</span>
      <span>{t['admin.inventory.stock.actions.export']}</span>
    </button>
  </div>

  <StockTable entries={stockEntries} />

  <AdjustStockModal />
</AdminLayout>
