---
/**
 * Monedas — admin (F5.5).
 *
 * Lista de 5 monedas aceptadas con tasa de conversión + estado +
 * última actualización. Header con moneda base + toggle auto-update
 * + botón "Refresh rates".
 *
 * **AGENTS.md §1**: ~110 líneas — header + tabla.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface Currency {
  id: string;
  code: string;
  name: string;
  symbol: string;
  rate: number;
  lastUpdate: string;
  isActive: boolean;
}

const currencies: readonly Currency[] = [
  {
    id: 'cur-001',
    code: 'NIO',
    name: 'Córdoba nicaragüense',
    symbol: 'C$',
    rate: 1.0,
    lastUpdate: '2026-09-26',
    isActive: true,
  },
  {
    id: 'cur-002',
    code: 'USD',
    name: 'Dólar estadounidense',
    symbol: '$',
    rate: 0.027,
    lastUpdate: '2026-09-26',
    isActive: true,
  },
  {
    id: 'cur-003',
    code: 'EUR',
    name: 'Euro',
    symbol: '€',
    rate: 0.025,
    lastUpdate: '2026-09-26',
    isActive: true,
  },
  {
    id: 'cur-004',
    code: 'CRC',
    name: 'Colón costarricense',
    symbol: '₡',
    rate: 14.18,
    lastUpdate: '2026-09-25',
    isActive: true,
  },
  {
    id: 'cur-005',
    code: 'HNL',
    name: 'Lempira hondureño',
    symbol: 'L',
    rate: 0.68,
    lastUpdate: '2026-09-25',
    isActive: false,
  },
];

const formatDate = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-NI', { day: '2-digit', month: 'short', year: 'numeric' });
};
---

<AdminLayout title={`${t['admin.settings.currencies.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.settings.currencies.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.settings.currencies.subtitle']}</p>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
      >
        <span aria-hidden="true">↻</span>
        <span>{t['admin.settings.currencies.refreshRates']}</span>
      </button>
      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
      >
        <span aria-hidden="true">+</span>
        <span>{t['admin.settings.currencies.addCurrency']}</span>
      </button>
    </div>
  </div>

  <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="grid gap-5 md:grid-cols-3">
      <div>
        <label for="base-currency" class="text-sm font-medium text-slate-700">
          {t['admin.settings.currencies.base']}
        </label>
        <select
          id="base-currency"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        >
          <option value="NIO">NIO — Córdoba nicaragüense</option>
          <option value="USD">USD — Dólar estadounidense</option>
        </select>
        <p class="mt-1 text-xs text-slate-500">{t['admin.settings.currencies.baseHelp']}</p>
      </div>
      <div>
        <label class="flex cursor-pointer items-start gap-3">
          <input
            type="checkbox"
            checked
            class="mt-1 h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
          />
          <span>
            <span class="text-sm font-medium text-slate-700">
              {t['admin.settings.currencies.autoUpdate']}
            </span>
            <span class="block text-xs text-slate-500">
              Cada 24h vía {t['admin.settings.currencies.rateSource']}
            </span>
          </span>
        </label>
      </div>
      <div>
        <label for="rate-source" class="text-sm font-medium text-slate-700">
          {t['admin.settings.currencies.rateSource']}
        </label>
        <select
          id="rate-source"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        >
          <option>open.er-api.com</option>
          <option>Banco Central</option>
          <option>Manual</option>
        </select>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3">{t['admin.settings.currencies.column.code']}</th>
            <th class="px-5 py-3">{t['admin.settings.currencies.column.name']}</th>
            <th class="px-5 py-3 text-center">{t['admin.settings.currencies.column.symbol']}</th>
            <th class="px-5 py-3 text-center">{t['admin.settings.currencies.column.rate']}</th>
            <th class="px-5 py-3">{t['admin.settings.currencies.column.lastUpdate']}</th>
            <th class="px-5 py-3">{t['admin.settings.currencies.column.status']}</th>
            <th class="px-5 py-3 text-right">{t['admin.settings.currencies.column.actions']}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {currencies.map((currency) => (
            <tr class="group hover:bg-slate-50/50">
              <td class="px-5 py-3 font-mono text-sm font-bold text-slate-900">{currency.code}</td>
              <td class="px-5 py-3 text-sm text-slate-700">{currency.name}</td>
              <td class="px-5 py-3 text-center font-mono text-base text-slate-700">
                {currency.symbol}
              </td>
              <td class="px-5 py-3 text-center">
                <span
                  class:list={[
                    'inline-flex min-w-[3.5rem] items-center justify-center rounded-md px-2 py-0.5 text-sm font-semibold',
                    currency.code === 'NIO'
                      ? 'bg-slate-100 text-slate-700'
                      : 'bg-emerald-50 text-emerald-700',
                  ]}
                >
                  {currency.rate.toFixed(currency.rate < 1 ? 4 : 2)}
                </span>
              </td>
              <td class="px-5 py-3 text-xs text-slate-500">{formatDate(currency.lastUpdate)}</td>
              <td class="px-5 py-3">
                <span
                  class:list={[
                    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                    currency.isActive
                      ? 'bg-emerald-100 text-emerald-700'
                      : 'bg-slate-100 text-slate-500',
                  ]}
                >
                  {currency.isActive
                    ? t['admin.settings.currencies.status.active']
                    : t['admin.settings.currencies.status.inactive']}
                </span>
              </td>
              <td class="px-5 py-3 text-right">
                <button
                  type="button"
                  class="rounded-md px-2 py-1 text-xs text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                >
                  ⚙
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
