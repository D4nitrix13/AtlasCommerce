---
/**
 * Impuestos — admin (F5.5).
 *
 * Tabla de tasas por país (8 entries: Nicaragua con sus
 * regiones + 3 países de la región + 2 internacionales). Header
 * con toggle "Precios incluyen impuestos" + tasa por defecto.
 *
 * Out-of-scope (F5.5): la edición inline de tasas se hace con
 * inputs nativos; el submit es un stub.
 *
 * **AGENTS.md §1**: ~120 líneas — header + toggle + tabla.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface TaxRate {
  id: string;
  countryCode: string;
  countryName: string;
  region: string;
  rate: number;
  appliesToShipping: boolean;
  updatedAt: string;
}

const taxRates: readonly TaxRate[] = [
  { id: 'tx-001', countryCode: 'NI', countryName: 'Nicaragua', region: 'Managua', rate: 15, appliesToShipping: false, updatedAt: '2026-09-15' },
  { id: 'tx-002', countryCode: 'NI', countryName: 'Nicaragua', region: 'León', rate: 15, appliesToShipping: false, updatedAt: '2026-09-15' },
  { id: 'tx-003', countryCode: 'NI', countryName: 'Nicaragua', region: 'Granada', rate: 15, appliesToShipping: false, updatedAt: '2026-09-15' },
  { id: 'tx-004', countryCode: 'NI', countryName: 'Nicaragua', region: 'Estelí', rate: 15, appliesToShipping: false, updatedAt: '2026-09-15' },
  { id: 'tx-005', countryCode: 'CR', countryName: 'Costa Rica', region: 'San José', rate: 13, appliesToShipping: true, updatedAt: '2026-09-10' },
  { id: 'tx-006', countryCode: 'HN', countryName: 'Honduras', region: 'Tegucigalpa', rate: 15, appliesToShipping: false, updatedAt: '2026-09-08' },
  { id: 'tx-007', countryCode: 'GT', countryName: 'Guatemala', region: 'Guatemala', rate: 12, appliesToShipping: true, updatedAt: '2026-09-08' },
  { id: 'tx-008', countryCode: 'US', countryName: 'Estados Unidos', region: 'Florida', rate: 7, appliesToShipping: false, updatedAt: '2026-08-25' },
];

const formatDate = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-NI', { day: '2-digit', month: 'short', year: 'numeric' });
};
---

<AdminLayout title={`${t['admin.settings.taxes.title']} | Admin`}>
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">
      {t['admin.settings.taxes.title']}
    </h1>
    <p class="mt-1 text-sm text-slate-500">{t['admin.settings.taxes.subtitle']}</p>
  </div>

  <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <label for="default-rate" class="text-sm font-medium text-slate-700">
          {t['admin.settings.taxes.defaultRate']}
        </label>
        <div class="mt-1.5 flex items-center gap-2">
          <input
            id="default-rate"
            type="number"
            min="0"
            max="100"
            step="0.5"
            value="15"
            class="block w-24 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
          />
          <span class="text-sm text-slate-500">%</span>
        </div>
      </div>
      <div>
        <label class="flex cursor-pointer items-start gap-3">
          <input
            type="checkbox"
            checked
            class="mt-1 h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
          />
          <span>
            <span class="text-sm font-medium text-slate-700">
              {t['admin.settings.taxes.taxIncluded']}
            </span>
            <span class="block text-xs text-slate-500">
              {t['admin.settings.taxes.taxIncludedHelp']}
            </span>
          </span>
        </label>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
      <h2 class="text-base font-bold text-slate-950">Tasas por país</h2>
      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-slate-800"
      >
        <span aria-hidden="true">+</span>
        <span>{t['admin.settings.taxes.addCountry']}</span>
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3">{t['admin.settings.taxes.column.country']}</th>
            <th class="px-5 py-3">{t['admin.settings.taxes.column.region']}</th>
            <th class="px-5 py-3 text-center">{t['admin.settings.taxes.column.rate']}</th>
            <th class="px-5 py-3 text-center">{t['admin.settings.taxes.column.appliesToShipping']}</th>
            <th class="px-5 py-3">{t['admin.settings.taxes.column.updatedAt']}</th>
            <th class="px-5 py-3 text-right">{t['admin.settings.taxes.column.actions']}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            taxRates.map((row) => (
              <tr class="group hover:bg-slate-50/50">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-slate-500">{row.countryCode}</span>
                    <span class="font-medium text-slate-900">{row.countryName}</span>
                  </div>
                </td>
                <td class="px-5 py-3 text-sm text-slate-600">{row.region}</td>
                <td class="px-5 py-3 text-center">
                  <div class="inline-flex items-center gap-1">
                    <input
                      type="number"
                      min="0"
                      max="100"
                      step="0.5"
                      value={row.rate}
                      class="block w-16 rounded-md border border-slate-200 bg-white px-2 py-1 text-center text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
                    />
                    <span class="text-xs text-slate-500">%</span>
                  </div>
                </td>
                <td class="px-5 py-3 text-center">
                  <input
                    type="checkbox"
                    checked={row.appliesToShipping}
                    class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
                  />
                </td>
                <td class="px-5 py-3 text-xs text-slate-500">{formatDate(row.updatedAt)}</td>
                <td class="px-5 py-3 text-right">
                  <button
                    type="button"
                    class="rounded-md px-2 py-1 text-xs text-slate-500 transition hover:bg-slate-100 hover:text-rose-600"
                  >
                    ✕
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50/50 px-5 py-3">
      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3.5 py-1.5 text-sm font-medium text-white transition hover:bg-emerald-700"
      >
        {t['admin.settings.taxes.save']}
      </button>
    </div>
  </section>
</AdminLayout>
