---
/**
 * Página admin de tiendas (RF-STOR-132).
 *
 * Wrapper Astro que monta el React island `StoresAdmin`. La lógica
 * de fetch + toggle de mantenimiento vive en el componente.
 *
 * Permiso: el backend filtra por tenant via `accessibleStoreIds()` y
 * `CheckPermission` middleware. El frontend sólo confía en la respuesta.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import StoresAdmin from '../../../../../components/admin/stores/StoresAdmin';
---

<AdminLayout title="Stores | Admin">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">Tiendas</h1>
    <p class="mt-1 text-sm text-slate-500">Gestionar tiendas y modo mantenimiento.</p>
  </div>

  <StoresAdmin locale={Astro.locals.locale} client:only="react" />
</AdminLayout>
