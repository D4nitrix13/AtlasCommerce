---
/**
 * `/[locale]/admin/` — Dashboard v3 (Bonfire mockup 11).
 *
 * Wrapper del shell del dashboard v3. La composición real vive en
 * `<DashboardV3Section>` para que tanto `/admin/` como
 * `/admin/dashboard/` la compartan sin duplicar imports/mocks/props.
 *
 * Auth: el `AdminLayout` ya monta `<AuthGuard client:load />` que
 * redirige a /account/login si el usuario no esta autenticado,
 * y a /account si el user autenticado no es admin/staff (defensa
 * en profundidad — el backend ya filtra en F0.1).
 *
 * **AGENTS.md §1** (<400 lineas): page es composicion pura.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DashboardV3Section from '../../../components/admin/dashboard/DashboardV3Section.astro';
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
---

<AdminLayout title={`${t['admin.dashboard.v3.title']} · Admin`}>
  <DashboardV3Section t={t} />
</AdminLayout>
