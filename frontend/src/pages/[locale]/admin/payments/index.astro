---
/**
 * Hub de Pagos — admin (F5.6).
 *
 * Dashboard con 4 KPIs (procesado, fees, refunds, tasa de éxito) +
 * tabla de pagos recientes (8 items del mock). Sigue el patrón F5.5
 * de `/admin/dashboard`: MetricCard inline en la página + tabla al pie.
 *
 * Out-of-scope F5.6: gráficos de tendencia. Se queda en tabla plana para
 * mantener el archivo bajo 400 líneas (AGENTS §1).
 *
 * **AGENTS.md §1**: ~150 líneas — header + 4 KPIs + tabla recent.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { getServerDictionary } from '../../../../i18n/server';
import { recentPayments, type PaymentStatus } from '../../../../data/payments-mock';

const t = getServerDictionary(Astro.locals.locale);

interface MetricCardData {
  title: string;
  value: string;
  hint: string;
  icon: string;
  accent: 'emerald' | 'amber' | 'rose' | 'sky';
}

const metrics: MetricCardData[] = [
  {
    title: t['admin.payments.hub.processed'],
    value: '$48,295',
    hint: t['admin.payments.hub.processedHint'],
    icon: 'banknotes',
    accent: 'emerald',
  },
  {
    title: t['admin.payments.hub.fees'],
    value: '$1,418',
    hint: t['admin.payments.hub.feesHint'],
    icon: 'chart-bar',
    accent: 'amber',
  },
  {
    title: t['admin.payments.hub.refunds'],
    value: '$1,820',
    hint: t['admin.payments.hub.refundsHint'],
    icon: 'arrow-path',
    accent: 'rose',
  },
  {
    title: t['admin.payments.hub.successRate'],
    value: '96.4%',
    hint: t['admin.payments.hub.successRateHint'],
    icon: 'shield-check',
    accent: 'sky',
  },
];

const accentClass: Record<MetricCardData['accent'], string> = {
  emerald: 'bg-emerald-50 text-emerald-600',
  amber: 'bg-amber-50 text-amber-600',
  rose: 'bg-rose-50 text-rose-600',
  sky: 'bg-sky-50 text-sky-600',
};

const STATUS_BADGE: Record<PaymentStatus, string> = {
  authorized: 'bg-sky-100 text-sky-700',
  captured: 'bg-emerald-100 text-emerald-700',
  refunded: 'bg-amber-100 text-amber-700',
  failed: 'bg-rose-100 text-rose-700',
};

const STATUS_LABEL_KEY: Record<PaymentStatus, `admin.payments.status.${PaymentStatus}`> = {
  authorized: 'admin.payments.status.authorized',
  captured: 'admin.payments.status.captured',
  refunded: 'admin.payments.status.refunded',
  failed: 'admin.payments.status.failed',
};

const formatAmount = (cents: number): string => {
  const dollars = cents / 100;
  return new Intl.NumberFormat('es-NI', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 2,
  }).format(dollars);
};

const formatTimestamp = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleString('es-NI', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });
};
---

<AdminLayout title={`${t['admin.payments.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">{t['admin.payments.title']}</h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.payments.subtitle']}</p>
    </div>
    <a
      href="/admin/payments/methods"
      class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500"
    >
      <Icon name="cog-6-tooth" class="h-4 w-4" />
      <span>{t['admin.payments.methods.title']}</span>
    </a>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {metrics.map((metric) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <div
            class:list={[
              'grid h-10 w-10 place-items-center rounded-xl',
              accentClass[metric.accent],
            ]}
          >
            <Icon name={metric.icon} class="h-5 w-5" />
          </div>
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{metric.title}</p>
            <p class="mt-0.5 text-2xl font-bold tracking-tight text-slate-950">{metric.value}</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-slate-500">{metric.hint}</p>
      </article>
    ))}
  </section>

  <section class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
      <h2 class="text-base font-bold text-slate-950">{t['admin.payments.hub.recent.heading']}</h2>
      <a
        href="/admin/payments/methods"
        class="text-xs font-medium text-slate-500 transition hover:text-slate-900"
      >
        {t['admin.payments.hub.recent.viewAll']} →
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3">{t['admin.payments.hub.recent.column.order']}</th>
            <th class="px-5 py-3">{t['admin.payments.hub.recent.column.method']}</th>
            <th class="px-5 py-3 text-right">{t['admin.payments.hub.recent.column.amount']}</th>
            <th class="px-5 py-3">{t['admin.payments.hub.recent.column.status']}</th>
            <th class="px-5 py-3">{t['admin.payments.hub.recent.column.createdAt']}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {recentPayments.map((payment) => (
            <tr class="group hover:bg-slate-50/50">
              <td class="px-5 py-3 font-mono text-xs font-bold text-slate-700">
                {payment.orderNumber}
              </td>
              <td class="px-5 py-3 text-sm text-slate-700">
                {payment.methodName}
                <span class="ml-2 font-mono text-[10px] text-slate-400">{payment.methodCode}</span>
              </td>
              <td class="px-5 py-3 text-right font-semibold text-slate-900">
                {formatAmount(payment.amountCents)}
              </td>
              <td class="px-5 py-3">
                <span
                  class:list={[
                    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                    STATUS_BADGE[payment.status],
                  ]}
                >
                  {t[STATUS_LABEL_KEY[payment.status]]}
                </span>
              </td>
              <td class="px-5 py-3 text-xs text-slate-500">
                <time datetime={payment.createdAt}>{formatTimestamp(payment.createdAt)}</time>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
