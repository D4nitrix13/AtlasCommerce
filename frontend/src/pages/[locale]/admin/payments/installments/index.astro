---
/**
 * Cuotas sin/con interés — admin (F5.6).
 *
 * Tabla de configuración de installments (5 items del mock: 3 sin
 * interés, 2 con recargo). Cada fila muestra número de cuotas +
 * recargo % + monto mín/máx + estado + acciones.
 *
 * Patrón Shopify Admin: badge semántico para recargo (0% = emerald,
 * hasta 10% = sky, hasta 20% = amber, >20% = rose). La columna de
 * monto máx muestra "Sin tope" cuando es null.
 *
 * **AGENTS.md §1**: ~180 líneas — header + tabla + badges.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { installmentOptions } from '../../../../../data/payments-mock';

const t = getServerDictionary(Astro.locals.locale);

const formatAmount = (cents: number): string => {
  return new Intl.NumberFormat('es-NI', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(cents / 100);
};

/**
 * Surcharge tier: 0 = sin interés (promo bancaria), >0..10 = bajo,
 * >10..20 = medio, >20 = alto. Devuelve clase Tailwind.
 */
const surchargeClass = (percent: number): string => {
  if (percent === 0) return 'bg-emerald-100 text-emerald-700';
  if (percent <= 10) return 'bg-sky-100 text-sky-700';
  if (percent <= 20) return 'bg-amber-100 text-amber-700';
  return 'bg-rose-100 text-rose-700';
};

const hasOptions = installmentOptions.length > 0;
---

<AdminLayout title={`${t['admin.payments.installments.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.payments.installments.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.payments.installments.subtitle']}</p>
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500"
    >
      <span aria-hidden="true">+</span>
      <span>{t['admin.payments.installments.create']}</span>
    </button>
  </div>

  {hasOptions ? (
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3 text-center">
                {t['admin.payments.installments.column.installments']}
              </th>
              <th class="px-5 py-3 text-center">
                {t['admin.payments.installments.column.surcharge']}
              </th>
              <th class="px-5 py-3 text-right">
                {t['admin.payments.installments.column.minAmount']}
              </th>
              <th class="px-5 py-3 text-right">
                {t['admin.payments.installments.column.maxAmount']}
              </th>
              <th class="px-5 py-3">{t['admin.payments.installments.column.status']}</th>
              <th class="px-5 py-3 text-right">
                {t['admin.payments.installments.column.actions']}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {installmentOptions.map((option) => (
              <tr class="group hover:bg-slate-50/50">
                <td class="px-5 py-3 text-center">
                  <span class="text-2xl font-bold tracking-tight text-slate-950">
                    {option.installments}
                  </span>
                  <span class="ml-1 text-xs text-slate-500">x</span>
                </td>
                <td class="px-5 py-3 text-center">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                      surchargeClass(option.surchargePercent),
                    ]}
                  >
                    {option.surchargePercent === 0
                      ? '0% (sin interés)'
                      : `+${option.surchargePercent.toFixed(1)}%`}
                  </span>
                </td>
                <td class="px-5 py-3 text-right font-mono text-sm text-slate-700">
                  {formatAmount(option.minAmountCents)}
                </td>
                <td class="px-5 py-3 text-right font-mono text-sm text-slate-700">
                  {option.maxAmountCents === null ? '—' : formatAmount(option.maxAmountCents)}
                </td>
                <td class="px-5 py-3">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
                      option.isActive
                        ? 'bg-emerald-100 text-emerald-700'
                        : 'bg-slate-100 text-slate-500',
                    ]}
                  >
                    {option.isActive
                      ? t['admin.payments.installments.status.active']
                      : t['admin.payments.installments.status.inactive']}
                  </span>
                </td>
                <td class="px-5 py-3 text-right">
                  <button
                    type="button"
                    class:list={[
                      'inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium transition focus:outline-none focus-visible:ring-2',
                      option.isActive
                        ? 'text-slate-500 hover:bg-slate-100 hover:text-rose-600 focus-visible:ring-slate-300'
                        : 'text-slate-500 hover:bg-slate-100 hover:text-emerald-600 focus-visible:ring-slate-300',
                    ]}
                    aria-label={`${option.isActive ? t['admin.payments.installments.status.inactive'] : t['admin.payments.installments.status.active']}: ${option.installments}x`}
                  >
                    {option.isActive
                      ? t['admin.payments.installments.status.inactive']
                      : t['admin.payments.installments.status.active']}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <p class="text-sm font-medium text-slate-700">{t['admin.payments.installments.empty']}</p>
    </div>
  )}
</AdminLayout>
