---
/**
 * Detalle de un cupón — admin (F5.5).
 *
 * Ruta dinámica `/admin/marketing/coupons/[id]`. Astro resuelve `id`
 * desde `Astro.params`, lo busca en el mock y renderiza:
 *   - Header con código + status pill + acciones
 *   - Métricas de rendimiento (canjes, ingresos, descuento promedio)
 *   - Sección de detalle (vigencia, mínimo, descripción)
 *
 * **AGENTS.md §1**: ~110 líneas — header + métricas + detail section.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Icon from '../../../../../components/ui/Icon.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { coupons, type CouponStatus } from '../../../../../data/marketing-mock';

const t = getServerDictionary(Astro.locals.locale);

const { id } = Astro.params;
const coupon = coupons.find((c) => c.id === id);

const STATUS_LABEL_KEY: Record<
  CouponStatus,
  | 'admin.marketing.coupons.status.active'
  | 'admin.marketing.coupons.status.scheduled'
  | 'admin.marketing.coupons.status.expired'
  | 'admin.marketing.coupons.status.exhausted'
> = {
  active: 'admin.marketing.coupons.status.active',
  scheduled: 'admin.marketing.coupons.status.scheduled',
  expired: 'admin.marketing.coupons.status.expired',
  exhausted: 'admin.marketing.coupons.status.exhausted',
};

const STATUS_BADGE: Record<CouponStatus, string> = {
  active: 'bg-emerald-100 text-emerald-700',
  scheduled: 'bg-sky-100 text-sky-700',
  expired: 'bg-slate-100 text-slate-500',
  exhausted: 'bg-rose-100 text-rose-700',
};

const formatDate = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-NI', { day: '2-digit', month: 'long', year: 'numeric' });
};

// Stats mock determinísticas derivadas del usageCount.
const computeStats = (count: number) => {
  const avgDiscount = count > 0 ? Math.round(count * 4.2) / 10 : 0;
  const revenue = count * 32;
  return { avgDiscount, revenue };
};

const stats = coupon ? computeStats(coupon.usageCount) : null;
---

<AdminLayout title={`${coupon?.code ?? t['admin.marketing.coupons.detail.notFound']} | Admin`}>
  <a
    href="/admin/marketing/coupons"
    class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-900"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    {t['admin.marketing.coupons.detail.back']}
  </a>

  {!coupon && (
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center">
      <p class="text-base font-semibold text-rose-900">
        {t['admin.marketing.coupons.detail.notFound']}
      </p>
    </div>
  )}

  {coupon && stats && (
    <>
      <header class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <div class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 to-sky-500 font-mono text-xl font-bold text-white">
              %
            </div>
            <div>
              <h1 class="font-mono text-2xl font-bold tracking-wider text-slate-950">
                {coupon.code}
              </h1>
              <p class="mt-1 text-sm text-slate-500">{coupon.description}</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span
              class:list={[
                'inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider',
                STATUS_BADGE[coupon.status],
              ]}
            >
              {t[STATUS_LABEL_KEY[coupon.status]]}
            </span>
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50"
            >
              {t['admin.marketing.coupons.detail.edit']}
            </button>
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-700 transition hover:bg-rose-100"
            >
              {t['admin.marketing.coupons.detail.deactivate']}
            </button>
          </div>
        </div>
      </header>

      <section class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.marketing.coupons.detail.stats.redemptions']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">{coupon.usageCount}</p>
          {coupon.usageLimit !== null && (
            <p class="mt-1 text-xs text-slate-500">
              de {coupon.usageLimit} ({Math.round((coupon.usageCount / coupon.usageLimit) * 100)}%)
            </p>
          )}
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.marketing.coupons.detail.stats.revenue']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">
            ${stats.revenue.toLocaleString('es-NI')}
          </p>
          <p class="mt-1 text-xs text-slate-500">en órdenes con cupón</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
            {t['admin.marketing.coupons.detail.stats.avgDiscount']}
          </p>
          <p class="mt-2 text-3xl font-bold text-slate-950">${stats.avgDiscount}</p>
          <p class="mt-1 text-xs text-slate-500">por canje</p>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-base font-bold text-slate-950">Configuración</h2>
        <dl class="grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {t['admin.marketing.coupons.detail.fields.discount']}
            </dt>
            <dd class="mt-1 text-sm font-semibold text-slate-900">
              {coupon.discountType === 'percentage'
                ? `${coupon.discountValue}%`
                : coupon.discountType === 'fixed_amount'
                  ? `$${coupon.discountValue}`
                  : t['admin.marketing.coupons.card.free']}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {t['admin.marketing.coupons.detail.fields.minSubtotal']}
            </dt>
            <dd class="mt-1 text-sm font-semibold text-slate-900">
              {coupon.minSubtotal !== null ? `$${coupon.minSubtotal}` : '—'}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {t['admin.marketing.coupons.detail.fields.validity']}
            </dt>
            <dd class="mt-1 text-sm font-semibold text-slate-900">
              {formatDate(coupon.validFrom)} → {formatDate(coupon.validUntil)}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {t['admin.marketing.coupons.detail.fields.usageLimit']}
            </dt>
            <dd class="mt-1 text-sm font-semibold text-slate-900">
              {coupon.usageLimit !== null ? coupon.usageLimit : '—'}
            </dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {t['admin.marketing.coupons.detail.fields.description']}
            </dt>
            <dd class="mt-1 text-sm text-slate-700">{coupon.description}</dd>
          </div>
        </dl>
      </section>
    </>
  )}
</AdminLayout>
