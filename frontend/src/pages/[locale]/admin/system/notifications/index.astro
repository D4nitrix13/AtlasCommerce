---
/**
 * Notificaciones — admin (F5.5).
 *
 * Centro de notificaciones del panel admin. Renderiza dos secciones:
 *   1. Notificaciones recientes (lista de eventos con icono + timestamp)
 *   2. Preferencias de canales (tabla email vs in-app por tipo)
 *
 * Patrón: usa `<Badge variant="primary">` con el kind como label —
 * sigue la convención de RecentActivityCard del dashboard.
 *
 * **AGENTS.md §1**: ~140 líneas — header + 2 sections.
 *
 * **i18n**: todas las labels y labels de cada kind localizadas.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import Icon from '../../../../../components/ui/Icon.astro';
import Badge from '../../../../../components/ui/Badge.astro';
import { getServerDictionary } from '../../../../../i18n/server';
import { systemNotifications, notificationPreferences } from '../../../../../data/system-mock';

const t = getServerDictionary(Astro.locals.locale);

const KIND_ICON: Record<string, string> = {
  orderPlaced: 'shopping-cart',
  returnRequest: 'arrow-uturn-left',
  ticketReply: 'chat-bubble-left-right',
  lowStock: 'archive-box',
};

const KIND_ACCENT: Record<string, string> = {
  orderPlaced: 'bg-emerald-50 text-emerald-600',
  returnRequest: 'bg-amber-50 text-amber-600',
  ticketReply: 'bg-sky-50 text-sky-600',
  lowStock: 'bg-rose-50 text-rose-600',
};

function formatTimeAgo(iso: string): string {
  const date = new Date(iso);
  const now = new Date('2026-09-26T10:00:00Z').getTime();
  const diffMs = now - date.getTime();
  const diffMin = Math.floor(diffMs / 60000);
  if (diffMin < 1) return 'ahora';
  if (diffMin < 60) return `${diffMin} min`;
  const diffHr = Math.floor(diffMin / 60);
  if (diffHr < 24) return `${diffHr} h`;
  const diffDays = Math.floor(diffHr / 24);
  return `${diffDays} d`;
}

const unreadCount = systemNotifications.filter((n) => !n.isRead).length;
const hasNotifications = notificationPreferences.length > 0;
---

<AdminLayout title={`${t['admin.system.notifications.title']} | Admin`}>
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950">
        {t['admin.system.notifications.title']}
      </h1>
      <p class="mt-1 text-sm text-slate-500">{t['admin.system.notifications.subtitle']}</p>
    </div>
    {unreadCount > 0 && (
      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
      >
        <Icon name="check" class="h-4 w-4" />
        <span>{t['admin.system.notifications.markAllRead']}</span>
      </button>
    )}
  </div>

  <section
    aria-labelledby="notifications-recent-heading"
    class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
  >
    <header class="mb-4 flex items-baseline justify-between">
      <div>
        <h2 id="notifications-recent-heading" class="text-base font-semibold text-slate-900">
          {t['admin.system.notifications.recent.heading']}
        </h2>
        <p class="mt-0.5 text-xs text-slate-500">
          {t['admin.system.notifications.recent.subtitle']}
        </p>
      </div>
      {unreadCount > 0 && (
        <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
          {unreadCount} nuevas
        </span>
      )}
    </header>

    {systemNotifications.length === 0 ? (
      <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-500">
        {t['admin.system.notifications.empty']}
      </p>
    ) : (
      <ol class="divide-y divide-slate-100">
        {systemNotifications.map((notification) => (
          <li
            class:list={[
              'flex items-start gap-3 py-3',
              !notification.isRead && 'bg-emerald-50/30 -mx-5 px-5',
            ]}
          >
            <div
              class:list={[
                'grid h-9 w-9 shrink-0 place-items-center rounded-xl',
                KIND_ACCENT[notification.kind],
              ]}
              aria-hidden="true"
            >
              <Icon name={KIND_ICON[notification.kind]} class="h-4 w-4" />
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-2">
                <p class="truncate text-sm font-semibold text-slate-900">{notification.title}</p>
                <span class="shrink-0 text-xs text-slate-400">
                  {formatTimeAgo(notification.createdAt)}
                </span>
              </div>
              <p class="mt-0.5 text-sm text-slate-600">{notification.body}</p>
              <div class="mt-1.5 flex items-center gap-2">
                <Badge variant="neutral">
                  {t[`admin.system.notifications.kind.${notification.kind}`]}
                </Badge>
                {!notification.isRead && (
                  <span
                    class="inline-block h-2 w-2 rounded-full bg-emerald-500"
                    aria-hidden="true"
                  />
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section
    aria-labelledby="notifications-preferences-heading"
    class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
  >
    <header class="mb-4">
      <h2 id="notifications-preferences-heading" class="text-base font-semibold text-slate-900">
        {t['admin.system.notifications.preferences.heading']}
      </h2>
      <p class="mt-0.5 text-xs text-slate-500">
        {t['admin.system.notifications.preferences.subtitle']}
      </p>
    </header>

    {hasNotifications ? (
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">
                Tipo de evento
              </th>
              <th scope="col" class="px-4 py-3 text-center font-medium">
                {t['admin.system.notifications.channel.email']}
              </th>
              <th scope="col" class="px-4 py-3 text-center font-medium">
                {t['admin.system.notifications.channel.inApp']}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {(['orderPlaced', 'returnRequest', 'ticketReply', 'lowStock'] as const).map((kind) => (
              <tr>
                <td class="px-4 py-3 text-slate-700">
                  {t[`admin.system.notifications.kind.${kind}`]}
                </td>
                {notificationPreferences.map((pref) => (
                  <td class="px-4 py-3 text-center">
                    {pref[kind] ? (
                      <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                        <Icon name="check" class="h-3 w-3" />
                      </span>
                    ) : (
                      <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x-mark" class="h-3 w-3" />
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-500">
        {t['admin.system.notifications.empty']}
      </p>
    )}
  </section>
</AdminLayout>
