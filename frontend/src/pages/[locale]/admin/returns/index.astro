---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ReturnsAdmin from '../../../../components/admin/returns/ReturnsAdmin';
import es from '../../../../i18n/locales/es';
---

<AdminLayout title={es['admin.returns.title'] + ' · Admin'}>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">{es['admin.returns.title']}</h1>
    <p class="mt-1 text-sm text-slate-500">{es['admin.returns.subtitle']}</p>
  </div>

  <ReturnsAdmin client:load />
</AdminLayout>
