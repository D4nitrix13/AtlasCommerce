---
/**
 * Hub de Compras B2B — admin (F5.5).
 *
 * Página de aterrizaje para el módulo de compras. Renderiza 4 KPI
 * cards + 2 secciones con links a los listados de suppliers y orders.
 *
 * Patrón Shopify Admin: cards de hub con icono + título + hint + link.
 *
 * **AGENTS.md §1**: ~80 líneas — header + 4 cards + 2 quick links.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MetricCard from '../../../../components/admin/dashboard/MetricCard.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { getServerDictionary, getServerLocale } from '../../../../i18n/server';
import { adminUrl } from '../../../../lib/path-helpers';
import { suppliers, purchaseOrders } from '../../../../data/purchases-mock';
import { formatCentsAsDecimal } from '../../../../lib/formatters';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const totalPurchasedCents = suppliers.reduce((sum, s) => sum + s.totalPurchasedCents, 0);
const activeSuppliers = suppliers.filter((s) => s.status === 'active').length;
const pendingOrders = purchaseOrders.filter(
  (o) => o.status === 'pending' || o.status === 'approved' || o.status === 'shipped'
).length;

const currentMonthPrefix = '2026-09';
const receivedThisMonth = purchaseOrders.filter(
  (o) => o.receivedAt !== null && o.receivedAt.startsWith(currentMonthPrefix)
);
const receivedThisMonthCents = receivedThisMonth.reduce((sum, o) => sum + o.totalCents, 0);

const totalPurchasedLabel = formatCentsAsDecimal(totalPurchasedCents, 'USD');
const receivedThisMonthLabel = formatCentsAsDecimal(receivedThisMonthCents, 'USD');

const recentSuppliers = [...suppliers]
  .sort((a, b) => b.totalPurchasedCents - a.totalPurchasedCents)
  .slice(0, 5);

const recentOrders = [...purchaseOrders]
  .sort((a, b) => b.placedAt.localeCompare(a.placedAt))
  .slice(0, 5);

const suppliersHref = adminUrl(locale, '/purchases/suppliers');
const ordersHref = adminUrl(locale, '/purchases/orders');
---

<AdminLayout title={`${t['admin.purchases.title']} | Admin`}>
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-950">
      {t['admin.purchases.hub.heading']}
    </h1>
    <p class="mt-1 text-sm text-slate-500">{t['admin.purchases.hub.subtitle']}</p>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <MetricCard
      title={t['admin.purchases.hub.card.totalPurchased']}
      value={totalPurchasedLabel}
      change=""
      icon="banknotes"
      accent="emerald"
      vsPreviousLabel={t['admin.purchases.hub.card.totalPurchasedHint']}
    />
    <MetricCard
      title={t['admin.purchases.hub.card.activeSuppliers']}
      value={String(activeSuppliers)}
      change=""
      icon="truck"
      accent="sky"
      vsPreviousLabel={t['admin.purchases.hub.card.activeSuppliersHint']}
    />
    <MetricCard
      title={t['admin.purchases.hub.card.pendingOrders']}
      value={String(pendingOrders)}
      change=""
      icon="clipboard-document-list"
      accent="amber"
      vsPreviousLabel={t['admin.purchases.hub.card.pendingOrdersHint']}
    />
    <MetricCard
      title={t['admin.purchases.hub.card.receivedThisMonth']}
      value={receivedThisMonthLabel}
      change=""
      icon="check"
      accent="emerald"
      vsPreviousLabel={t['admin.purchases.hub.card.receivedThisMonthHint']}
    />
  </section>

  <section class="mt-5 grid gap-5 xl:grid-cols-2">
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <header class="mb-4 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900 sm:text-lg">
          {t['admin.purchases.hub.card.suppliersHeading']}
        </h2>
        <a href={suppliersHref} class="text-sm font-medium text-emerald-600 hover:underline">
          {t['admin.purchases.hub.card.viewSuppliers']} ↗
        </a>
      </header>
      <ul class="divide-y divide-slate-100">
        {recentSuppliers.map((supplier) => (
          <li class="flex items-center justify-between py-2 text-sm">
            <div class="flex flex-col">
              <span class="font-medium text-slate-900">{supplier.name}</span>
              <span class="text-xs text-slate-500">
                {supplier.contactName} · {supplier.country}
              </span>
            </div>
            <span class="font-semibold tabular-nums text-slate-900">
              {formatCentsAsDecimal(supplier.totalPurchasedCents, 'USD')}
            </span>
          </li>
        ))}
      </ul>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <header class="mb-4 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900 sm:text-lg">
          {t['admin.purchases.hub.card.ordersHeading']}
        </h2>
        <a href={ordersHref} class="text-sm font-medium text-emerald-600 hover:underline">
          {t['admin.purchases.hub.card.viewOrders']} ↗
        </a>
      </header>
      <ul class="divide-y divide-slate-100">
        {recentOrders.map((order) => (
          <li class="flex items-center justify-between py-2 text-sm">
            <div class="flex flex-col">
              <span class="font-mono text-xs font-medium text-slate-900">{order.number}</span>
              <span class="text-xs text-slate-500">{order.supplierName}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-semibold tabular-nums text-slate-900">
                {formatCentsAsDecimal(order.totalCents, 'USD')}
              </span>
              <span
                class:list={[
                  'inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
                  order.status === 'pending'
                    ? 'bg-amber-100 text-amber-800'
                    : order.status === 'approved'
                      ? 'bg-sky-100 text-sky-800'
                      : order.status === 'shipped'
                        ? 'bg-violet-100 text-violet-800'
                        : order.status === 'received'
                          ? 'bg-emerald-100 text-emerald-800'
                          : 'bg-slate-100 text-slate-700',
                ]}
              >
                {t[`admin.purchases.orders.status.${order.status}`]}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <section class="mt-6 grid gap-4 lg:grid-cols-2">
    <a
      href={suppliersHref}
      class="group flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
    >
      <div>
        <h3 class="text-base font-bold text-slate-950">{t['admin.purchases.suppliers.title']}</h3>
        <p class="mt-1 text-xs text-slate-500">
          {suppliers.length} {suppliers.length === 1 ? 'proveedor' : 'proveedores'} ·{' '}
          {activeSuppliers} activos
        </p>
      </div>
      <Icon
        name="chevron-right"
        class="h-5 w-5 text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-700"
      />
    </a>
    <a
      href={ordersHref}
      class="group flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
    >
      <div>
        <h3 class="text-base font-bold text-slate-950">{t['admin.purchases.orders.title']}</h3>
        <p class="mt-1 text-xs text-slate-500">
          {purchaseOrders.length} órdenes · {pendingOrders} pendientes
        </p>
      </div>
      <Icon
        name="chevron-right"
        class="h-5 w-5 text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-700"
      />
    </a>
  </section>
</AdminLayout>
