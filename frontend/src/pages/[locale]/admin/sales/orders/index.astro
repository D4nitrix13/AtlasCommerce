---
/**
 * `/[locale]/admin/sales/orders` — Lista de orders admin (Bonfire 12).
 *
 * Wrapper del shell de la pagina. La composición REAL vive en
 * `<OrdersV3Section />`, que replica el mockup Bonfire (vista 12):
 *  - Header (eyebrow "Ventas" + H1 + count)
 *  - Filter card (search + status + date from + date to)
 *  - Bulk actions bar (visible cuando count > 0)
 *  - Tabla con checkboxes + kebab dropdown Ver/Editar/Reembolso
 *  - Pagination numeric 1..N + anterior/sig
 *  - Empty state con CTA "Refrescar"
 *
 * El page hace TODO el trabajo server-side: parsea query params,
 * filtra por status/q/date, computa paginacion. La sección solo
 * compone — misma frontera que DashboardV3Section.
 *
 * Filtros soportados (URL params — back/forward del navegador
 * funciona sin hydration JS, AGENTS §18):
 *  - status (OrderStatus | 'all')
 *  - q (búsqueda por número o nombre de cliente, case-insensitive)
 *  - dateFrom + dateTo (yyyy-mm-dd)
 *  - page (int, default 1)
 *
 * **AGENTS.md §1** (<400 lineas): page es composicion pura.
 * **AGENTS.md §11**: muestra loading/empty sin necesidad — SSR puro,
 * no loading skeleton; error lo renderiza el caller cuando proceda.
 */
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import OrdersV3Section from '../../../../../components/admin/sales/OrdersV3Section.astro';
import { getServerDictionary, getServerLocale } from '../../../../../i18n/server';
import { adminUrl } from '../../../../../lib/path-helpers';
import { getAllOrdersMock, type AdminOrderStatus } from '../../../../../data/sales-mock';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const ALL_ORDERS = getAllOrdersMock();
const PAGE_SIZE = 10;
const CURRENCY_CODE = 'USD';

const ALL_STATUSES = ['all', 'pending', 'processing', 'shipped', 'delivered', 'cancelled'] as const;
type FilterSlug = (typeof ALL_STATUSES)[number];

function parseStatus(value: string | null): FilterSlug {
  if (value === null) return 'all';
  return (ALL_STATUSES as readonly string[]).includes(value) ? (value as FilterSlug) : 'all';
}

const currentStatus = parseStatus(Astro.url.searchParams.get('status'));
const currentQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const currentDateFrom = Astro.url.searchParams.get('dateFrom') ?? '';
const currentDateTo = Astro.url.searchParams.get('dateTo') ?? '';

const currentPageRaw = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(currentPageRaw) && currentPageRaw > 0 ? currentPageRaw : 1;

// ─── Filter pipeline ───────────────────────────────────────────────────
let filtered =
  currentStatus === 'all' ? ALL_ORDERS : ALL_ORDERS.filter((o) => o.status === currentStatus);

if (currentQuery !== '') {
  const needle = currentQuery.toLowerCase();
  filtered = filtered.filter(
    (o) => o.number.toLowerCase().includes(needle) || o.customer.name.toLowerCase().includes(needle)
  );
}

if (currentDateFrom !== '') {
  filtered = filtered.filter((o) => o.date >= currentDateFrom);
}
if (currentDateTo !== '') {
  filtered = filtered.filter((o) => o.date <= currentDateTo);
}

const totalFiltered = filtered.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
const clampedPage = Math.min(currentPage, totalPages);
const startIdx = (clampedPage - 1) * PAGE_SIZE;
const paginatedOrders = filtered.slice(startIdx, startIdx + PAGE_SIZE);
const from = totalFiltered === 0 ? 0 : startIdx + 1;
const to = Math.min(startIdx + PAGE_SIZE, totalFiltered);

const showEmpty = totalFiltered === 0;

// ─── Status labels (i18n ya resuelto) ─────────────────────────────────
const statusLabels: Record<AdminOrderStatus, string> = {
  pending: t['admin.sales.orderStatus.pending'],
  processing: t['admin.sales.orderStatus.processing'],
  shipped: t['admin.sales.orderStatus.shipped'],
  delivered: t['admin.sales.orderStatus.delivered'],
  cancelled: t['admin.sales.orderStatus.cancelled'],
};

// ─── Href builders ─────────────────────────────────────────────────────
const baseHref = adminUrl(locale, '/sales/orders');
const clearFiltersHref = baseHref;

function detailHrefFor(orderId: string): string {
  return adminUrl(locale, `/sales/orders/${orderId}`);
}

function pageHrefFor(page: number): string {
  const params = new URLSearchParams();
  if (currentStatus !== 'all') params.set('status', currentStatus);
  if (currentQuery !== '') params.set('q', currentQuery);
  if (currentDateFrom !== '') params.set('dateFrom', currentDateFrom);
  if (currentDateTo !== '') params.set('dateTo', currentDateTo);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs.length > 0 ? `${baseHref}?${qs}` : baseHref;
}

const prevHref = clampedPage > 1 ? pageHrefFor(clampedPage - 1) : null;
const nextHref = clampedPage < totalPages ? pageHrefFor(clampedPage + 1) : null;
---

<AdminLayout title={t['admin.sales.layout.title']}>
  <OrdersV3Section
    t={t}
    orders={paginatedOrders}
    totalFiltered={totalFiltered}
    currencyCode={CURRENCY_CODE}
    detailHrefFor={detailHrefFor}
    current={{
      query: currentQuery,
      status: currentStatus,
      dateFrom: currentDateFrom,
      dateTo: currentDateTo,
    }}
    clearFiltersHref={clearFiltersHref}
    baseHref={baseHref}
    pagination={{
      currentPage: clampedPage,
      totalPages,
      total: totalFiltered,
      from,
      to,
      prevHref,
      nextHref,
      pageHrefFor,
    }}
    statusLabels={statusLabels}
    showEmpty={showEmpty}
  />
</AdminLayout>
