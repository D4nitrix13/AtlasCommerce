---
/**
 * /rfq/confirmation — Ticket de confirmación post-RFQ (F3.2).
 *
 * Muestra el ticket # + "te respondemos en 24h" + CTAs secundarios
 * (volver al catálogo, ir a dashboard).
 *
 * Accesibilidad (AGENTS §17):
 *   - Página es un milestone de éxito (`role="status"` o aria-live).
 *   - El ticket ID va en un `<code>` semántico.
 *   - Botones son `<a>` reales (no divs).
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import { getServerDictionary } from '../../../i18n/server';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const url = new URL(Astro.request.url);
const ticketParam = url.searchParams.get('ticket');
const ticketNumber = ticketParam ?? `RFQ-${Date.now().toString(36).toUpperCase()}`;
const quotedProduct = url.searchParams.get('producto');
const quotedQuantity = url.searchParams.get('cantidad');

const homeHref = `/${locale}`;
const bulkOrderHref = `/${locale}/bulk-order`;
const rfqHref = `/${locale}/rfq`;
---

<StorefrontLayout title={t['storefront.rfq.confirmation.title']} cartCount={0}>
  <main class="mx-auto w-full max-w-xl px-4 py-16 sm:px-6 sm:py-24">
    <article
      role="status"
      class="overflow-hidden rounded-[1.75rem] bg-white shadow-[0_0_0_1px_var(--line,#e7e5e4),0_28px_50px_-36px_rgba(28,25,23,0.55)]"
    >
      <div aria-hidden="true" class="h-1.5 bg-[var(--primary)]"></div>
      <div class="px-8 py-10 sm:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--primary)]">
          {t['storefront.rfq.confirmation.ticketLabel']}
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl">
          {t['storefront.rfq.confirmation.heading']}
        </h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-stone-600">
          {t['storefront.rfq.confirmation.body']}
        </p>

        <p
          class="mt-8 border-t border-dashed border-stone-300 pt-6 font-display text-3xl tracking-tight text-[var(--ink,#1c1917)]"
          data-testid="rfq-ticket"
        >
          {ticketNumber}
        </p>
        {quotedProduct !== null && quotedProduct !== '' && (
          <p class="mt-3 text-sm font-semibold text-[var(--ink,#1c1917)]">
            {quotedProduct}
            {quotedQuantity !== null && quotedQuantity !== '' ? ` · ${quotedQuantity}` : ''}
          </p>
        )}
        <p class="mt-3 text-sm text-stone-600">{t['storefront.rfq.confirmation.responseTime']}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={homeHref}
            class="inline-flex h-11 items-center justify-center rounded-full bg-[var(--primary)] px-6 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
          >
            {t['storefront.rfq.confirmation.ctaHome']}
          </a>
          <a
            href={bulkOrderHref}
            class="inline-flex h-11 items-center justify-center rounded-full border border-[var(--line,#e7e5e4)] bg-white px-6 text-sm font-semibold text-stone-800 transition hover:bg-stone-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
          >
            {t['storefront.rfq.confirmation.ctaBulk']}
          </a>
        </div>
      </div>
    </article>

    <p class="mt-6 text-center text-xs text-stone-500">
      <a class="font-medium text-[var(--primary)] hover:underline" href={rfqHref}>
        {t['storefront.rfq.confirmation.newRequest']}
      </a>
    </p>
  </main>
</StorefrontLayout>
