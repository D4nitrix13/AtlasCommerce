---
/**
 * /rfq/confirmation — Ticket de confirmación post-RFQ (F3.2).
 *
 * Muestra el ticket # + "te respondemos en 24h" + CTAs secundarios
 * (volver al catálogo, ir a dashboard).
 *
 * Accesibilidad (AGENTS §17):
 *   - Página es un milestone de éxito (`role="status"` o aria-live).
 *   - El ticket ID va en un `<code>` semántico.
 *   - Botones son `<a>` reales (no divs).
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import { getServerDictionary } from '../../../i18n/server';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const url = new URL(Astro.request.url);
const ticketParam = url.searchParams.get('ticket');
const ticketNumber = ticketParam ?? `RFQ-${Date.now().toString(36).toUpperCase()}`;

const homeHref = `/${locale}`;
const bulkOrderHref = `/${locale}/bulk-order`;
const rfqHref = `/${locale}/rfq`;
---

<StorefrontLayout title={t['storefront.rfq.confirmation.title']} cartCount={0}>
  <main class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6">
    <div
      role="status"
      class="rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-white p-8 shadow-sm"
    >
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--primary,#059669)] text-2xl text-white">
          <span aria-hidden="true">✓</span>
        </div>
        <div class="flex-1">
          <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">
            {t['storefront.rfq.confirmation.heading']}
          </h1>
          <p class="mt-2 text-sm text-slate-600 sm:text-base">
            {t['storefront.rfq.confirmation.body']}
          </p>
        </div>
      </div>

      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs uppercase tracking-wide text-slate-500">
          {t['storefront.rfq.confirmation.ticketLabel']}
        </p>
        <p class="mt-1">
          <code
            class="block break-all rounded bg-slate-50 px-3 py-2 text-base font-mono font-semibold text-slate-900"
            data-testid="rfq-ticket"
          >
            {ticketNumber}
          </code>
        </p>
        <p class="mt-3 text-sm text-slate-700">
          {t['storefront.rfq.confirmation.responseTime']}
        </p>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <a
          href={bulkOrderHref}
          class="inline-flex h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-6 text-sm font-semibold text-slate-800 hover:bg-slate-50"
        >
          {t['storefront.rfq.confirmation.ctaBulk']}
        </a>
        <a
          href={homeHref}
          class="inline-flex h-11 items-center justify-center rounded-lg bg-[var(--primary,#059669)] px-6 text-sm font-semibold text-white shadow-sm hover:bg-[var(--primary-hover,#047857)]"
        >
          {t['storefront.rfq.confirmation.ctaHome']}
        </a>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-slate-500">
      <a class="font-medium text-[var(--primary,#059669)] hover:underline" href={rfqHref}>
        {t['storefront.rfq.confirmation.newRequest']}
      </a>
    </p>
  </main>
</StorefrontLayout>
