---
/**
 * /rfq — Request For Quote (B2B Panda Estampados).
 *
 * Layout full-width (sin `max-w` estrecho) siguiendo el design system
 * de `.interface-design/system.md`: canvas papel, tinta, un acento
 * (tenant), panel-resumen estilo recibo con divisor punteado y total
 * display Fraunces.
 *
 * Multi-tenant: colores vía tokens (`--primary`, `--ink`, `--edge`,
 * `--paper-raised`) — sin hex hardcodeados por tenant.
 *
 * Accesibilidad (AGENTS §17):
 *   - Stepper con `<nav aria-label>` + `aria-current="step"`.
 *   - Form con `<fieldset>` por sección + `<legend>`.
 *   - Labels asociados via `for`.
 *
 * Estados (AGENTS §11):
 *   - Submit: button disabled + label cambia vía JS.
 *   - Mock submit: genera ticket ID + redirect a /rfq/confirmation.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import RFQStepper from '../../../components/storefront/b2b/RFQStepper.astro';
import RfqSummaryPanel from '../../../components/storefront/b2b/RfqSummaryPanel.astro';
import { getServerDictionary } from '../../../i18n/server';
import { isPandaStore, PANDA_PRODUCTS } from '../../../data/panda-catalog';
import { PRODUCTS } from '../../../data/products';
import { bulkTotalCents, bulkDiscountPercent } from '../../../lib/bulk-estimate';
import { formatCurrency } from '../../../lib/formatters';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const homeHref = `/${locale}`;
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const catalog = isPandaStore(tenantSlug) ? PANDA_PRODUCTS : PRODUCTS;
const requestedSlug = Astro.url.searchParams.get('product');
const requestedQty = Number.parseInt(Astro.url.searchParams.get('cantidad') ?? '', 10);
const selectedPiece =
  catalog.find((product) => product.slug === requestedSlug) ?? catalog[0];
const initialQuantity = Number.isNaN(requestedQty) ? 100 : Math.min(1000, Math.max(1, requestedQty));
const initialTotal =
  selectedPiece === undefined
    ? '—'
    : formatCurrency(
        bulkTotalCents(selectedPiece.priceCents, initialQuantity),
        selectedPiece.currency ?? 'USD',
      );
const initialDiscountPercent = bulkDiscountPercent(initialQuantity);
const initialUnitPrice =
  selectedPiece === undefined
    ? '—'
    : formatCurrency(selectedPiece.priceCents, selectedPiece.currency ?? 'USD');

const stepperLabels = [
  t['storefront.b2b.rfq.v3.step1.label'],
  t['storefront.b2b.rfq.v3.step2.label'],
  t['storefront.b2b.rfq.v3.step3.label'],
];

/** Clase compartida para inputs/selects/textarea del form. */
const inputClass =
  'block w-full rounded-lg border border-[var(--edge,#e7e5e4)] bg-white px-3.5 py-2.5 text-sm text-[var(--ink,#1c1917)] transition placeholder:text-[var(--ink-faint,#a8a29e)] hover:border-[var(--edge-strong,#d6d3d1)]';

/** Clase de label de campo: 13px/500 ink-soft. */
const labelClass = 'mb-1.5 block text-[13px] font-medium text-[var(--ink-soft,#44403c)]';

/** Clase de legend/section header: micro-label tracked. */
const sectionClass = 'px-1 text-xs font-semibold uppercase tracking-wider text-[var(--ink-muted,#78716c)]';
---

<StorefrontLayout title={`${t['storefront.b2b.rfq.v3.title']} | AtlasCommerce`} cartCount={0}>
  <main class="min-h-screen">
    <section class="w-full px-4 pb-16 pt-10 sm:px-6 lg:px-10">
      {/* Header full-width */}
      <header class="mb-10">
        <span
          class="mb-4 inline-flex items-center rounded-full bg-[var(--primary-soft,#e6f3f1)] px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-[var(--primary,#2D9D8E)]"
          data-testid="rfq-b2b-badge"
        >
          {t['storefront.b2b.rfq.v3.b2bOnly']}
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem]">
          {t['storefront.b2b.rfq.v3.title']}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--ink-muted,#78716c)] sm:text-lg">
          {t['storefront.rfq.subtitle']}
        </p>
      </header>

      {/* Grid: form + receipt summary */}
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
        {/* LEFT: form panel */}
        <div class="paper-card p-6 sm:p-8" data-testid="rfq-card">
          <RFQStepper currentStep={1} labels={stepperLabels} />

          <form id="rfq-form" class="space-y-8" novalidate data-testid="rfq-form" data-reveal>
            {/* Paso 1: detalles del pedido */}
            <fieldset class="space-y-4">
              <legend class={sectionClass}>
                {t['storefront.b2b.rfq.v3.step1.label']}
              </legend>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="rfq-tipo-producto" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step1.tipoProducto']}
                  </label>
                  <select
                    id="rfq-tipo-producto"
                    name="tipoProducto"
                    required
                    class={`${inputClass} cursor-pointer`}
                    data-testid="rfq-tipo-producto"
                  >
                    {catalog.map((product) => (
                      <option
                        value={product.slug}
                        data-price={product.priceCents}
                        data-currency={product.currency ?? 'USD'}
                        selected={product.slug === selectedPiece?.slug}
                      >
                        {product.name}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="rfq-cantidad" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step1.cantidad']}
                  </label>
                  <input
                    id="rfq-cantidad"
                    type="number"
                    name="cantidad"
                    min="1"
                    required
                    placeholder="100"
                    value={initialQuantity}
                    class={inputClass}
                    data-testid="rfq-cantidad"
                  />
                </div>
              </div>

              <div>
                <label for="rfq-tecnica" class={labelClass}>
                  {t['storefront.b2b.rfq.v3.step1.tecnica']}
                </label>
                <select
                  id="rfq-tecnica"
                  name="tecnica"
                  required
                  class={`${inputClass} cursor-pointer`}
                  data-testid="rfq-tecnica"
                >
                  <option value="serigrafia">
                    {t['storefront.b2b.rfq.v3.step1.tecnica.serigrafia']}
                  </option>
                  <option value="sublimacion">
                    {t['storefront.b2b.rfq.v3.step1.tecnica.sublimacion']}
                  </option>
                  <option value="bordado">
                    {t['storefront.b2b.rfq.v3.step1.tecnica.bordado']}
                  </option>
                  <option value="vinilo">{t['storefront.b2b.rfq.v3.step1.tecnica.vinilo']}</option>
                </select>
              </div>

              <div>
                <label for="rfq-descripcion" class={labelClass}>
                  {t['storefront.b2b.rfq.v3.step1.descripcion']}
                </label>
                <textarea
                  id="rfq-descripcion"
                  name="descripcion"
                  rows="4"
                  required
                  class={`${inputClass} resize-none`}
                  data-testid="rfq-descripcion"
                ></textarea>
              </div>

              <div>
                <label for="rfq-fecha" class={labelClass}>
                  {t['storefront.b2b.rfq.v3.step1.fechaRequerida']}
                </label>
                <input
                  id="rfq-fecha"
                  type="date"
                  name="fechaRequerida"
                  required
                  class={inputClass}
                  data-testid="rfq-fecha"
                />
              </div>
            </fieldset>

            <hr class="border-0 border-t border-[var(--edge-soft,#f0eeec)]" />

            {/* Paso 2: datos de contacto */}
            <fieldset class="space-y-4">
              <legend class={sectionClass}>
                {t['storefront.b2b.rfq.v3.step2.label']}
              </legend>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="rfq-nombre" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step2.nombre']}
                  </label>
                  <input
                    id="rfq-nombre"
                    type="text"
                    name="nombre"
                    required
                    autocomplete="name"
                    class={inputClass}
                    data-testid="rfq-nombre"
                  />
                </div>

                <div>
                  <label for="rfq-email" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step2.email']}
                  </label>
                  <input
                    id="rfq-email"
                    type="email"
                    name="email"
                    required
                    autocomplete="email"
                    class={inputClass}
                    data-testid="rfq-email"
                  />
                </div>

                <div>
                  <label for="rfq-telefono" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step2.telefono']}
                  </label>
                  <input
                    id="rfq-telefono"
                    type="tel"
                    name="telefono"
                    required
                    autocomplete="tel"
                    class={inputClass}
                    data-testid="rfq-telefono"
                  />
                </div>

                <div>
                  <label for="rfq-empresa" class={labelClass}>
                    {t['storefront.b2b.rfq.v3.step2.empresa']}
                  </label>
                  <input
                    id="rfq-empresa"
                    type="text"
                    name="empresa"
                    autocomplete="organization"
                    class={inputClass}
                    data-testid="rfq-empresa"
                  />
                </div>
              </div>
            </fieldset>

            <hr class="border-0 border-t border-[var(--edge-soft,#f0eeec)]" />

            {/* Paso 3: revisión */}
            <fieldset class="space-y-3">
              <legend class={sectionClass}>
                {t['storefront.b2b.rfq.v3.step3.label']}
              </legend>
              <p class="text-sm leading-relaxed text-[var(--ink-muted,#78716c)]">
                {t['storefront.rfq.responseTime']}
              </p>
            </fieldset>

            {/* Footer: back + submit */}
            <div class="flex flex-col-reverse items-stretch gap-3 border-t border-[var(--edge-soft,#f0eeec)] pt-6 sm:flex-row sm:items-center sm:justify-between">
              <a
                href={homeHref}
                class="text-sm font-medium text-[var(--ink-muted,#78716c)] transition hover:text-[var(--ink,#1c1917)]"
                data-testid="rfq-back"
              >
                {t['storefront.b2b.rfq.v3.back']}
              </a>
              <button
                type="submit"
                class="pressable inline-flex h-12 items-center justify-center rounded-lg bg-[var(--primary,#2D9D8E)] px-8 text-[15px] font-semibold text-white transition hover:bg-[var(--primary-hover,#258777)] disabled:opacity-60"
                data-testid="rfq-submit"
              >
                {t['storefront.b2b.rfq.v3.submit']}
              </button>
            </div>
          </form>
        </div>

        {/* RIGHT: receipt-style summary panel */}
        <RfqSummaryPanel
          productName={selectedPiece?.name ?? '—'}
          quantity={initialQuantity}
          techniqueLabel={t['storefront.b2b.rfq.v3.step1.tecnica.serigrafia']}
          unitPrice={initialUnitPrice}
          total={initialTotal}
          discountPercent={initialDiscountPercent}
          labels={{
            summary: t['storefront.b2b.rfq.v3.summary'],
            product: t['storefront.b2b.rfq.v3.step1.tipoProducto'],
            quantity: t['storefront.b2b.rfq.v3.step1.cantidad'],
            technique: t['storefront.b2b.rfq.v3.step1.tecnica'],
            unitPrice: t['storefront.b2b.rfq.v3.unitPriceLabel'],
            discount: t['storefront.b2b.rfq.v3.discountLabel'],
            totalLabel: t['storefront.b2b.rfq.v3.totalLabel'],
            responseTime: t['storefront.rfq.responseTime'],
          }}
        />
      </div>

      {/* Bottom notice */}
      <p class="mt-10 text-sm text-[var(--ink-muted,#78716c)]" data-testid="rfq-notice">
        <a
          href={`${homeHref}/account`}
          class="font-medium text-[var(--primary,#2D9D8E)] transition hover:underline"
        >
          {t['storefront.rfq.alreadyCustomer']}
        </a>
      </p>
    </section>
  </main>
</StorefrontLayout>

<script>
  import './rfq-form';
</script>
