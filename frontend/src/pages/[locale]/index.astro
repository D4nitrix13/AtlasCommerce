---
/**
 * Home pública del storefront (`/[locale]/`).
 *
 * F3.1 — Tenant detection.
 * F4.x — Sprint home Bonfire: composición completa para Panda B2B.
 *
 * Resuelve el tenant desde `Astro.locals.tenant?.tenantSlug` y renderiza
 * una composición distinta según el caso:
 *
 *   - `panda-estampados` → home B2B estilo Bonfire:
 *     TenantHero + StatsBar (cifras) + FeaturedCategories +
 *     ProcessSteps (4 pasos Cotiza→Entrega) + ClientLogos (rubros)
 *     + MaterialsCard (materiales y tintas) + CustomerStories
 *     (testimonios con métricas) + FaqAccordion (Q&A operacional).
 *     Total ~9 secciones en scroll largo.
 *   - cualquier otro     → composición B2C Bonfire-adapted:
 *     HomeHero + categorías + productos destacados + UseCases +
 *     CtaBanner de cierre (intacta del sprint F1.4/F4.x anterior).
 *
 * Esto mantiene el comportamiento previo intacto y reemplaza la rama
 * B2B por la nueva forma del plan panda-bonfire-complete.
 *
 * Datos:
 *   - Categorías viven en `data/b2b-mock.ts` (B2B) y `data/products.ts`
 *     (B2C). Stats, process, logos, stories, materials y faq viven en
 *     `data/home-content.ts` como contenido editorial tipado. Cuando el
 *     endpoint `/api/storefront/b2b/home` exista, esa construcción se
 *     mueve a un fetch server-side con la misma shape.
 */
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import HomeHero from '../../components/storefront/home/HomeHero.astro';
import UseCases from '../../components/storefront/home/UseCases.astro';
import CtaBanner from '../../components/storefront/home/CtaBanner.astro';
import FeaturedCategories from '../../components/storefront/home/FeaturedCategories.astro';
import FeaturedProducts from '../../components/storefront/home/FeaturedProducts.astro';
import DarkHeroCardB2C from '../../components/storefront/home/DarkHeroCardB2C.astro';
import CustomerStoriesB2C from '../../components/storefront/home/CustomerStoriesB2C.astro';
import TenantHero from '../../components/storefront/b2b/TenantHero.astro';
import StatsBar from '../../components/storefront/b2b/StatsBar.astro';
import ProcessSteps from '../../components/storefront/b2b/ProcessSteps.astro';
import ClientLogos from '../../components/storefront/b2b/ClientLogos.astro';
import CustomerStories from '../../components/storefront/b2b/CustomerStories.astro';
import FaqAccordion from '../../components/storefront/FaqAccordion.astro';
import MaterialsCard from '../../components/storefront/b2b/MaterialsCard.astro';
import DarkHeroCard from '../../components/storefront/b2b/DarkHeroCard.astro';
import CtaFinal from '../../components/storefront/b2b/CtaFinal.astro';
import { getBrandBySlug } from '../../config/stores';
import { getServerDictionary } from '../../i18n/server';
import { apiFetch } from '../../lib/api';
import { API_ENDPOINTS } from '../../lib/endpoints';
import {
  mapBackendToProduct,
  type StorefrontProductsResponse,
} from '../../lib/backend-product-mapper';
import { CATEGORIES } from '../../data/products';
import { B2B_CATEGORIES } from '../../data/b2b-mock';
import { getUseCasesForTenant } from '../../data/tenants';
import { getHomeContent } from '../../data/home-content';

const locale = Astro.locals.locale ?? 'es';

// Destacados reales desde el API (tenant por host). Si el backend no
// responde, `FeaturedProducts` renderiza su estado vacío honesto
// (emptyLabel/emptyHint): nunca se inventa catálogo.
async function loadFeaturedProducts(): Promise<ReturnType<typeof mapBackendToProduct>[]> {
  try {
    const response = await apiFetch<StorefrontProductsResponse>(
      `${API_ENDPOINTS.storefront.products}?per_page=8`,
      {
        headers: { Accept: 'application/json' },
        origin: Astro.url.origin,
        host: Astro.url.host,
      },
    );
    return response.data.map(mapBackendToProduct);
  } catch (error) {
    console.error('[home] apiFetch featured failed:', error);
    return [];
  }
}

const featuredFromApi = await loadFeaturedProducts();
const t = getServerDictionary(locale);

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const brand = getBrandBySlug(tenantSlug);
const isPandaB2B = brand.slug === 'panda-estampados';

const cartCount = 0;

const productsHref = `/${locale}/products`;
const searchHref = `/${locale}/search`;
const rfqHref = `/${locale}/rfq`;
const bulkOrderHref = `/${locale}/bulk-order`;

const cardLabels = {
  newBadge: t['storefront.productCard.badge.new'],
  saleBadge: t['storefront.productCard.badge.sale'],
  lowStockBadge: t['storefront.productCard.badge.lowStock'],
  addToCart: t['storefront.productCard.addToCart'],
  outOfStock: t['storefront.productCard.outOfStock'],
  viewDetail: t['storefront.productCard.viewDetail'],
};

// Los use cases vienen del data layer como `{ iconKey, labelKey, href }`.
// Acá resolvemos `labelKey` contra el dictionary `t` para producir la
// shape final `{ iconKey, label, href }` que espera `UseCases.astro`.
// El fallback al `labelKey` cubre el caso de una key faltante durante
// el rollout (no se renderiza string vacía).
const rawUseCases = getUseCasesForTenant(tenantSlug);
const localizedUseCases = rawUseCases.map((useCase) => ({
  iconKey: useCase.iconKey,
  label: t[useCase.labelKey] ?? useCase.labelKey,
  href: useCase.href,
}));

// Datos editoriales de las secciones (stats, logos, stories, process,
// materials, faq) viven en `data/home-content.ts`. El copy traducido se
// construye contra `t` al armar el contenido.
const {
  b2bStats,
  b2bProcessSteps,
  b2bClientLogos,
  b2bCustomerStories,
  b2bMaterialsFeatures,
  b2bFaqItems,
  b2cCustomerStories,
} = getHomeContent(t);
---

<StorefrontLayout
  title={isPandaB2B ? t['storefront.b2b.home.hero.title'] : t['storefront.home.hero.title']}
  cartCount={cartCount}
>
  {isPandaB2B ? (
    <>
      <TenantHero
        eyebrow={t['storefront.b2b.home.hero.eyebrow']}
        title={t['storefront.b2b.home.hero.title']}
        subtitle={t['storefront.b2b.home.hero.subtitle']}
        primaryCta={{
          label: t['storefront.b2b.home.hero.ctaPrimary'],
          href: bulkOrderHref,
        }}
        secondaryCta={{
          label: t['storefront.b2b.home.hero.ctaSecondary'],
          href: rfqHref,
        }}
        bullets={[
          { icon: '📦', text: t['storefront.b2b.home.bullet.bulk'] },
          { icon: '📝', text: t['storefront.b2b.home.bullet.rfq'] },
          { icon: '🏢', text: t['storefront.b2b.home.bullet.multiBranch'] },
          { icon: '💳', text: t['storefront.b2b.home.bullet.net30'] },
        ]}
      />

      <StatsBar heading={t['storefront.b2b.home.stats.heading']} stats={b2bStats} />

      <FeaturedCategories
        categories={B2B_CATEGORIES}
        heading={t['storefront.b2b.home.featuredCategories.heading']}
        viewAllLabel={t['storefront.b2b.home.featuredCategories.viewAll']}
        viewAllHref={productsHref}
        badges={{
          'estampados-personalizados': {
            label: t['storefront.b2b.home.featuredCategories.badge.popular'],
          },
          'regalos-corporativos': { label: t['storefront.b2b.home.featuredCategories.badge.new'] },
          sublimacion: {
            label: t['storefront.b2b.home.featuredCategories.badge.eco'],
          },
        }}
      />

      <FeaturedProducts
        products={featuredFromApi.slice(0, 4)}
        locale={locale}
        heading={t['storefront.home.featuredProducts.heading']}
        viewAllLabel={t['storefront.home.featuredProducts.viewAll']}
        viewAllHref={productsHref}
        cardLabels={cardLabels}
        loadingLabel={t['storefront.productGrid.loading']}
        emptyLabel={t['storefront.productGrid.empty']}
        emptyHint={t['storefront.productGrid.emptyHint']}
      />

      <ProcessSteps
        heading={t['storefront.b2b.home.process.heading']}
        subheading={t['storefront.b2b.home.process.subheading']}
        steps={b2bProcessSteps}
      />

      <ClientLogos
        heading={t['storefront.b2b.home.clients.heading']}
        subheading={t['storefront.b2b.home.clients.subheading']}
        logos={b2bClientLogos}
      />

      <MaterialsCard
        heading={t['storefront.b2b.home.materials.heading']}
        eyebrow={t['storefront.b2b.home.materials.eyebrow']}
        body={t['storefront.b2b.home.materials.body']}
        features={b2bMaterialsFeatures}
      />

      <DarkHeroCard
        eyebrow={t['storefront.b2b.home.darkHero.eyebrow']}
        heading={t['storefront.b2b.home.darkHero.heading']}
        body={t['storefront.b2b.home.darkHero.body']}
        ctaLabel={t['storefront.b2b.home.darkHero.ctaLabel']}
        ctaHref={rfqHref}
      />

      <CustomerStories
        heading={t['storefront.b2b.home.stories.heading']}
        subheading={t['storefront.b2b.home.stories.subheading']}
        stories={b2bCustomerStories}
      />

      <FaqAccordion heading={t['storefront.b2b.home.faq.heading']} items={b2bFaqItems} />

      <CtaFinal
        heading={t['storefront.b2b.home.ctaFinal.heading']}
        ctaLabel={t['storefront.b2b.home.ctaFinal.ctaLabel']}
        ctaHref={rfqHref}
      />
    </>
  ) : (
    <>
      <HomeHero
        eyebrow={t['storefront.home.hero.eyebrow']}
        title={t['storefront.home.hero.title']}
        subtitle={t['storefront.home.hero.subtitle']}
        primaryCta={{
          label: t['storefront.home.hero.ctaPrimary'],
          href: productsHref,
        }}
        secondaryCta={{
          label: t['storefront.home.hero.ctaSecondary'],
          href: searchHref,
        }}
        trustBadges={[
          { iconKey: 'shield-check', label: t['storefront.home.trustBadge.riskFree'] },
          { iconKey: 'cube', label: t['storefront.home.trustBadge.noInventory'] },
          { iconKey: 'bolt', label: t['storefront.home.trustBadge.easyUse'] },
        ]}
      />

      <FeaturedCategories
        categories={CATEGORIES}
        heading={t['storefront.home.featuredCategories.heading']}
        viewAllLabel={t['storefront.home.featuredCategories.viewAll']}
        viewAllHref={productsHref}
      />

      <FeaturedProducts
        products={featuredFromApi.slice(0, 4)}
        locale={locale}
        heading={t['storefront.home.featuredProducts.heading']}
        viewAllLabel={t['storefront.home.featuredProducts.viewAll']}
        viewAllHref={productsHref}
        cardLabels={cardLabels}
        loadingLabel={t['storefront.productGrid.loading']}
        emptyLabel={t['storefront.productGrid.empty']}
        emptyHint={t['storefront.productGrid.emptyHint']}
      />

      <DarkHeroCardB2C
        eyebrow={t['storefront.b2c.home.darkHero.eyebrow']}
        heading={t['storefront.b2c.home.darkHero.heading']}
        body={t['storefront.b2c.home.darkHero.body']}
        ctaLabel={t['storefront.b2c.home.darkHero.ctaLabel']}
        ctaHref={productsHref}
      />

      <UseCases
        heading={t['storefront.home.useCases.heading']}
        subheading={t['storefront.home.useCases.subheading']}
        cases={localizedUseCases}
      />

      <CustomerStoriesB2C
        heading={t['storefront.b2c.home.stories.heading']}
        subheading={t['storefront.b2c.home.stories.subheading']}
        stories={b2cCustomerStories}
      />

      <CtaBanner
        heading={t['storefront.home.ctaBanner.label']}
        ctaLabel={t['storefront.home.hero.ctaPrimary']}
        ctaHref={productsHref}
      />
    </>
  )}
</StorefrontLayout>
