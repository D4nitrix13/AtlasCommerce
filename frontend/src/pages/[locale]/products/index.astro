---
/**
 * Lista pública de productos (`/[locale]/products`).
 *
 * Vista 04 (Bonfire): grid con sidebar de filtros + grid de cards
 * + paginación. Tokens: bg-slate-50 / cards rounded-2xl / border-slate-200
 * / hover -translate-y-0.5 + shadow-md.
 *
 * Compone:
 *  - Header: H1 + subtítulo (conteo) a la izquierda, SortDropdown a la derecha.
 *  - Layout lg+ en 2 columnas (sidebar 264px + grid flexible).
 *  - Sidebar: FiltersSidebar con 4 grupos (Categoría, Precio, Color, Talla).
 *  - Grid: 8 ProductCardCatalog con `data-reveal-stagger` para la animación
 *    Bonfire de scroll-driven (script scroll-fx.ts).
 *  - Pagination: Pagination primitive al pie (links SSR-friendly).
 *
 * i18n: todas las strings vienen del dictionary `t[key]` resuelto en
 * SSR; ningún literal hardcoded en la UI.
 *
 * Decisiones:
 *  - **Sin handler de filtros**: la página es presentacional pura. Los
 *    inputs están wireados visualmente (checked/pressed/active) pero
 *    no se hidratan — el handler real queda para F4.x cuando exista
 *    backend paginado. Esto evita un componente React island sólo
 *    para cambiar el query string.
 *  - **Sin `productGrid.*` legacy**: el código previo usaba keys
 *    `productGrid.heading` (todos los productos) con un link-based
 *    filter por categoría. Las nuevas keys son `products.v3.*`,
 *    namespace dedicado para no colisionar.
 *  - **Mock counts**: los counts por filtro vienen del propio mock
 *    PRODUCTS (cálculo client-side). Esto evita un fetch extra.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import ProductCardCatalog from '../../../components/storefront/products/ProductCardCatalog.astro';
import FiltersSidebar from '../../../components/storefront/products/FiltersSidebar.astro';
import SortDropdown from '../../../components/storefront/products/SortDropdown.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { getServerDictionary } from '../../../i18n/server';
import { apiFetch } from '../../../lib/api';
import { API_ENDPOINTS } from '../../../lib/endpoints';
import { LA_VOZ_BRANDS, LA_VOZ_CATEGORIES } from '../../../data/la-voz-mock';
import type { ProductImage, ProductVariant } from '../../../types/catalog';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const cartCount = 0;

// Fetch real del backend: SSR trae la lista de productos visibles
// del tenant actual. El tenant se resuelve via middleware store.domain
// (no se pasa explicitamente). Filtra por is_visible via el controller.
//
// El backend retorna el modelo Eloquent Product (snake_case: image_url,
// base_price_cents, etc). Mapeamos al shape del ProductCardCatalog
// (camelCase + tipos narrowed) para que el render funcione sin tocar
// el componente.
//
// Fase 5 plan v3: storage keys hasheadas via StorageKeyDeriver.
// El frontend las consume via `assetUrl(storage_key)` (lib/asset.ts).
const PAGE_SIZE = 24;
const currentPage = 1;
// Imagen de la galería. OJO: el resource de storefront ya emite estos
// campos en camelCase (`altText`, `isPrimary`, `variantId`, `sortOrder`,
// `srcset`) aunque el product-level venga en snake_case — ver
// `StorefrontProductResource::galleryEntry()`. Sólo hace falta adaptarlos
// al shape de `types/catalog.ts`.
interface BackendProductImage {
  url: string;
  altText: string;
  isPrimary: boolean;
  /** El backend lo emite como int; la card lo compara contra `variants[].id`. */
  variantId: number | string | null;
  sortOrder: number;
  srcset: string;
}

// Variante de acabado. El resource NO expone `sku` (por eso
// `ProductVariant.sku` es opcional en `types/catalog.ts`).
interface BackendProductVariant {
  id: number | string;
  name: string;
  finishSlug: string;
  finishLabel: string;
  finishHex: string | null;
  condition: string;
  stock: number;
  handedness: string | null;
}
// Shape de `StorefrontProductResource` (backend/app/Http/Resources/
// Storefront/StorefrontProductResource.php). OJO: la API emite **camelCase**
// y `category`/`brand` vienen como **string**, no como objeto anidado. Una
// versión anterior de esta interface declaraba snake_case con objetos
// (`base_price_cents`, `category: {slug}`), así que todos esos campos
// llegaban `undefined` y la carta renderizaba `USDNaN` con filtros vacíos.
interface BackendProduct {
  id: number;
  slug: string;
  name: string;
  description: string;
  priceCents: number;
  imageUrl: string | null;
  isExclusive?: boolean;
  stock: number;
  category: string;
  brand?: string;
  images?: BackendProductImage[];
  variants?: BackendProductVariant[];
}
type StorefrontProductsResponse = BackendProduct[];

let apiProducts: BackendProduct[] = [];
try {
  apiProducts = await apiFetch<StorefrontProductsResponse>(
    API_ENDPOINTS.storefront.products + '?per_page=200',
    {
      headers: { 'Accept': 'application/json' },
      // Fallback de URL origin (ya no es el camino feliz — ver
      // INTERNAL_API_ORIGIN en lib/api.ts). Se mantiene para que la
      // página siga funcionando si por algún motivo se levanta el
      // stack dev sin la env var (ej. tests locales, override temporal).
      origin: Astro.url.origin,
      // Override del `Host` header para que el backend pueda resolver
      // el tenant vía middleware `store.domain` cuando el SSR fetch
      // va por el sidecar nginx. Sin esto el backend responde 404
      // "Store not found or inactive". Ver `host?` en lib/api.ts.
      host: Astro.url.host,
    },
  );
} catch (e) {
  // Si el backend no responde, devolvemos lista vacía y el empty state
  // del ProductGrid se renderiza. Log para debugging.
  console.error('[products/index] apiFetch failed:', e);
}

const allProducts = apiProducts.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(allProducts.length / PAGE_SIZE));
const totalProducts = allProducts.length;
const from = totalProducts === 0 ? 0 : 1;
const to = Math.min(PAGE_SIZE, totalProducts);

// Normaliza el id de variante a string. El backend lo emite como int
// tanto en `images[].variantId` como en `variants[].id`, y
// `deriveProductCardSwap` matchea swatch ↔ foto por igualdad estricta
// (Map<string, ...>). Si uno queda number y el otro string, el lookup
// falla en silencio: el swatch pierde su miniatura Y su image-swap.
function normalizeVariantId(raw: number | string | null): string | null {
  if (raw === null) return null;
  return String(raw);
}

function mapBackendImage(image: BackendProductImage): ProductImage {
  return {
    url: image.url,
    altText: image.altText,
    isPrimary: image.isPrimary,
    variantId: normalizeVariantId(image.variantId),
    sortOrder: image.sortOrder,
    srcset: image.srcset,
  };
}

function mapBackendVariant(variant: BackendProductVariant): ProductVariant {
  return {
    // `normalizeVariantId` nunca devuelve null acá (`id` es required),
    // pero el shape lo pide `string`: coalesce explícito, no `as string`.
    id: normalizeVariantId(variant.id) ?? '',
    name: variant.name,
    finishSlug: variant.finishSlug,
    finishLabel: variant.finishLabel,
    finishHex: variant.finishHex,
    condition: variant.condition,
    stock: variant.stock,
    handedness: variant.handedness,
  };
}

// El listado público puede mandar `images` / `variants` ausentes (producto
// recién publicado, todavía sin fotos). El default a array vacío vive acá
// y no en `mapBackendToProduct` para no sumar ramas a una función que ya
// roza el umbral de complejidad.
function mapBackendImages(images: readonly BackendProductImage[] | undefined): ProductImage[] {
  return (images ?? []).map(mapBackendImage);
}

function mapBackendVariants(
  variants: readonly BackendProductVariant[] | undefined,
): ProductVariant[] {
  return (variants ?? []).map(mapBackendVariant);
}

// Adapter backend (snake_case Eloquent) -> frontend (camelCase Product).
// Mapea solo campos que ProductCardCatalog requiere. Si el backend agrega
// campos, este adapter los ignora (mejor que el frontend truene).
// `stock` lo inferimos de `is_active` por ahora (el backend no lo
// expone en /products publico — solo is_visible). Si el backend expone
// stock en una iteración futura, agregar al BackendProduct type.
//
// `images` y `variants` SÍ se propagan: sin ellos la card no puede
// mostrar la foto real ni los swatches de acabado (cae al
// `imageUrl` único y no hace swap).
function mapBackendToProduct(b: BackendProduct) {
  return {
    id: b.id,
    slug: b.slug,
    name: b.name,
    description: b.description ?? '',
    priceCents: b.priceCents,
    imageUrl: b.imageUrl ?? '/images/product-placeholder.png',
    images: mapBackendImages(b.images),
    variants: mapBackendVariants(b.variants),
    category: b.category,
    brand: b.brand ?? '',
    isExclusive: b.isExclusive ?? false,
    inStock: b.stock > 0,
    stock: b.stock,
    badges: [] as ('new' | 'sale' | 'low_stock')[],
    updatedAt: new Date().toISOString(),
  };
}

const productsForUi = allProducts.map(mapBackendToProduct);

// Diccionario para los subcomponentes
const dictionary = {
  viewDetail: t['storefront.productCard.viewDetail'],
  sort: {
    label: t['storefront.products.v3.sort.label'],    relevancia: t['storefront.products.v3.sort.relevancia'],
    precioAsc: t['storefront.products.v3.sort.precioAsc'],
    precioDesc: t['storefront.products.v3.sort.precioDesc'],
    nombre: t['storefront.products.v3.sort.nombre'],
  },
  filters: {
    heading: t['storefront.products.v3.filter.heading'],
    clear: t['storefront.products.v3.filter.clear'],
    categoryHeading: t['storefront.products.v3.filter.categoria'],
    brandHeading: t['storefront.products.v3.filter.marca'],
    priceHeading: t['storefront.products.v3.filter.precio'],
    colorHeading: t['storefront.products.v3.filter.color'],
    sizeHeading: t['storefront.products.v3.filter.talla'],
    colorSwatchAltTemplate: t['storefront.products.v3.filter.colorSwatchAlt'],
  },
  breadcrumb: {
    home: t['storefront.products.v3.breadcrumb.home'],
    catalog: t['storefront.products.v3.breadcrumb.catalog'],
  },
  eyebrow: t['storefront.products.v3.eyebrow'],
};

// Categorías: derivamos del backend. En vez de getCategoriesInUse()
// (que leía del mock PRODUCTS), construimos de apiProducts agrupando
// por category.slug con count. El shape coincide con CategoryFilterOption
// (que requiere `label`, no `name`).
const categoryCounts = apiProducts.reduce<Record<string, { slug: string; label: string; count: number }>>(
  (acc, p) => {
    const catSlug = p.category || 'unknown';
    if (!acc[catSlug]) {
      acc[catSlug] = { slug: catSlug, label: catSlug, count: 0 };
    }
    acc[catSlug].count += 1;
    return acc;
  },
  {},
);
const filterCategoryOptions = [
  {
    slug: 'all',
    label: t['storefront.products.v3.filter.categoriaAll'],
    count: apiProducts.length,
  },
  ...Object.values(categoryCounts),
];

// Marcas: combinamos la lista canonica de La Voz (instrumentos
// musicales) con counts placeholder. Solo se muestra si hay al menos
// 1 producto visible — cuando la pagina integre el data layer real
// de cada tenant, este switch se generaliza via getBrandsForTenant.
const filterBrandOptions = LA_VOZ_BRANDS.map((brand) => ({
  slug: brand.slug,
  label: brand.label,
  count: LA_VOZ_CATEGORIES.length > 0 ? 0 : 0,
}));

// Rangos de precio (en USD cents). Mockup Bonfire propone 4 buckets.
const PRICE_RANGES = [
  { slug: '0-30', label: t['storefront.products.v3.range.0-30'] },
  { slug: '30-60', label: t['storefront.products.v3.range.30-60'] },
  { slug: '60-100', label: t['storefront.products.v3.range.60-100'] },
  { slug: '100+', label: t['storefront.products.v3.range.100+'] },
] as const;

// Paleta de colores Bonfire-safe (sin rust #951318, sin verde primary).
// Los slugs son kebab-case para poder usarlos en URLs cuando los
// filtros sean reales.
const filterColorOptions = [
  { slug: 'black', label: 'Negro', hex: '#132028', count: 4 },
  { slug: 'navy', label: 'Azul marino', hex: '#1E3A8A', count: 3 },
  { slug: 'cream', label: 'Crema', hex: '#F2EDE4', count: 2 },
  { slug: 'pink', label: 'Rosa', hex: '#DB2777', count: 2 },
  { slug: 'amber', label: 'Mostaza', hex: '#EAB24B', count: 2 },
  { slug: 'purple', label: 'Violeta', hex: '#7C3AED', count: 2 },
];

// Tallas: 4 buckets estilo Bonfire. Los counts son placeholders
// razonables para la demo (suma arbitraria, no cálculo real).
const filterSizeOptions = [
  { slug: 'ch', label: 'CH', count: 12 },
  { slug: 'm', label: 'M', count: 24 },
  { slug: 'g', label: 'G', count: 18 },
  { slug: 'xg', label: 'XG', count: 8 },
];

const subtitle = t['storefront.products.v3.subtitle'].replace('{count}', String(apiProducts.length));

const countRange = t['storefront.products.v3.countRange']
  .replace('{from}', String(from))
  .replace('{to}', String(to))
  .replace('{total}', String(apiProducts.length));

const baseUrl = `/${locale}/products`;
---

<StorefrontLayout
  title={`${t['storefront.products.v3.title']} · AtlasCommerce`}
  cartCount={cartCount}
>
  <main class="min-h-screen bg-slate-50">
    <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:py-16">
      <!-- Breadcrumb visible (patron guitargear) — el usuario lo espera
           en cualquier pagina de catalogo. -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-slate-500">
          <li>
            <a href={`/${locale}`} class="transition hover:text-slate-900">
              {dictionary.breadcrumb.home}
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-300">
            /
          </li>
          <li>
            <span class="font-semibold text-slate-700" aria-current="page">
              {dictionary.breadcrumb.catalog}
            </span>
          </li>
        </ol>
      </nav>

      <header class="mb-8 flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="inline-block rounded-full bg-[var(--primary-soft,#F1F5F9)] px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[var(--primary,#475569)]">
            {dictionary.eyebrow}
          </span>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
            {t['storefront.products.v3.title']}
          </h1>
          <p class="mt-2 text-sm text-slate-500">{subtitle}</p>
        </div>
        <SortDropdown labels={dictionary.sort} value="relevancia" />
      </header>

      <div class="grid gap-10 pb-12 lg:grid-cols-[264px_1fr]">
        <div class="hidden lg:block">
          <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white p-6">
            <FiltersSidebar
              labels={dictionary.filters}
              categories={filterCategoryOptions}
              brands={filterBrandOptions}
              prices={PRICE_RANGES.map(({ slug, label }) => ({ slug, label }))}
              colors={filterColorOptions}
              sizes={filterSizeOptions}
              activeCategory={null}
            />
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-[13px] text-slate-500">{countRange}</p>
          </div>

          {/*
            Render SSR-only del grid de productos. Decisión: NO se monta
            la island `StorefrontProductsList` acá.

              - El SSR ya trae los productos (línea del apiFetch más
                arriba en este archivo). Montar la island la convierte en
                duplicado: cada producto se renderiza dos veces
                ( `<ul>` SSR + island que hydrata en `client:visible`).
              - El `client:visible` significa que el contenido real solo
                aparece cuando el usuario scrollea — pésimo para el
                contenido primario de la página. El grid tiene que estar
                visible ya desde el primer paint.
              - Los filtros (`FiltersSidebar`) y el orden (`SortDropdown`)
                siguen presentacionales puros — `activeCategory` está
                hardcodeado a `null` y no hay handler que filtre la
                lista. La island no aporta nada que el SSR no aporte;
                removerla no rompe interacción.
              - El fetch SSR funciona vía `INTERNAL_API_ORIGIN` para
                resolver el lado nginx del docker network cuando
                `PUBLIC_API_URL` es relativo (`/api`). Ver `lib/api.ts`.

            Si más adelante se wirean los filtros/orden, la solución NO
            es re-introducir esta island acá: hay que mover el render
            del grid a un componente React único (algo como
            `<CatalogGrid client:load>`) que reciba filtros como props y
            haga su propio fetch + sort + paginación. Mantener dos
            fuentes de verdad (SSR + island) es exactamente la fuente del
            bug actual.
          */}
          <ul
            data-reveal-stagger
            class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 xl:grid-cols-4"
            aria-label={t['storefront.products.v3.title']}
          >
            {productsForUi.length > 0 ? productsForUi.map((product) => (
              <li class="list-none">
                <ProductCardCatalog
                  product={product}
                  locale={locale}
                  labels={{ viewDetail: dictionary.viewDetail }}
                />
              </li>
            )) : null}
          </ul>

          <Pagination
            currentPage={currentPage}
            lastPage={lastPage}
            baseUrl={baseUrl}
            pageLabel={t['storefront.products.v3.pagination.page']}
            ofLabel={t['storefront.products.v3.pagination.of']}
            previousLabel={t['storefront.products.v3.pagination.previous']}
            nextLabel={t['storefront.products.v3.pagination.next']}
          />
        </div>
      </div>
    </div>
  </main>
</StorefrontLayout>
