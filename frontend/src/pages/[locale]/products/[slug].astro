---
/**
 * Detalle de producto v5 — layout La Voz Instrumentos (estilo Gibson).
 *
 * Composición:
 *   - Top: grid 2-col con gallery uniforme (2-col image grid) +
 *     aside pegajoso de info (sticky top-20). Aside acomoda título,
 *     tag "Limitado" condicional, dl 2-col Precio/Acabado, shipping
 *     inline, selectores (condición, tamaño, acabado), CTA grande,
 *     3 accordions de inclusión y link "Buscar una tienda".
 *   - Debajo: reseñas full-width → ficha técnica (ProductDetailsBlock)
 *     → highlights (ProductHighlights) → specs por categoría
 *     (ProductSpecificationsByCategory) → features carousel →
 *     productos relacionados.
 *
 * Decisiones:
 *  - Variants estáticas hasta cart store: conditionOptions y
 *    sizeOptions vienen del padre mock (data/products.ts + mock).
 *  - Si el slug no matchea, devolvemos 404.
 *  - Mock placeholder visual hasta que exista CDN de storefront.
 *  - Las nuevas secciones (highlights, specsByCategory) sólo se
 *    renderizan si el mock las provee — no rompen el render del
 *    mock actual (Saber Alter Figma).
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import ProductDetailGallery from '../../../components/storefront/products/ProductDetailGallery.astro';
import ProductDetailVariants, {
  type VariantOption,
} from '../../../components/storefront/products/ProductDetailVariants.astro';
// ProductDetailColorSwatches eliminado en T5 — el picker ahora vive inline
// en el dl "Acabado" usando thumbnails reales de cada variante.
import ProductDetailRatingRow from '../../../components/storefront/products/ProductDetailRatingRow.astro';
import ProductDetailFinancingBlock from '../../../components/storefront/products/ProductDetailFinancingBlock.astro';
import ProductFeaturedArticle from '../../../components/storefront/products/ProductFeaturedArticle.astro';
import ProductFrequentlyBoughtTogether from '../../../components/storefront/products/ProductFrequentlyBoughtTogether.astro';
import ProductRecentlyViewed from '../../../components/storefront/products/ProductRecentlyViewed.astro';
import ProductFitSelector from '../../../components/storefront/products/ProductFitSelector.astro';
import ProductSizeGrid from '../../../components/storefront/products/ProductSizeGrid.astro';
import ProductCTAs from '../../../components/storefront/products/ProductCTAs.astro';
import ProductShippingAccordion from '../../../components/storefront/products/ProductShippingAccordion.astro';
import ProductDetailsBlock from '../../../components/storefront/products/ProductDetailsBlock.astro';
import ProductFeaturesCarousel, {
  type ProductFeatureItem,
} from '../../../components/storefront/products/ProductFeaturesCarousel.astro';
import ProductReviews from '../../../components/storefront/products/ProductReviews.astro';
import ProductRelated from '../../../components/storefront/products/ProductRelated.astro';
import ProductHighlights from '../../../components/storefront/products/ProductHighlights.astro';
import ProductSpecificationsByCategory from '../../../components/storefront/products/ProductSpecificationsByCategory.astro';
import { getServerDictionary } from '../../../i18n/server';
import { findProductBySlug, CATEGORIES } from '../../../data/products';
import { formatCurrency } from '../../../lib/formatters';
import {
  SABER_ALTER_DETAIL,
  FENDER_PLAYER_FUSION_BASS_DETAIL,
  FENDER_PLAYER_FUSION_BASS_INTRO_HTML,
  FENDER_PLAYER_FUSION_BASS_HEADING,
  FENDER_BUNDLE_ITEMS,
  RELATED_PRODUCTS,
  type ProductReview,
  getAverageRating,
} from '../../../data/product-detail-mock';
import type { Product } from '../../../types/catalog';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const { slug } = Astro.params;
const product = slug !== undefined ? findProductBySlug(slug) : null;

// URL actual — para query params (`?color=`, `?image=`).
const url = new URL(Astro.request.url);

if (product === null) {
  Astro.response.status = 404;
}

// Detalle enriquecido: si el slug matchea uno de nuestros mocks
// enriquecidos (Saber Alter, Fender), lo usamos directamente.
// Si no, derivamos un subset mínimo del producto base.
const detail =
  product?.slug === FENDER_PLAYER_FUSION_BASS_DETAIL.slug
    ? FENDER_PLAYER_FUSION_BASS_DETAIL
    : product?.slug === SABER_ALTER_DETAIL.slug
      ? SABER_ALTER_DETAIL
      : product !== null
      ? {
          ...SABER_ALTER_DETAIL,
          id: product.id,
          slug: product.slug,
          name: product.name,
          description: product.description,
          priceCents: product.priceCents,
          compareAtPriceCents: product.compareAtPriceCents,
          currency: product.currency ?? 'USD',
          category: product.category,
          stock: product.stock,
          badges: product.badges ?? [],
        }
      : null;

// Estado inicial del accordion de specs: leído de la cookie SSR
// (`pdp-specs-expanded-<slug>`) para evitar el flash visual que se
// produciría si el cliente abriera los `<details>` después del
// primer paint. Defensivo: si la cookie no existe, está mal
// formada, no es array o el producto es null, arrancamos con
// todas las specs cerradas.
const cookieName = product !== null ? `pdp-specs-expanded-${product.slug}` : null;
const expandedSpecs: readonly string[] = (() => {
  if (cookieName === null) return [];
  const raw = Astro.cookies.get(cookieName)?.value;
  if (raw === undefined) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.filter((v): v is string => typeof v === 'string');
  } catch {
    return [];
  }
})();

const catalogHref = `/${locale}/products`;
const category =
  product !== null ? (CATEGORIES.find((entry) => entry.slug === product.category) ?? null) : null;

// ─── Variants mocks (estáticos hasta cart store) ──────────────────────
const CONDITION_OPTIONS = [
  { id: 'new', label: t['storefront.products.detail.v4.condition.new'] },
  { id: 'used', label: t['storefront.products.detail.v4.condition.used'] },
];

const SIZE_OPTIONS: readonly VariantOption[] = [
  { id: '44', label: '4/4' },
  { id: '34', label: '3/4' },
  { id: '12', label: '1/2' },
  { id: '14', label: '1/4' },
];

// Color (swatches) — fuente data-driven: detail.variantAttributes[0].
// Fallback al set hardcoded de Saber Alter si el mock no trae colores
// (mantiene compatibilidad con productos sin variantAttributes poblado).
const COLOR_OPTIONS: readonly VariantOption[] = (() => {
  const colorAttrs = detail?.variantAttributes?.find((group) => group[0]?.type === 'color');
  if (colorAttrs !== undefined && colorAttrs.length > 0) {
    return colorAttrs.map((attr) => ({
      id: attr.id,
      label: attr.label,
      hex: attr.hex,
    }));
  }
  return [
    { id: 'sunburst', label: 'Sunburst', hex: '#7C3A1A' },
    { id: 'black', label: 'Negro', hex: '#132028' },
    { id: 'vintage-white', label: 'Vintage White', hex: '#EDE7D7' },
  ];
})();

const SELECTED_CONDITION = 'new';
const SELECTED_SIZE = '44';

// Acabado seleccionado: viene por query param `?finish=<variant-slug>`
// (English + descriptive por convención del resto de la app — ver
// `2fa.astro`/`admin/sales/*` que usan `token`/`status`/`dateFrom`).
// Default = primera variante. Esto permite cambiar el acabado via SSR sin JS.
const selectedFinishFromUrl = url.searchParams.get('finish');
const SELECTED_COLOR =
  COLOR_OPTIONS.find((option) => option.id === selectedFinishFromUrl)?.id ??
  COLOR_OPTIONS[0]?.id ??
  'sunburst';
const selectedFinish = COLOR_OPTIONS.find((option) => option.id === SELECTED_COLOR) ?? COLOR_OPTIONS[0];

// Imágenes filtradas por el color seleccionado. Convención: la URL de
// la imagen contiene el slug del variant (ej. "ebony-black"). Si el
// mock no sigue esta convención (Saber Alter usa placeholder), caemos
// al set completo.
const VARIANT_SLUG_PATTERN = SELECTED_COLOR.toLowerCase();
const displayedImages = (() => {
  const all = detail?.images ?? [];
  const filtered = all.filter((url) =>
    url.toLowerCase().includes(VARIANT_SLUG_PATTERN)
  );
  return filtered.length > 0 ? filtered : all;
})();

// Para cada variante, exponemos la PRIMERA imagen (thumbnail del picker).
// Si no hay imágenes suficientes, caemos al hex como fallback visual.
const variantFirstImage: Record<string, string | undefined> = {};
if (detail !== null) {
  for (const option of COLOR_OPTIONS) {
    const slug = option.id.toLowerCase();
    variantFirstImage[option.id] =
      detail.images.find((url) => url.toLowerCase().includes(slug)) ??
      detail.images[0];
  }
}

const HIGHLY_RATED = detail !== null && detail.reviews.length >= 5;
const IN_STOCK = detail !== null && detail.stock > 0;
const AVG_RATING = detail !== null ? getAverageRating(detail.reviews) : 0;
const RATING_COUNT = detail !== null ? detail.reviews.length : 0;

// Precio formateado para el dl 2-col (single source of truth: formatCurrency).
const precioFormatted =
  detail !== null ? formatCurrency(detail.priceCents, detail.currency) : '';

const HIGHLY_RATED_LABEL = HIGHLY_RATED
  ? t['storefront.products.detail.v4.highlyRated']
  : undefined;

// ─── Inclusions (3 accordions debajo del CTA) ─────────────────────────
// Labels + body copy vienen de i18n; orden sigue el patrón Gibson PDP
// (Garantía primero, luego Estuche, luego Ajuste).
const INCLUSION_ACCORDIONS: readonly { label: string; content: string }[] = [
  {
    label: t['storefront.products.detail.v4.inclusions.warranty'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.warrantyContent']}</p>`,
  },
  {
    label: t['storefront.products.detail.v4.inclusions.case'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.caseContent']}</p>`,
  },
  {
    label: t['storefront.products.detail.v4.inclusions.tuning'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.tuningContent']}</p>`,
  },
];

// Features: 3 imágenes lifestyle para carrusel (mock con SVG inline).
const FEATURE_IMAGE =
  'data:image/svg+xml;utf8,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500"><rect width="400" height="500" fill="#e2e8f0"/><circle cx="200" cy="220" r="80" fill="#cbd5e1"/></svg>`
  );
const FEATURE_ITEMS: readonly ProductFeatureItem[] = detail !== null
  ? [
      { image: FEATURE_IMAGE, alt: `${detail.name} — pastilla`, caption: 'Pastillas hand-wound calibradas a mano.' },
      { image: FEATURE_IMAGE, alt: `${detail.name} — puente`, caption: 'Puente de 2 puntos con selletas de acero.' },
      { image: FEATURE_IMAGE, alt: `${detail.name} — cuerpo`, caption: 'Cuerpo de aliso con acabado gloss urethane.' },
    ]
  : [];

// Reviews (extraídos del detail si existe, mock vacío si no).
const REVIEWS: readonly ProductReview[] = detail?.reviews ?? [];
const VIEW_ALL_HREF = `/${locale}/products/${product?.slug ?? ''}/reviews`;
const WRITE_REVIEW_HREF = `/${locale}/products/${product?.slug ?? ''}/reviews/new`;
const FIND_STORE_HREF = `/${locale}/stores`;

const reviewsLabels = {
  heading: 'Reseñas',
  average: 'Promedio',
  outOf: 'de 5',
  count: t['storefront.productDetail.reviews.count'].replace('{count}', String(REVIEWS.length)),
  write: t['storefront.products.detail.v4.writeReview'],
  viewAll: 'Ver todas las reseñas',
  empty: 'Este producto todavía no tiene reseñas.',
  verified: t['storefront.productDetail.reviews.verified'],
  starAlt: t['storefront.productDetail.reviews.starAlt'],
  loadMore: t['storefront.products.detail.v4.reviews.loadMore'],
  showLess: t['storefront.products.detail.v4.reviews.showLess'],
  filterAll: t['storefront.products.detail.v4.reviews.filterAll'],
  filterByRating: t['storefront.products.detail.v4.reviews.filterByRating'],
};

/** Metadata mínima del producto actual — expuesta a window.__PRODUCT_META__
 *  para que ProductRecentlyViewed pueda trackear este producto via localStorage. */
const FENDER_PRODUCT = product !== null
  ? {
      slug: product.slug,
      name: product.name,
      imageUrl: product.imageUrl,
      priceCents: product.priceCents,
      currency: product.currency ?? 'USD',
    }
  : { slug: 'unknown', name: '', imageUrl: '', priceCents: 0, currency: 'USD' };

const cardLabels = {
  heading: t['storefront.productDetail.related.heading'],
  empty: t['storefront.productDetail.related.empty'],
  newBadge: t['storefront.productCard.badge.new'],
  saleBadge: t['storefront.productCard.badge.sale'],
  lowStockBadge: t['storefront.productCard.badge.lowStock'],
  addToCart: t['storefront.productCard.addToCart'],
  outOfStock: t['storefront.productCard.outOfStock'],
  viewDetail: t['storefront.productCard.viewDetail'],
};

const galleryLabels = {
  mainAlt: product?.name ?? t['storefront.productDetail.notFound'],
  logoText: product?.name?.split(' ')[0] ?? 'Atlas',
};
---

<StorefrontLayout title={product?.name ?? t['storefront.productDetail.notFound']}>
  <main class="bg-slate-50" data-product-slug={product?.slug ?? 'unknown'}>
    <section class="mx-auto w-full max-w-[1160px] px-4 py-4 sm:px-6 sm:py-6">
      {/* Breadcrumb */}
      <nav aria-label="breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-sm text-slate-500">
        <a href={catalogHref} class="transition hover:text-slate-700">
          {t['storefront.products.detail.v3.breadcrumb']}
        </a>
        <span aria-hidden="true">/</span>
        {category !== null && (
          <>
            <a
              href={`${catalogHref}?category=${category.slug}`}
              class="transition hover:text-slate-700"
            >
              {category.name}
            </a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span class="font-medium text-slate-700">{product?.name ?? ''}</span>
      </nav>

      {product === null && (
        <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
          <h1 class="text-2xl font-bold text-slate-900">{t['storefront.productDetail.notFound']}</h1>
          <p class="max-w-md text-sm text-slate-500">{t['storefront.productDetail.notFoundHint']}</p>
          <a
            href={catalogHref}
            class="mt-2 inline-flex h-10 items-center rounded-lg bg-[var(--primary,#475569)] px-5 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#334155)]"
          >
            {t['storefront.products.detail.v3.breadcrumb']}
          </a>
        </div>
      )}

      {product !== null && detail !== null && (
        <article class="flex flex-col gap-16">
          {/* Top: gallery uniforme + aside pegajoso */}
          <section class="grid gap-6 lg:grid-cols-[1.8fr_minmax(0,420px)] lg:gap-8">
            <ProductDetailGallery
              images={displayedImages}
              productName={product.name}
              labels={galleryLabels}
              highlyRatedLabel={HIGHLY_RATED_LABEL}
            />

            <aside class="flex flex-col gap-5 lg:sticky lg:top-20 lg:self-start">
              <ProductDetailRatingRow rating={AVG_RATING} count={RATING_COUNT} />

              <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                {product.name}
              </h1>

              {HIGHLY_RATED_LABEL !== undefined && (
                <a
                  href="#"
                  class="self-start text-xs font-bold uppercase tracking-wider text-[var(--primary,#475569)] underline"
                >
                  {t['storefront.products.detail.v4.limited']}
                </a>
              )}

              <dl class="grid grid-cols-2 gap-4 border-b border-slate-200 pb-4">
                <div class="flex flex-col gap-1">
                  <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Precio</dt>
                  <dd class="text-xl font-bold tabular-nums text-slate-900">{precioFormatted}</dd>
                </div>
                <div class="flex flex-col gap-2">
                  <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Acabado</dt>
                  <dd class="flex flex-col gap-3 text-sm font-medium text-slate-900">
                    <span class="inline-flex items-center gap-2">
                      <span class="text-base font-semibold">{selectedFinish?.label ?? '—'}</span>
                      {selectedFinish?.hex !== undefined && (
                        <span
                          aria-hidden="true"
                          class="inline-block h-3 w-3 rounded-full border border-slate-200"
                          style={`background-color: ${selectedFinish.hex};`}
                        />
                      )}
                    </span>
                    {/* Picker de variantes con thumbnails reales (pattern Gibson).
                        SSR: cada swatch es un <a> con ?finish=<id> que filtra la galería
                        via query param (sin JS). */}
                    <ul class="flex flex-wrap items-center gap-2" role="list" aria-label="Selector de acabado">
                      {COLOR_OPTIONS.map((option) => {
                        const isActive = option.id === SELECTED_COLOR;
                        const thumbSrc = variantFirstImage[option.id];
                        return (
                          <li>
                            <a
                              href={`?finish=${option.id}`}
                              title={option.label}
                              aria-label={`Cambiar a ${option.label}`}
                              aria-current={isActive ? 'true' : undefined}
                              class:list={[
                                'block h-10 w-10 rounded-md border bg-slate-50 object-cover transition focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2',
                                isActive
                                  ? 'border-slate-900 ring-2 ring-slate-900 ring-offset-1'
                                  : 'border-slate-200 opacity-70 hover:opacity-100',
                              ]}
                            >
                              {thumbSrc !== undefined && (
                                <img
                                  src={thumbSrc}
                                  alt=""
                                  loading="lazy"
                                  decoding="async"
                                  class="h-full w-full rounded-md object-cover"
                                />
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </dd>
                </div>
              </dl>

              <ProductDetailsBlock variant="inline" intro={detail.description} moreLabel={t['storefront.products.detail.v4.details.more']} lessLabel={t['storefront.products.detail.v4.details.less']} />

              <p class="text-xs text-slate-500">
                {t['storefront.products.detail.v4.shippingInline']}
              </p>

              {detail.hasCondition === true && (
                <ProductFitSelector
                  legend={t['storefront.products.detail.v4.condition.legend']}
                  options={CONDITION_OPTIONS}
                  selected={SELECTED_CONDITION}
                  name="condition"
                />
              )}

              {detail.hasSizes === true && (
                <ProductSizeGrid
                  legend={t['storefront.products.detail.v4.size.legend']}
                  options={SIZE_OPTIONS}
                  selected={SELECTED_SIZE}
                  name="size"
                />
              )}

              {/* El picker de variantes vive arriba en el dl "Acabado" (con thumbnails
                  reales via ?color=). No duplicamos el fieldset acá. */}

              <ProductCTAs
                addToCartLabel={t['storefront.productDetail.addToCart']}
                favoriteLabel={t['storefront.products.detail.v4.favorite']}
                inStock={IN_STOCK}
              />

              {detail.financing !== undefined && <ProductDetailFinancingBlock syncLine={t['storefront.products.detail.v4.financing.syncLine']} shopPayLine={t['storefront.products.detail.v4.financing.shopPay']} learnMoreLabel={t['storefront.products.detail.v4.financing.learnMore']} />}

              <div class="flex flex-col gap-2">
                {INCLUSION_ACCORDIONS.map((entry) => (
                  <ProductShippingAccordion label={entry.label} content={entry.content} />
                ))}
              </div>

              <a
                href={FIND_STORE_HREF}
                class="inline-flex items-center gap-1 self-start text-sm font-semibold text-[var(--primary,#475569)] hover:underline"
              >
                {t['storefront.products.detail.v4.findStore']}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </aside>
          </section>

          {/* Description block (card + Lee más toggle). Las specs por categoría
              se renderizan aparte en `<ProductSpecificationsByCategory>`. */}
          {detail.description.length > 0 && (
            <ProductDetailsBlock
              introLabel={t['storefront.products.detail.v4.details.introLabel']}
              heading={
                detail.slug === FENDER_PLAYER_FUSION_BASS_DETAIL.slug
                  ? FENDER_PLAYER_FUSION_BASS_HEADING
                  : undefined
              }
              intro={
                detail.slug === FENDER_PLAYER_FUSION_BASS_DETAIL.slug
                  ? FENDER_PLAYER_FUSION_BASS_INTRO_HTML
                  : detail.description
              }
              moreLabel={t['storefront.products.detail.v4.details.more']}
              lessLabel={t['storefront.products.detail.v4.details.less']}
            />
          )}

          {detail.featuredArticle !== undefined && (
            <ProductFeaturedArticle {...detail.featuredArticle} ctaLabel={t['storefront.products.detail.v4.featuredArticle.cta']} />
          )}

          {/* Highlights — sólo si el mock los provee */}
          {detail.highlights !== undefined && detail.highlights.length > 0 && (
            <ProductHighlights
              heading={t['storefront.products.detail.v4.highlights.heading']}
              items={detail.highlights}
            />
          )}

          {/* Especificaciones por categoría — sólo si el mock las provee */}
          {detail.groupedSpecs !== undefined && detail.groupedSpecs.length > 0 && (
            <ProductSpecificationsByCategory
              heading={t['storefront.products.detail.v4.specsByCategory.heading']}
              groups={detail.groupedSpecs}
              expanded={expandedSpecs}
            />
          )}

          {/* Reseñas — full-width después de specs (convención e-commerce: specs → reviews → related) */}
          {REVIEWS.length > 0 && (
            <ProductReviews
              labels={reviewsLabels}
              reviews={REVIEWS}
              viewAllHref={VIEW_ALL_HREF}
              writeHref={WRITE_REVIEW_HREF}
              apiBaseUrl="/api/v1"
              loginHref={`/${locale}/login`}
            />
          )}

          {/* Features carousel */}
          {FEATURE_ITEMS.length > 0 && (
            <ProductFeaturesCarousel
              heading={t['storefront.products.detail.v4.features.heading']}
              items={FEATURE_ITEMS}
            />
          )}

          {/* Related products */}
          {RELATED_PRODUCTS.length > 0 && (
            <ProductRelated labels={cardLabels} products={RELATED_PRODUCTS} locale={locale} />
          )}

          {/* Frequently bought together (bundle bass + accesorios) */}
          {detail.slug === FENDER_PLAYER_FUSION_BASS_DETAIL.slug && (
            <ProductFrequentlyBoughtTogether
              heading="Comprados juntos frecuentemente"
              items={FENDER_BUNDLE_ITEMS.map((item) => ({
                product: item.product as Product,
                position: item.position,
              }))}
              addAllHref={`/${locale}/cart?bundle=fender-fusion`}
              addAllLabel="Agregar todo al carrito"
              locale={locale}
            />
          )}

          {/* Recently viewed (client-side via localStorage) */}
          <ProductRecentlyViewed />
        </article>
      )}
    </section>
  </main>
  <script is:inline define:vars={{ productSlug: product?.slug ?? 'unknown', productName: product?.name ?? '', productImage: FENDER_PRODUCT.imageUrl, productPriceCents: FENDER_PRODUCT.priceCents, productCurrency: FENDER_PRODUCT.currency ?? 'USD' }}>
    // Inyecta la metadata del producto actual para que ProductRecentlyViewed
    // pueda trackearlo via localStorage en el cliente.
    window.__PRODUCT_META__ = { slug: productSlug, name: productName, imageUrl: productImage, priceCents: productPriceCents, currency: productCurrency };
  </script>
  <script is:inline>
    // Scroll restoration: al recargar la página, permanecemos en la sección
    // que el usuario estaba leyendo (Reseñas, Specs, etc.). El estado vive
    // en sessionStorage (scoped al tab, muere al cerrar) y se rehidrata al
    // cargar. Tres señales: (a) click en anchor con #id, (b) beforeunload,
    // (c) restore al cargar.
    //
    // Si la URL ya trae un hash, el browser hace scroll al anchor por sí
    // mismo — no interferimos (el hash gana sobre el sessionStorage).
    (() => {
      const STORAGE_KEY = 'pdp-scroll-state';

      if (window.location.hash !== '' && window.location.hash !== '#') return;

      // (a) Capturar sección clickeada vía anchor links (event delegation).
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const anchor = target.closest('a[href^="#"]');
        if (anchor === null) return;
        const href = anchor.getAttribute('href');
        if (href === null || href === '' || href === '#') return;
        if (document.querySelector(href) === null) return;
        try {
          sessionStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ type: 'anchor', id: href.slice(1) }),
          );
        } catch {
          /* sessionStorage no disponible — ignorar */
        }
      });

      // (b) Capturar scrollY antes de que la página se descargue (reload, navegación).
      window.addEventListener('beforeunload', () => {
        try {
          sessionStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ type: 'position', y: window.scrollY }),
          );
        } catch {
          /* sessionStorage no disponible — ignorar */
        }
      });

      // (c) Restaurar al cargar (DOMContentLoaded para tener el DOM estable).
      const restore = () => {
        let saved;
        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (raw === null) return;
          saved = JSON.parse(raw);
        } catch {
          return;
        }
        if (saved === null || typeof saved !== 'object') return;
        if (saved.type === 'anchor' && typeof saved.id === 'string') {
          const el = document.getElementById(saved.id);
          if (el !== null) {
            el.scrollIntoView({ behavior: 'auto', block: 'start' });
          }
          return;
        }
        if (saved.type === 'position' && typeof saved.y === 'number') {
          window.scrollTo({ top: saved.y, behavior: 'auto' });
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restore);
      } else {
        restore();
      }
    })();
  </script>
</StorefrontLayout>