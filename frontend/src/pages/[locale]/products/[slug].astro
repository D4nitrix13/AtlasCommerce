---
/**
 * Detalle de producto B2C (`/[locale]/products/[slug]`) — v3 Bonfire.
 *
 * Composición replicada del IA mock 05 (Bonfire-style product detail):
 *  - Grid 2 columnas: gallery a la izquierda, info a la derecha.
 *  - Gallery: 1 imagen principal cuadrada + thumbnails 80×80 a la
 *    izquierda en desktop / abajo en mobile. `data-reveal` activo.
 *  - Info: breadcrumb categoría, h1 nombre, rating row, precio
 *    tachado + chip descuento, fieldset talla (pills), fieldset
 *    color (swatches), qty stepper visual, CTA principal +
 *    secundario, trust signals (envío / devolución / garantía).
 *  - Tabs (Descripción / Especificaciones / Envío) usando `<details>`
 *    nativo — sin JS. `data-reveal` activo.
 *  - Sección "Productos relacionados" — 4 ProductCard en grid.
 *
 * Decisiones:
 *  - Variantes estáticas (no hay backend de inventario aún) — el
 *    padre pasa listas hardcoded. Add to cart / Buy now son visuales.
 *  - Si el slug no matchea, devolvemos 404 (Astro convention).
 *  - Reusamos `ProductMockup` (shirt variant) como placeholder visual
 *    mientras no haya CDN de storefront.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import ProductDetailGallery from '../../../components/storefront/products/ProductDetailGallery.astro';
import ProductDetailVariants, {
  type VariantOption,
} from '../../../components/storefront/products/ProductDetailVariants.astro';
import ProductTrustSignals from '../../../components/storefront/products/ProductTrustSignals.astro';
import ProductCard from '../../../components/storefront/products/ProductCard.astro';
import { getServerDictionary } from '../../../i18n/server';
import { findProductBySlug, CATEGORIES, PRODUCTS } from '../../../data/products';
import { SABER_ALTER_DETAIL } from '../../../data/product-detail-mock';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const { slug } = Astro.params;
const product = slug !== undefined ? findProductBySlug(slug) : null;

if (product === null) {
  Astro.response.status = 404;
}

// Detalle: si el slug matchea el mock Saber Alter, lo usamos; si no,
// derivamos un subset mínimo del producto base.
const detail =
  product?.slug === SABER_ALTER_DETAIL.slug
    ? SABER_ALTER_DETAIL
    : product !== null
      ? {
          ...SABER_ALTER_DETAIL,
          id: product.id,
          slug: product.slug,
          name: product.name,
          description: product.description,
          priceCents: product.priceCents,
          compareAtPriceCents: product.compareAtPriceCents,
          currency: product.currency ?? 'USD',
          category: product.category,
          stock: product.stock,
          badges: product.badges ?? [],
        }
      : null;

// URL parsing (sólo `?image=N` se usa en v3 — variants ya no son por query param).
const url = new URL(Astro.request.url);
const selectedImageIndex = Number(url.searchParams.get('image') ?? '0');

// Hrefs
const catalogHref = `/${locale}/products`;
const cartHref = `/${locale}/cart`;

// Categoría label (eyebrow sobre el h1).
const category =
  product !== null ? (CATEGORIES.find((entry) => entry.slug === product.category) ?? null) : null;

// ─── Mock variants (estáticos hasta cart store) ──────────────────────
const SIZE_OPTIONS: readonly VariantOption[] = [
  { id: 's', label: 'CH' },
  { id: 'm', label: 'M' },
  { id: 'l', label: 'G' },
  { id: 'xl', label: 'XG' },
];

const COLOR_OPTIONS: readonly VariantOption[] = [
  { id: 'black', label: 'Negro', hex: '#132028' },
  { id: 'teal', label: 'Teal', hex: '#2D9D8E' },
  { id: 'cream', label: 'Crema', hex: '#F2EDE4' },
  { id: 'wine', label: 'Vino', hex: '#951318' },
];

const SELECTED_SIZE = 'm';
const SELECTED_COLOR = 'black';

// ─── Etiquetas i18n ──────────────────────────────────────────────────
const galleryLabels = {
  mainAlt: product?.name ?? t['storefront.productDetail.notFound'],
  thumbAlt: (index: number) => t['storefront.productDetail.gallery.thumbAlt'].replace('{index}', String(index)),
  logoText: product?.name?.split(' ')[0] ?? 'Atlas',
};

const variantsLabels = {
  sizeLegend: t['storefront.products.detail.v3.size'],
  colorLegend: t['storefront.products.detail.v3.color'],
};

const priceFormatted = detail ? new Intl.NumberFormat('es-NI', { style: 'currency', currency: detail.currency }).format(detail.priceCents / 100) : '';
const compareAtFormatted =
  detail?.compareAtPriceCents !== undefined
    ? new Intl.NumberFormat('es-NI', { style: 'currency', currency: detail.currency }).format(detail.compareAtPriceCents / 100)
    : null;

const discountPercent =
  detail?.compareAtPriceCents !== undefined && detail.compareAtPriceCents > detail.priceCents
    ? Math.round(((detail.compareAtPriceCents - detail.priceCents) / detail.compareAtPriceCents) * 100)
    : null;

// Rating mock — en v3 son números hardcoded (no reviews).
const RATING_AVERAGE = 4.9;
const RATING_COUNT = 214;
const STOCK_DISPLAY = detail?.stock ?? 0;

// Products relacionados (4 — uno por categoría presente en PRODUCTS).
const relatedProducts = PRODUCTS.filter((entry) => entry.id !== product?.id).slice(0, 4);

const cardLabels = {
  newBadge: t['storefront.productCard.badge.new'],
  saleBadge: t['storefront.productCard.badge.sale'],
  lowStockBadge: t['storefront.productCard.badge.lowStock'],
  addToCart: t['storefront.productCard.addToCart'],
  outOfStock: t['storefront.productCard.outOfStock'],
  viewDetail: t['storefront.productCard.viewDetail'],
};
---

<StorefrontLayout title={product?.name ?? t['storefront.productDetail.notFound']}>
  <main class="bg-slate-50">
    <section class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-10">
      {/* Breadcrumb */}
      <nav aria-label="breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-slate-500">
        <a href={catalogHref} class="transition hover:text-slate-700">
          {t['storefront.products.detail.v3.breadcrumb']}
        </a>
        <span aria-hidden="true">/</span>
        {category !== null && (
          <>
            <a
              href={`${catalogHref}?category=${category.slug}`}
              class="transition hover:text-slate-700"
            >
              {category.name}
            </a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span class="font-medium text-slate-700">{product?.name ?? ''}</span>
      </nav>

      {product === null && (
        <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
          <h1 class="text-2xl font-bold text-slate-900">{t['storefront.productDetail.notFound']}</h1>
          <p class="max-w-md text-sm text-slate-500">{t['storefront.productDetail.notFoundHint']}</p>
          <a
            href={catalogHref}
            class="mt-2 inline-flex h-10 items-center rounded-lg bg-[var(--primary)] px-5 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover)]"
          >
            {t['storefront.products.detail.v3.breadcrumb']}
          </a>
        </div>
      )}

      {product !== null && detail !== null && (
        <article class="flex flex-col gap-16">
          {/* Top section: gallery + info */}
          <section class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] lg:gap-16">
            <ProductDetailGallery
              images={detail.images}
              productName={product.name}
              selectedIndex={selectedImageIndex}
              labels={galleryLabels}
            />

            <div class="flex flex-col gap-6">
              {category !== null && (
                <p class="text-xs font-bold uppercase tracking-wider text-[var(--primary)]">
                  {category.name}
                </p>
              )}

              <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                {product.name}
              </h1>

              {/* Rating + stock row */}
              <div class="flex flex-wrap items-center gap-3 text-sm">
                <span class="inline-flex items-center gap-1 font-bold text-slate-900">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-4 w-4 text-amber-500"
                    aria-hidden="true"
                  >
                    <path
                      d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9 4.7 17.6l1-5.8L1.5 7.7l5.9-.9L10 1.5z"
                    />
                  </svg>
                  {RATING_AVERAGE.toFixed(1)}
                </span>
                <span class="text-slate-500">
                  {RATING_COUNT} {t['storefront.products.detail.v3.rating']}
                </span>
                <span aria-hidden="true" class="h-1 w-1 rounded-full bg-slate-300"></span>
                <span class="text-slate-500">
                  {t['storefront.productDetail.inStock']}: <strong class="text-slate-900">{STOCK_DISPLAY}</strong>
                </span>
              </div>

              {/* Price row */}
              <div class="flex items-baseline gap-3">
                <span class="text-4xl font-bold tabular-nums text-slate-900">{priceFormatted}</span>
                {compareAtFormatted !== null && (
                  <span class="text-lg text-slate-400 tabular-nums line-through">
                    {compareAtFormatted}
                  </span>
                )}
                {discountPercent !== null && (
                  <span class="rounded-full bg-[var(--primary-soft)] px-2.5 py-0.5 text-xs font-bold text-[var(--primary)]">
                    -{discountPercent}%
                  </span>
                )}
              </div>

              {/* Variants */}
              <ProductDetailVariants
                type="size"
                options={SIZE_OPTIONS}
                selected={SELECTED_SIZE}
                labels={variantsLabels}
              />

              <ProductDetailVariants
                type="color"
                options={COLOR_OPTIONS}
                selected={SELECTED_COLOR}
                labels={variantsLabels}
              />

              {/* Quantity stepper (visual) */}
              <div class="flex flex-col gap-2">
                <span class="text-sm font-bold text-slate-900">
                  {t['storefront.products.detail.v3.quantity']}
                </span>
                <div class="flex items-center gap-4">
                  <div
                    class="inline-flex w-fit items-center overflow-hidden rounded-lg border border-slate-200"
                    role="group"
                    aria-label={t['storefront.products.detail.v3.quantity']}
                  >
                    <button
                      type="button"
                      aria-label={t['storefront.productDetail.quantity.decrement']}
                      class="flex h-12 w-12 items-center justify-center text-slate-600 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
                    >
                      <span aria-hidden="true">−</span>
                    </button>
                    <span
                      class="flex h-12 w-14 items-center justify-center border-x border-slate-200 text-base font-bold tabular-nums text-slate-900"
                      aria-live="polite"
                    >
                      1
                    </span>
                    <button
                      type="button"
                      aria-label={t['storefront.productDetail.quantity.increment']}
                      class="flex h-12 w-12 items-center justify-center text-slate-600 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
                    >
                      <span aria-hidden="true">+</span>
                    </button>
                  </div>
                  <span class="text-xs leading-tight text-slate-500">
                    Precio unitario<br />
                    <strong class="text-slate-900">{priceFormatted}</strong>
                  </span>
                </div>
              </div>

              {/* CTAs */}
              <div class="flex flex-col gap-3 sm:flex-row">
                <button
                  type="button"
                  class="inline-flex h-12 flex-1 items-center justify-center rounded-lg bg-[var(--primary)] px-6 text-base font-semibold text-white transition hover:bg-[var(--primary-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
                >
                  {t['storefront.products.detail.v3.addToCart']}
                </button>
                <a
                  href={cartHref}
                  class="inline-flex h-12 items-center justify-center rounded-lg border border-slate-300 bg-white px-6 text-base font-semibold text-slate-900 transition hover:border-slate-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2"
                >
                  {t['storefront.products.detail.v3.buyNow']}
                </a>
              </div>

              {/* Trust signals */}
              <ProductTrustSignals
                shippingLabel={t['storefront.products.detail.v3.shipping']}
                returnsLabel={t['storefront.products.detail.v3.returns']}
                warrantyLabel={t['storefront.products.detail.v3.warranty']}
              />
            </div>
          </section>

          {/* Tabs (native <details>) */}
          <section class="rounded-2xl border border-slate-200 bg-white p-2 sm:p-4" data-reveal>
            <details class="group" open>
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-base font-bold text-slate-900">
                {t['storefront.products.detail.v3.tab.description']}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 text-slate-400 transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div class="pb-5 text-sm leading-relaxed text-slate-600">
                <p>{detail.description}</p>
              </div>
            </details>

            <div class="border-t border-slate-100"></div>

            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-base font-bold text-slate-900">
                {t['storefront.products.detail.v3.tab.specs']}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 text-slate-400 transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div class="pb-5 text-sm leading-relaxed text-slate-600">
                <dl class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
                  {detail.specs.map((entry) => (
                    <div class="flex items-baseline justify-between border-b border-slate-100 py-2 last:border-b-0">
                      <dt class="font-medium text-slate-500">{entry.label}</dt>
                      <dd class="font-semibold text-slate-900">{entry.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </details>

            <div class="border-t border-slate-100"></div>

            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-base font-bold text-slate-900">
                {t['storefront.products.detail.v3.tab.shipping']}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 text-slate-400 transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div class="pb-5 text-sm leading-relaxed text-slate-600">
                <p>{t['storefront.productDetail.shippingReturns.shippingBody']}</p>
                <p class="mt-3">{t['storefront.productDetail.shippingReturns.returnsBody']}</p>
                <p class="mt-3">{t['storefront.productDetail.shippingReturns.warrantyBody']}</p>
              </div>
            </details>
          </section>

          {/* Related products */}
          {relatedProducts.length > 0 && (
            <section class="flex flex-col gap-6" data-reveal>
              <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">
                {t['storefront.products.detail.v3.related']}
              </h2>
              <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
                {relatedProducts.map((entry) => (
                  <ProductCard product={entry} locale={locale} labels={cardLabels} />
                ))}
              </div>
            </section>
          )}
        </article>
      )}
    </section>
  </main>
</StorefrontLayout>