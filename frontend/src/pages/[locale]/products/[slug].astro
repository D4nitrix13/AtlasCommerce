---
/**
 * Detalle de producto v5 — layout La Voz Instrumentos (estilo Gibson).
 *
 * Composición:
 *   - Top: grid 2-col con gallery uniforme (2-col image grid) +
 *     aside pegajoso de info (sticky top-20). Aside acomoda título,
 *     tag "Limitado" condicional, dl 2-col Precio/Acabado, shipping
 *     inline, selectores (condición, tamaño, acabado), CTA grande,
 *     3 accordions de inclusión y link "Buscar una tienda".
 *   - Debajo: reseñas full-width → ficha técnica (ProductDetailsBlock)
 *     → highlights (ProductHighlights) → specs por categoría
 *     (ProductSpecificationsByCategory) → features carousel →
 *     productos relacionados.
 *
 * Decisiones:
 *  - Variants estáticas hasta cart store: conditionOptions y
 *    sizeOptions vienen del padre mock (data/products.ts + mock).
 *  - Si el slug no matchea, devolvemos 404.
 *  - Mock placeholder visual hasta que exista CDN de storefront.
 *  - Las nuevas secciones (highlights, specsByCategory) sólo se
 *    renderizan si el mock las provee — no rompen el render del
 *    mock actual (Saber Alter Figma).
 *
 * Phase 7: selectores data-driven.
 *  - COLOR_OPTIONS: deriva de `detail.variants[].finishSlug/Label`
 *    cuando el producto los provee (Phase 7); fallback a
 *    variantAttributes[0] (Saber Alter) y luego al set hardcoded.
 *  - CONDITION_OPTIONS: deriva de la unión de `detail.variants[].condition`
 *    cuando `hasCondition=true` y hay variants; IDs alineados al enum
 *    backend ('nuevo' | 'usado' | 'ambos').
 *  - SIZE_OPTIONS: deriva de `detail.sizes[]` cuando está poblado;
 *    fallback a violin sizes hardcoded (demo Saber Alter).
 *  - Tag "Limitado": ahora lo dispara `detail.isExclusive` (Phase 7),
 *    no la cantidad de reseñas.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import ProductDetailGallery from '../../../components/storefront/products/ProductDetailGallery.astro';
import ProductDetailVariants, {
  type VariantOption,
} from '../../../components/storefront/products/ProductDetailVariants.astro';
// ProductDetailColorSwatches eliminado en T5 — el picker ahora vive inline
// en el dl "Acabado" usando thumbnails reales de cada variante.
import ProductDetailRatingRow from '../../../components/storefront/products/ProductDetailRatingRow.astro';
import ProductDetailFinancingBlock from '../../../components/storefront/products/ProductDetailFinancingBlock.astro';
import ProductFeaturedArticle from '../../../components/storefront/products/ProductFeaturedArticle.astro';
// FENDER_PLAYER_FUSION_BASS_DETAIL fue removido en el refactor
// seeders/mocks brand-agnostic (Oct 2026). El bundle "comprados juntos
// frecuentemente" que vivía acá se restaurará cuando exista data real
// para otros productos. El componente ProductFrequentlyBoughtTogether
// queda en `components/storefront/products/` para reuso futuro.
// import ProductFrequentlyBoughtTogether from '../../../components/storefront/products/ProductFrequentlyBoughtTogether.astro';
import ProductRecentlyViewed from '../../../components/storefront/products/ProductRecentlyViewed.astro';
import ProductFitSelector from '../../../components/storefront/products/ProductFitSelector.astro';
import ProductSizeGrid from '../../../components/storefront/products/ProductSizeGrid.astro';
import ProductCTAs from '../../../components/storefront/products/ProductCTAs.astro';
import ProductShippingAccordion from '../../../components/storefront/products/ProductShippingAccordion.astro';
import ProductDetailsBlock from '../../../components/storefront/products/ProductDetailsBlock.astro';
import ProductReviews from '../../../components/storefront/products/ProductReviews.astro';
import ProductRelated from '../../../components/storefront/products/ProductRelated.astro';
import ProductHighlights from '../../../components/storefront/products/ProductHighlights.astro';
import ProductExtendedDescription from '../../../components/storefront/products/ProductExtendedDescription.astro';
import ProductFAQ from '../../../components/storefront/products/ProductFAQ.astro';

import ProductSpecificationsByCategory from '../../../components/storefront/products/ProductSpecificationsByCategory.astro';
import { getServerDictionary } from '../../../i18n/server';
// CATEGORIES se mantiene para el breadcrumb; el lookup del producto
// ya NO usa la data mock (ver fetch SSR abajo).
import { CATEGORIES } from '../../../data/products';
import { formatCurrency } from '../../../lib/formatters';
import {
  SABER_ALTER_DETAIL,
  type ProductReview,
  getAverageRating,
} from '../../../data/product-detail-mock';
import type { Product } from '../../../types/catalog';
import { deriveProductDetail } from '../../../lib/product-detail';
// `RELATED_PRODUCTS` ya NO se importa: el carrusel se deriva del catálogo
// real del tenant en SSR (ver bloque más abajo). El export se mantiene en
// `data/product-detail-mock.ts` por compat con quien lo consuma fuera de acá.
import {
  pickRelatedProducts,
  type StorefrontApiProductSummary,
} from '../../../lib/related-products';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const { slug } = Astro.params;

// URL actual — para query params (`?color=`, `?image=`).
const url = new URL(Astro.request.url);

/**
 * Resolución del producto via SSR fetch al backend real.
 *
 * Decisión arquitectónica: usá `Astro.url.origin` como base para
 * construir la URL del API en REQUEST TIME. NO uses `PUBLIC_API_URL`
 * ni ninguna URL horneada en build — eso fue la causa del problema
 * que motivó `.ai/rules/workflow/decisions-storefront-rendering.md`
 * (commit `a8e478d5` y reversión `ee5639d1`). Astro SSR inlinea
 * envs del build en el bundle baked; rompería cuando el host del
 * dev/prod cambiara.
 *
 * Estados distinguidos (transferidos al render abajo):
 *  - `product  !== null && fetchError === null` → happy path.
 *  - `notFound === true`                     → 404 real del backend.
 *  - `fetchError !== null`                   → 5xx / timeout / red caída.
 *
 * Timeout de 5s para abortar el fetch y degradar con fallback antes
 * de que la request al PDP quede colgada en el SSR.
 */
interface StorefrontApiProduct {
  id: number;
  slug: string;
  name: string;
  description: string;
  priceCents: number;
  imageUrl: string;
  category: string;
  stock: number;
  compareAtPriceCents?: number;
  images?: readonly string[];
  brand?: string;
  currency?: string;
  isExclusive?: boolean;
  hasCondition?: boolean;
  hasSizes?: boolean;
}

const SSR_FETCH_TIMEOUT_MS = 5_000;

/**
 * Origen del API para el fetch SSR.
 *
 * Por defecto `Astro.url.origin`: correcto en producción, donde el
 * request llega a través de Caddy y el backend es alcanzable en el
 * mismo origin.
 *
 * `INTERNAL_API_ORIGIN` existe para dev: el container de Astro NO logra
 * alcanzar al host (Caddy en `*:80` del host no responde desde los
 * bridges de Docker), pero sí alcanza a `nginx`, que vive en la misma
 * red. Es configuración de RUNTIME leída del entorno del proceso, no
 * una URL horneada en build — no reintroduce el acoplamiento a hostname
 * que motivó `.ai/rules/workflow/decisions-storefront-rendering.md`.
 */
const internalApiOrigin: string | undefined =
  process.env.INTERNAL_API_ORIGIN?.trim();
const apiOrigin =
  internalApiOrigin !== undefined && internalApiOrigin.length > 0
    ? internalApiOrigin
    : Astro.url.origin;

/**
 * El middleware `store.domain` resuelve el tenant por cabecera `Host`.
 * Con el origin interno hay que mandarla explícitamente; sin ella el
 * backend no sabe qué tienda es y responde 404.
 */
const apiRequestHeaders: Record<string, string> = {
  Accept: 'application/json',
};
if (apiOrigin !== Astro.url.origin) {
  apiRequestHeaders.Host = Astro.url.host;
}

let product: Product | null = null;
let notFound = false;
let fetchError: string | null = null;

if (typeof slug !== 'string' || slug.length === 0) {
  notFound = true;
} else {
  const apiUrl = new URL(
    `/api/v1/storefront/products/${encodeURIComponent(slug)}`,
    apiOrigin,
  );

  const abortController = new AbortController();
  const timeoutHandle = setTimeout(
    (): void => abortController.abort(),
    SSR_FETCH_TIMEOUT_MS,
  );

  try {
    const response = await fetch(apiUrl, {
      headers: apiRequestHeaders,
      signal: abortController.signal,
    });

    if (response.status === 404) {
      notFound = true;
    } else if (response.ok) {
      // El Resource del backend declara la shape via PHPDoc; acá
      // asumimos la misma shape `ApiProduct` y mapeamos al interface
      // `Product` del frontend (camelCase → camelCase directo).
      const data = (await response.json()) as StorefrontApiProduct;
      product = {
        id: data.id,
        slug: data.slug,
        name: data.name,
        description: data.description,
        priceCents: data.priceCents,
        imageUrl: data.imageUrl,
        category: data.category,
        stock: data.stock,
        ...(data.compareAtPriceCents !== undefined && {
          compareAtPriceCents: data.compareAtPriceCents,
        }),
        ...(data.images !== undefined && {
          images: data.images,
        }),
        ...(data.brand !== undefined && { brand: data.brand }),
        ...(data.currency !== undefined && { currency: data.currency }),
        ...(data.isExclusive === true && { isExclusive: true }),
        ...(data.hasCondition !== undefined && { hasCondition: data.hasCondition }),
        ...(data.hasSizes !== undefined && { hasSizes: data.hasSizes }),
      };
    } else {
      fetchError = `HTTP ${response.status}`;
    }
  } catch (err) {
    fetchError =
      err instanceof Error ? `${err.name}: ${err.message}` : 'Network error';
  } finally {
    clearTimeout(timeoutHandle);
  }
}

if (notFound) {
  Astro.response.status = 404;
} else if (fetchError !== null) {
  // Fijamos 503 para que el cliente (browser / proxy) sepa que es
  // transitorio y pueda reintentar. La página igual renderiza
  // un fallback visible (no crashea).
  Astro.response.status = 503;
}

/**
 * Productos relacionados — segundo SSR fetch al catálogo filtrado por
 * la categoría del producto actual.
 *
 * Por qué un fetch aparte:
 *   - El endpoint público `/api/v1/storefront/products/{slug}` sólo
 *     devuelve el producto individual (no sus relacionados).
 *   - El catálogo completo del tenant es accesible via
 *     `/api/v1/storefront/products?category=<slug>` (parámetro opcional
 *     agregado en `ProductController::index` para no crear un endpoint
 *     nuevo).
 *   - Filtrar por categoría en SSR evita traer los 356 productos del
 *     catálogo completo por cada PDP (~500KB innecesarios).
 *
 * Estados (independientes del fetch principal):
 *   - `relatedProducts === [] && relatedError === null`
 *     → sin productos en la categoría (la sección se oculta).
 *   - `relatedError !== null`
 *     → 5xx / timeout / network → la sección se oculta, el PDP sigue
 *       respondiendo con los datos del producto principal (no se
 *       degrada la respuesta HTTP).
 *   - `relatedProducts.length > 0`
 *     → happy path: el carrusel muestra hasta N productos.
 *
 * Reutilizamos el mismo `apiOrigin` (resuelve Caddy/nginx según stage)
 * y la misma `apiRequestHeaders` (Host header cuando vamos por la red
 * interna del container).
 */
let relatedProducts: ReturnType<typeof pickRelatedProducts> = [];
let relatedError: string | null = null;

const relatedCategory = product?.category ?? '';
if (product !== null && relatedCategory !== '') {
  const relatedUrl = new URL(
    `/api/v1/storefront/products?category=${encodeURIComponent(relatedCategory)}`,
    apiOrigin,
  );
  const relatedController = new AbortController();
  const relatedTimeout = setTimeout(
    (): void => relatedController.abort(),
    SSR_FETCH_TIMEOUT_MS,
  );
  try {
    const relatedResponse = await fetch(relatedUrl, {
      headers: apiRequestHeaders,
      signal: relatedController.signal,
    });
    if (relatedResponse.ok) {
      const data = (await relatedResponse.json()) as StorefrontApiProductSummary[];
      relatedProducts = pickRelatedProducts(product.id, data);
    } else if (relatedResponse.status !== 404) {
      // 404 sería "categoría sin productos" pero el controller devuelve
      // [] para ese caso; cualquier otro status sí es error.
      relatedError = `HTTP ${relatedResponse.status}`;
    }
  } catch (err) {
    relatedError =
      err instanceof Error ? `${err.name}: ${err.message}` : 'Network error';
  } finally {
    clearTimeout(relatedTimeout);
  }
}

// Detalle enriquecido: el helper deriveProductDetail decide si usar
// SABER_ALTER_DETAIL directamente (cuando el slug matchea) o derivar
// un detail desde el Product base sin heredar colors/sizes/variants
// del mock de Saber Alter. Antes este spread contaminaba guitarras y
// otros productos con los selectores equivocados.
const detail = product !== null ? deriveProductDetail(product) : null;

// Estado inicial del accordion de specs: leído de la cookie SSR
// (`pdp-specs-expanded-<slug>`) para evitar el flash visual que se
// produciría si el cliente abriera los `<details>` después del
// primer paint. Defensivo: si la cookie no existe, está mal
// formada, no es array o el producto es null, arrancamos con
// todas las specs cerradas.
const cookieName = product !== null ? `pdp-specs-expanded-${product.slug}` : null;
const expandedSpecs: readonly string[] = (() => {
  if (cookieName === null) return [];
  const raw = Astro.cookies.get(cookieName)?.value;
  if (raw === undefined) return [];
  try {
    const parsed: unknown = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.filter((v): v is string => typeof v === 'string');
  } catch {
    return [];
  }
})();

const catalogHref = `/${locale}/products`;
const category =
  product !== null ? (CATEGORIES.find((entry) => entry.slug === product.category) ?? null) : null;

// ─── Variants mocks (estáticos hasta cart store) ──────────────────────
//
// Phase 7: las opciones de los selectores se derivan del detail cuando
// el mock/producto las provee. Se mantiene el fallback hardcoded para
// preservar el comportamiento del SABER_ALTER_DETAIL (que no expone
// los campos nuevos).
//
// IDs de condition se alinean con el enum backend `product_variants.
// condition` ('nuevo' | 'usado' | 'ambos').

type ConditionKey =
  | 'storefront.products.detail.v4.condition.nuevo'
  | 'storefront.products.detail.v4.condition.usado'
  | 'storefront.products.detail.v4.condition.ambos';

const CONDITION_OPTIONS: readonly VariantOption[] = (() => {
  if (detail !== null && detail.hasCondition === true && detail.variants !== undefined) {
    const distinct = new Set<string>();
    for (const variant of detail.variants) {
      if (variant.condition !== undefined) {
        distinct.add(variant.condition);
      }
    }
    if (distinct.size > 0) {
      return Array.from(distinct).map((cond) => {
        const key = `storefront.products.detail.v4.condition.${cond}` as ConditionKey;
        return {
          id: cond,
          label: t[key] ?? cond,
        };
      });
    }
  }
  return [
    { id: 'nuevo', label: t['storefront.products.detail.v4.condition.nuevo'] },
    { id: 'usado', label: t['storefront.products.detail.v4.condition.usado'] },
  ];
})();

const SIZE_OPTIONS: readonly VariantOption[] = (() => {
  // Phase 7: cuando el detail declara `sizes`, derivamos de ahí.
  if (detail !== null && detail.sizes !== undefined && detail.sizes.length > 0) {
    return detail.sizes.map((size) => ({
      id: size.slug,
      label: size.label,
    }));
  }
  // Fallback legacy — violin sizes hardcoded para el demo Saber Alter.
  return [
    { id: '44', label: '4/4' },
    { id: '34', label: '3/4' },
    { id: '12', label: '1/2' },
    { id: '14', label: '1/4' },
  ];
})();

// Color (swatches) — fuente preferida (Phase 7): variants con finish.
// Fallback al set de Saber Alter via variantAttributes[0].
// Fallback final: 3 colores hardcoded (sunburst/black/vintage-white).
const COLOR_OPTIONS: readonly VariantOption[] = (() => {
  if (detail === null) {
    return [
      { id: 'sunburst', label: 'Sunburst', hex: '#7C3A1A' },
      { id: 'black', label: 'Negro', hex: '#132028' },
      { id: 'vintage-white', label: 'Vintage White', hex: '#EDE7D7' },
    ];
  }
  // Phase 7: derivar de detail.variants cuando tienen finishSlug/Label.
  const phase7 = detail.variants
    .filter(
      (v): v is typeof v & { finishSlug: string; finishLabel: string } =>
        v.finishSlug !== undefined && v.finishLabel !== undefined,
    )
    .map((v) => ({
      id: v.finishSlug,
      label: v.finishLabel,
      ...(v.finishHex !== undefined && { hex: v.finishHex }),
    }));
  if (phase7.length > 0) return phase7;

  const colorAttrs = detail.variantAttributes.find((group) => group[0]?.type === 'color');
  if (colorAttrs !== undefined && colorAttrs.length > 0) {
    return colorAttrs.map((attr) => ({
      id: attr.id,
      label: attr.label,
      hex: attr.hex,
    }));
  }
  return [
    { id: 'sunburst', label: 'Sunburst', hex: '#7C3A1A' },
    { id: 'black', label: 'Negro', hex: '#132028' },
    { id: 'vintage-white', label: 'Vintage White', hex: '#EDE7D7' },
  ];
})();

const SELECTED_CONDITION = CONDITION_OPTIONS[0]?.id ?? 'nuevo';
const SELECTED_SIZE = SIZE_OPTIONS[0]?.id ?? '44';

// Acabado seleccionado: viene por query param `?finish=<variant-slug>`
// (English + descriptive por convención del resto de la app — ver
// `2fa.astro`/`admin/sales/*` que usan `token`/`status`/`dateFrom`).
// Default = primera variante. Esto permite cambiar el acabado via SSR sin JS.
const selectedFinishFromUrl = url.searchParams.get('finish');
const SELECTED_COLOR =
  COLOR_OPTIONS.find((option) => option.id === selectedFinishFromUrl)?.id ??
  COLOR_OPTIONS[0]?.id ??
  'sunburst';
const selectedFinish =
  COLOR_OPTIONS.find((option) => option.id === SELECTED_COLOR) ?? COLOR_OPTIONS[0];

// Imágenes filtradas por el color seleccionado. Convención: la URL de
// la imagen contiene el slug del variant (ej. "ebony-black"). Si el
// mock no sigue esta convención (Saber Alter usa placeholder), caemos
// al set completo.
const VARIANT_SLUG_PATTERN = SELECTED_COLOR.toLowerCase();
const displayedImages = (() => {
  const all = detail?.images ?? [];
  const filtered = all.filter((url) => url.toLowerCase().includes(VARIANT_SLUG_PATTERN));
  return filtered.length > 0 ? filtered : all;
})();

// Para cada variante, exponemos la PRIMERA imagen (thumbnail del picker).
// Si no hay imágenes suficientes, caemos al hex como fallback visual.
const variantFirstImage: Record<string, string | undefined> = {};
if (detail !== null) {
  for (const option of COLOR_OPTIONS) {
    const slug = option.id.toLowerCase();
    variantFirstImage[option.id] =
      detail.images.find((url) => url.toLowerCase().includes(slug)) ?? detail.images[0];
  }
}

const HIGHLY_RATED = detail !== null && detail.reviews.length >= 5;
const IN_STOCK = detail !== null && detail.stock > 0;
const AVG_RATING = detail !== null ? getAverageRating(detail.reviews) : 0;
const RATING_COUNT = detail !== null ? detail.reviews.length : 0;

// Precio formateado para el dl 2-col (single source of truth: formatCurrency).
const precioFormatted = detail !== null ? formatCurrency(detail.priceCents, detail.currency) : '';

const HIGHLY_RATED_LABEL = HIGHLY_RATED
  ? t['storefront.products.detail.v4.highlyRated']
  : undefined;

// ─── Inclusions (3 accordions debajo del CTA) ─────────────────────────
// Labels + body copy vienen de i18n; orden sigue el patrón Gibson PDP
// (Garantía primero, luego Estuche, luego Ajuste).
const INCLUSION_ACCORDIONS: readonly { label: string; content: string }[] = [
  {
    label: t['storefront.products.detail.v4.inclusions.warranty'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.warrantyContent']}</p>`,
  },
  {
    label: t['storefront.products.detail.v4.inclusions.case'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.caseContent']}</p>`,
  },
  {
    label: t['storefront.products.detail.v4.inclusions.tuning'],
    content: `<p>${t['storefront.products.detail.v4.inclusions.tuningContent']}</p>`,
  },
];

// Reviews (extraídos del detail si existe, mock vacío si no).
const REVIEWS: readonly ProductReview[] = detail?.reviews ?? [];
const VIEW_ALL_HREF = `/${locale}/products/${product?.slug ?? ''}/reviews`;
const WRITE_REVIEW_HREF = `/${locale}/products/${product?.slug ?? ''}/reviews/new`;
const FIND_STORE_HREF = `/${locale}/stores`;

const reviewsLabels = {
  heading: 'Reseñas',
  average: 'Promedio',
  outOf: 'de 5',
  count: t['storefront.productDetail.reviews.count'].replace('{count}', String(REVIEWS.length)),
  write: t['storefront.products.detail.v4.writeReview'],
  viewAll: 'Ver todas las reseñas',
  empty: 'Este producto todavía no tiene reseñas.',
  verified: t['storefront.productDetail.reviews.verified'],
  starAlt: t['storefront.productDetail.reviews.starAlt'],
  loadMore: t['storefront.products.detail.v4.reviews.loadMore'],
  showLess: t['storefront.products.detail.v4.reviews.showLess'],
  filterAll: t['storefront.products.detail.v4.reviews.filterAll'],
  filterByRating: t['storefront.products.detail.v4.reviews.filterByRating'],
  collapse: t['storefront.products.detail.v4.reviews.collapse'],
  expand: t['storefront.products.detail.v4.reviews.expand'],
  like: t['storefront.products.detail.v4.reviews.like'],
  unlike: t['storefront.products.detail.v4.reviews.unlike'],
  loginRequired: t['storefront.products.detail.v4.reviews.loginRequired'],
};

/** Metadata mínima del producto actual — expuesta a window.__PRODUCT_META__
 *  para que ProductRecentlyViewed pueda trackear este producto via localStorage. */
const CURRENT_PRODUCT =
  product !== null
    ? {
        slug: product.slug,
        name: product.name,
        imageUrl: product.imageUrl,
        priceCents: product.priceCents,
        currency: product.currency ?? 'USD',
      }
    : { slug: 'unknown', name: '', imageUrl: '', priceCents: 0, currency: 'USD' };

const galleryLabels = {
  mainAlt: product?.name ?? t['storefront.productDetail.notFound'],
  logoText: product?.name?.split(' ')[0] ?? 'Atlas',
};

const cardLabels = {
  heading: t['storefront.productDetail.related.heading'],
  empty: t['storefront.productDetail.related.empty'],
  prevLabel: t['storefront.productDetail.related.prev'],
  nextLabel: t['storefront.productDetail.related.next'],
  variantsLabel: t['storefront.productDetail.related.variantsLabel'],
  newBadge: t['storefront.productCard.badge.new'],
  saleBadge: t['storefront.productCard.badge.sale'],
  lowStockBadge: t['storefront.productCard.badge.lowStock'],
  addToCart: t['storefront.productCard.addToCart'],
  outOfStock: t['storefront.productCard.outOfStock'],
  viewDetail: t['storefront.productCard.viewDetail'],
};
---

<StorefrontLayout title={product?.name ?? t['storefront.productDetail.notFound']}>
  <main class="bg-slate-50" data-product-slug={product?.slug ?? 'unknown'}>
    {/* Script de scroll restoration al INICIO del <main>, antes del
        primer paint del contenido. <script is:inline> bloquea el
        parsing hasta ejecutar, así que corre antes del primer paint. */}
    <script is:inline>
      (() => {
        // (1) Desactivar scroll restoration automático del browser.
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        // Si la URL trae #anchor, dejar que el browser haga scroll al anchor.
        if (window.location.hash !== '' && window.location.hash !== '#') return;

        // (2) Leer posición guardada. Prioridad CORREGIDA:
        //   URL search (?scrollY=N) PRIMARIO — lo que el user EXPLÍCITAMENTE
        //     pone o comparte en el URL gana sobre todo lo demás.
        //   sessionStorage (persist entre reloads del mismo tab).
        //   cookie (persist cross-tab, pero SameSite puede fallar cross-domain).
        //
        // Antes sessionStorage era primario y eso hacía que el URL fuera
        // ignorado cuando sessionStorage tenía un valor stale (caso real del
        // user: sessionStorage=1600, URL=?scrollY=560 → iba a 1600, no a 560).
        const SS_KEY = 'pdp-scroll-y';
        const COOKIE_KEY = 'pdp-scroll-y';
        let savedY = null;

        // URL search PRIMARIO.
        const urlMatch = window.location.search.match(/[?&]scrollY=(\d+)/);
        if (urlMatch !== null && urlMatch[1] !== undefined) {
          const parsed = Number.parseInt(urlMatch[1], 10);
          if (Number.isFinite(parsed) && parsed >= 0) savedY = parsed;
        }

        // sessionStorage fallback.
        if (savedY === null) {
          try {
            const ss = sessionStorage.getItem(SS_KEY);
            if (ss !== null) {
              const parsed = Number.parseInt(ss, 10);
              if (Number.isFinite(parsed) && parsed >= 0) savedY = parsed;
            }
          } catch {
            /* sessionStorage no disponible */
          }
        }

        // Cookie fallback.
        if (savedY === null) {
          const cookieMatch = document.cookie.match(new RegExp(`(?:^|;\\s*)${COOKIE_KEY}=([^;]*)`));
          if (cookieMatch !== null && cookieMatch[1] !== undefined) {
            const parsed = Number.parseInt(decodeURIComponent(cookieMatch[1]), 10);
            if (Number.isFinite(parsed) && parsed >= 0) savedY = parsed;
          }
        }

        // (3) Restaurar ANTES del primer paint.
        if (savedY !== null && savedY > 0) {
          window.scrollTo({ top: savedY, left: 0, behavior: 'auto' });
        }
      })();
    </script>
    <section class="mx-auto w-full max-w-[1160px] px-4 py-4 sm:px-6 sm:py-6">
      {/* Breadcrumb */}
      <nav
        aria-label="breadcrumb"
        class="mb-4 flex flex-wrap items-center gap-2 text-sm text-slate-500"
      >
        <a href={catalogHref} class="transition hover:text-slate-700">
          {t['storefront.products.detail.v3.breadcrumb']}
        </a>
        <span aria-hidden="true">/</span>
        {category !== null && (
          <>
            <a
              href={`${catalogHref}?category=${category.slug}`}
              class="transition hover:text-slate-700"
            >
              {category.name}
            </a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span class="font-medium text-slate-700">{product?.name ?? ''}</span>
      </nav>

      {product === null && (
        <div
          class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center"
          data-product-status={notFound ? 'not-found' : 'unavailable'}
          role={fetchError !== null ? 'alert' : undefined}
        >
          <h1 class="text-2xl font-bold text-slate-900">
            {fetchError !== null
              ? 'No pudimos cargar el producto'
              : t['storefront.productDetail.notFound']}
          </h1>
          <p class="max-w-md text-sm text-slate-500">
            {fetchError !== null
              ? `El servicio respondió con un error (${fetchError}). Reintentá en unos segundos.`
              : t['storefront.productDetail.notFoundHint']}
          </p>
          <a
            href={catalogHref}
            class="mt-2 inline-flex h-10 items-center rounded-lg bg-[var(--primary,#475569)] px-5 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#334155)]"
          >
            {t['storefront.products.detail.v3.breadcrumb']}
          </a>
        </div>
      )}

      {product !== null && detail !== null && (
        <article class="flex flex-col gap-16">
          {/* Top: gallery uniforme + aside pegajoso */}
          <section class="grid gap-6 lg:grid-cols-[1.8fr_minmax(0,420px)] lg:gap-8">
            <ProductDetailGallery
              images={displayedImages}
              productName={product.name}
              labels={galleryLabels}
              highlyRatedLabel={HIGHLY_RATED_LABEL}
            />

            <aside class="flex flex-col gap-5 lg:sticky lg:top-20 lg:self-start">
              <ProductDetailRatingRow rating={AVG_RATING} count={RATING_COUNT} />

              <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                {product.name}
              </h1>

              {detail.isExclusive === true && (
                <a
                  href="#"
                  class="self-start text-xs font-bold uppercase tracking-wider text-[var(--primary,#475569)] underline"
                  data-product-exclusive
                >
                  {t['storefront.products.detail.v4.limited']}
                </a>
              )}

              <dl class="grid grid-cols-2 gap-4 border-b border-slate-200 pb-4">
                <div class="flex flex-col gap-1">
                  <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Precio</dt>
                  <dd class="text-xl font-bold tabular-nums text-slate-900">{precioFormatted}</dd>
                </div>
                <div class="flex flex-col gap-2">
                  <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Acabado</dt>
                  <dd class="flex flex-col gap-3 text-sm font-medium text-slate-900">
                    <span class="text-base font-semibold">{selectedFinish?.label ?? '—'}</span>
                    {/* Picker de variantes con thumbnails reales (estilo Nike).
                        Cada swatch es un <a> con ?finish=<id> que filtra la galería
                        via query param (sin JS). Thumbnails uniformes ~48×48
                        con object-cover para mantener el aspect ratio. */}
                    <ul
                      class="flex flex-wrap items-center gap-1.5"
                      role="list"
                      aria-label="Selector de acabado"
                    >
                      {COLOR_OPTIONS.map((option) => {
                        const isActive = option.id === SELECTED_COLOR;
                        const thumbSrc = variantFirstImage[option.id];
                        return (
                          <li>
                            <a
                              href={`?finish=${option.id}`}
                              title={option.label}
                              aria-label={`Cambiar a ${option.label}`}
                              aria-current={isActive ? 'true' : undefined}
                              class:list={[
                                'block h-12 w-12 overflow-hidden rounded-md border-2 bg-slate-50 object-cover transition focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2',
                                isActive
                                  ? 'border-slate-900'
                                  : 'border-slate-200 opacity-70 hover:opacity-100',
                              ]}
                            >
                              {thumbSrc !== undefined ? (
                                <img
                                  src={thumbSrc}
                                  alt=""
                                  loading="lazy"
                                  decoding="async"
                                  class="h-full w-full rounded-md object-cover"
                                />
                              ) : (
                                <span
                                  aria-hidden="true"
                                  class="block h-full w-full rounded-md"
                                  style={`background-color: ${option.hex ?? '#e2e8f0'};`}
                                />
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </dd>
                </div>
              </dl>

              <ProductDetailsBlock
                variant="inline"
                intro={detail.description}
                moreLabel={t['storefront.products.detail.v4.details.more']}
                lessLabel={t['storefront.products.detail.v4.details.less']}
              />

              <p class="text-xs text-slate-500">
                {t['storefront.products.detail.v4.shippingInline']}
              </p>

              {detail.hasCondition === true && (
                <ProductFitSelector
                  legend={t['storefront.products.detail.v4.condition.legend']}
                  options={CONDITION_OPTIONS}
                  selected={SELECTED_CONDITION}
                  name="condition"
                />
              )}

              {detail.hasSizes === true && (
                <ProductSizeGrid
                  legend={t['storefront.products.detail.v4.size.legend']}
                  options={SIZE_OPTIONS}
                  selected={SELECTED_SIZE}
                  name="size"
                />
              )}

              {/* El picker de variantes vive arriba en el dl "Acabado" (con thumbnails
                  reales via ?color=). No duplicamos el fieldset acá. */}

              <ProductCTAs
                addToCartLabel={t['storefront.productDetail.addToCart']}
                favoriteLabel={t['storefront.products.detail.v4.favorite']}
                inStock={IN_STOCK}
                productId={product.id}
                apiBaseUrl="/api/v1"
                loginHref={`/${locale}/login`}
              />

              {detail.financing !== undefined && (
                <ProductDetailFinancingBlock
                  syncLine={t['storefront.products.detail.v4.financing.syncLine']}
                  shopPayLine={t['storefront.products.detail.v4.financing.shopPay']}
                  learnMoreLabel={t['storefront.products.detail.v4.financing.learnMore']}
                />
              )}

              <div class="flex flex-col gap-2">
                {INCLUSION_ACCORDIONS.map((entry) => (
                  <ProductShippingAccordion label={entry.label} content={entry.content} />
                ))}
              </div>

              <a
                href={FIND_STORE_HREF}
                class="inline-flex items-center gap-1 self-start text-sm font-semibold text-[var(--primary,#475569)] hover:underline"
              >
                {t['storefront.products.detail.v4.findStore']}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </aside>
          </section>

          {/* Description block (card + Lee más toggle). Las specs por categoría
              se renderizan aparte en `<ProductSpecificationsByCategory>`. */}
          {detail.description.length > 0 && (
            <ProductDetailsBlock
              heading={undefined}
              intro={detail.description}
              moreLabel={t['storefront.products.detail.v4.details.more']}
              lessLabel={t['storefront.products.detail.v4.details.less']}
            />
          )}

          {detail.featuredArticle !== undefined && (
            <ProductFeaturedArticle
              {...detail.featuredArticle}
              ctaLabel={t['storefront.products.detail.v4.featuredArticle.cta']}
            />
          )}

          {/* Highlights — sólo si el mock los provee */}
          {detail.highlights !== undefined && detail.highlights.length > 0 && (
            <ProductHighlights
              heading={t['storefront.products.detail.v4.highlights.heading']}
              items={detail.highlights}
            />
          )}

          {/* Especificaciones por categoría — sólo si el mock las provee */}
          {detail.groupedSpecs !== undefined && detail.groupedSpecs.length > 0 && (
            <ProductSpecificationsByCategory
              heading={t['storefront.products.detail.v4.specsByCategory.heading']}
              groups={detail.groupedSpecs}
              expanded={expandedSpecs}
            />
          )}

          {/* Descripción extendida — Fase 8. Vacío = no renderiza. */}
          {detail.extendedDescriptions !== undefined && detail.extendedDescriptions.length > 0 && (
            <ProductExtendedDescription
              items={detail.extendedDescriptions}
              labels={{ heading: t['storefront.products.detail.v4.extendedDescription.heading'] }}
            />
          )}

          {/* Preguntas frecuentes — Fase 8. Vacío = no renderiza. */}
          {detail.faqs !== undefined && detail.faqs.length > 0 && (
            <ProductFAQ
              faqs={detail.faqs}
              labels={{ heading: t['storefront.products.detail.v4.faq.heading'] }}
            />
          )}

          {/* Reseñas — full-width después de specs (convención e-commerce: specs → reviews → related) */}
          {REVIEWS.length > 0 && (
            <ProductReviews
              labels={reviewsLabels}
              reviews={REVIEWS}
              viewAllHref={VIEW_ALL_HREF}
              writeHref={WRITE_REVIEW_HREF}
              apiBaseUrl="/api/v1"
              loginHref={`/${locale}/login`}
            />
          )}

          {/* Features carousel — removido: sección redundante con Highlights. */}

          {/* Related products — "You May Also Like"
              Derivados del catálogo real del tenant, filtrados por la
              categoría del producto actual (ver fetch SSR arriba).
              Si el backend devolvió error o la categoría sólo contiene el
              producto actual, la sección se oculta. `relatedError` se ignora
              a propósito: el PDP no expone el error al cliente (sólo en
              logs del server) y la sección vacía es suficiente. */}
          {relatedProducts.length > 0 && (
            <ProductRelated labels={cardLabels} products={relatedProducts} locale={locale} />
          )}

          {/* Recently viewed (client-side via localStorage) */}
          <ProductRecentlyViewed />
        </article>
      )}
    </section>
  </main>
  <script
    is:inline
    define:vars={{
      productSlug: product?.slug ?? 'unknown',
      productName: product?.name ?? '',
      productImage: CURRENT_PRODUCT.imageUrl,
      productPriceCents: CURRENT_PRODUCT.priceCents,
      productCurrency: CURRENT_PRODUCT.currency ?? 'USD',
    }}
  >
    // Inyecta la metadata del producto actual para que ProductRecentlyViewed
    // pueda trackearlo via localStorage en el cliente.
    window.__PRODUCT_META__ = {
      slug: productSlug,
      name: productName,
      imageUrl: productImage,
      priceCents: productPriceCents,
      currency: productCurrency,
    };
  </script>
  <script is:inline>
    // Scroll restoration: al recargar la página, permanecemos en la sección
    // que el usuario estaba leyendo (Reseñas, Specs, etc.). El estado vive
    // en sessionStorage (scoped al tab, muere al cerrar) y se rehidrata al
    // cargar. Tres señales: (a) click en anchor con #id, (b) beforeunload,
    // (c) restore al cargar.
    //
    // Persistencia del scroll position. La restauración YA se hizo en el
    // script al inicio del body (antes del primer paint). Acá solo
    // capturamos el scroll position cuando el usuario navega o recarga,
    // y guardamos en sessionStorage + cookie (triple redundancia con URL
    // search como backup, manejada en el script del inicio).
    (() => {
      const SS_KEY = 'pdp-scroll-y';
      const COOKIE_KEY = 'pdp-scroll-y';
      const COOKIE_ATTRS = 'path=/; max-age=86400; samesite=lax';

      // (a) Click en anchor con #id → guardar anchor (overrides position).
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const anchor = target.closest('a[href^="#"]');
        if (anchor === null) return;
        const href = anchor.getAttribute('href');
        if (href === null || href === '' || href === '#') return;
        if (document.querySelector(href) === null) return;
        try {
          sessionStorage.setItem(SS_KEY + ':anchor', href.slice(1));
        } catch {
          /* ignore */
        }
      });

      // (b) Capturar scrollY en cada cambio (debounced via rAF).
      let scrollYScheduled = false;
      window.addEventListener(
        'scroll',
        () => {
          if (scrollYScheduled) return;
          scrollYScheduled = true;
          requestAnimationFrame(() => {
            scrollYScheduled = false;
            try {
              sessionStorage.setItem(SS_KEY, String(window.scrollY));
              document.cookie = `${COOKIE_KEY}=${window.scrollY}; ${COOKIE_ATTRS}`;
              // URL backup: ?scrollY=N (limpiada en load).
              const url = new URL(window.location.href);
              if (url.searchParams.get('scrollY') !== String(window.scrollY)) {
                url.searchParams.set('scrollY', String(window.scrollY));
                window.history.replaceState(null, '', url.toString());
              }
            } catch {
              /* ignore */
            }
          });
        },
        { passive: true }
      );
    })();
  </script>
</StorefrontLayout>
