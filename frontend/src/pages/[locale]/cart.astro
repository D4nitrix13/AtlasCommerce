---
/**
 * Página pública del carrito de compras — Bonfire mockup 08.
 *
 * Composición v3 (sobre el cart store):
 *   - Header H1 con el título del carrito (server).
 *   - `CartView` (isla, `client:visible`) lee el cart store
 *     (`stores/cart.ts`, localStorage) y renderiza empty state, lista de
 *     líneas con controles de cantidad y resumen de totales. El conteo
 *     de productos vive en la isla porque depende del store, que el SSR
 *     no conoce.
 *   - `TrustSignalsCompact` (Astro estático, cero hidratación) entra
 *     como children de la isla para aparecer junto al resumen solo
 *     cuando hay líneas, sin duplicar su markup en TSX.
 *
 * Decisiones Bonfire:
 *   - `bg-slate-50` en el main + cards blancas con `rounded-2xl` +
 *     `border-slate-200` (consistente con el resto del storefront v3).
 *   - Resumen sticky en desktop (`lg:sticky lg:top-24`) dentro de la
 *     isla; en mobile apila debajo de la lista.
 *   - Lista con `data-reveal-stagger` para animar cada item al entrar
 *     al viewport (coherente con scroll-fx.css).
 */
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import CartView from '../../components/storefront/cart/CartView';
import TrustSignalsCompact from '../../components/storefront/cart/TrustSignalsCompact.astro';
import { getServerDictionary } from '../../i18n/server';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const checkoutHref = `/${locale}/checkout`;
const productsHref = `/${locale}/products`;

const cartViewLabels = {
  remove: t['storefront.cart.v3.remove'],
  decrement: t['storefront.cart.decrement'],
  increment: t['storefront.cart.increment'],
  qty: t['storefront.cart.v3.quantity'],
  subtotal: t['storefront.cart.v3.subtotal'],
  discount: t['storefront.cart.discount'],
  shipping: t['storefront.cart.v3.shipping'],
  shippingFree: t['storefront.cart.shippingFree'],
  tax: t['storefront.cart.v3.tax'],
  total: t['storefront.cart.v3.total'],
  checkout: t['storefront.cart.v3.checkout'],
  empty: t['storefront.cart.v3.empty'],
  emptyCta: t['storefront.cart.v3.emptyCta'],
  continueShopping: t['storefront.cart.v3.continueShopping'],
  itemsCount: t['storefront.cart.itemsCount'],
};
---

<StorefrontLayout title={t['storefront.cart.v3.title']}>
  <main class="w-full px-4 py-8 sm:px-6 sm:py-12 lg:px-10">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <h1 class="text-4xl sm:text-5xl">
        {t['storefront.cart.v3.title']}
      </h1>
    </header>

    <CartView
      client:visible
      locale={locale}
      labels={cartViewLabels}
      checkoutHref={checkoutHref}
      productsHref={productsHref}
    >
      <TrustSignalsCompact
        signals={[
          { iconKey: 'truck', label: 'Envio gratis sobre $50' },
          { iconKey: 'shield-check', label: 'Garantia oficial' },
          { iconKey: 'rotate-ccw', label: 'Devolucion 30 dias' },
          { iconKey: 'lock', label: 'Pago 100% seguro' },
        ]}
      />
    </CartView>
  </main>
</StorefrontLayout>
