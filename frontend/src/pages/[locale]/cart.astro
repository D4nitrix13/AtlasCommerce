---
/**
 * Página pública del carrito de compras — Bonfire mockup 08.
 *
 * Composición v3:
 *   - Header H1 con el título del carrito y el conteo de productos.
 *   - Layout 2 columnas en lg+: lista de CartItem a la izquierda, CartSummary
 *     sticky a la derecha. En mobile colapsa a una columna.
 *   - Si está vacío: empty state con CTA a /products.
 *
 * Decisiones Bonfire:
 *   - `bg-slate-50` en el main + cards blancas con `rounded-2xl` +
 *     `border-slate-200` (consistente con el resto del storefront v3).
 *   - Resumen sticky en desktop (`lg:sticky lg:top-24`) vía prop del
 *     CartSummary; en mobile apila debajo de la lista.
 *   - Lista con `data-reveal-stagger` para animar cada item al entrar
 *     al viewport (coherente con scroll-fx.css).
 *
 * TODO F1.4: cart store — hoy los datos son demo. Cuando el cart store
 * global exista, `demoItems` se reemplaza por `cart.items` y los handlers
 * de CartItem se hidratan.
 */
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import CartItem from '../../components/storefront/cart/CartItem.astro';
import CartSummary from '../../components/storefront/cart/CartSummary.astro';
import TrustSignalsCompact from '../../components/storefront/cart/TrustSignalsCompact.astro';
import { getServerDictionary } from '../../i18n/server';
import { PRODUCTS, findProductBySlug } from '../../data/products';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const checkoutHref = `/${locale}/checkout`;
const productsHref = `/${locale}/products`;

// TODO F1.4: cart store — leer de un store Zustand o endpoint backend.
// Demo: 3 items para que la composición se vea completa.
const demoItems = [
  { productSlug: PRODUCTS[0].slug, quantity: 1 }, // saber-alter-figma
  { productSlug: PRODUCTS[2].slug, quantity: 2 }, // chainsaw-man-t1
  { productSlug: PRODUCTS[6].slug, quantity: 1 }, // evangelion-unit-01
];

const cartItems = demoItems
  .map((entry) => {
    const product = findProductBySlug(entry.productSlug);
    if (product === null) {
      return null;
    }
    return {
      id: product.id,
      slug: product.slug,
      name: product.name,
      imageUrl: product.imageUrl,
      priceCents: product.priceCents,
      currency: product.currency ?? 'USD',
      quantity: entry.quantity,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);

const isEmpty = cartItems.length === 0;

const subtotalCents = cartItems.reduce((total, item) => total + item.priceCents * item.quantity, 0);
const currencyCode = cartItems[0]?.currency ?? 'USD';

// Envío gratis sobre $50, sino $4 fijo (placeholder UX).
const FREE_SHIPPING_THRESHOLD_CENTS = 5000;
const FLAT_SHIPPING_CENTS = 400;
const shippingCents =
  subtotalCents === 0
    ? null
    : subtotalCents >= FREE_SHIPPING_THRESHOLD_CENTS
      ? 0
      : FLAT_SHIPPING_CENTS;

// TODO F1.4: el tax real viene del backend (depende de país y catálogo).
// Aquí calculamos 15% sobre el subtotal como placeholder visual.
const TAX_RATE_BPS = 1500;
const taxCents = Math.round((subtotalCents * TAX_RATE_BPS) / 10_000);

const cartItemLabels = {
  remove: t['storefront.cart.v3.remove'],
  decrement: t['storefront.cart.decrement'],
  increment: t['storefront.cart.increment'],
  qty: t['storefront.cart.v3.quantity'],
};

const summaryLabels = {
  subtotal: t['storefront.cart.v3.subtotal'],
  discount: t['storefront.cart.discount'],
  shipping: t['storefront.cart.v3.shipping'],
  shippingFree: t['storefront.cart.shippingFree'],
  tax: t['storefront.cart.v3.tax'],
  total: t['storefront.cart.v3.total'],
  checkout: t['storefront.cart.v3.checkout'],
};

const totalUnits = cartItems.reduce((sum, item) => sum + item.quantity, 0);
---

<StorefrontLayout title={t['storefront.cart.v3.title']}>
  <main class="mx-auto w-full max-w-6xl bg-slate-50 px-4 py-8 sm:px-6 sm:py-12">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          {t['storefront.cart.v3.title']}
        </h1>
        {!isEmpty && (
          <p class="mt-2 text-sm text-slate-500">
            {cartItems.length} {cartItems.length === 1 ? 'producto' : 'productos'} · {totalUnits}{' '}
            {totalUnits === 1 ? 'unidad' : 'unidades'}
          </p>
        )}
      </div>
    </header>

    {isEmpty ? (
      <section class="flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-white p-10 text-center sm:p-16">
        <p class="text-2xl font-bold text-slate-900">{t['storefront.cart.v3.empty']}</p>
        <a
          href={productsHref}
          class="mt-2 inline-flex h-11 items-center justify-center rounded-lg bg-[var(--primary,#475569)] px-6 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#334155)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
        >
          {t['storefront.cart.v3.emptyCta']}
        </a>
      </section>
    ) : (
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div>
          <ul data-reveal-stagger class="flex list-none flex-col gap-4 p-0">
            {cartItems.map((item) => (
              <li class="list-none">
                <CartItem item={item} locale={locale} labels={cartItemLabels} />
              </li>
            ))}
          </ul>

          <a
            href={productsHref}
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition hover:text-slate-900"
          >
            <span aria-hidden="true">←</span>
            {t['storefront.cart.v3.continueShopping']}
          </a>
        </div>

        <div class="flex flex-col gap-5">
          <CartSummary
            subtotalCents={subtotalCents}
            currencyCode={currencyCode}
            shippingCents={shippingCents}
            taxCents={taxCents}
            checkoutHref={checkoutHref}
            labels={summaryLabels}
            isEmpty={false}
            stickyOnLg={true}
          />

          {/* Trust signals COMPACTOS (patron Nike + guitargear): cerca del
              CTA del CartSummary para reducir la ansiedad del usuario
              sobre envio, devolucion y pago seguro. Horizontal en
              desktop, wrap en mobile. */}
          <TrustSignalsCompact
            signals={[
              { iconKey: 'truck', label: 'Envio gratis sobre $50' },
              { iconKey: 'shield-check', label: 'Garantia oficial' },
              { iconKey: 'rotate-ccw', label: 'Devolucion 30 dias' },
              { iconKey: 'lock', label: 'Pago 100% seguro' },
            ]}
          />
        </div>
      </div>
    )}
  </main>
</StorefrontLayout>
