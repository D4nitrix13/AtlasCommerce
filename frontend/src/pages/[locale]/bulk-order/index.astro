---
/**
 * /bulk-order — Volumen B2B v3 (Bonfire mockup 07).
 *
 * Composición:
 *   1. Hero: eyebrow + h1 + intro (columna izquierda) y panel-resumen
 *      con los 5 breakpoints de descuento (columna derecha).
 *   2. TierComparator (5 cards comparativas lado a lado, una destacada).
 *   3. PricingCalculator (form con slider + selector de producto) a la
 *      izquierda + aside RFQ sticky a la derecha.
 *
 * Decisiones:
 *   - B2B (Panda Estampados) — usa tokens `--primary` heredados de
 *     `data-tenant="panda"` del layout raíz.
 *   - Reemplaza la versión previa (Calculator React + table plano)
 *     por una composición estática + island de TS. El calculator es
 *     Astro + script TS sin React para mantener bundle pequeño.
 *   - El comparator usa los 5 tiers canónicos F3.3 (10/25/50/100/500)
 *     con el tier 100+ marcado como "Más popular".
 *   - Full-width según `.interface-design/system.md`: `main` sin
 *     `max-w`/`mx-auto`, solo padding simétrico.
 *   - Accesibilidad (AGENTS §17):
 *       - `<section>` con `<h1>` jerárquico + aria-labelledby en cada bloque.
 *       - Calculator: `<form>` con `<label for>` + `<output aria-live>`.
 *       - Comparator: cada tier es `<article>` con `<h3>`.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import TierComparator from '../../../components/storefront/b2b/TierComparator.astro';
import PricingCalculator from '../../../components/storefront/b2b/PricingCalculator.astro';
import { getServerDictionary } from '../../../i18n/server';
import { isPandaStore, PANDA_PRODUCTS } from '../../../data/panda-catalog';
import { PRODUCTS } from '../../../data/products';
import type { BulkOrderProduct } from '../../../data/b2b-mock';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const rfqHref = `/${locale}/rfq`;

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const catalog = isPandaStore(tenantSlug) ? PANDA_PRODUCTS : PRODUCTS;
const catalogForVolume: readonly BulkOrderProduct[] = catalog.map((product) => ({
  id: product.id,
  slug: product.slug,
  name: product.name,
  description: product.description,
  basePriceCents: product.priceCents,
  currency: product.currency ?? 'USD',
  imageUrl: product.imageUrl,
  minQuantity: 10,
}));
---

<StorefrontLayout title={t['storefront.bulk_order.title']} cartCount={0}>
  <main class="w-full px-4 pb-16 pt-8 sm:px-6 sm:pt-12 lg:px-10 lg:pb-16">
    <header class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-12">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--primary-soft,#e6f7f4)] px-3 py-1 text-xs font-semibold text-[var(--primary,#2d9d8e)]">
          <span aria-hidden="true">★</span>
          {t['storefront.b2b.bulk.v3.eyebrow']}
        </span>
        <h1 class="mt-3 text-4xl sm:text-5xl">{t['storefront.b2b.bulk.v3.title']}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--ink,#1c1917)]/70 sm:text-lg">
          {t['storefront.b2b.bulk.v3.intro']}
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--line,#e7e5e4)] bg-white p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)]">
        <div class="flex items-baseline justify-between gap-3 border-t border-[var(--line,#e7e5e4)]/60 py-2 first:border-t-0">
          <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/55">
            10+ unidades
          </span>
          <span class="text-sm font-semibold tabular-nums text-[var(--ink,#1c1917)]">Base</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-[var(--line,#e7e5e4)]/60 py-2 first:border-t-0">
          <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/55">
            25+ unidades
          </span>
          <span class="text-sm font-semibold tabular-nums text-[var(--ink,#1c1917)]">-5%</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-[var(--line,#e7e5e4)]/60 py-2 first:border-t-0">
          <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/55">
            50+ unidades
          </span>
          <span class="text-sm font-semibold tabular-nums text-[var(--ink,#1c1917)]">-12%</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-[var(--line,#e7e5e4)]/60 py-2 first:border-t-0">
          <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/55">
            100+ unidades
          </span>
          <span class="text-sm font-semibold tabular-nums text-[var(--primary,#2d9d8e)]">-20%</span>
        </div>
        <div class="flex items-baseline justify-between gap-3 border-t border-[var(--line,#e7e5e4)]/60 py-2 first:border-t-0">
          <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/55">
            500+ unidades
          </span>
          <span class="text-sm font-semibold tabular-nums text-[var(--ink,#1c1917)]">-35%</span>
        </div>
      </div>
    </header>

    <section class="mt-12">
      <TierComparator
        basePriceCents={2400}
        currency="USD"
        popularBadge={t['storefront.b2b.bulk.v3.popularBadge']}
        includesLabel={t['storefront.b2b.bulk.v3.includes']}
        ctaLabel={t['storefront.b2b.bulk.v3.calculator.cta']}
        perUnitLabel={t['storefront.b2b.bulk.v3.perUnit']}
        ctaHref={rfqHref}
        eyebrow={t['storefront.b2b.bulk.v3.popularBadge']}
      />
    </section>

    <section class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:gap-8">
      <PricingCalculator
        heading={t['storefront.b2b.bulk.v3.calculator.heading']}
        productLabel={t['storefront.b2b.bulk.v3.calculator.productLabel']}
        quantityLabel={t['storefront.b2b.bulk.v3.calculator.quantityLabel']}
        quantityHint={t['storefront.b2b.bulk.v3.calculator.quantityHint']}
        unitPriceLabel={t['storefront.b2b.bulk.v3.calculator.unitPriceLabel']}
        totalLabel={t['storefront.b2b.bulk.v3.calculator.totalLabel']}
        savingsLabel={t['storefront.b2b.bulk.v3.calculator.savingsLabel']}
        tierLabelTemplate={t['storefront.b2b.bulk.v3.calculator.tierLabel']}
        ctaLabel={t['storefront.b2b.bulk.v3.calculator.cta']}
        ctaHref={rfqHref}
        products={catalogForVolume}
      />

      <aside
        class="rounded-2xl border border-[var(--line,#e7e5e4)] bg-white p-6 shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)] lg:sticky lg:top-24"
        aria-labelledby="bulk-help-heading"
      >
        <h2 id="bulk-help-heading" class="text-lg">
          {t['storefront.b2b.bulk.v3.help.heading']}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--ink,#1c1917)]/70">
          {t['storefront.b2b.bulk.v3.help.body']}
        </p>
        <a
          href={rfqHref}
          class="mt-4 inline-flex h-12 w-full items-center justify-center rounded-lg bg-[var(--primary,#2d9d8e)] px-4 text-sm font-semibold text-white transition-transform hover:bg-[var(--primary-hover,#258777)] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2d9d8e)] focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:active:scale-100"
        >
          {t['storefront.b2b.bulk.v3.help.cta']}
        </a>
      </aside>
    </section>
  </main>
</StorefrontLayout>
