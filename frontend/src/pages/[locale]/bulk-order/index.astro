---
/**
 * /bulk-order — Volumen B2B v3 (Bonfire mockup 07).
 *
 * Composición:
 *   1. Heading + intro del modelo B2B de tiers.
 *   2. TierComparator (5 cards comparativas lado a lado, una destacada).
 *   3. PricingCalculator (form con slider + selector de producto).
 *   4. Aside con CTA a /rfq para pedidos fuera de bulk estándar.
 *
 * Decisiones:
 *   - B2B (Panda Estampados) — usa tokens `--primary` heredados de
 *     `data-tenant="panda"` del layout raíz.
 *   - Reemplaza la versión previa (Calculator React + table plano)
 *     por una composición estática + island de TS. El calculator es
 *     Astro + script TS sin React para mantener bundle pequeño.
 *   - El comparator usa los 5 tiers canónicos F3.3 (10/25/50/100/500)
 *     con el tier 100+ marcado como "Más popular".
 *   - Accesibilidad (AGENTS §17):
 *       - `<section>` con `<h1>` jerárquico + aria-labelledby en cada bloque.
 *       - Calculator: `<form>` con `<label for>` + `<output aria-live>`.
 *       - Comparator: cada tier es `<article>` con `<h3>`.
 */
import StorefrontLayout from '../../../layouts/StorefrontLayout.astro';
import TierComparator from '../../../components/storefront/b2b/TierComparator.astro';
import PricingCalculator from '../../../components/storefront/b2b/PricingCalculator.astro';
import { getServerDictionary } from '../../../i18n/server';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const rfqHref = `/${locale}/rfq`;
---

<StorefrontLayout title={t['storefront.bulk_order.title']} cartCount={0}>
  <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <header class="mb-8 max-w-3xl sm:mb-10">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-[var(--primary-soft,#e6f7f4)] px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[var(--primary,#2d9d8e)]"
      >
        <span aria-hidden="true">★</span>
        {t['storefront.b2b.bulk.v3.eyebrow']}
      </span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        {t['storefront.b2b.bulk.v3.title']}
      </h1>
      <p class="mt-3 max-w-2xl text-base text-slate-600 sm:text-lg">
        {t['storefront.b2b.bulk.v3.intro']}
      </p>
    </header>

    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <TierComparator
        basePriceCents={2400}
        currency="USD"
        popularBadge={t['storefront.b2b.bulk.v3.popularBadge']}
        includesLabel={t['storefront.b2b.bulk.v3.includes']}
        ctaLabel={t['storefront.b2b.bulk.v3.calculator.cta']}
        perUnitLabel={t['storefront.b2b.bulk.v3.perUnit']}
        ctaHref={rfqHref}
        eyebrow={t['storefront.b2b.bulk.v3.popularBadge']}
      />
    </div>

    <section class="mt-10 grid gap-6 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)]">
      <PricingCalculator
        heading={t['storefront.b2b.bulk.v3.calculator.heading']}
        productLabel={t['storefront.b2b.bulk.v3.calculator.productLabel']}
        quantityLabel={t['storefront.b2b.bulk.v3.calculator.quantityLabel']}
        quantityHint={t['storefront.b2b.bulk.v3.calculator.quantityHint']}
        unitPriceLabel={t['storefront.b2b.bulk.v3.calculator.unitPriceLabel']}
        totalLabel={t['storefront.b2b.bulk.v3.calculator.totalLabel']}
        savingsLabel={t['storefront.b2b.bulk.v3.calculator.savingsLabel']}
        tierLabelTemplate={t['storefront.b2b.bulk.v3.calculator.tierLabel']}
        ctaLabel={t['storefront.b2b.bulk.v3.calculator.cta']}
        ctaHref={rfqHref}
      />
    </section>

    <aside
      class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6"
      aria-labelledby="bulk-help-heading"
    >
      <h2
        id="bulk-help-heading"
        class="text-base font-bold text-slate-900 sm:text-lg"
      >
        {t['storefront.b2b.bulk.v3.help.heading']}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
        {t['storefront.b2b.bulk.v3.help.body']}
      </p>
      <a
        href={rfqHref}
        class="mt-4 inline-flex h-11 items-center justify-center rounded-full bg-[var(--primary,#2d9d8e)] px-6 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#258777)]"
      >
        {t['storefront.b2b.bulk.v3.help.cta']}
      </a>
    </aside>
  </main>
</StorefrontLayout>