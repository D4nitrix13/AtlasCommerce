---
/**
 * `/[locale]/checkout` — flujo multi-step del checkout.
 *
 * La isla `CheckoutFlow` (client:visible) es dueña del flujo: estado de
 * paso en React, sin recargas GET entre pasos, borrador en
 * sessionStorage y validación por paso (RHF + Zod). El deep-link
 * `?step=` sigue funcionando: el paso inicial se resuelve en SSR y
 * `history.replaceState` lo mantiene sincronizado.
 *
 * Contratos preservados:
 *  - `?step=shipping|payment|review|success` (out-of-range → shipping).
 *  - `?step=success` → CheckoutSuccess SSR con número de pedido mock.
 *  - `data-cart-href` + script de redirect por carrito vacío (se saltea
 *    en success).
 */
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import CheckoutFlow from '../../components/storefront/checkout/CheckoutFlow';
import CheckoutSuccess from '../../components/storefront/checkout/CheckoutSuccess.astro';
import type { CheckoutStepId } from '../../components/storefront/checkout/checkoutSchemas';
import { getServerDictionary } from '../../i18n/server';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const checkoutBaseHref = `/${locale}/checkout`;
const cartHref = `/${locale}/cart`;
const catalogHref = `/${locale}/products`;
const orderHref = `/${locale}/account/orders`;
const helpHref = `/${locale}/account`;

// ─── Step actual desde query param `?step=`. Default = 'shipping'.
// `success` no es un step del stepper: es la confirmación terminal.
const VALID_STEPS: readonly CheckoutStepId[] = ['shipping', 'payment', 'review'];
const url = new URL(Astro.request.url);
const rawStep = url.searchParams.get('step') ?? 'shipping';
const isSuccess = rawStep === 'success';
const currentStepId: CheckoutStepId = (VALID_STEPS as readonly string[]).includes(rawStep)
  ? (rawStep as CheckoutStepId)
  : 'shipping';

// ─── Labels de la isla (resueltos desde i18n; incluye trust signals
// compartidos con el carrito — `storefront.cart.v3.trust.*`).
const flowLabels = {
  stepper: {
    stepOf: t['storefront.checkout.v3.stepOf'],
    stepperLabel: t['storefront.checkout.v3.stepperLabel'],
  },
  stepLabels: {
    shipping: t['storefront.checkout.v3.step1'],
    payment: t['storefront.checkout.v3.step2'],
    review: t['storefront.checkout.v3.step3'],
  },
  shipping: {
    heading: t['storefront.checkout.v3.shippingHeading'],
    name: t['storefront.checkout.v3.shipping.name'],
    email: t['storefront.checkout.v3.shipping.email'],
    phone: t['storefront.checkout.v3.shipping.phone'],
    address1: t['storefront.checkout.v3.shipping.address1'],
    address2: t['storefront.checkout.v3.shipping.address2'],
    city: t['storefront.checkout.v3.shipping.city'],
    state: t['storefront.checkout.v3.shipping.state'],
    postal: t['storefront.checkout.v3.shipping.postal'],
    country: t['storefront.checkout.v3.shipping.country'],
  },
  payment: {
    heading: t['storefront.checkout.v3.paymentHeading'],
    methodLegend: t['storefront.checkout.v3.payment.method'],
    card: t['storefront.checkout.v3.payment.card'],
    transfer: t['storefront.checkout.v3.payment.transfer'],
    cod: t['storefront.checkout.v3.payment.cod'],
    cardDesc: t['storefront.checkout.v3.payment.cardDesc'],
    transferDesc: t['storefront.checkout.v3.payment.transferDesc'],
    codDesc: t['storefront.checkout.v3.payment.codDesc'],
    cardDetails: t['storefront.checkout.v3.cardDetails'],
    cardName: t['storefront.checkout.v3.payment.cardName'],
    cardNumber: t['storefront.checkout.v3.payment.cardNumber'],
    expiry: t['storefront.checkout.v3.payment.expiry'],
    cvv: t['storefront.checkout.v3.payment.cvv'],
  },
  review: {
    heading: t['storefront.checkout.v3.reviewHeading'],
    hint: t['storefront.checkout.v3.reviewHint'],
    edit: t['storefront.checkout.v3.edit'],
    qty: t['storefront.checkout.v3.qty'],
    subtotal: t['storefront.checkout.v3.subtotal'],
    emptyItems: t['storefront.checkout.v3.empty'],
    shippingStep: t['storefront.checkout.v3.step1'],
    paymentStep: t['storefront.checkout.v3.step2'],
  },
  summary: {
    summary: t['storefront.checkout.v3.summary'],
    emptyItems: t['storefront.checkout.v3.empty'],
    subtotal: t['storefront.checkout.v3.subtotal'],
    shippingCost: t['storefront.checkout.v3.shippingCost'],
    shippingFree: t['storefront.checkout.v3.shippingFree'],
    tax: t['storefront.checkout.v3.tax'],
    total: t['storefront.checkout.v3.total'],
    freeShippingProgress: t['storefront.cart.v3.freeShippingProgress'],
    freeShippingReached: t['storefront.cart.v3.freeShippingReached'],
    trust: {
      shipping: t['storefront.cart.v3.trust.shipping'],
      guarantee: t['storefront.cart.v3.trust.guarantee'],
      returns: t['storefront.cart.v3.trust.returns'],
      secure: t['storefront.cart.v3.trust.secure'],
    },
  },
  continueToPayment: t['storefront.checkout.v3.continueToPayment'],
  continueToReview: t['storefront.checkout.v3.continueToReview'],
  placeOrder: t['storefront.checkout.v3.placeOrder'],
  previous: t['storefront.checkout.v3.previous'],
  termsHint: t['storefront.checkout.v3.termsHint'],
  validation: {
    required: t['storefront.checkout.v3.validation.required'],
    email: t['storefront.checkout.v3.validation.email'],
    postal: t['storefront.checkout.v3.validation.postal'],
  },
  error: {
    title: t['storefront.checkout.v3.error.title'],
    message: t['storefront.checkout.v3.error.message'],
  },
};

// ─── Labels del success (confirmación post-pedido).
const successLabels = {
  title: t['storefront.checkout.success.title'],
  subtitle: t['storefront.checkout.success.subtitle'],
  orderNumber: t['storefront.checkout.success.orderNumber'],
  confirmationEmail: t['storefront.checkout.success.confirmationEmail'],
  continueShopping: t['storefront.checkout.success.continueShopping'],
  viewOrder: t['storefront.checkout.success.viewOrder'],
  help: t['storefront.checkout.success.help'],
};
// Placeholder hasta que el backend asigne el número real de pedido.
const orderNumber = `PE-${Date.now().toString(36).toUpperCase()}`;
---

<StorefrontLayout title={t['storefront.checkout.v3.title']}>
  <main data-cart-href={cartHref}>
    {isSuccess ? (
      <section class="w-full px-4 py-8 sm:px-6 sm:py-12 lg:px-10">
        <CheckoutSuccess
          labels={successLabels}
          orderNumber={orderNumber}
          catalogHref={catalogHref}
          orderHref={orderHref}
          helpHref={helpHref}
        />
      </section>
    ) : (
      <section class="w-full px-4 py-8 sm:px-6 sm:py-12 lg:px-10">
        <header class="mb-6 sm:mb-10">
          <h1 class="text-4xl sm:text-5xl">
            {t['storefront.checkout.v3.title']}
          </h1>
        </header>

        <CheckoutFlow
          client:visible
          initialStep={currentStepId}
          checkoutBaseHref={checkoutBaseHref}
          labels={flowLabels}
        />
      </section>
    )}
  </main>
</StorefrontLayout>

<script>
  // Redirect por carrito vacío. Antes era un Astro.redirect en el SSR,
  // pero el store vive en localStorage: la verdad está en el cliente.
  import { cartStore } from '../../stores/cart';

  const root = document.querySelector<HTMLElement>('[data-cart-href]');
  const cartHref = root?.dataset.cartHref ?? '/cart';
  const params = new URLSearchParams(window.location.search);
  // `?step=success` no redirige: el pedido ya se hizo y el carrito puede
  // estar vacío.
  if (params.get('step') !== 'success' && cartStore.getSnapshot().lines.length === 0) {
    window.location.assign(cartHref);
  }
</script>
