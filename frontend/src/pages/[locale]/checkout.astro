---
/**
 * `/[locale]/checkout` — flujo multi-step V3 estilo Bonfire.
 *
 * Replica el IA mockup `09-checkout.html`:
 *  - H1 "Finalizar compra".
 *  - Stepper horizontal de 3 pasos (Envío / Pago / Revisión) con
 *    círculos numerados conectados por líneas; activo en `--primary`,
 *    completado con check.
 *  - 2-col grid desktop (form izquierda · summary sticky derecha).
 *  - Background `bg-slate-50` en `<main>`.
 *  - Empty cart → redirect a `/cart` con locale preservado.
 *
 * Decisiones:
 *  - El carrito es MOCK (mismo demo de `cart.astro` v3). Cuando exista
 *    el cart store global, `cartItems` se hidrata del store.
 *  - Los pasos se navegan por GET (sin JS): cada step es un `?step=`
 *    alias; steps futuros se ocultan vía `<fieldset hidden>` para que
 *    no aparezcan en el AT.
 *  - Submit final es un `<button type="submit">` que navega a
 *    `?step=success` (placeholder sin backend real).
 *  - Single source of truth de totales: pre-computamos acá y los
 *    pasamos al summary; cuando exista el backend, esto se hidrata
 *    de la misma forma.
 */
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import CheckoutStepperV3 from '../../components/storefront/checkout/CheckoutStepperV3.astro';
import CheckoutSummaryV3 from '../../components/storefront/checkout/CheckoutSummaryV3.astro';
import CheckoutFormV3, {
  type CheckoutV3StepId,
} from '../../components/storefront/checkout/CheckoutFormV3.astro';
import { getServerDictionary } from '../../i18n/server';
import { PRODUCTS, findProductBySlug } from '../../data/products';

const locale = Astro.locals.locale ?? 'es';
const t = getServerDictionary(locale);

const checkoutBaseHref = `/${locale}/checkout`;
const cartHref = `/${locale}/cart`;

// ─── Step actual desde query param `?step=`. Default = 'shipping'.
const VALID_STEPS: readonly CheckoutV3StepId[] = ['shipping', 'payment', 'review'];
const url = new URL(Astro.request.url);
const rawStep = url.searchParams.get('step') ?? 'shipping';
const currentStepId: CheckoutV3StepId =
  (VALID_STEPS as readonly string[]).includes(rawStep)
    ? (rawStep as CheckoutV3StepId)
    : 'shipping';

// ─── Mock cart: 2 items demo (mismas elecciones que cart.astro v3).
const demoCart = [
  { productSlug: PRODUCTS[0].slug, quantity: 2 },
  { productSlug: PRODUCTS[2].slug, quantity: 1 },
];

const cartItems = demoCart
  .map((entry) => {
    const product = findProductBySlug(entry.productSlug);
    if (product === null) {
      return null;
    }
    return {
      id: product.id,
      name: product.name,
      imageUrl: product.imageUrl,
      priceCents: product.priceCents,
      currency: product.currency ?? 'USD',
      quantity: entry.quantity,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);

// ─── Empty-safe: si no hay items, redirigimos a /cart.
if (cartItems.length === 0) {
  return Astro.redirect(cartHref);
}

// ─── Labels del stepper.
const stepperSteps = [
  { id: 'shipping', label: t['storefront.checkout.v3.step1'] },
  { id: 'payment', label: t['storefront.checkout.v3.step2'] },
  { id: 'review', label: t['storefront.checkout.v3.step3'] },
];

// ─── Labels del form.
const formLabels = {
  shippingHeading: t['storefront.checkout.v3.shippingHeading'],
  paymentHeading: t['storefront.checkout.v3.paymentHeading'],
  reviewHeading: t['storefront.checkout.v3.reviewHeading'],
  reviewHint: t['storefront.checkout.v3.reviewHint'],
  previous: t['storefront.checkout.v3.previous'],
  next: t['storefront.checkout.v3.next'],
  placeOrder: t['storefront.checkout.v3.placeOrder'],
  shipping: {
    shippingHeading: t['storefront.checkout.v3.shippingHeading'],
    name: t['storefront.checkout.v3.shipping.name'],
    email: t['storefront.checkout.v3.shipping.email'],
    phone: t['storefront.checkout.v3.shipping.phone'],
    address1: t['storefront.checkout.v3.shipping.address1'],
    address2: t['storefront.checkout.v3.shipping.address2'],
    city: t['storefront.checkout.v3.shipping.city'],
    state: t['storefront.checkout.v3.shipping.state'],
    postal: t['storefront.checkout.v3.shipping.postal'],
    country: t['storefront.checkout.v3.shipping.country'],
  },
  payment: {
    paymentHeading: t['storefront.checkout.v3.paymentHeading'],
    paymentMethod: t['storefront.checkout.v3.payment.method'],
    card: t['storefront.checkout.v3.payment.card'],
    transfer: t['storefront.checkout.v3.payment.transfer'],
    cod: t['storefront.checkout.v3.payment.cod'],
    cardDetails: t['storefront.checkout.v3.cardDetails'],
    cardNumber: t['storefront.checkout.v3.payment.cardNumber'],
    expiry: t['storefront.checkout.v3.payment.expiry'],
    cvv: t['storefront.checkout.v3.payment.cvv'],
    cardName: t['storefront.checkout.v3.payment.cardName'],
  },
  review: {
    qty: t['storefront.checkout.v3.qty'],
    subtotal: t['storefront.checkout.v3.subtotal'],
  },
};

// ─── Labels del summary.
const summaryLabels = {
  summary: t['storefront.checkout.v3.summary'],
  emptyItems: t['storefront.checkout.v3.empty'],
  subtotal: t['storefront.checkout.v3.subtotal'],
  shippingCost: t['storefront.checkout.v3.shippingCost'],
  shippingFree: t['storefront.checkout.v3.shippingFree'],
  tax: t['storefront.checkout.v3.tax'],
  total: t['storefront.checkout.v3.total'],
  cta: t['storefront.checkout.v3.placeOrder'],
  termsHint: t['storefront.checkout.v3.termsHint'],
};

// ─── Totales (single source of truth en el padre).
const subtotalCents = cartItems.reduce(
  (total, item) => total + item.priceCents * item.quantity,
  0
);
const currencyCode = cartItems[0]?.currency ?? 'USD';

// Free shipping sobre $50 (mismo umbral que cart.astro v3).
const FREE_SHIPPING_THRESHOLD_CENTS = 5000;
const shippingCents: number | null =
  subtotalCents >= FREE_SHIPPING_THRESHOLD_CENTS ? 0 : 400;

// Tax placeholder: 15% del subtotal.
const TAX_RATE = 0.15;
const taxCents = Math.round(subtotalCents * TAX_RATE);
---

<StorefrontLayout title={t['storefront.checkout.v3.title']}>
  <main class="bg-slate-50">
    <section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
      <header class="mb-6 sm:mb-10">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          {t['storefront.checkout.v3.title']}
        </h1>
      </header>

      <CheckoutStepperV3
        steps={stepperSteps}
        currentStepId={currentStepId}
        stepHrefBase={checkoutBaseHref}
      />

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-10">
        <div class="order-2 lg:order-1">
          <CheckoutFormV3
            currentStepId={currentStepId}
            stepHrefBase={checkoutBaseHref}
            items={cartItems}
            currencyCode={currencyCode}
            labels={formLabels}
          />
        </div>

        <div class="order-1 lg:order-2">
          <CheckoutSummaryV3
            items={cartItems}
            subtotalCents={subtotalCents}
            currencyCode={currencyCode}
            shippingCents={shippingCents}
            taxCents={taxCents}
            labels={summaryLabels}
            ctaHref={`${checkoutBaseHref}?step=success`}
          />
        </div>
      </div>
    </section>
  </main>
</StorefrontLayout>
