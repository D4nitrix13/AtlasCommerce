---
import AuthLayout from '../../../layouts/AuthLayout.astro';
import AuthShell from '../../../components/auth/AuthShell.astro';
import StorefrontForgotPasswordForm from '../../../components/storefront/auth/StorefrontForgotPasswordForm';
import LanguageSwitcher from '../../../components/ui/LanguageSwitcher';
import { getServerDictionary } from '../../../i18n/server';
import { getBrandBySlug, DEFAULT_BRAND } from '../../../config/stores';
import { themeToBrand } from '../../../lib/theme';

const t = getServerDictionary(Astro.locals.locale);

const fallbackBrand = getBrandBySlug(Astro.locals.tenant?.tenantSlug ?? null) ?? DEFAULT_BRAND;
const brand = themeToBrand(Astro.locals.theme, fallbackBrand);
---

<AuthLayout title={`${t['auth.forgot.shell.heading']} · ${brand.name}`}>
  <AuthShell
    illustration=`/images/amico/auth/forgot-password.svg`
    illustrationAlt={t['auth.shell.illustration.alt']}
    leftHeading={t['auth.forgot.shell.leftHeading']}
    leftBody={t['auth.forgot.shell.leftBody']}
    brandName={brand.name}
    brandLogo={brand.logoPath}
    topRightLink="back"
    side="left"
  >
    <LanguageSwitcher slot="topRightExtra" client:load theme="light" />

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">{t['auth.forgot.shell.heading']}</h1>
      <p class="mt-2 text-slate-500">{t['auth.forgot.shell.subtitle']}</p>
    </div>

    <StorefrontForgotPasswordForm client:load />

    <div class="mt-8 p-4 bg-[var(--brand-accent-bg,#E6F7F4)] border border-[var(--brand-accent-border,#C2EBE4)] rounded-lg flex gap-3">
      <svg
        class="w-5 h-5 text-[var(--brand-accent-dark,#1E6F62)] flex-shrink-0 mt-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        ></path>
      </svg>
      <div class="text-sm text-slate-600">
        <strong class="text-slate-800">{t['auth.forgot.shell.infoTitle']}</strong>{' '}
        <span
          set:html={t['auth.forgot.shell.infoBody'].replace(
            '{support}',
            `<a href="#" class="text-[var(--brand-accent,#2D9D8E)] hover:underline font-medium">${t['auth.forgot.shell.supportLink']}</a>`
          )}
        />
      </div>
    </div>

    <p class="text-center text-xs text-slate-400 mt-8" slot="terms">
      {t['auth.shell.termsPrefix']}{' '}
      <a href="#" class="underline hover:text-[var(--brand-accent,#2D9D8E)]">
        {t['auth.shell.termsLink']}
      </a>{' '}
      {t['auth.shell.termsAnd'] ?? 'y'}{' '}
      <a href="#" class="underline hover:text-[var(--brand-accent,#2D9D8E)]">
        {t['auth.shell.privacyLink']}
      </a>
      .
    </p>
  </AuthShell>
</AuthLayout>
