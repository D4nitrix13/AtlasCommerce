---
/**
 * `/[locale]/account/orders/[id]` — Detalle del trabajo (job-ticket).
 *
 * Rediseño al lenguaje del taller (consistente con el dashboard):
 *  1. Back link quieto.
 *  2. Hero: hoja `paper-card-hero` con marcas de registro, banda
 *     kraft (Orden de trabajo · #ID + chip de tinta) y el rail de
 *     etapas `ProductionRail` como FOCAL.
 *  3. Acciones compactas: Descargar factura (documento real, data
 *     URL) · Solicitar cambio (mail del soporte del tenant) ·
 *     Rastrear envío · Volver a pedir.
 *  4. Tracking, timeline (5 hitos), items / envío / pago.
 *  5. 404 amistoso reestilizado (sin emojis).
 *
 * Decisiones:
 *  - Sin emojis, sin hex de tenant (todo `var(--primary)` / tintas).
 *  - "Descargar factura" genera un documento HTML autocontenido
 *    descargable desde los mocks — no se inventa backend.
 *  - "Solicitar cambio" abre el mail del soporte del tenant.
 */
import AccountLayout from '../../../../layouts/AccountLayout.astro';
import OrderTimeline from '../../../../components/account/orders/OrderTimeline.astro';
import OrderItemsList from '../../../../components/account/orders/OrderItemsList.astro';
import OrderShippingCard from '../../../../components/account/orders/OrderShippingCard.astro';
import OrderPaymentSummary from '../../../../components/account/orders/OrderPaymentSummary.astro';
import InkChip from '../../../../components/account/dashboard/InkChip.astro';
import ProductionRail from '../../../../components/account/dashboard/ProductionRail.astro';
import RegistrationMarks from '../../../../components/account/dashboard/RegistrationMarks.astro';
import { getServerDictionary, getServerLocale } from '../../../../i18n/server';
import { findOrderById, countOrderItems, type OrderMock } from '../../../../data/orders-mock';
import { PRODUCTION_STAGE_INDEX } from '../../../../data/dashboard-kpis';
import { getBrandBySlug } from '../../../../config/stores';
import { themeToBrand } from '../../../../lib/theme';
import { formatCurrency, formatDate } from '../../../../lib/formatters';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const orderId = Astro.params.id;
const order = typeof orderId === 'string' ? findOrderById(orderId) : null;

const localePrefix = `/${locale}`;
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const brand = themeToBrand(Astro.locals.theme, getBrandBySlug(tenantSlug));

const orderIdTemplate = t['account.dashboard.recentOrders.orderId'];
const orderLabel = (id: string): string => orderIdTemplate.replace('{id}', id);

interface InvoiceLabels {
  title: string;
  orderNumber: string;
  date: string;
  items: string;
  quantity: string;
  unitPrice: string;
  total: string;
}

/** Documento de factura autocontenido (descargable desde los mocks). */
function buildInvoiceHtml(current: OrderMock, labels: InvoiceLabels): string {
  const rows = current.items
    .map(
      (item) =>
        `<tr><td>${item.productName}</td><td>${item.quantity}</td><td>${formatCurrency(item.unitPriceCents, 'USD')}</td></tr>`
    )
    .join('');
  const total = formatCurrency(current.totalCents, 'USD');
  return `<!doctype html><meta charset="utf-8"><title>${labels.title} ${current.id}</title><body style="font-family:system-ui,sans-serif;background:#f3efe8;color:#1c1917;padding:40px"><h1 style="font-size:22px">${labels.title} · ${labels.orderNumber} ${current.id}</h1><p>${labels.date}: ${formatDate(current.date)}</p><table style="width:100%;border-collapse:collapse" cellpadding="8"><thead><tr style="text-align:left;border-bottom:1px solid rgba(28,25,23,.15)"><th>${labels.items}</th><th>${labels.quantity}</th><th>${labels.unitPrice}</th></tr></thead><tbody>${rows}</tbody></table><p style="font-size:18px;font-weight:600">${labels.total}: ${total}</p></body>`;
}

const invoiceHref =
  order === null
    ? '#'
    : `data:text/html;charset=utf-8,${encodeURIComponent(
        buildInvoiceHtml(order, {
          title: t['account.orders.invoice.title'],
          orderNumber: t['account.orders.list.column.orderNumber'],
          date: t['account.orders.list.column.date'],
          items: t['account.orders.list.column.items'],
          quantity: t['account.orders.detail.items.quantity'],
          unitPrice: t['account.orders.invoice.unitPrice'],
          total: t['account.orders.detail.payment.total'],
        })
      )}`;

const changeSubject =
  order === null ? '' : t['account.orders.action.requestChangeSubject'].replace('{id}', order.id);
const changeBody =
  order === null
    ? ''
    : t['account.orders.action.requestChangeBody']
        .replace('{id}', order.id)
        .replace('{date}', formatDate(order.date));
const requestChangeHref = `mailto:${brand.supportEmail}?subject=${encodeURIComponent(changeSubject)}&body=${encodeURIComponent(changeBody)}`;

const isDelivered = order?.status === 'delivered';
const reorderHref =
  order !== null && isDelivered && order.items.length > 0
    ? `${localePrefix}/products/${order.items[0].productSlug}`
    : null;
---

<AccountLayout title={t['account.orders.detail.heading']}>
  {!order && (
    <section class="paper-card-hero relative overflow-hidden px-6 py-14 text-center lg:px-12">
      <RegistrationMarks />
      <p class="micro-label">{t['account.orders.ledger.eyebrow']}</p>
      <h1 class="mt-3 font-display text-3xl lg:text-[40px]">
        {t['account.orders.detail.notFound.title']}
      </h1>
      <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-[var(--ink-muted)]">
        {t['account.orders.detail.notFound.hint']}
      </p>
      <a
        href={`${localePrefix}/account/orders`}
        class="pressable mt-8 inline-flex min-h-10 items-center rounded-[10px] px-5 py-2.5 text-sm font-semibold text-white"
        style="background:var(--primary)"
      >
        {t['account.orders.detail.notFound.back']}
      </a>
    </section>
  )}

  {order && (
    <div class="flex flex-col gap-8">
      <a
        href={`${localePrefix}/account/orders`}
        class="pressable inline-flex w-fit min-h-10 items-center gap-1.5 text-sm font-semibold text-[var(--primary)] hover:underline"
      >
        <span aria-hidden="true">←</span>
        {t['account.orders.detail.backToList']}
      </a>

      {order.status === 'cancelled' && (
        <div
          role="status"
          class="rounded-[12px] px-5 py-4 text-sm"
          style="background:var(--ink-void-soft);color:var(--ink-void)"
        >
          {t['account.orders.detail.cancelled.banner']}
        </div>
      )}

      {/* Hero: la orden de trabajo. */}
      <article class="paper-card-hero relative overflow-hidden" data-reveal>
        <RegistrationMarks />
        <header class="kraft-band flex flex-wrap items-center justify-between gap-3 px-6 py-3 lg:px-10">
          <p class="micro-label" style="color:var(--ink-soft)">
            {t['account.orders.detail.ticketLabel']}
            <span aria-hidden="true" class="mx-1.5 text-[var(--ink-faint)]">
              ·
            </span>
            <span>#{order.id}</span>
          </p>
          <InkChip status={order.status} t={t} />
        </header>

        <div class="flex flex-col gap-8 px-6 py-8 lg:px-10 lg:py-10">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="micro-label">{t['account.dashboard.ticket.open']}</p>
              <h1 class="mt-2 font-display text-4xl leading-none tracking-tight lg:text-[44px]">
                {orderLabel(order.id)}
              </h1>
              <p class="mt-3 text-[13px] text-[var(--ink-muted)]">
                {t['account.dashboard.ticket.pieces'].replace(
                  '{count}',
                  String(countOrderItems(order))
                )}
                <span aria-hidden="true" class="mx-1.5 text-[var(--ink-faint)]">
                  ·
                </span>
                {t['account.orders.detail.summary.placedOn']}{' '}
                <time datetime={order.date}>{formatDate(order.date)}</time>
              </p>
            </div>
            <div class="text-right">
              <p class="micro-label">{t['account.dashboard.ledger.column.total']}</p>
              <p class="mt-2 text-3xl font-semibold tabular-nums lg:text-[32px]">
                {formatCurrency(order.totalCents, 'USD')}
              </p>
            </div>
          </div>

          <ProductionRail
            stageIndex={PRODUCTION_STAGE_INDEX[order.status]}
            placedAt={order.date}
            t={t}
          />

          <div class="flex flex-wrap items-center gap-3">
            <a
              href={invoiceHref}
              download={`factura-${order.id}.html`}
              class="pressable inline-flex min-h-10 items-center rounded-[10px] border px-5 py-2.5 text-sm font-semibold text-[var(--ink)]"
              style="border-color:var(--edge-strong);background:var(--paper-raised)"
              data-testid="order-download-invoice"
            >
              {t['account.orders.action.downloadInvoice']}
            </a>
            <a
              href={requestChangeHref}
              class="pressable inline-flex min-h-10 items-center rounded-[10px] border px-5 py-2.5 text-sm font-semibold text-[var(--ink)]"
              style="border-color:var(--edge-strong);background:var(--paper-raised)"
              data-testid="order-request-change"
            >
              {t['account.orders.action.requestChange']}
            </a>
            {order.trackingUrl && (
              <a
                href={order.trackingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="pressable inline-flex min-h-10 items-center rounded-[10px] border px-5 py-2.5 text-sm font-semibold text-[var(--ink)]"
                style="border-color:var(--edge-strong);background:var(--paper-raised)"
              >
                {t['account.orders.detail.tracking.openLabel']}
                <span aria-hidden="true" class="ml-1.5">
                  ↗
                </span>
              </a>
            )}
            {reorderHref && (
              <a
                href={reorderHref}
                class="pressable inline-flex min-h-10 items-center rounded-[10px] px-5 py-2.5 text-sm font-semibold text-white"
                style="background:var(--primary)"
                data-testid="order-detail-reorder"
              >
                {t['account.orders.detail.reorder']}
              </a>
            )}
          </div>

          {(order.trackingNumber || order.trackingCarrier) && (
            <div
              class="flex flex-col gap-1 rounded-[10px] px-4 py-3"
              style="background:var(--paper-sunken)"
            >
              <p class="micro-label">{t['account.orders.detail.tracking.heading']}</p>
              <p class="text-sm text-[var(--ink-soft)]">
                {t['account.orders.detail.tracking.carrier']}: {order.trackingCarrier ?? '—'}
                {' · '}
                {t['account.orders.detail.tracking.number']}: {order.trackingNumber ?? '—'}
              </p>
            </div>
          )}
          {!order.trackingNumber && order.status !== 'cancelled' && (
            <p class="text-[13px] text-[var(--ink-muted)]">
              {t['account.orders.detail.tracking.notShipped']}
            </p>
          )}
        </div>
      </article>

      <OrderTimeline
        milestones={order.milestones}
        heading={t['account.orders.detail.timeline.heading']}
        labels={[
          {
            key: 'received',
            title: t['account.orders.detail.timeline.received'],
            description: t['account.orders.detail.timeline.receivedDescription'],
            icon: '',
          },
          {
            key: 'preparing',
            title: t['account.orders.detail.timeline.preparing'],
            description: t['account.orders.detail.timeline.preparingDescription'],
            icon: '',
          },
          {
            key: 'shipped',
            title: t['account.orders.detail.timeline.shipped'],
            description: t['account.orders.detail.timeline.shippedDescription'],
            icon: '',
          },
          {
            key: 'outForDelivery',
            title: t['account.orders.detail.timeline.outForDelivery'],
            description: t['account.orders.detail.timeline.outForDeliveryDescription'],
            icon: '',
          },
          {
            key: 'delivered',
            title: t['account.orders.detail.timeline.delivered'],
            description: t['account.orders.detail.timeline.deliveredDescription'],
            icon: '',
          },
        ]}
      />

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <OrderItemsList
            items={order.items}
            currencyCode="USD"
            locale={locale}
            heading={t['account.orders.detail.items.heading']}
            quantityLabel={t['account.orders.detail.items.quantity']}
          />
        </div>
        <div class="flex flex-col gap-6">
          <OrderShippingCard
            address={order.shippingAddress}
            heading={t['account.orders.detail.shipping.heading']}
            labelRecipient={t['account.orders.detail.shipping.recipient']}
            labelPhone={t['account.orders.detail.shipping.phone']}
            labelAddress={t['account.orders.detail.shipping.address']}
            labelCountry={t['account.orders.detail.shipping.country']}
            labelReference={t['account.orders.detail.shipping.reference']}
          />
          <OrderPaymentSummary
            payment={order.payment}
            totalCents={order.totalCents}
            currencyCode="USD"
            heading={t['account.orders.detail.payment.heading']}
            labelMethod={t['account.orders.detail.payment.method']}
            methodCard={t['account.orders.detail.payment.methodCard']}
            methodTransfer={t['account.orders.detail.payment.methodTransfer']}
            methodCod={t['account.orders.detail.payment.methodCod']}
            labelSubtotal={t['account.orders.detail.payment.subtotal']}
            labelShipping={t['account.orders.detail.payment.shipping']}
            shippingFree={t['account.orders.detail.payment.shippingFree']}
            labelTotal={t['account.orders.detail.payment.total']}
          />
        </div>
      </div>
    </div>
  )}
</AccountLayout>
