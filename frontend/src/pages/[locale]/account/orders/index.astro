---
/**
 * `/[locale]/account/orders` — Mis pedidos (ledger job-ticket).
 *
 * Composición (consistente con el dashboard rediseñado):
 *  1. Header quieto: eyebrow micro-label + H1 Fraunces + subtítulo,
 *     con el sort select a la derecha.
 *  2. StatusFilter — pills de tinta que filtran de verdad (links GET
 *     sobre la query string, patrón SSR de la PLP).
 *  3. OrdersLedger — la hoja del taller: cabecera kraft + una fila
 *     por trabajo (mini-rail de etapas + chip de tinta como focal).
 *  4. Footer del ledger: "mostrando X de Y" + Cargar más órdenes.
 *
 * Estado vacío diseñado (`StudioEmptyState`) cuando nunca hubo
 * trabajos; estado de filtro sin resultados vive dentro del ledger.
 *
 * Decisiones:
 *  - Filtrado/orden/corte en SSR vía `lib/orders-filters.ts` — sin
 *    islas React y sin estado en cliente.
 *  - Los datos siguen viniendo de mocks (`data/orders-mock`): no se
 *    inventan endpoints de backend.
 *  - "Solicitar cambio" abre el mail del soporte del tenant.
 */
import AccountLayout from '../../../../layouts/AccountLayout.astro';
import OrdersLedger from '../../../../components/account/orders/OrdersLedger.astro';
import OrdersSortSelect from '../../../../components/account/orders/OrdersSortSelect.astro';
import StatusFilter from '../../../../components/account/orders/StatusFilter.astro';
import StudioEmptyState from '../../../../components/account/dashboard/StudioEmptyState.astro';
import { getServerDictionary, getServerLocale } from '../../../../i18n/server';
import { getAllOrders } from '../../../../data/orders-mock';
import {
  DEFAULT_ORDERS_SHOWN,
  ORDER_STATUS_FILTER_VALUES,
  applyOrdersQuery,
  buildOrdersHref,
  countOrdersByStatus,
  parseOrdersQuery,
  type OrderStatusFilterValue,
} from '../../../../lib/orders-filters';
import { getBrandBySlug } from '../../../../config/stores';
import { themeToBrand } from '../../../../lib/theme';
import type { TranslationKey } from '../../../../i18n/types';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);
const localePrefix = `/${locale}`;
const ordersPath = `${localePrefix}/account/orders`;

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const brand = themeToBrand(Astro.locals.theme, getBrandBySlug(tenantSlug));

const allOrders = getAllOrders();
const query = parseOrdersQuery(Astro.url.searchParams);
const counts = countOrdersByStatus(allOrders);
const visibleOrders = applyOrdersQuery(allOrders, query);

const FILTER_LABEL_KEY: Record<OrderStatusFilterValue, TranslationKey> = {
  all: 'account.orders.list.filter.all',
  pending: 'account.orders.list.filter.pending',
  processing: 'account.orders.list.filter.processing',
  shipped: 'account.orders.list.filter.shipped',
  delivered: 'account.orders.list.filter.delivered',
  cancelled: 'account.orders.list.filter.cancelled',
};

const filterOptions = ORDER_STATUS_FILTER_VALUES.map((value) => ({
  value,
  label: t[FILTER_LABEL_KEY[value]],
  count: counts[value],
  href: `${ordersPath}${buildOrdersHref(query, { status: value })}`,
}));

const filteredCount = counts[query.status];
const hasAnyOrder = allOrders.length > 0;
const hasMore = visibleOrders.length < filteredCount;
const loadMoreHref = `${ordersPath}${buildOrdersHref(query, {
  shown: query.shown + DEFAULT_ORDERS_SHOWN,
})}`;
const showingLabel = t['account.orders.ledger.showing']
  .replace('{shown}', String(visibleOrders.length))
  .replace('{count}', String(filteredCount));

const catalogHref = `${localePrefix}/products`;
const quoteHref = `${localePrefix}/rfq`;
---

<AccountLayout title={t['account.orders.list.heading']}>
  {!hasAnyOrder ? (
    <StudioEmptyState variant="first" t={t} catalogHref={catalogHref} quoteHref={quoteHref} />
  ) : (
    <section aria-labelledby="my-orders-heading" class="flex flex-col gap-6">
      <header class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="micro-label">{t['account.orders.ledger.eyebrow']}</p>
          <h1 id="my-orders-heading" class="mt-2 text-4xl lg:text-[44px]">
            {t['account.orders.list.heading']}
          </h1>
          <p class="mt-2 text-[15px] text-[var(--ink-muted)]">
            {t['account.orders.ledger.subtitle'].replace('{count}', String(allOrders.length))}
          </p>
        </div>
        <OrdersSortSelect
          currentSort={query.sort}
          statusValue={query.status}
          actionHref={ordersPath}
          t={t}
        />
      </header>

      <StatusFilter
        current={query.status}
        options={filterOptions}
        navLabel={t['account.orders.ledger.filterLabel']}
      />

      <OrdersLedger
        orders={visibleOrders}
        localePrefix={localePrefix}
        supportEmail={brand.supportEmail}
        clearFilterHref={`${ordersPath}${buildOrdersHref(query, { status: 'all' })}`}
        t={t}
      />

      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-[13px] tabular-nums text-[var(--ink-muted)]">{showingLabel}</p>
        {hasMore && (
          <a
            href={loadMoreHref}
            class="pressable inline-flex min-h-10 items-center gap-2 rounded-[10px] border px-5 py-2.5 text-sm font-semibold text-[var(--ink)]"
            style="border-color:var(--edge-strong);background:var(--paper-raised)"
            data-testid="orders-load-more"
          >
            {t['account.orders.ledger.loadMore']}
            <span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    </section>
  )}
</AccountLayout>
