---
/**
 * `/[locale]/account/orders` — Mis órdenes (Bonfire mockup 10 v3).
 *
 * Composición:
 *  - H1 + subtítulo con count total.
 *  - Fila de filter pills (StatusFilter, visual-only por ahora).
 *  - Lista de cards colapsables (OrderRow) con `<details>` nativo.
 *  - Empty state con dashed border + CTA.
 *
 * Decisiones:
 *  - `<details>` nativo para expand/collapse (sin JS, accesible).
 *  - El filter es visual (click handler se agregará después). El
 *    `current` se mantiene en estado de servidor para que la
 *    primera fila activa de pills siempre refleje un estado real.
 *  - Statuses se mapean a los strings existentes
 *    `account.orderStatus.*` (no se duplican).
 *  - Subtotal del header usa el helper `countOf` ya existente para
 *    mantener paridad con la versión legacy.
 *  - `data-reveal-stagger` activa la animación escalonada de
 *    scroll-fx.css (no requiere JS).
 *
 * Multi-tenant: el shell hereda tokens del tenant vía AccountLayout.
 */
import AccountLayout from '../../../../layouts/AccountLayout.astro';
import OrderRow from '../../../../components/account/orders/OrderRow.astro';
import StatusFilter from '../../../../components/account/orders/StatusFilter.astro';
import type { OrderStatusFilterValue } from '../../../../components/account/orders/StatusFilter.astro';
import { getServerDictionary, getServerLocale } from '../../../../i18n/server';
import { getAllOrders } from '../../../../data/orders-mock';
import type { OrderStatus } from '../../../../data/account-mock';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const ALL_ORDERS = getAllOrders();

// Status filter options (Bonfire v3 spec: 6 pills, "Todas" primero).
const FILTER_VALUES: readonly OrderStatusFilterValue[] = [
  'all',
  'pending',
  'processing',
  'shipped',
  'delivered',
  'cancelled',
];

function countByStatus(status: OrderStatus): number {
  return ALL_ORDERS.filter((order) => order.status === status).length;
}

const filterOptions = FILTER_VALUES.map((value) => ({
  value,
  label: t[`storefront.account.orders.v3.filter.${value}` as const],
  count: value === 'all' ? ALL_ORDERS.length : countByStatus(value as OrderStatus),
}));

// Default filter: "all" (visual state only — no SSR filtering yet).
const currentFilter: OrderStatusFilterValue = 'all';

const showEmpty = ALL_ORDERS.length === 0;
const totalCount = ALL_ORDERS.length;

const orderIdTemplate = t['account.dashboard.recentOrders.orderId'];
const orderIdLabel = (id: string): string => orderIdTemplate.replace('{id}', id);

const statusLabel = (status: OrderStatus): string => t[`account.orderStatus.${status}` as const];

const subtitle = t['storefront.account.orders.v3.subtitle'].replace('{count}', String(totalCount));

const localePrefix = `/${locale}`;
const currencyCode = 'USD';

// Default open: only the first order, para que la página muestre
// el body expandido como demo. El resto arranca colapsado.
const ordersToRender = showEmpty ? [] : [...ALL_ORDERS];
---

<AccountLayout title={t['storefront.account.orders.v3.title']}>
  <section
    aria-labelledby="my-orders-heading"
    class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
  >
    <header class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1
          id="my-orders-heading"
          class="text-3xl sm:text-4xl"
        >
          {t['storefront.account.orders.v3.title']}
        </h1>
        <p class="mt-1 text-sm text-slate-500">{subtitle}</p>
      </div>

      {/* CTA prominent estilo Nike: 'Volver a pedir' (re-order) como
          accion principal del header. El re-order button en cada row
          individual sigue presente (visible al expandir la card).
          Aca lo exponemos a nivel de pagina para los clientes que
          repiten compras (nike.com member/orders tiene este mismo
          patron). */}
      <a
        href={`${localePrefix}/products`}
        class="inline-flex h-10 items-center justify-center rounded-lg bg-[var(--primary,#7c3aed)] px-5 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#6d28d9)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2"
      >
        {t['storefront.account.orders.v3.reorder']}
      </a>
    </header>

    <div class="mb-5">
      <StatusFilter
        current={currentFilter}
        options={filterOptions}
        navLabel={t['storefront.account.orders.v3.filter.all']}
      />
    </div>

    {showEmpty ? (
      <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-white"
          aria-hidden="true"
        >
          <span class="h-2 w-2 rounded-full bg-[var(--primary)]"></span>
        </div>
        <p class="text-base font-semibold text-slate-900">
          {t['storefront.account.orders.v3.empty']}
        </p>
        <a
          href={`${localePrefix}/products`}
          class="mt-2 inline-flex items-center gap-1 rounded-lg bg-[var(--primary,#7c3aed)] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[var(--primary-hover,#6d28d9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2"
        >
          {t['storefront.account.orders.v3.emptyCta']}
        </a>
      </div>
    ) : (
      <div class="flex flex-col gap-3" data-reveal-stagger>
        {ordersToRender.map((order, index) => (
          <OrderRow
            order={order}
            currencyCode={currencyCode}
            localePrefix={localePrefix}
            orderIdLabel={orderIdLabel(order.id)}
            statusLabel={statusLabel(order.status)}
            etaLabel={t['storefront.account.orders.v3.eta']}
            itemsHeading={t['storefront.account.orders.v3.items']}
            shippingHeading={t['storefront.account.orders.v3.shippingAddress']}
            paymentHeading={t['storefront.account.orders.v3.payment']}
            recipientLabel={t['storefront.account.orders.v3.recipient']}
            phoneLabel={t['storefront.account.orders.v3.phone']}
            addressLabel={t['storefront.account.orders.v3.address']}
            countryLabel={t['storefront.account.orders.v3.country']}
            methodLabel={t['storefront.account.orders.v3.method']}
            subtotalLabel={t['storefront.account.orders.v3.subtotal']}
            totalLabel={t['storefront.account.orders.v3.total']}
            reorderLabel={t['storefront.account.orders.v3.reorder']}
            viewDetailLabel={t['storefront.account.orders.v3.expand']}
            viewInvoiceLabel={t['storefront.account.orders.v3.viewInvoice']}
            trackShipmentLabel={t['storefront.account.orders.v3.trackShipment']}
            defaultOpen={index === 0}
          />
        ))}
      </div>
    )}
  </section>
</AccountLayout>
