---
/**
 * Dashboard del cliente — composición Bonfire v3.
 *
 * Reemplaza el layout task-oriented de F2.2 por la composición
 * del mockup `03-account-dashboard.html` (Bonfire v1 adaptado):
 *
 *   1. H1 saludo (HOLA, ANA)
 *   2. KpiGrid 4 cards (Pedidos activos / Cotizaciones / Gastado (mes) / Favoritos)
 *   3. QuickActionsCards (4 cards: Cotizar / Direcciones / Ayuda / Perfil)
 *   4. RecentOrdersTable (tabla 5 órdenes, 4 columnas)
 *
 * Decisiones locked-in (ver `odd/tasks/bonfire-visual-fidelity.md`):
 *   - Tenant-aware: cada acento sale de `var(--primary)`. El shell
 *     visual lo seteá `AccountLayout.astro` en el `<body style="...">`,
 *     así que acá no toco hexes.
 *   - Empty-safe: si una sección no tiene datos, la sección no se
 *     renderiza (no mostramos cards vacías, Baymard §2.6 #4).
 *   - data-reveal-stagger en cada grid para el sistema de
 *     animaciones de scroll (scroll-fx.ts).
 *   - No emojis, no fotos de personas, no logos reales. AvatarCircle
 *     para user, ProductMockup si hicera falta una foto de producto.
 */
import AccountLayout from '../../../layouts/AccountLayout.astro';
import KpiGrid from '../../../components/account/dashboard/KpiGrid.astro';
import QuickActionsCards from '../../../components/account/dashboard/QuickActionsCards.astro';
import RecentOrdersTable from '../../../components/account/dashboard/RecentOrdersTable.astro';
import { getServerDictionary, getServerLocale } from '../../../i18n/server';
import { getAccountDashboardData } from '../../../lib/server/account';
import { buildDashboardKpisV3 } from '../../../data/dashboard-kpis';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const cookieHeader = Astro.request.headers.get('Cookie') ?? '';
// Pedimos 5 órdenes para la tabla (la sección más ancha del dashboard).
// Otros endpoints del helper no se usan en v3 pero los seguimos trayendo
// por si en el futuro queremos re-introducir una sección que los consuma
// (ej: tarjetas de seguridad/notificaciones).
const dashboard = await getAccountDashboardData(
  Astro.url.origin,
  cookieHeader,
  { limit: 5 },
);

// Saludo. Si no hay user, fallback al idioma actual.
const fallbackFirstName = locale === 'en' ? 'Customer' : 'Cliente';
const firstName =
  dashboard.user?.full_name?.split(' ')[0] ?? fallbackFirstName;
const greeting = locale === 'en' ? `Hello, ${firstName}` : `Hola, ${firstName}`;

const localePrefix = `/${locale}`;

// KPIs v3 (Bonfire adaptation). El helper ya devuelve 4 elementos con
// los labelKey del namespace v3.
const kpis = buildDashboardKpisV3(dashboard, locale);
---

<AccountLayout title={t['account.layout.title']}>
  <div class="flex flex-col gap-10">
    <header class="flex flex-col gap-2">
      <h1
        class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
        data-testid="dashboard-greeting"
      >
        {greeting}
      </h1>
    </header>

    <KpiGrid kpis={kpis} t={t} />

    <QuickActionsCards locale={locale} t={t} />

    <RecentOrdersTable
      orders={dashboard.orders}
      localePrefix={localePrefix}
      currencyCode={null}
      t={t}
    />
  </div>
</AccountLayout>
