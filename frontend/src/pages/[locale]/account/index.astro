---
/**
 * Dashboard del cliente — composición job-ticket (estampados).
 *
 * Reemplaza la composición Bonfire v3 (grid de KPI cards + acciones
 * en cards + tabla plana) por la metáfora del taller:
 *
 *   1. GreetingHeader quieto (eyebrow + nombre) + QuickLinkRow.
 *   2. ProductionStrip — FOCAL: orden de trabajo con rail de etapas
 *      y chips de tinta (o estado vacío diseñado del taller).
 *   3. StatRail — UNA stat hero + soportes con significado real.
 *   4. RecentOrdersTable — ledger de últimos trabajos.
 *
 * Decisiones locked-in:
 *   - Tenant-aware: todo acento sale de `var(--primary)` / `--primary-hover`
 *     (shell en AccountLayout). Sin hex de tenant hardcodeados.
 *   - Empty-safe: sin datos, las secciones no se renderizan o se
 *     muestra el empty diseñado de ProductionStrip.
 *   - data-reveal / data-reveal-stagger con el sistema scroll-fx.
 *   - Sin emojis, sin fotos de personas, sin logos reales.
 */
import AccountLayout from '../../../layouts/AccountLayout.astro';
import GreetingHeader from '../../../components/account/dashboard/GreetingHeader.astro';
import QuickLinkRow from '../../../components/account/dashboard/QuickLinkRow.astro';
import ProductionStrip from '../../../components/account/dashboard/ProductionStrip.astro';
import StatRail from '../../../components/account/dashboard/StatRail.astro';
import RecentOrdersTable from '../../../components/account/dashboard/RecentOrdersTable.astro';
import { getServerDictionary, getServerLocale } from '../../../i18n/server';
import { getAccountDashboardData } from '../../../lib/server/account';
import { buildDashboardStats, buildProductionTickets } from '../../../data/dashboard-kpis';

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const cookieHeader = Astro.request.headers.get('Cookie') ?? '';
const dashboard = await getAccountDashboardData(Astro.url.origin, cookieHeader, { limit: 5 });

const fallbackFirstName = locale === 'en' ? 'Customer' : 'Cliente';
const firstName = dashboard.user?.full_name?.split(' ')[0] ?? fallbackFirstName;
const greeting = t['account.dashboard.greetingFallback'].replace('{name}', firstName);

const localePrefix = `/${locale}`;
const tickets = buildProductionTickets(dashboard);
const stats = buildDashboardStats(dashboard);
---

<AccountLayout title={t['account.layout.title']}>
  <div class="flex flex-col gap-12">
    <GreetingHeader eyebrow={t['account.dashboard.eyebrow']} greeting={greeting}>
      <QuickLinkRow locale={locale} t={t} />
    </GreetingHeader>

    <ProductionStrip tickets={tickets} localePrefix={localePrefix} t={t} />

    <StatRail stats={stats} t={t} />

    <RecentOrdersTable tickets={tickets} localePrefix={localePrefix} t={t} />
  </div>
</AccountLayout>
