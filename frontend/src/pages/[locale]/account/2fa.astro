---
import AuthLayout from '../../../layouts/AuthLayout.astro';
import TwoFactorChallengeForm from '../../../components/admin/auth/TwoFactorChallengeForm';
import AuthShell from '../../../components/auth/AuthShell.astro';
import LanguageSwitcher from '../../../components/ui/LanguageSwitcher';
import { getServerDictionary, getServerLocale } from '../../../i18n/server';
import { getBrandBySlug, DEFAULT_BRAND } from '../../../config/stores';
import { themeToBrand } from '../../../lib/theme';

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const fallbackBrand = getBrandBySlug(Astro.locals.tenant?.tenantSlug ?? null) ?? DEFAULT_BRAND;
const brand = themeToBrand(Astro.locals.theme, fallbackBrand);

const loginPath = `/${locale}/admin/auth/login`;

/**
 * 2FA challenge page.
 *
 * El LoginForm redirige acá con `?token=<challengeId>&redirect=<path>`
 * cuando el backend responde `2fa_required` en `/auth/login`. Si falta
 * el `token`, redirigimos server-side al login.
 */
const rawToken = Astro.url.searchParams.get('token');
const rawRedirect = Astro.url.searchParams.get('redirect');

if (rawToken === null) {
  return Astro.redirect(loginPath);
}

const challengeId = Number.parseInt(rawToken, 10);
if (!Number.isFinite(challengeId)) {
  return Astro.redirect(loginPath);
}

const fallbackRedirect = `/${locale}/admin/dashboard`;
const redirectTo =
  rawRedirect !== null && rawRedirect.startsWith(`/${locale}`) ? rawRedirect : fallbackRedirect;
---

<AuthLayout title={`${t['auth.twoFactor.title']} · ${brand.name}`}>
  <AuthShell
    illustration={`/assets/frontend/amico/auth/login.svg`}
    illustrationAlt={t['auth.shell.illustration.alt']}
    leftHeading={t['auth.twoFactor.heading']}
    leftBody={t['auth.twoFactor.subtitle']}
    brandName={brand.name}
    brandLogo={brand.logoPath}
    topRightLink="back"
    backHref={loginPath}
    side="left"
  >
    <LanguageSwitcher slot="topRightExtra" client:load theme="light" />

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">{t['auth.twoFactor.heading']}</h1>
      <p class="mt-2 text-slate-500">{t['auth.twoFactor.subtitle']}</p>
    </div>

    <TwoFactorChallengeForm client:load challengeId={challengeId} redirectTo={redirectTo} />

    <p class="text-center text-xs text-slate-400 mt-8" slot="terms">
      {t['auth.shell.termsPrefix']}{' '}
      <a href="#" class="underline hover:text-[var(--brand-accent,#2D9D8E)]">
        {t['auth.shell.termsLink']}
      </a>{' '}
      {t['auth.shell.termsAnd'] ?? 'y'}{' '}
      <a href="#" class="underline hover:text-[var(--brand-accent,#2D9D8E)]">
        {t['auth.shell.privacyLink']}
      </a>
      .
    </p>
  </AuthShell>
</AuthLayout>
