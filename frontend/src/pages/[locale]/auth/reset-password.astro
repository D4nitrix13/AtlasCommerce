---
import AuthLayout from "../../../layouts/AuthLayout.astro";
import AuthShell from "../../../components/auth/AuthShell.astro";
import ResetPasswordForm from "../../../components/admin/auth/ResetPasswordForm";
import { getServerDictionary, getServerLocale } from "../../../i18n/server";
import { getBrandBySlug, DEFAULT_BRAND } from "../../../config/stores";
import { themeToBrand } from "../../../lib/theme";
import { AUTH_ACCENT } from "../../../lib/auth-accent";

const t = getServerDictionary(Astro.locals.locale);
const locale = getServerLocale(Astro.locals.locale);

const fallbackBrand =
  getBrandBySlug(Astro.locals.tenant?.tenantSlug ?? null) ?? DEFAULT_BRAND;
const brand = themeToBrand(Astro.locals.theme, fallbackBrand);

const emailParam = Astro.url.searchParams.get("email");
const callbackPath = Astro.url.searchParams.get("callback") ?? "/admin/dashboard";
const codeFromUrl = Astro.url.searchParams.get("code") ?? "";
const email = emailParam ?? "";
const showMissingEmailWarning = email === "";

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? "panda-estampados";
const illustration = `/images/stores/${tenantSlug}/amico/auth/reset-password-amico.svg`;

const loginHref = `/${locale}/admin/auth/login`;
const forgotHref = `/${locale}/admin/auth/forgot-password`;
---

<AuthLayout title={`${t["auth.passwordReset.title"]} · ${brand.name}`}>
  <AuthShell
    illustration={illustration}
    illustrationAlt={t["auth.shell.illustration.alt"]}
    leftHeading={t["auth.passwordReset.step2.heading"]}
    leftBody={t["auth.passwordReset.step2.intro"]}
    brandName={brand.name}
    brandLogo={brand.logoPath}
    topRightLink="back"
    backHref={loginHref}
    side="left"
  >
    {showMissingEmailWarning ? (
      <div
        role="alert"
        class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"
      >
        {t["auth.passwordReset.error.missingEmail"]}
        <div class="mt-3">
          <a
            href={forgotHref}
            class="text-sm font-semibold text-amber-900 underline"
          >
            ← {t["common.back"]}
          </a>
        </div>
      </div>
    ) : (
      <>
        {/* Banner: "Restableciendo para {email}" — usa la paleta auth
            universal (ver `lib/auth-accent.ts`). Misma fuente de verdad
            que login, forgot-password y reset-success. */}
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1.5"
          style={`background-color: ${AUTH_ACCENT.softBg}; border-color: ${AUTH_ACCENT.softBorder};`}
        >
          <svg
            class="h-4 w-4 text-[#1E6F62]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            />
          </svg>
          <span class="text-xs text-slate-600">
            {t["auth.passwordReset.bannerFor"].replace("{email}", email)}
          </span>
        </div>

        <div class="mb-8">
          <h1 class="text-3xl font-bold text-slate-900">
            {t["auth.passwordReset.step2.heading"]}
          </h1>
          <p class="mt-2 text-slate-500">
            {t["auth.passwordReset.step2.intro"]}
          </p>
        </div>

        <ResetPasswordForm
          client:load
          email={email}
          codeFromUrl={codeFromUrl}
          callbackPath={callbackPath}
          locale={locale}
        />

        <div
          class="mt-6 flex items-start gap-2.5 rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500"
        >
          <svg
            class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            />
          </svg>
          <p>
            {t["auth.passwordReset.expiryNote"].replace("{time}", "15:00")}
          </p>
        </div>

        <div class="mt-6 text-sm text-slate-500">
          <a
            href={forgotHref}
            class="transition hover:text-slate-700"
          >
            ← {t["auth.passwordReset.requestNewCode"]}
          </a>
        </div>
      </>
    )}
  </AuthShell>
</AuthLayout>