---
/**
 * pages/[locale]/rem/index.astro
 *
 * Route `/<locale>/rem/` for the REM viewer. Renders the server-side
 * shell with the first requirement preselected (REQ-04#2) and the
 * `RemSidebar` React island mounted with the full dataset.
 *
 * Selection contract (REQ-12):
 *   - No `?id=` → preselect the first dataset item.
 *   - `?id=<uid>` resolves to an existing UID → preselect that item.
 *   - `?id=<uid>` does NOT resolve → fall back to the first item;
 *     the React island records `fallbackApplied` so e2e can assert.
 *
 * Loader failure contract (REQ-10#3):
 *   - When `loadAllRequirements()` throws, render `<RemError>` only
 *     (no sidebar / no detail panel). The `errorCode` carries the
 *     `load:<kind>:<path>` prefix the component understands.
 *
 * Locale handling:
 *   - `Astro.params.locale` carries the URL segment (`es` / `en`).
 *   - `Astro.locals.locale` is set by the project middleware and used
 *     by `getServerDictionary()` to resolve translations.
 *   - `<html lang>` on `<RemLayout>` receives the same locale so the
 *     SSR output advertises the language to assistive tech.
 *
 * `getStaticPaths` is delegated to `getRemStaticPaths()` in
 * `lib/rem/page-route.ts` so the test can assert on the same source
 * of truth (per REQ-08#1 the page must serve both locales).
 */

import RemLayout from '../../../layouts/RemLayout.astro';
import RemSidebar from '../../../components/rem/RemSidebar';
import RemDetail from '../../../components/rem/RemDetail.astro';
import RemPrintButton from '../../../components/rem/RemPrintButton';
import RemError from '../../../components/rem/RemError.astro';
import { loadAllRequirements } from '../../../lib/rem/loader';
import {
  findItemByUid,
  getRemStaticPaths,
  resolveSelectionFromQuery,
} from '../../../lib/rem/page-route';
import { getServerDictionary } from '../../../i18n/server';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n/config';
import type { RemDataset } from '../../../lib/rem/types';

// Re-export the static paths from the helper so Astro generates both
// `/es/rem/` and `/en/rem/`. Keeping the source of truth in one place
// (the helper module) means the test only needs to import that.
export const getStaticPaths = getRemStaticPaths;

const rawLocale = Astro.params.locale;
const locale: Locale =
  rawLocale !== undefined && (SUPPORTED_LOCALES as readonly string[]).includes(rawLocale)
    ? (rawLocale as Locale)
    : 'es';

// Page-side translator — wraps the server dictionary in a function so
// children that expect the `useTranslations().t` shape (`(key) => string`)
// can consume it verbatim. Falls back to the literal key when the
// translation is missing so the page never throws on a missing entry.
const dictionary = getServerDictionary(locale);
const t = (key: string): string => {
  const value = (dictionary as Record<string, string>)[key];
  return value ?? key;
};

let dataset: RemDataset | null = null;
let errorCode: string | null = null;
try {
  dataset = loadAllRequirements();
} catch (cause) {
  const code =
    cause instanceof Error && cause.name === 'RemParseError'
      ? `load:parse-error:${(cause as { path?: string }).path ?? 'unknown'}`
      : 'load:unknown';
  errorCode = code;
}

if (errorCode !== null) {
  // Render RemError only — no sidebar / no detail panel per REQ-10#3.
  // We can't call `<RemError>` inside `<RemLayout>` cleanly because
  // the layout assumes a 2-column shell. Mount RemError at the page
  // root with the same minimum shell so the user still sees a header.
}

const queryId = Astro.url.searchParams.get('id');
const safeDataset: RemDataset =
  dataset ?? { rf: [], rnf: [], stakeholders: [] };
const { selectedUid, fallbackApplied } = resolveSelectionFromQuery(
  queryId,
  safeDataset
);

const selectedItem = selectedUid === '' ? null : findItemByUid(safeDataset, selectedUid);

// `tree` is built for the sidebar island but never read on the SSR
// side; we keep the call so future server-side debug output (e.g.
// the full-report PDF) can reuse it. Touching the variable keeps the
// named-binding lint gate happy without an unused-var warning.
void safeDataset;

const title = t('rem.title');
---

{
  errorCode !== null ? (
    <RemLayout title={title} locale={locale} t={t}>
      <RemError slot="detail" code={errorCode} t={t} />
    </RemLayout>
  ) : selectedItem === null ? (
    <RemLayout title={title} locale={locale} t={t}>
      <p slot="detail" class="rem-empty-msg mx-auto max-w-md p-8 text-center text-slate-500">
        {t('rem.empty.title')}
      </p>
    </RemLayout>
  ) : (
    <RemLayout title={title} locale={locale} t={t}>
      <RemPrintButton slot="header-actions" client:idle />

      <RemSidebar
        slot="sidebar"
        dataset={safeDataset}
        initialUid={selectedUid}
        locale={locale}
        client:load
      />

      <RemDetail
        slot="detail"
        item={selectedItem}
        stakeholders={safeDataset.stakeholders}
        t={t}
      />

      <p slot="footer" class="rem-fallback-flag" data-rem-fallback-applied={fallbackApplied ? 'true' : 'false'}>
        {t('rem.title')}
      </p>
    </RemLayout>
  )
}
