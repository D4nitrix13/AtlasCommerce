---
// Favicon per-tenant: derivado del slug del tenant detectado por el
// middleware. Convention: /api/storefront/assets/tenants/{slug}/branding/favicon.webp.
// Si el tenant no está detectado (ej. dev local sin /etc/hosts),
// cae al favicon genérico del repo.
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const tenantFavicon = tenantSlug
  ? `/api/storefront/assets/tenants/${tenantSlug}/branding/favicon.webp`
  : "/favicon.svg";

interface Props {
  title?: string;
}

const { title = "Ecommerce" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={tenantFavicon} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="font-sans">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>