---
import { getBrandBySlug } from '../config/stores';
import { resolveTenantFavicon } from '../lib/tenant-favicon';

// Favicon per-tenant: lo DECLARA el brand (`StoreBrand.faviconPath`).
// Antes este layout armaba la URL por convención desde el slug y
// afirmaba que todo tenant tiene branding subido — para los que no lo
// tienen eso era un 404 por carga de página. Ver `lib/tenant-favicon.ts`.
// Si el tenant no está detectado (ej. dev local sin /etc/hosts),
// `getBrandBySlug` cae al DEFAULT_BRAND y el resolver al favicon del repo.
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const favicon = resolveTenantFavicon(getBrandBySlug(tenantSlug));

interface Props {
  title?: string;
}

const { title = 'AtlasCommerce' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type={favicon.type} href={favicon.href} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
