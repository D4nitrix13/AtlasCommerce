---
/**
 * StorefrontLayout — shell visual completo del storefront público.
 *
 * Compone: <StorefrontHeader> + <slot> + <StorefrontFooter>, y aplica
 * la paleta del tenant vía CSS variables (`--primary`, `--primary-hover`,
 * `--secondary`, `--accent`). Estas variables se setean como `style`
 * inline en `<html>` para que TODO el subtree herede los colores del
 * brand sin tener que hardcodear hexes por componente.
 *
 * Tenant resolution:
 *   - El middleware setea `Astro.locals.tenant?.tenantSlug`.
 *   - Si está, resolvemos el brand con `getBrandBySlug(slug)`.
 *   - Si no, caemos al DEFAULT_BRAND (Kitsune).
 *
 * El layout envuelve el contenido con min-h-screen + flex column para
 * que el footer quede siempre al final de la página aunque el slot
 * tenga poco contenido (sticky footer pattern).
 *
 * Uso:
 *   ---
 *   import StorefrontLayout from '../layouts/StorefrontLayout.astro';
 *   ---
 *   <StorefrontLayout title="Inicio">
 *     <h1>Bienvenido</h1>
 *   </StorefrontLayout>
 */
import '../styles/global.css';
import '../styles/scroll-fx.css';
import { SHOP_FONT_STYLESHEET, shopThemeStyle } from '../lib/shop-canvas';
import { apiFetch } from '../lib/api';
import { API_ENDPOINTS } from '../lib/endpoints';
import { getBrandBySlug, type StoreBrand } from '../config/stores';
import { resolveTenantFavicon } from '../lib/tenant-favicon';
import StorefrontHeader from '../components/storefront/layout/StorefrontHeader.astro';
import StorefrontFooter from '../components/storefront/layout/StorefrontFooter.astro';

interface Props {
  title?: string;
  cartCount?: number;
}

interface SocialLinkRow {
  platform: string;
  url: string | null;
}

const { title = 'AtlasCommerce', cartCount = 0 } = Astro.props;

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const brand: StoreBrand = getBrandBySlug(tenantSlug);
const locale = Astro.locals.locale ?? 'es';

// Redes sociales del footer desde el API (tenant por host). Fail-soft
// obligatorio: si el backend no responde, devolvemos [] y el footer
// renderiza el fallback decorativo — el footer nunca tumba la página.
async function loadSocialLinks(): Promise<SocialLinkRow[]> {
  try {
    const response = await apiFetch<{ data: SocialLinkRow[] }>(
      API_ENDPOINTS.storefront.socialLinks,
      {
        headers: { Accept: 'application/json' },
        origin: Astro.url.origin,
        host: Astro.url.host,
      },
    );
    return response.data;
  } catch (error) {
    console.error('[layout] apiFetch social-links failed:', error);
    return [];
  }
}

const socialLinks = await loadSocialLinks();

// Theme root: convierte los accent colors del brand en CSS vars que
// cualquier componente puede consumir vía `var(--primary)` o
// `bg-[var(--primary)]`. El default fallback (`#475569`) mantiene
// legibilidad si no hay brand resuelto.
const themeRootStyle = shopThemeStyle(brand.accentColor, brand.accentHoverColor);

// El favicon lo DECLARA el brand. Antes se armaba la URL por convención
// desde el slug, lo que pedía un asset de branding que este tenant todavía
// no tiene (404 por carga de página). Ver `lib/tenant-favicon.ts`.
const favicon = resolveTenantFavicon(brand);
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={favicon.type} href={favicon.href} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={SHOP_FONT_STYLESHEET}
      rel="stylesheet"
    />
    <title>{title}</title>
    {/* Scroll restoration robusto: setea manual ANTES del primer paint Y
        hace scrollTo en 3 momentos (head, main, load) para que NADA
        pueda sobrescribir la posición. Sin esto, el browser hace scroll
        restoration automática a su historial y deja al user en el top. */}
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      const restoreScroll = () => {
        const urlMatch = window.location.search.match(/[?&]scrollY=(\d+)/);
        if (urlMatch === null || urlMatch[1] === undefined) return;
        const y = Number.parseInt(urlMatch[1], 10);
        if (Number.isFinite(y) && y > 0) {
          window.scrollTo({ top: y, left: 0, behavior: 'auto' });
        }
      };
      restoreScroll();
      document.addEventListener('DOMContentLoaded', restoreScroll);
      window.addEventListener('load', restoreScroll);
    </script>
  </head>

  <body
    class="shop-canvas flex min-h-screen flex-col font-sans antialiased"
    style={themeRootStyle}
  >
    <StorefrontHeader brand={brand} locale={locale} cartCount={cartCount} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <StorefrontFooter brand={brand} locale={locale} socialLinks={socialLinks} />

    {/* Scroll-driven animations fallback para Safari/Firefox. Chrome/Edge
        115+ corren animation-timeline nativamente via scroll-fx.css. */}
    <script>
      import '../scripts/scroll-fx.ts';
    </script>
  </body>
</html>
