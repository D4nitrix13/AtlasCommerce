---
import "../styles/global.css";
import AdminSidebar from "../components/admin/sidebar/AdminSidebar.astro";
import AdminHeader from "../components/admin/header/AdminHeader.astro";
import AuthGuard from "../components/admin/auth/AuthGuard";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;

// Favicon per-tenant: derivado del slug del tenant detectado por el
// middleware. Convention: /images/stores/{slug}/brand/favicon.webp.
// Si el tenant no está detectado (ej. dev local sin /etc/hosts),
// cae al favicon genérico del repo en /favicon.svg.
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const tenantFavicon = tenantSlug
  ? `/images/stores/${tenantSlug}/brand/favicon.webp`
  : "/favicon.svg";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={tenantFavicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var c = localStorage.getItem("admin-sidebar-collapsed") === "true";
          var isDesktop = window.innerWidth >= 1024;
          if (isDesktop) {
            document.documentElement.classList.add(c ? "sidebar-collapsed-init" : "sidebar-expanded-init");
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[#f6f7f9] font-sans text-slate-900 antialiased">
    <AuthGuard client:load />

    <div class="min-h-screen">
      <AdminSidebar />

      <div id="main-content" class="min-h-screen transition-[padding] duration-200 lg:pl-[260px]">
        <AdminHeader />

        <main class="px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
