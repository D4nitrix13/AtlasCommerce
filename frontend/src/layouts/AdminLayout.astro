---
/**
 * AdminLayout — Shell visual completo del panel administrativo.
 *
 * Usado en TODAS las paginas /admin/* (dashboard, customers, sales,
 * shipping, settings, reports, returns — 7+ paginas).
 *
 * Composición:
 *   - <AuthGuard> (envuelve el slot): valida Sanctum auth + redirect a /auth/login
 *   - <AdminSidebar> (izquierda): menu colapsable con 8 categorias, 24 items
 *   - <AdminHeader> (top): sticky header con search + user menu + sidebar toggle
 *   - <slot /> (contenido principal): la pagina especifica renderiza aca
 *
 * Multi-tenancy:
 *   - El tenant se resuelve via middleware backend (store.domain), no aca
 *   - Favicon per-tenant declarado por el brand (`StoreBrand.faviconPath`)
 *
 * **AGENTS.md §16**: layout/shell — siempre via este componente para
 * consistencia visual. NO usar <body> directamente en paginas admin.
 */
import '../styles/global.css';
import AdminSidebar from '../components/admin/sidebar/AdminSidebar.astro';
import AdminHeader from '../components/admin/header/AdminHeader.astro';
import AuthGuard from '../components/admin/auth/AuthGuard';
import { getBrandBySlug } from '../config/stores';
import { resolveTenantFavicon } from '../lib/tenant-favicon';

interface Props {
  title?: string;
}

const { title = 'Admin' } = Astro.props;

// Favicon per-tenant: lo DECLARA el brand (`StoreBrand.faviconPath`), no
// se construye por convención desde el slug. Antes este layout pedía un
// `.webp` de branding con `type="image/svg+xml"` para todo tenant, incluso
// para los que todavía no subieron branding (404 en cada carga de página).
// Ver `lib/tenant-favicon.ts`. Sin tenant detectado `getBrandBySlug` cae al
// DEFAULT_BRAND y el resolver al favicon del repo.
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const favicon = resolveTenantFavicon(getBrandBySlug(tenantSlug));
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={favicon.type} href={favicon.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          const c = localStorage.getItem('admin-sidebar-collapsed') === 'true';
          const isDesktop = window.innerWidth >= 1024;
          if (isDesktop) {
            document.documentElement.classList.add(
              c ? 'sidebar-collapsed-init' : 'sidebar-expanded-init'
            );
          }
        } catch {
          // localStorage puede no estar disponible (modo privado, etc.).
          // Fallar silenciosamente: sin clases de init, la sidebar usa defaults.
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[#f6f7f9] font-sans text-slate-900 antialiased">
    <AuthGuard client:load />

    <div class="min-h-screen">
      <AdminSidebar />

      <div id="main-content" class="min-h-screen transition-[padding] duration-200 lg:pl-[260px]">
        <AdminHeader />

        <main class="px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
