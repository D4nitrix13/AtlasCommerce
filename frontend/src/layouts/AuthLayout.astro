---
/**
 * AuthLayout — Shell visual para TODAS las pantallas de autenticacion.
 *
 * Usado en paginas de auth (login, signup, forgot-password,
 * reset-password, 2fa challenge, 2fa setup, 2fa recovery — 7 paginas).
 *
 * Composición:
 *   - Lado izquierdo: tagline + ilustracion (desktop only)
 *   - Lado derecho: <slot /> con el form (login form, signup form, etc)
 *   - En mobile, el layout se apila (ilustracion oculta)
 *
 * Multi-tenancy:
 *   - Tenant via `Astro.props.store` (resuelto por middleware store.domain)
 *   - Favicon per-tenant desde public/favicon-{slug}.ico
 *   - Brand color aplica a:focus-visible + submit button
 *
 * **AGENTS.md §16**: shell — siempre via este layout para /auth/* y /admin/auth/*.
 */
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Login' } = Astro.props;

// Favicon per-tenant: derivado del slug del tenant detectado por el
// middleware. Convention: /api/storefront/assets/tenants/{slug}/branding/favicon.webp.
// Si el tenant no está detectado (ej. dev local sin /etc/hosts),
// cae al favicon genérico del repo en /favicon.svg.
const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const tenantFavicon = tenantSlug
  ? `/api/storefront/assets/tenants/${tenantSlug}/branding/favicon.webp`
  : '/favicon.svg';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={tenantFavicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {
      /*
      CR2: CSRF bootstrap para Sanctum stateful cookies.

      Sanctum protege los POST con double-submit cookie: el backend
      emite una cookie XSRF-TOKEN en /sanctum/csrf-cookie y el
      frontend debe copiarla al header X-XSRF-TOKEN en cada POST.

      Este <script> corre en cada navegación a una auth page y garantiza
      que la cookie esté seteada antes de que el user clickee "Iniciar
      sesión" / "Continuar". Sin esto, el primer POST tira 419 CSRF
      token mismatch porque Sanctum nunca emitió la cookie.

      El bootstrap es idempotente: si la cookie ya existe, fetch() la
      actualiza pero no la borra, así que múltiples llamadas no rompen.

      inline script (no externo) para que funcione aunque Vite tarde en
      compilar el bundle React. Astro inyecta el script sin esperar el
      hydration de cualquier componente React hijo.
    */
    }
    <script>
      // CSRF bootstrap inline. NO depende del bundle React (puede correr
      // antes que cualquier componente hidrate).
      (function () {
        try {
          // Construimos el path absoluto en runtime — el endpoint vive
          // en el mismo origin del browser, así que usamos el origin del
          // location actual (que respeta el host del dev server, no de Caddy).
          var endpoint = window.location.origin + '/sanctum/csrf-cookie';

          // fetch con credentials: 'include' para que el browser envíe
          // Y reciba cookies httpOnly del backend (Sanctum las emite así
          // — httpOnly=false para que el JS pueda leer XSRF-TOKEN y
          // copiarla al header).
          fetch(endpoint, {
            method: 'GET',
            credentials: 'include',
          }).catch(function () {
            // Silenciar errores — si el backend está caído, el POST
            // subsiguiente también va a fallar y va a mostrar el error
            // correspondiente al user. No spameamos console.error acá.
          });
        } catch (_) {
          /* noop */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-slate-900 font-sans text-slate-900 antialiased">
    <slot />
  </body>
</html>
