---
/**
 * AccountLayout — Shell visual completo de la sección clientes
 * (post-login: dashboard, profile, orders, addresses, wishlist, etc).
 *
 * Compone:
 *   - `<head>` con theme tokens del tenant en CSS vars (`--primary`,
 *     `--primary-hover`) para que TODO el subtree herede el branding
 *     sin hardcodear hexes.
 *   - `<AccountSidebar>` con los items de navegación.
 *   - `<slot />` con el contenido de la página concreta.
 *
 * Multi-tenancy:
 *   - `Astro.locals.tenant.tenantSlug` (del middleware) → brand.
 *   - `Astro.locals.theme` (del middleware) → override dinámico.
 *   - Fallback: DEFAULT_BRAND.
 *
 * Auth:
 *   - Esta versión NO envuelve con AuthGuard (todavía no existe un
 *     customer-side AuthGuard unificado). En F2 se integrará cuando
 *     `/api/storefront/me` exista.
 *
 * **AGENTS.md §16**: shell — siempre via este layout para
 * `/[locale]/account/*` (excepto auth pages: login, signup,
 * forgot-password usan `AuthLayout` + `AuthShell`).
 */
import '../../styles/global.css';
import { getBrandBySlug, type StoreBrand } from '../config/stores';
import { themeToBrand } from '../lib/theme';
import { getServerDictionary, getServerLocale } from '../i18n/server';
import AccountSidebar from '../components/account/layout/AccountSidebar.astro';

interface Props {
  title?: string;
}

const { title = 'Mi cuenta' } = Astro.props;

const locale = getServerLocale(Astro.locals.locale);
const t = getServerDictionary(Astro.locals.locale);

const tenantSlug = Astro.locals.tenant?.tenantSlug ?? null;
const fallbackBrand = getBrandBySlug(tenantSlug);
const brand: StoreBrand = themeToBrand(Astro.locals.theme, fallbackBrand);

const themeRootStyle = `--primary: ${brand.accentColor}; --primary-hover: ${brand.accentHoverColor};`;

const localePrefix = `/${locale}`;
const currentPath = Astro.url.pathname;

const navItems = [
  {
    key: 'account.sidebar.nav.dashboard' as const,
    label: t['account.sidebar.nav.dashboard'],
    path: `${localePrefix}/account`,
    iconName: 'squares-2x2',
  },
  {
    key: 'account.sidebar.nav.profile' as const,
    label: t['account.sidebar.nav.profile'],
    path: `${localePrefix}/account/profile`,
    iconName: 'user',
  },
  {
    key: 'account.sidebar.nav.orders' as const,
    label: t['account.sidebar.nav.orders'],
    path: `${localePrefix}/account/orders`,
    iconName: 'shopping-cart',
  },
  {
    key: 'account.sidebar.nav.addresses' as const,
    label: t['account.sidebar.nav.addresses'],
    path: `${localePrefix}/account/addresses`,
    iconName: 'building-office',
  },
  {
    key: 'account.sidebar.nav.wishlist' as const,
    label: t['account.sidebar.nav.wishlist'],
    path: `${localePrefix}/account/wishlist`,
    iconName: 'gift',
  },
  {
    key: 'account.sidebar.nav.security' as const,
    label: t['account.sidebar.nav.security'],
    path: `${localePrefix}/account/security`,
    iconName: 'shield-check',
  },
  {
    key: 'account.sidebar.nav.tickets' as const,
    label: t['account.sidebar.nav.tickets'],
    path: `${localePrefix}/account/tickets`,
    iconName: 'chat-bubble-left-right',
  },
  {
    key: 'account.sidebar.nav.notifications' as const,
    label: t['account.sidebar.nav.notifications'],
    path: `${localePrefix}/account/notifications`,
    iconName: 'bell',
  },
  {
    key: 'account.sidebar.nav.privacy' as const,
    label: t['account.sidebar.nav.privacy'],
    path: `${localePrefix}/account/privacy`,
    iconName: 'cog-6-tooth',
  },
];
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {brand.name}</title>
  </head>

  <body
    class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased"
    style={themeRootStyle}
  >
    <main
      id="main-content"
      class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6 sm:px-6 lg:flex-row lg:gap-8 lg:px-8 lg:py-10"
    >
      <AccountSidebar
        title={t['account.sidebar.title']}
        navLabel={t['account.sidebar.navLabel']}
        logoutLabel={t['account.sidebar.logout']}
        items={navItems}
        currentPath={currentPath}
        localePrefix={localePrefix}
      />

      <div class="flex w-full min-w-0 flex-col gap-6">
        <slot />
      </div>
    </main>
  </body>
</html>
