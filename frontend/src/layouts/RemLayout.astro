---
import '../styles/global.css';
import { getServerDictionary } from '../i18n/server';
import { SUPPORTED_LOCALES, type Locale } from '../i18n/config';

/**
 * RemLayout.astro
 *
 * 2-column shell for the REM viewer (REQ-11#1 landmarks + REQ-06#2
 * print stylesheet linking).
 *
 * Document structure:
 *
 *   <html>
 *     <head>
 *       <title>{title}</title>
 *       <link rel="stylesheet" href="...rem-print.css" media="print" />
 *     </head>
 *     <body>
 *       <header>...</header>
 *       <nav aria-label="rem.sidebar.heading">...</nav>
 *       <main>...</main>
 *       <footer>...</footer>
 *     </body>
 *   </html>
 *
 * Pure shell: no data fetching, no client-side logic. The page
 * (`pages/[locale]/rem/index.astro`) passes the rendered
 * sidebar / detail / footer / header-actions content as slots.
 *
 * The print stylesheet is linked via `<link>` with `media="print"` per
 * spec REQ-06#2 + design §10 (DP7). The browser only loads it when the
 * user actually prints, so the rest of the page bundle stays print-
 * free.
 *
 * Translator is the same `(key: string) => string` shape used by
 * `format.ts` so the page (Batch 2b) can wire `useTranslations().t`
 * verbatim without touching this file.
 */

interface Props {
  /** Browser tab + `<header>` heading text. */
  title: string;
  /**
   * Locale code used for the `<html lang>` attribute (REQ-08#1). The
   * page reads it from `Astro.params.locale` and forwards it here so
   * the SSR output advertises the correct language to assistive tech.
   * Defaults to `'es'` for backward compat with the previous
   * hard-coded `<html lang="es">`.
   */
  locale?: 'es' | 'en';
  /** Optional aria-label override for the <nav> landmark. */
  navLabel?: string;
  /** Optional translator (Batch 2b wires real i18n). */
  t?: (key: string) => string;
}

const {
  title,
  locale = 'es',
  navLabel = 'rem.sidebar.heading',
  t: tProp,
} = Astro.props;

// Always resolve `t` against the server dictionary for the active
// locale. When the caller passes `t` (page route or the API endpoint)
// we honor it; otherwise we derive from `Astro.locals.locale` (set by
// the project middleware) and fall back to identity for safety.
const resolvedLocale: Locale =
  (Astro.locals.locale as Locale | undefined) ?? locale;
const dictionary = getServerDictionary(resolvedLocale);
const fallbackT = (key: string): string =>
  (dictionary as Record<string, string>)[key] ?? key;
const t = tProp ?? fallbackT;

/**
 * Vite resolves the CSS file via its import and emits a hashed asset
 * URL. We use Astro's CSS import (`?url&inline` via `import.meta.url`
 * pattern) so the production build keeps the `media="print"` constraint
 * even after asset hashing.
 *
 * The dev path is a literal `/src/styles/rem-print.css` so HMR keeps
 * the stylesheet live during development.
 */
const cssHref = '/src/styles/rem-print.css';
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href={cssHref} media="print" />
  </head>
  <body class="rem-shell min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
    <div class="rem-shell__app flex min-h-screen flex-col">
      <header
        role="banner"
        aria-label={t('rem.shell.header')}
        class="rem-shell__header flex items-center justify-between border-b border-slate-200 bg-white px-6 py-4 shadow-sm"
      >
        <h1 class="rem-shell__title text-lg font-semibold">{title}</h1>
        <div class="rem-shell__actions flex items-center gap-3" data-rem-shell-actions>
          <slot name="header-actions" />
        </div>
      </header>

      <div class="rem-shell__body flex flex-1 flex-col lg:flex-row">
        <nav
          aria-label={t(navLabel)}
          class="rem-shell__nav rem-sidebar w-full border-b border-slate-200 bg-white lg:w-[30rem] lg:border-b-0 lg:border-r lg:overflow-y-auto"
        >
          <slot name="sidebar" />
        </nav>

        <main
          role="main"
          aria-label={t('rem.shell.main')}
          class="rem-shell__main rem-detail-container flex-1 overflow-y-auto px-6 py-6"
        >
          <article class="rem-detail" data-rem-detail>
            <slot name="detail" />
          </article>
        </main>
      </div>

      <footer
        role="contentinfo"
        aria-label={t('rem.shell.footer')}
        class="rem-shell__footer border-t border-slate-200 bg-white px-6 py-3 text-xs text-slate-500"
      >
        <slot name="footer" />
      </footer>
    </div>
  </body>
</html>
