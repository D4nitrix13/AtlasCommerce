---
import { getServerDictionary } from "../../i18n/server";

/**
 * Layout compartido para todas las pantallas de auth (forgot password,
 * login admin, login cliente, register cliente).
 *
 * Estructura: 2 columnas en desktop (ilustración + form). En mobile
 * se apila vertical (form primero, ilustración oculta).
 *
 * Props:
 *   - illustration: ruta a la imagen SVG (relativa a /public).
 *   - illustrationAlt: texto alternativo para la imagen.
 *   - leftHeading: heading del lado izquierdo (debajo de la ilustración).
 *   - leftBody: cuerpo del lado izquierdo.
 *   - brandName: nombre que se muestra (en cursiva).
 *   - signupHref: ruta real al signup (sin .html).
 *   - loginHref: ruta real al login (sin .html).
 *   - backHref: ruta real al login para el link "Volver" (sin .html).
 *   - side: en qué lado va la ilustración ("left" o "right").
 */
interface Props {
  illustration: string;
  illustrationAlt: string;
  leftHeading: string;
  leftBody: string;
  brandName: string;
  brandLogo?: string;
  brandLogoAlt?: string;
  topRightLink?: "signup" | "login" | "back" | "none";
  signupHref?: string;
  loginHref?: string;
  backHref?: string;
  side?: "left" | "right";
  background?: string;
  showIllustration?: boolean;
}

const {
  illustration,
  illustrationAlt,
  leftHeading,
  leftBody,
  brandName,
  brandLogo,
  brandLogoAlt,
  topRightLink = "none",
  signupHref = "signup",
  loginHref = "login",
  backHref = "login",
  side = "left",
  background = "bg-white",
  showIllustration = true,
} = Astro.props;

const t = getServerDictionary(Astro.locals.locale);
const isReversed = side === "right";
---

<div class={`min-h-screen grid lg:grid-cols-[45%_55%] ${background}`}>
  {
    showIllustration && (
      <aside
        class:list={[
          "hidden lg:flex relative items-center justify-center p-12 overflow-hidden",
          isReversed ? "lg:order-2" : "lg:order-1",
        ]}
        style="background: radial-gradient(circle at 30% 30%, #E6F7F4 0%, #ffffff 70%);"
      >
        {/* Decoración: burbujas suaves */}
        <div class="absolute top-10 left-10 w-20 h-20 rounded-full bg-[#8FD9CD] opacity-30"></div>
        <div class="absolute bottom-20 right-16 w-32 h-32 rounded-full bg-[#C2EBE4] opacity-40"></div>
        <div class="absolute top-1/3 right-10 w-12 h-12 rounded-full bg-[#5BC7B5] opacity-30"></div>

        <div class="relative z-10 max-w-md text-center">
          <img
            src={illustration}
            alt={illustrationAlt}
            class="w-full h-auto mx-auto drop-shadow-xl"
            loading="eager"
          />
          <h2 class="mt-6 text-2xl font-bold text-slate-900">{leftHeading}</h2>
          <p class="mt-2 text-slate-600">{leftBody}</p>
        </div>
      </aside>
    )
  }

  <main
    class:list={[
      "flex items-center justify-center p-4 sm:p-8 lg:p-10",
      isReversed ? "order-2 lg:order-1" : "lg:order-2",
    ]}
  >
    {/* max-w-4xl = ~896px: el form ocupa todo el ancho disponible sin
        que el card se vea apretado en mobile/tablet. Antes max-w-2xl
        (672px) limitaba el card a 448px en viewports chicos. */}
    <div class="w-full max-w-4xl">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mb-10">
        <div class="flex items-center gap-3 shrink-0">
          {brandLogo && (
            <img
              src={brandLogo}
              alt={brandLogoAlt ?? brandName}
              class="h-10 w-10 shrink-0 rounded-md bg-white object-contain p-1"
              loading="eager"
            />
          )}
          <span class="whitespace-nowrap text-xl font-bold italic text-slate-900">{brandName}</span>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <slot name="topRightExtra" />
          {topRightLink === "signup" && (
            <a
              href={signupHref}
              data-auth-link="signup"
              class="whitespace-nowrap text-sm text-slate-500 hover:text-[#2D9D8E] transition"
            >
              <slot name="topRightLink">
                ¿No tienes cuenta? <span class="font-semibold text-[#2D9D8E]">Regístrate</span>
              </slot>
            </a>
          )}
          {topRightLink === "login" && (
            <a
              href={loginHref}
              data-auth-link="login"
              class="whitespace-nowrap text-sm text-slate-500 hover:text-[#2D9D8E] transition"
            >
              <slot name="topRightLink">
                ¿Ya tienes cuenta? <span class="font-semibold text-[#2D9D8E]">Inicia sesión</span>
              </slot>
            </a>
          )}
          {topRightLink === "back" && (
            <a
              href={backHref}
              data-auth-link="back"
              class="whitespace-nowrap text-sm text-slate-500 hover:text-[#2D9D8E] transition"
            >
              <slot name="topRightLink">
                <span class="font-semibold text-[#2D9D8E]">← Volver a iniciar sesión</span>
              </slot>
            </a>
          )}
        </div>
      </div>

      <slot />

      {/* Footer terms con spacing correcto. El <p> wrapper está DENTRO del slot default
          para que las páginas puedan override con su propio <p slot="terms"> sin generar
          un <p> anidado (que el navegador cierra automáticamente, dejando wrapper vacío). */}
      <slot name="terms">
        <p class="text-center text-xs text-slate-400 mt-8">
          {t["auth.shell.termsPrefix"]}{" "}
          <a href="#" class="underline hover:text-[#2D9D8E]">{t["auth.shell.termsLink"]}</a>
          {" "}{t["auth.shell.termsAnd"] ?? "y"}{" "}
          <a href="#" class="underline hover:text-[#2D9D8E]">{t["auth.shell.privacyLink"]}</a>.
        </p>
      </slot>
    </div>
  </main>
</div>