---
/**
 * RemDetail.astro
 *
 * Server-rendered detail panel for one requirement (or stakeholder)
 * — REQ-05 + REQ-04#2. Zero client JS; the page hydrates with this
 * markup already in place.
 *
 * The detail panel swap-on-selection uses `fetch + innerHTML` from
 * `RemSidebar.tsx` (F2-locked, design §4 step 8): the island fetches
 * `/api/rem/<uid>.html` (Batch 2b's endpoint) and replaces the contents
 * of `.rem-detail` with the Astro-rendered HTML for the new UID.
 *
 * Row specs come from `buildDetailRows` in `lib/rem/format.ts` so the
 * production Astro and the unit tests share the same source of truth.
 */

import RemFieldRow from './RemFieldRow.astro';
import { buildDetailRows } from '../../lib/rem/format';
import { buildCodeToUidMap, codeToHref } from '../../lib/rem/links';
import { getServerDictionary } from '../../i18n/server';
import { SUPPORTED_LOCALES, type Locale } from '../../i18n/config';
import type { Requirement, Stakeholder } from '../../lib/rem/types';
import type { RemDataset } from '../../lib/rem/types';

interface Props {
  /** The item to display — an RF, RNF, or stakeholder. */
  item: Requirement | Stakeholder;
  /** Stakeholder list for resolving `verifiedBy` UIDs to names. */
  stakeholders?: Stakeholder[];
  /** Translator — same shape as React `useTranslations()`'s `t`. */
  t?: (key: string) => string;
  /** Active locale for deep-link href construction (`/es/rem?id=...`). */
  locale?: string;
  /** Full dataset so we can link chips by code (RF-AUTH-001 → rf_NNN). */
  dataset?: RemDataset;
}

const { item, stakeholders = [], t: tProp, locale, dataset } = Astro.props;

// Build the code→uid map once at render time so each chip in the
// Fuentes/Dependencias row can render an internal <a> with the right
// href. Cheap linear pass; safer than a regex on the codes.
const codeToUid = dataset !== undefined
  ? buildCodeToUidMap(dataset)
  : new Map<string, string>();

// Resolve locale with priority: middleware `Astro.locals.locale` >
// `locale` prop > 'es' fallback. Single declaration used by the
// translator below AND by the chip-link hrefs.
const resolvedLocale: Locale =
  (Astro.locals.locale as Locale | undefined) ??
  (locale !== undefined
    ? ((SUPPORTED_LOCALES as readonly string[]).includes(locale)
        ? (locale as Locale)
        : 'es')
    : 'es');

// Build a locale-aware fallback translator from the server dictionary
// (set by the project middleware via `Astro.locals.locale`). The page
// route and the API endpoint both pass `t`; this fallback prevents
// identity-key rendering if either forgets.
const dictionary = getServerDictionary(resolvedLocale);
const fallbackT = (key: string): string =>
  (dictionary as Record<string, string>)[key] ?? key;
const t = tProp ?? fallbackT;

const rows = buildDetailRows(item, t, stakeholders);

// ─── Header line ─────────────────────────────────────────────────────

interface HeaderShape {
  code: string | null;
  title: string | null;
  kind: 'rf' | 'rnf' | 'stakeholder';
}

function headerOf(item: Requirement | Stakeholder): HeaderShape {
  if ('kind' in item) {
    return { code: item.code || null, title: item.title || null, kind: item.kind };
  }
  return { code: item.uid, title: item.name || null, kind: 'stakeholder' };
}

// `buildDetailRows` returns a `stakeholders` shape for the
// `verifiedBy` row; the field row component renders that as plain
// text by joining the resolved names.
function rowValueToString(value: (typeof rows)[number]['value']): string | string[] | null {
  if (value === null) return null;
  if (Array.isArray(value)) return value;
  if (typeof value === 'object' && value.kind === 'stakeholders') {
    return value.names.join(', ');
  }
  return null;
}

const header = headerOf(item);
const headerTitle = `${header.code ?? '?'} — ${header.title ?? 'Sin título'}`;
---

<section
  data-rem-detail-render
  data-rem-detail-kind={header.kind}
  data-rem-detail-uid={'uid' in item ? item.uid : ''}
  class="rem-detail__panel w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
>
  <header class="rem-detail__header -mx-px -mt-px mb-0 border-b border-slate-200 bg-gradient-to-r from-[#2D9D8E]/8 via-white to-white px-8 py-6">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#2D9D8E]/15 text-lg font-bold text-[#1E6F62]">
        {header.kind === 'rf' ? '⚡' : header.kind === 'rnf' ? '⚙' : '👤'}
      </span>
      <div class="min-w-0 flex-1">
        <h2 class="rem-detail__header-title text-2xl font-bold tracking-tight text-slate-900">
          {headerTitle}
        </h2>
        <div class="mt-1 flex items-center gap-2 text-xs text-slate-500">
          <span class="inline-flex items-center rounded bg-slate-100 px-2 py-0.5 font-mono uppercase tracking-wide">
            {header.kind === 'rf' ? 'Requisito Funcional' : header.kind === 'rnf' ? 'Requisito No Funcional' : 'Stakeholder'}
          </span>
          <span>·</span>
          <span>Detalle completo</span>
        </div>
      </div>
    </div>
  </header>

  <table class="rem-detail__table w-full border-collapse text-left" role="table">
    <tbody>
      {
        rows.map((row, idx) => (
          <RemFieldRow
            label={row.labelKey}
            value={rowValueToString(row.value)}
            isLinksRow={row.field === 'fuentes'}
            accentIndex={idx}
            codeToUid={codeToUid}
            locale={resolvedLocale}
          />
        ))
      }
    </tbody>
  </table>
</section>
