---
/**
 * RemSkeleton.astro
 *
 * First-paint loading state (REQ-10#1). Rendered server-side by the
 * RemLayout shell before the React `RemSidebar` island hydrates.
 *
 * The component is purely presentational: zero JS, zero data
 * fetching. Its contract is:
 *   - `[data-rem-skeleton]` wrapper selector (used by E2E + tests).
 *   - `aria-busy="true"` so assistive tech announces the loading
 *     state.
 *   - A neutral "Cargando visor…" label (i18n key, identity-mocked
 *     until Batch 2b lands).
 *
 * Mirrored in `RemSidebar.tsx` for hydration-window states: the React
 * island renders the same `data-rem-skeleton` + `aria-busy` markers
 * when the user types into the search before the first paint resolves.
 */

interface Props {
  t?: (key: string) => string;
}

const { t = (k: string) => k } = Astro.props;
---

<div data-rem-skeleton aria-busy="true" class="rem-skeleton flex animate-pulse flex-col gap-3 p-4">
  <span class="block h-4 w-1/2 rounded bg-slate-200"></span>
  <span class="block h-4 w-2/3 rounded bg-slate-200"></span>
  <span class="block h-4 w-3/4 rounded bg-slate-200"></span>
  <span class="block h-4 w-1/3 rounded bg-slate-200"></span>
  <span class="block h-4 w-1/2 rounded bg-slate-200"></span>
  <p class="mt-2 text-sm text-slate-500" aria-live="polite">
    {t('rem.skeleton.loading')}
  </p>
</div>
