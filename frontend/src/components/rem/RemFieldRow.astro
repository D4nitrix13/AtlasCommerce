---
/**
 * RemFieldRow.astro
 *
 * One row in the REM detail panel. Three visual variants:
 *   - null value              → "PD" (Por Definir) badge
 *                                 (REQ-05#3)
 *   - empty array on links row → red `?` with aria-label="Sin fuentes"
 *                                (REQ-05#4)
 *   - string or non-empty array → plain text render (or
 *                                clickable chips when `codeToUid`
 *                                resolves the entry to a uid)
 *
 * Variant selection lives in `lib/rem/format.ts` (`getFieldRowVariant`)
 * so the Vitest container-free test
 * (`tests/unit/components/rem/RemFieldRow.test.tsx`) can exercise it
 * without needing an Astro render API.
 *
 * Contrast targets (per design §9):
 *   - PD badge  bg-amber-100 / text-amber-900  = 7.5:1
 *   - Red `?`   bg-red-100 / text-red-700  = 5.9:1
 * Both pass WCAG 2.2 AA (≥ 4.5:1).
 */

import { getFieldRowVariant } from '../../lib/rem/format';
import { codeToHref } from '../../lib/rem/links';

interface Props {
  /** Cell label, already translated by the caller (e.g. "Módulo"). */
  label: string;
  /**
   * Cell value. `format.ts`'s `RowSpec.value` is the richer
   * `string | string[] | { kind: "stakeholders"; ... } | null` union
   * — the stakeholder-row case is rendered server-side by the parent
   * (`RemDetail.astro`) before this component sees it, so the type here
   * is the three-branch rendering subset the row needs.
   */
  value: string | string[] | null;
  /** True only on the Fuentes/Dependencias row (REQ-05#4). */
  isLinksRow?: boolean;
  /** Index of the row in the table — used to alternate the row background tint. */
  accentIndex?: number;
  /** code→uid lookup so chip arrays become clickable deep-links. */
  codeToUid?: ReadonlyMap<string, string>;
  /** Active locale for href construction (`/${locale}/rem?id=...`). */
  locale?: string;
}

const {
  label,
  value,
  isLinksRow = false,
  accentIndex = 0,
  codeToUid,
  locale,
} = Astro.props;
const variant = getFieldRowVariant(value, { isLinksRow });

const labelClass =
    'rem-detail-row__label w-1/4 border-b border-slate-200 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500 align-top';
  const rowBg = accentIndex % 2 === 0 ? 'bg-white' : 'bg-slate-50/40';
  const valueBaseClass = `rem-detail-row__value w-3/4 border-b border-slate-200 px-4 py-3 text-sm text-slate-900 align-top whitespace-pre-wrap break-words ${rowBg}`;

const chipBaseClass =
  'inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs text-slate-700 transition-colors hover:bg-[#2D9D8E]/15 hover:text-[#1E6F62] hover:ring-1 hover:ring-inset hover:ring-[#2D9D8E]/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D9D8E]';
---

<tr role="row" data-rem-row data-rem-row-variant={variant} class="group transition-colors hover:bg-[#2D9D8E]/5">
  <th scope="row" class={labelClass}>
    {label}
  </th>
  <td class={valueBaseClass}>
    {
      variant === 'pd' && (
        <span class="rem-pd-badge inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900 ring-1 ring-inset ring-amber-300">
          <svg class="mr-1 h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <circle cx="6" cy="6" r="3" />
          </svg>
          PD
        </span>
      )
    }
    {
      variant === 'no-links' && (
        <span
          aria-label="Sin fuentes"
          class="rem-no-links inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-100 text-base font-bold text-red-700 ring-1 ring-inset ring-red-300"
        >
          ?
        </span>
      )
    }
    {variant === 'plain' && (Array.isArray(value) ? (
      <span class="flex flex-wrap gap-1.5">
        {value.map((entry) => {
          // Each chip becomes a clickable deep-link when the
          // `codeToUid` map knows the entry; otherwise we render
          // a plain chip. Both share the same base class so layout
          // stays identical.
          const href = codeToUid !== undefined && locale !== undefined
            ? codeToHref(entry, codeToUid, locale)
            : null;
          if (href !== null) {
            return (
              <a
                href={href}
                data-rem-internal-link={entry}
                class={chipBaseClass}
                title={`Ir a ${entry}`}
              >
                <svg class="mr-1 h-3 w-3 opacity-60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 4 H12 V12" stroke-linecap="round" />
                  <path d="M9 3 L12 3 L12 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {entry}
              </a>
            );
          }
          return (
            <span
              key={entry}
              class={chipBaseClass.replace(/ ?hover:[^\s]+/g, '')}
              data-rem-chip-static={entry}
            >
              {entry}
            </span>
          );
        })}
      </span>
    ) : (
      <span>{value}</span>
    ))}
  </td>
</tr>
