---
/**
 * Button — primitive UI.
 *
 * Soporta 4 variantes visuales y 3 tamaños. Los tokens de color por
 * defecto son slate-700 (neutral) para que el padre (theme root) pueda
 * override vía `style="--primary: ..."`. El consumidor controla los
 * estados `loading` y `disabled` desde fuera.
 *
 * Accesibilidad:
 *  - Siempre `<button>` real (AGENTS §17).
 *  - Cuando `loading`, aria-busy=true y aria-disabled=true para lectores.
 *  - El label va por slot default para permitir íconos o composición.
 *
 * Uso:
 *   <Button variant="primary" size="md" type="submit">Guardar</Button>
 *   <Button variant="ghost" loading={isSubmitting}>Enviar</Button>
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  loading?: boolean;
  disabled?: boolean;
  fullWidth?: boolean;
  href?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  loading = false,
  disabled = false,
  fullWidth = false,
  href,
  ariaLabel,
  class: className,
} = Astro.props;

const isDisabled = disabled || loading;

const VARIANT_CLASSES: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'bg-[var(--primary,#475569)] text-white hover:bg-[var(--primary-hover,#334155)] focus-visible:ring-[var(--primary,#475569)]',
  secondary:
    'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 focus-visible:ring-slate-400',
  danger:
    'bg-red-600 text-white hover:bg-red-700 focus-visible:ring-red-500',
  ghost:
    'bg-transparent text-slate-700 hover:bg-slate-100 focus-visible:ring-slate-400',
};

const SIZE_CLASSES: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-6 text-base',
};

const BASE_CLASSES =
  'inline-flex items-center justify-center gap-2 rounded-lg font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60';

const classes = [
  BASE_CLASSES,
  VARIANT_CLASSES[variant],
  SIZE_CLASSES[size],
  fullWidth ? 'w-full' : '',
  className ?? '',
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a
      href={href}
      aria-label={ariaLabel}
      aria-disabled={isDisabled}
      class={classes}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={isDisabled}
      aria-busy={loading}
      aria-label={ariaLabel}
      class={classes}
    >
      {loading && (
        <span
          aria-hidden="true"
          class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent"
        />
      )}
      <slot />
    </button>
  )
}
