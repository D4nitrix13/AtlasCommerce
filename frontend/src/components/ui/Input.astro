---
/**
 * Input — primitive UI.
 *
 * Wrapper accesible de `<input>` con label asociado y soporte para
 * estados (error con mensaje). El consumidor controla el estado
 * `error` desde fuera; este componente no valida.
 *
 * Accesibilidad:
 *  - `<label for>` enlazado al id del input.
 *  - Cuando hay error: aria-invalid + aria-describedby al mensaje.
 *  - El hint usa `aria-describedby` cuando no hay error.
 *
 * Uso:
 *   <Input name="email" type="email" label="Correo" required />
 *   <Input name="email" error="Email inválido" />
 */
interface Props {
  name: string;
  id?: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search';
  label?: string;
  placeholder?: string;
  value?: string | number;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  error?: string;
  hint?: string;
  autocomplete?: string;
  min?: number | string;
  max?: number | string;
  pattern?: string;
  inputmode?: 'text' | 'numeric' | 'decimal' | 'tel' | 'email' | 'url' | 'search';
  class?: string;
}

const {
  name,
  id,
  type = 'text',
  label,
  placeholder,
  value,
  required = false,
  disabled = false,
  readonly = false,
  error,
  hint,
  autocomplete,
  min,
  max,
  pattern,
  inputmode,
  class: className,
} = Astro.props;

const inputId = id ?? `input-${name}`;
const messageId = `${inputId}-message`;
const hasError = typeof error === 'string' && error !== '';
---

<div class={`flex flex-col gap-1.5 ${className ?? ''}`}>
  {label && (
    <label for={inputId} class="text-sm font-medium text-slate-700">
      {label}
      {required && (
        <span aria-hidden="true" class="ml-1 text-red-500">
          *
        </span>
      )}
    </label>
  )}

  <input
    id={inputId}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    readonly={readonly}
    autocomplete={autocomplete}
    min={min}
    max={max}
    pattern={pattern}
    inputmode={inputmode}
    aria-invalid={hasError}
    aria-describedby={hasError || hint ? messageId : undefined}
    class:list={[
      'block w-full rounded-lg border bg-white px-3 py-2 text-sm text-slate-900 transition',
      'placeholder:text-slate-400',
      'focus:outline-none focus:ring-2 focus:ring-offset-0',
      hasError
        ? 'border-red-300 focus:border-red-500 focus:ring-red-200'
        : 'border-slate-200 focus:border-slate-400 focus:ring-slate-200',
      disabled && 'cursor-not-allowed bg-slate-50 opacity-70',
    ]}
  />

  {hasError ? (
    <p id={messageId} role="alert" class="text-xs text-red-600">
      {error}
    </p>
  ) : hint ? (
    <p id={messageId} class="text-xs text-slate-500">
      {hint}
    </p>
  ) : null}
</div>
