---
/**
 * ProductReviews — resumen de rating + lista de reseñas con filtro y
 * paginación interna (cargar más).
 *
 * UI/UX conventions (Amazon, Apple, Gibson, Nike):
 *   - Header con rating promedio grande + count + breakdown por estrella.
 *   - Filter chips por rating (Todos, 5★, 4★, etc.) con counts.
 *   - Lista de reseñas: por defecto muestra 3, con botón "Cargar más"
 *     si hay más. "Ver menos" para colapsar.
 *   - Estrellas renderizadas con SVG (accesible, no emoji).
 *   - "Compra verificada" badge para reseñas de buyers reales.
 *
 * Implementación:
 *   - SSR renderiza las primeras N reseñas y los filtros.
 *   - `<script>` inline lee `<details reviews-filter>` y `<details reviews-list>`
 *     y conecta los chips de filtro + el botón "Cargar más".
 *   - Filtro: oculta reseñas que no coincidan con el rating seleccionado.
 *   - "Cargar más": expande el `<details>` para mostrar todas.
 */
import type { ProductReview } from '../../../data/product-detail-mock';
import { getAverageRating } from '../../../data/product-detail-mock';

export interface ProductReviewsLabels {
  heading: string;
  average: string;
  outOf: string;
  count: string;
  write: string;
  viewAll: string;
  empty: string;
  verified: string;
  starAlt: string;
  loadMore: string;
  showLess: string;
  filterAll: string;
  filterByRating: string;
}

interface Props {
  labels: ProductReviewsLabels;
  reviews: readonly ProductReview[];
  /** Locale-prefixed href a la página completa de reseñas. */
  viewAllHref: string;
  /** Locale-prefixed href a escribir reseña. */
  writeHref: string;
  /** Cuántas reseñas mostrar antes de "Cargar más". Default 3. */
  initialCount?: number;
}

const {
  labels,
  reviews,
  viewAllHref,
  writeHref,
  initialCount = 3,
} = Astro.props;

const hasReviews = reviews.length > 0;
const average = hasReviews ? getAverageRating(reviews) : 0;
const reviewCount = reviews.length;
const countLabel = labels.count.replace('{count}', String(reviewCount));

// Cuenta de reseñas por rating (para los filter chips).
const ratingCounts = [5, 4, 3, 2, 1].map((stars) => ({
  stars,
  count: reviews.filter((r) => Math.floor(r.rating) === stars).length,
}));
---

<section
  aria-labelledby="reviews-heading"
  class="flex flex-col gap-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"
  data-reviews
>
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2">
      <h2 id="reviews-heading" class="text-xl font-bold text-slate-900">
        {labels.heading}
      </h2>
      {hasReviews ? (
        <div class="flex items-center gap-3">
          <div
            class="flex items-center gap-1"
            role="img"
            aria-label={`${labels.average} ${average} ${labels.outOf}`}
          >
            {Array.from({ length: 5 }, (_, i) => {
              const isFull = i < Math.floor(average);
              const isHalf = !isFull && i < average;
              return (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill={isFull ? '#facc15' : isHalf ? 'url(#halfGrad)' : '#e2e8f0'}
                  stroke="currentColor"
                  stroke-width="0"
                  class="h-5 w-5 text-amber-400"
                  aria-hidden="true"
                >
                  {isHalf && (
                    <defs>
                      <linearGradient id="halfGrad" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="50%" stop-color="#facc15" />
                        <stop offset="50%" stop-color="#e2e8f0" />
                      </linearGradient>
                    </defs>
                  )}
                  <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" />
                </svg>
              );
            })}
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-bold tabular-nums text-slate-900">{average.toFixed(1)}</span>
            <span class="text-xs text-slate-500">
              {labels.outOf} · {countLabel}
            </span>
          </div>
        </div>
      ) : (
        <p class="text-sm text-slate-500">{labels.empty}</p>
      )}
    </div>
    <a
      href={writeHref}
      class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
    >
      {labels.write}
    </a>
  </header>

  {/* Filter chips por rating */}
  {hasReviews && (
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label={labels.filterByRating}>
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
        {labels.filterByRating}:
      </span>
      <button
        type="button"
        data-reviews-filter="all"
        aria-pressed="true"
        class="inline-flex items-center gap-1.5 rounded-full border border-[var(--primary,#475569)] bg-[var(--primary,#475569)] px-3 py-1 text-xs font-semibold text-white transition hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
      >
        {labels.filterAll} <span class="opacity-80">({reviewCount})</span>
      </button>
      {ratingCounts.map(({ stars, count }) => (
        <button
          type="button"
          data-reviews-filter={stars}
          aria-pressed="false"
          disabled={count === 0}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            'data-[active=true]:border-[var(--primary,#475569)] data-[active=true]:bg-[var(--primary,#475569)]/5 data-[active=true]:text-[var(--primary,#475569)]',
            count === 0 && 'cursor-not-allowed opacity-50',
          ]}
        >
          {stars}★ <span class="opacity-70">({count})</span>
        </button>
      ))}
    </div>
  )}

  {hasReviews && (
    <ul
      class="flex list-none flex-col gap-4 p-0"
      role="list"
      data-reviews-list
    >
      {reviews.map((review) => (
        <li
          class="flex flex-col gap-2 border-t border-slate-100 pt-4 first:border-t-0 first:pt-0"
          data-review-rating={Math.floor(review.rating)}
          data-review-index={reviews.indexOf(review)}
        >
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-slate-900">{review.authorName}</span>
              {review.verified && (
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-3 w-3"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  {labels.verified}
                </span>
              )}
            </div>
            <time class="text-xs text-slate-500" datetime={review.createdAt}>
              {new Date(review.createdAt).toLocaleDateString('es-NI', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
          </div>
          <div
            class="flex items-center gap-1"
            role="img"
            aria-label={labels.starAlt.replace('{count}', String(review.rating))}
          >
            {Array.from({ length: 5 }, (_, i) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill={i < review.rating ? '#facc15' : '#e2e8f0'}
                stroke="currentColor"
                stroke-width="0"
                class="h-4 w-4 text-amber-400"
                aria-hidden="true"
              >
                <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" />
              </svg>
            ))}
          </div>
          <h3 class="text-sm font-semibold text-slate-900">{review.title}</h3>
          <p class="text-sm leading-relaxed text-slate-700">{review.body}</p>
        </li>
      ))}
    </ul>
  )}

  {/* Cargar más / Ver menos */}
  {hasReviews && reviews.length > initialCount && (
    <div class="flex items-center justify-center border-t border-slate-100 pt-4">
      <button
        type="button"
        data-reviews-toggle
        data-initial-count={initialCount}
        class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
      >
        <span data-reviews-label-show>{labels.loadMore}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-4 w-4 transition-transform duration-200 group-aria-expanded:rotate-180"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </button>
    </div>
  )}

  {hasReviews && reviews.length > 5 && (
    <div class="border-t border-slate-100 pt-4">
      <a
        href={viewAllHref}
        class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--primary,#475569)] hover:underline"
      >
        {labels.viewAll}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>
  )}
</section>

<script>
  /**
   * ProductReviews — interactividad:
   *   1. Filter chips por rating: ocultan reseñas que no coincidan.
   *   2. Botón "Cargar más": muestra todas las reseñas (oculta las extras inicialmente).
   */
  function setupReviewsFilter(root: HTMLElement): void {
    const filterButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-reviews-filter]')
    );
    const reviewItems = Array.from(
      root.querySelectorAll<HTMLElement>('[data-review-rating]')
    );
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-reviews-toggle]');

    if (filterButtons.length === 0) return;

    // 1. Filter por rating
    const applyFilter = (filter: string) => {
      reviewItems.forEach((item) => {
        const rating = Number(item.dataset.reviewRating ?? '0');
        const index = Number(item.dataset.reviewIndex ?? '-1');
        const initialCount = Number(toggleBtn?.dataset.initialCount ?? '3');

        // Filter por rating
        const matchesRating = filter === 'all' || rating === Number(filter);
        // Límite por "cargar más": solo aplica cuando NO está expandido
        const withinLimit = filter === 'all' || index < initialCount;
        // Cuando el filtro está activo (no 'all'), mostramos todas las que coincidan
        const visible = filter === 'all'
          ? (withinLimit ? !item.hidden : true) // all: depende del toggle
          : matchesRating; // filtrado: solo las del rating

        if (filter === 'all') {
          // Restaurar comportamiento del toggle
          const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
          if (isExpanded || withinLimit) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        } else {
          item.classList.toggle('hidden', !visible);
        }
      });

      // Update aria-pressed en filter buttons
      filterButtons.forEach((btn) => {
        const isActive = btn.dataset.reviewsFilter === filter;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.dataset.active = String(isActive);
      });
    };

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.reviewsFilter ?? 'all';
        applyFilter(filter);
      });
    });

    // 2. Toggle "Cargar más" / "Ver menos"
    if (toggleBtn !== null) {
      const labelEl = toggleBtn.querySelector<HTMLElement>('[data-reviews-label-show]');
      const labelShow = labelEl?.textContent ?? '';
      const labelHide = toggleBtn.dataset.reviewsLabelHide ?? labelShow;
      const initialCount = Number(toggleBtn.dataset.initialCount ?? '3');

      // Inicial: ocultar las reseñas extras
      const applyToggleState = (expanded: boolean) => {
        toggleBtn.setAttribute('aria-expanded', String(expanded));
        if (labelEl !== null) labelEl.textContent = expanded ? labelHide : labelShow;
        reviewItems.forEach((item) => {
          const index = Number(item.dataset.reviewIndex ?? '-1');
          const isVisible = expanded || index < initialCount;
          // Solo aplicar si NO hay un filter activo
          const activeFilterBtn = filterButtons.find((b) => b.getAttribute('aria-pressed') === 'true');
          if (activeFilterBtn?.dataset.reviewsFilter === 'all') {
            item.classList.toggle('hidden', !isVisible);
          }
        });
      };

      applyToggleState(false);

      toggleBtn.addEventListener('click', () => {
        const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        applyToggleState(!expanded);
      });
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-reviews]')
    .forEach(setupReviewsFilter);
</script>