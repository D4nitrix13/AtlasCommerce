---
/**
 * ProductQuantitySelector — botones +/- con readout.
 *
 * Baymard research/product-page:
 *  - Botones +/- reales (no spinner nativo) — mejor para mobile y
 *    accesibilidad (aria-label explicito).
 *  - Readout anunciado a screen readers via `aria-live="polite"`.
 *  - Min=1, max configurable (default 99, o el stock disponible).
 *  - Disabled state para los extremos (no se puede bajar de 1, no
 *    se puede subir del max).
 */
export interface ProductQuantitySelectorLabels {
  label: string;
  decrement: string;
  increment: string;
}

interface Props {
  labels: ProductQuantitySelectorLabels;
  /** Cantidad actual. */
  quantity: number;
  /** Cantidad mínima. */
  min?: number;
  /** Cantidad máxima (default = stock del producto). */
  max?: number;
  /** Locale-prefixed href base. */
  hrefBase: string;
}

const { labels, quantity, min = 1, max = 99, hrefBase } = Astro.props;

const safeQty = Math.max(min, Math.min(quantity, max));
const decrementDisabled = safeQty <= min;
const incrementDisabled = safeQty >= max;

const url = (newQty: number): string => {
  const next = Math.max(min, Math.min(newQty, max));
  const params = new URLSearchParams({ qty: String(next) });
  return `${hrefBase}?${params.toString()}`;
};
---

<div class="flex flex-col gap-2">
  <span class="text-sm font-medium text-slate-700">{labels.label}</span>
  <div
    class="inline-flex w-fit items-center overflow-hidden rounded-lg border border-slate-200"
    role="group"
    aria-label={labels.label}
  >
    <a
      href={decrementDisabled ? undefined : url(safeQty - 1)}
      aria-label={labels.decrement}
      aria-disabled={decrementDisabled}
      class:list={[
        'flex h-10 w-10 items-center justify-center text-slate-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
        decrementDisabled ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-100',
      ]}
    >
      <span aria-hidden="true">−</span>
    </a>
    <span
      class="flex h-10 min-w-[3rem] items-center justify-center border-x border-slate-200 px-3 text-sm font-semibold tabular-nums text-slate-900"
      aria-live="polite"
      data-product-quantity
    >
      {safeQty}
    </span>
    <a
      href={incrementDisabled ? undefined : url(safeQty + 1)}
      aria-label={labels.increment}
      aria-disabled={incrementDisabled}
      class:list={[
        'flex h-10 w-10 items-center justify-center text-slate-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
        incrementDisabled ? 'cursor-not-allowed opacity-40' : 'hover:bg-slate-100',
      ]}
    >
      <span aria-hidden="true">+</span>
    </a>
  </div>
</div>
