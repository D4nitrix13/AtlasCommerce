---
/**
 * ProductFrequentlyBoughtTogether — bundle bass + accesorios relacionados
 * (patrón Fender/Gibson para e-commerce de instrumentos).
 *
 * Renderiza una grilla horizontal con:
 *   - El producto principal (el bajo)
 *   - 2-4 accesorios frecuentemente comprados juntos (amp, strap, case, etc.)
 *   - Botón "Agregar todo al carrito" con precio total
 *
 * Decisiones:
 *   - El CTA del footer es una isla React chica (`client:visible`) que
 *     agrega cada línea del bundle al cart store y navega al carrito.
 *     Sin JS el `<a>` sigue funcionando como link al carrito.
 *   - "+" visual entre items indica que se suman al bundle.
 *   - Cada item es un mini-card vertical con imagen, nombre y precio.
 *   - Labels por props (i18n en el caller), mismo patrón que
 *     `<ProductRelated>`: el componente no importa el diccionario.
 */
import type { Product } from '../../../types/catalog';

interface BundleItem {
  product: Product;
  /** Posición en el bundle (1-based). Usado para aria-label. */
  position: number;
}

interface Props {
  /** Heading del bundle. */
  heading: string;
  /** Subtítulo bajo el heading. */
  subtitle: string;
  /** Items del bundle — incluye el producto principal + accesorios. */
  items: readonly BundleItem[];
  /** URL del carrito locale-prefixed (fallback sin JS del CTA). */
  addAllHref: string;
  /** Label del botón "Agregar todo". */
  addAllLabel: string;
  /** Label "Total del bundle". */
  totalLabel: string;
  /** Aria-label de la lista de items del bundle. */
  itemsAriaLabel: string;
  /** Locale para formatear precios. */
  locale: string;
}

const { heading, subtitle, items, addAllHref, addAllLabel, totalLabel, itemsAriaLabel, locale } =
  Astro.props;

import { formatCurrency } from '../../../lib/formatters';
import FbtAddAllButton from './FbtAddAllButton';

const totalCents = items.reduce((sum, item) => sum + item.product.priceCents, 0);
const totalAmountLabel = formatCurrency(totalCents, items[0]?.product.currency ?? 'USD');
/** Líneas del bundle para el cart store (sin cantidad ni variantLabel). */
const bundleLines = items.map((item) => ({
  productSlug: item.product.slug,
  name: item.product.name,
  imageUrl: item.product.imageUrl,
  priceCents: item.product.priceCents,
  currency: item.product.currency ?? 'USD',
}));
---

<section
  aria-labelledby="bundle-heading"
  class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"
  data-reveal
>
  <header class="mb-6 flex flex-col gap-1">
    <h2 id="bundle-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      {heading}
    </h2>
    <p class="text-sm text-slate-600">
      {subtitle}
    </p>
  </header>

  <ul
    class="flex flex-wrap items-stretch justify-center gap-4 sm:gap-6"
    role="list"
    aria-label={itemsAriaLabel}
  >
    {items.map((item, idx) => (
      <Fragment>
        <li class="flex h-full w-32 flex-col items-center gap-2 sm:w-40">
          <a
            href={`/${locale}/products/${item.product.slug}`}
            class="group flex h-full w-full flex-col items-center gap-2 text-center"
            aria-label={`${item.product.name} — posición ${item.position} del bundle`}
          >
            <span class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition group-hover:border-[var(--primary,#475569)]">
              <img
                src={item.product.imageUrl}
                alt={item.product.name}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </span>
            <span class="text-xs font-medium text-slate-900 sm:text-sm">{item.product.name}</span>
            <span class="mt-auto text-xs font-bold tabular-nums text-slate-900">
              {formatCurrency(item.product.priceCents, item.product.currency ?? 'USD')}
            </span>
          </a>
        </li>
        {idx < items.length - 1 && (
          <li
            aria-hidden="true"
            class="flex h-12 w-8 items-center justify-center self-center text-2xl font-light text-slate-400"
          >
            +
          </li>
        )}
      </Fragment>
    ))}
  </ul>

  <footer class="mt-6 flex flex-col items-center gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:justify-between">
    <div class="flex flex-col gap-1 text-center sm:text-left">
      <span class="text-xs uppercase tracking-wider text-slate-500">{totalLabel}</span>
      <span class="text-2xl font-bold tabular-nums text-slate-900">{totalAmountLabel}</span>
    </div>
    <FbtAddAllButton client:visible lines={bundleLines} cartHref={addAllHref} label={addAllLabel} />
  </footer>
</section>
