---
/**
 * ProductCard — tarjeta de producto para grids del storefront.
 * Phase 9: swatch row Fender-style (≥2 variants), image-swap CSS-only
 * (`:has()` + per-variant `is:global` rules), `min-h` en title/desc
 * para alturas iguales sin tocar el grid container. Lógica en
 * `lib/product-card-swap.ts` para testearla aislada del render Astro.
 */
import Badge from '../../ui/Badge.astro';
import { formatCurrency } from '../../../lib/formatters';
import {
  buildStackedImages,
  buildVariantHoverCss,
  deriveProductCardSwap,
  shouldRenderSwatchRow,
  swatchFallbackHex,
} from '../../../lib/product-card-swap';
import type { Product, ProductBadge } from '../../../types/catalog';

export interface ProductCardLabels {
  newBadge: string;
  saleBadge: string;
  lowStockBadge: string;
  addToCart: string;
  outOfStock: string;
  viewDetail: string;
  /** Label del badge "Limitado" cuando `isExclusive === true`. Fallback hardcoded si falta. */
  limitedBadge?: string;
  /** Label del `role="group"` que envuelve la fila de swatches. Fallback hardcoded si falta. */
  swatchGroupLabel?: string;
  /** Template del contador "N colores". Fallback `${n} colores` español si falta. */
  finishCountLabel?: (count: number) => string;
}

interface Props {
  product: Product;
  locale: string;
  labels: ProductCardLabels;
  showAddToCart?: boolean;
  /** Eyebrow opcional arriba del título (ej. "Bajo eléctrico"). */
  eyebrow?: string;
}
const { product, locale, labels, showAddToCart = true, eyebrow } = Astro.props;

const detailHref = `/${locale}/products/${product.slug}`;
const currencyCode = product.currency ?? 'USD';
const priceFormatted = formatCurrency(product.priceCents, currencyCode);
const compareAtFormatted =
  product.compareAtPriceCents !== undefined
    ? formatCurrency(product.compareAtPriceCents, currencyCode)
    : null;
const isOutOfStock = product.stock <= 0;
const hasDiscount = compareAtFormatted !== null && !isOutOfStock;

const BADGE_STYLES: Record<
  ProductBadge,
  { variant: 'primary'; status: 'pending' | 'processing' | 'shipped'; label: keyof ProductCardLabels }
> = {
  new: { variant: 'primary', status: 'pending', label: 'newBadge' },
  sale: { variant: 'primary', status: 'processing', label: 'saleBadge' },
  low_stock: { variant: 'primary', status: 'shipped', label: 'lowStockBadge' },
};

const ariaLabelForBadge = (badge: ProductBadge): string => {
  const key = BADGE_STYLES[badge].label;
  // `labels[key]` puede ser `string | ((count: number) => string) | undefined`
  // porque `keyof ProductCardLabels` incluye `finishCountLabel` (función).
  // Filtramos no-strings para que TS no se queje y para que el aria-label
  // siempre sea un string (los badges no usan el formatter de count).
  const value = labels[key];
  return typeof value === 'string' ? value : '';
};

/** Fallback español para `finishCountLabel` (mismo pattern que `limitedBadge`). */
const defaultFinishCountLabel = (count: number): string => `${count} colores`;

const swap = deriveProductCardSwap(product);
const showSwatches = shouldRenderSwatchRow(swap.swatches);
const stackedImages = buildStackedImages(product, swap, showSwatches);
// El CSS se arma sobre `stackedImages`, no sobre `swap.variantImages`: un
// swatch cuyo archivo fue deduplicado (dos variants con la misma foto)
// tiene entrada en el mapa pero ninguna `<img>` en el DOM, y su regla de
// swap no matchearía nada.
const variantHoverCss = buildVariantHoverCss(swap, stackedImages);

/**
 * `buildVariantHoverCss` emite las reglas del MOUSE (`:hover`).
 * Para teclado espejamos los MISMOS selectores con `:focus-visible`, así
 * el swap por swatch también ocurre al tabular — sin `<script>`.
 *
 * El replace cubre las dos familias de reglas que emite la lib (swap y
 * escape de la primaria) porque ambas se disparan con `:hover)` dentro
 * del `:has()`: tabular a un swatch sin foto propia también tiene que
 * dejar la foto a la vista, igual que con el mouse.
 *
 * El replace es seguro: `cssEscape` escapa `\`, `"`, `(` y `)`, así que
 * el literal `:hover)` no puede aparecer dentro de un valor de atributo
 * (el `)` siempre va escapado y el replace no encuentra nada que tocar).
 */
const focusVariantCss = variantHoverCss.replaceAll(':hover)', ':focus-visible)');

const finishCountLabelText =
  labels.finishCountLabel === undefined
    ? defaultFinishCountLabel(swap.swatches.length)
    : labels.finishCountLabel(swap.swatches.length);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg focus-within:ring-2 focus-within:ring-[var(--primary,#475569)] focus-within:ring-offset-2">
  <a
    href={detailHref}
    class="productcard-swap-root relative block aspect-[4/5] overflow-hidden bg-slate-50"
    aria-label={`${labels.viewDetail}: ${product.name}`}
  >
    {/* Stack cross-fade CSS-only: primaria visible, las demás
        `opacity:0` (reglas al final). */}
    {stackedImages.map((image) => (
      <img
        src={image.src}
        srcset={image.srcset === '' ? undefined : image.srcset}
        alt={image.role === 'primary' ? image.alt : ''}
        loading="lazy"
        decoding="async"
        aria-hidden={image.role === 'primary' ? undefined : 'true'}
        class="productcard-swap-img absolute inset-0 h-full w-full object-cover transition duration-500 ease-out group-hover:scale-105"
        data-role={image.role}
        data-variant-id={image.variantId ?? ''}
      />
    ))}

    {product.badges && product.badges.length > 0 && (
      <div class="absolute left-3 top-3 flex flex-col gap-1.5">
        {product.badges.map((badge) => {
          const style = BADGE_STYLES[badge];
          const isNew = badge === 'new';
          return (
            <span aria-label={ariaLabelForBadge(badge)}>
              <Badge variant={isNew ? style.variant : undefined} status={isNew ? undefined : style.status}>
                {labels[style.label]}
              </Badge>
            </span>
          );
        })}
      </div>
    )}
    {isOutOfStock && (
      <div class="absolute right-3 top-3">
        <Badge variant="neutral">{labels.outOfStock}</Badge>
      </div>
    )}
    {/* Phase 7: badge "Limitado" — debajo del outOfStock badge si ambos aplican. */}
    {product.isExclusive === true && (
      <div class:list={['absolute right-3 flex flex-col items-end gap-1.5', isOutOfStock ? 'top-12' : 'top-3']}>
        <Badge variant="primary" status="pending">
          {labels.limitedBadge ?? 'Limitado'}
        </Badge>
      </div>
    )}
    {/* Phase 9: swatch row Fender-style (sólo ≥2 variants — un swatch es control muerto). */}
    {showSwatches && (
      <div
        class="absolute bottom-3 left-3 right-3 flex items-center gap-1.5"
        role="group"
        aria-label={labels.swatchGroupLabel ?? 'Variantes disponibles'}
      >
        <div class="flex flex-wrap items-center gap-1.5">
          {/*
            Se renderiza TODO swatch, incluso el que no aporta una foto
            propia al stack (su archivo fue deduplicado porque otra
            variant usa la misma foto — caso real: la versión zurda y la
            diestra de un mismo acabado). Mismo criterio y mismo motivo
            que en `ProductCardCatalog.astro`: el swatch comunica que ese
            acabado existe y es comprable, y el badge "N colores" cuenta
            los finishes reales. Ocultarlo los desincronizaría. El hover
            de un swatch sin foto propia sólo hace un cross-fade a la
            misma imagen, por las reglas de escape de
            `buildVariantHoverCss`.
          */}
          {swap.swatches.map((swatch) => {
            const isActive = swatch.id === swap.primaryVariantId;
            return (
              <button
                type="button"
                data-swatch-id={swatch.id}
                data-swatch-active={isActive ? 'true' : undefined}
                title={swatch.label}
                aria-label={swatch.label}
                aria-pressed={isActive ? 'true' : 'false'}
                class:list={[
                  'productcard-swap-swatch relative inline-flex h-5 w-5 items-center justify-center overflow-hidden rounded-full border border-white/80 shadow ring-1 ring-slate-300 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
                  isActive ? 'ring-2 ring-[var(--primary,#475569)]' : 'hover:scale-110',
                ]}
                style={`background-color: ${swatchFallbackHex(swatch)};`}
              >
                {swatch.thumbnailUrl !== null && (
                  <img
                    src={swatch.thumbnailUrl}
                    srcset={swatch.thumbnailSrcset ?? undefined}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                )}
              </button>
            );
          })}
        </div>
        <span class="ml-auto hidden rounded-full bg-black/40 px-2 py-0.5 text-[10px] font-semibold tabular-nums text-white sm:inline-block">
          {finishCountLabelText}
        </span>
      </div>
    )}
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4">
    {eyebrow !== undefined && eyebrow !== '' && (
      <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--primary,#475569)]">
        {eyebrow}
      </p>
    )}

    {/* Phase 9 height fix: el `line-clamp-2` va en el `<a>`, NO en el
        `<h3>`, y el `<h3>` NO lleva utility de `display`.

        `line-clamp-*` necesita `display: -webkit-box` para que
        `-webkit-line-clamp` haga algo. Cualquier utility de display en el
        mismo elemento lo pisa en la cascada y el clamp queda inerte sin
        error visible: `-webkit-line-clamp` sigue declarado en el estilo
        computado pero no recorta nada. Medido en Chromium: con
        `line-clamp-2 flex` en el mismo elemento el título llegaba a 4
        líneas (82.5px) y las cards variaban 20.6px de alto.

        `flex` + `items-end` sí se quedan en el `<h3>`: existen para
        anclar el texto abajo dentro del `min-h`, y no compiten con el
        clamp porque viven en otro elemento.

        `min-h-[2.5rem]` = 2 líneas de text-sm / leading-tight
        (≈ 1.25rem × 2). Con el clamp activo todo título mide ≤2 líneas, así
        que el `min-h` iguala las de 1 línea con las de 2 y la altura queda
        uniforme entre cards. */}
    <h3 class="flex min-h-[2.5rem] items-end text-sm font-semibold leading-tight text-slate-900">
      <a
        href={detailHref}
        class="line-clamp-2 transition hover:text-[var(--primary,#475569)] focus:outline-none focus-visible:underline"
      >
        {product.name}
      </a>
    </h3>
    <p class="line-clamp-2 min-h-[2rem] text-xs leading-tight text-slate-500">
      {product.description}
    </p>

    <div class="mt-auto flex items-end justify-between gap-2 pt-2">
      <div class="flex flex-col gap-0.5">
        <span
          class:list={[
            'text-base font-bold tabular-nums',
            isOutOfStock ? 'text-slate-400 line-through' : 'text-slate-900',
          ]}
        >
          {priceFormatted}
        </span>
        {hasDiscount && <span class="text-xs text-slate-400 line-through">{compareAtFormatted}</span>}
      </div>
      {showAddToCart && !isOutOfStock && (
        <a
          href={detailHref}
          class="inline-flex h-9 items-center justify-center rounded-full bg-slate-900 px-4 text-xs font-semibold text-white transition hover:bg-[var(--primary,#475569)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
        >
          {labels.addToCart}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* Default: sólo la imagen primaria está visible. Las del stack
     comparten el mismo rect (`absolute inset-0`), por eso `opacity:0`
     sin display:none — preserva la transición. */
  .productcard-swap-img { opacity: 0; transition: opacity 220ms ease-out; }
  .productcard-swap-img[data-role='primary'] { opacity: 1; }

  /* `@media (hover: hover)` evita sticky-hover en touch (un tap puede
     dejar el :hover pegado y esconder la primary detrás del back). */
  @media (hover: hover) {
    /* Card hover SIN swatch hovered → mostrar la foto de hover. La elige
       el administrador (`is_hover`); `deriveProductCardSwap` la lee de la
       galería. Si el producto no tiene foto de hover marcada no hay
       `<img data-role="back">` en el DOM y la regla no matchea: la
       portada queda a la vista. */
    .productcard-swap-root:not(:has(.productcard-swap-swatch:hover)):hover
      .productcard-swap-img[data-role='primary'] { opacity: 0; }
    .productcard-swap-root:not(:has(.productcard-swap-swatch:hover)):hover
      .productcard-swap-img[data-role='back'] { opacity: 1; }

    /* Swatch hovered → ocultar primary/back. Las reglas per-variant
       inyectadas abajo muestran la foto de ESE variant, o — si no tiene
       foto propia en el stack — devuelven la primaria a la vista, así
       que ningún hover puede dejar la card en blanco. */
    .productcard-swap-root:has(.productcard-swap-swatch:hover)
        .productcard-swap-img[data-role='primary'],
    .productcard-swap-root:has(.productcard-swap-swatch:hover)
        .productcard-swap-img[data-role='back'] { opacity: 0; }
  }

  /* Teclado: mismo contrato que el mouse pero con `:focus-visible`, para
     que tabular a un swatch también cambie la foto. El "ocultar
     primary/back" va FUERA del `@media (hover: hover)` a propósito — un
     híbrido touch+teclado no matchea ese media query y quedaría mostrando
     la primaria encima de la foto del variant. */
  .productcard-swap-root:has(.productcard-swap-swatch:focus-visible)
      .productcard-swap-img[data-role='primary'],
  .productcard-swap-root:has(.productcard-swap-swatch:focus-visible)
      .productcard-swap-img[data-role='back'] { opacity: 0; }

  /* ── Why: swatch ACTIVO hover/focus ────────────────────────────────
     El swatch activo apunta por `data-variant-id` a la MISMA imagen que
     ya es la primaria, así que las dos reglas anteriores la matan:
     "swatch hover → ocultar primary" gana en especificidad (0,3,4 — el
     scope de Astro suma un `[data-astro-cid]` por selector) contra el
     `is:global` que la muestra (0,2,3, sin scope). Resultado medido en
     Chromium: hover sobre el swatch activo dejaba la card en BLANCO.
     Estas dos reglas la vuelven a mostrar con 0,3,5 — un punto por
     encima del selector que la ocultaba. Para los swatches NO activos
     no matchean, así que su foto sigue mandando sin conflicto. */
  .productcard-swap-root:has(.productcard-swap-swatch[data-swatch-active]:hover)
      .productcard-swap-img[data-role='primary'] { opacity: 1; }
  .productcard-swap-root:has(.productcard-swap-swatch[data-swatch-active]:focus-visible)
      .productcard-swap-img[data-role='primary'] { opacity: 1; }
</style>

{/* Reglas per-variant de mouse y de teclado (`:hover` / `:focus-visible`).
    Sin esto `:has()` no puede resolver qué imagen mostrar: el selector
    depende del variant ID concreto. `is:global` porque los
    `[data-swatch-id="..."]` no entran en el scope de Astro. */}
{variantHoverCss !== '' && <style is:global set:html={variantHoverCss} />}
{focusVariantCss !== '' && <style is:global set:html={focusVariantCss} />}
