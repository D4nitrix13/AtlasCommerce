---
/**
 * FiltersDisclosure — acceso a los filtros en móvil (WU3 de
 * catalogo-plp-busqueda).
 *
 * El sidebar vive en `hidden lg:block`, así que bajo `lg` los filtros
 * eran inalcanzables. Este wrapper los hace accesibles con un
 * disclosure nativo (`<details>`/`<summary>`) — sin JS, sin islas y sin
 * overlay: Enter/Espacio expande el mismo `FiltersSidebar` de siempre.
 *
 * Decisiones:
 *  - **Dos copias del sidebar (móvil + desktop)**: el contenido de un
 *    `<details>` cerrado lo esconde el CSS del UA y no hay forma
 *    cross-browser de forzarlo visible sólo en ≥ lg sin JS. Se
 *    renderizan el disclosure (`lg:hidden`) y el panel estático
 *    (`hidden lg:block`) para conservar el desktop tal cual. Cada
 *    copia recibe un `idPrefix` distinto: sin ids duplicados en el DOM.
 *  - **Trigger compacto**: "Filtros (n)" con el conteo de filtros
 *    activos y chevron que rota con `group-open`. Una sola línea, misma
 *    paleta slate del PLP: la grilla de productos sigue siendo el foco.
 *  - **Links intactos**: lo revelado es `FiltersSidebar` tal cual
 *    (hrefs, `aria-current`, swatches) — sigue agnóstico al contexto
 *    responsive. El `details` aporta semántica y teclado gratis.
 */
import FiltersSidebar, {
  type BrandFilterOption,
  type CategoryFilterOption,
  type ColorFilterOption,
  type FiltersSidebarLabels,
  type PriceFilterOption,
  type SizeFilterOption,
} from './FiltersSidebar.astro';

interface Props {
  labels: FiltersSidebarLabels;
  /** Label del trigger sin conteo (p. ej. "Filtros"). */
  triggerLabel: string;
  /** Plantilla del trigger con `{count}` cuando hay filtros activos. */
  triggerCountTemplate: string;
  /** Cantidad de filtros activos (chips que arma la página). */
  activeCount: number;
  categories: readonly CategoryFilterOption[];
  brands?: readonly BrandFilterOption[];
  prices: readonly PriceFilterOption[];
  colors: readonly ColorFilterOption[];
  sizes: readonly SizeFilterOption[];
  /** Href que limpia todos los filtros (link "Limpiar"). */
  clearHref: string;
  /** Slug actualmente activo (categoría). */
  activeCategory?: string | null;
  /** Slugs actualmente activos (marca). */
  activeBrands?: readonly string[];
  /** Slug actualmente activo (precio). */
  activePrice?: string | null;
  /** Slugs actualmente activos (color). */
  activeColors?: readonly string[];
  /** Slugs actualmente activos (talla). */
  activeSizes?: readonly string[];
}

const { triggerLabel, triggerCountTemplate, activeCount, ...sidebarProps } =
  Astro.props;

const triggerText =
  activeCount > 0
    ? triggerCountTemplate.replace('{count}', String(activeCount))
    : triggerLabel;
---

<div>
  {/* Móvil (< lg): disclosure nativo con el sidebar adentro. */}
  <details class="group lg:hidden">
    <summary
      class="flex w-full cursor-pointer list-none items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-300 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden"
    >
      <span>{triggerText}</span>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-4 w-4 shrink-0 text-slate-500 transition-transform group-open:rotate-180"
      >
        <path
          fill-rule="evenodd"
          d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
          clip-rule="evenodd"
        ></path>
      </svg>
    </summary>
    <div class="mt-3 rounded-2xl border border-slate-200 bg-white p-6">
      <FiltersSidebar {...sidebarProps} idPrefix="m-" />
    </div>
  </details>

  {/* Desktop (≥ lg): panel estático, igual que antes del drawer. */}
  <div class="hidden lg:block">
    <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white p-6">
      <FiltersSidebar {...sidebarProps} idPrefix="d-" />
    </div>
  </div>
</div>
