---
/**
 * ProductDetailVariants — selector de variantes estilo Bonfire (v3).
 *
 * Diseño replicado del IA mock 5 (Bonfire-style product detail):
 *  - Tallas como pills (`rounded-full`), activas = `bg-[var(--primary)]
 *    text-white`, inactivas = borde slate + texto slate.
 *  - Colores como swatches redondos (44×44), activos = scale 110% +
 *    ring `[var(--primary)]`, inactivos = `hover:scale-105`.
 *  - Sin lógica de inventario (Trello card `v3`): las opciones son
 *    estáticas, hardcoded como `{ id, label, hex? }`. Cuando exista
 *    backend real, este componente recibe la lista del padre.
 *  - Renderiza un `<fieldset>` + `<legend>` por grupo (size / color)
 *    para mantener el agrupamiento semántico + accesibilidad.
 *  - Es un componente visual puro: no interactúa con URL ni form. El
 *    padre pasa el `selected` por prop y maneja los cambios cuando
 *    llegue el cart store. Mientras tanto, los clicks son no-op.
 *
 * `data-reveal` se aplica al wrapper raíz para coherencia con gallery.
 */

export interface VariantOption {
  /** ID estable para tracking. */
  id: string;
  /** Label localizado (ej. "S", "Negro"). */
  label: string;
  /** Hex para swatches de color. */
  hex?: string;
}

export interface ProductDetailVariantsLabels {
  sizeLegend: string;
  colorLegend: string;
}

interface Props {
  /** Tipo de variantes que renderiza este bloque (size / color). */
  type: 'size' | 'color';
  /** Opciones disponibles. */
  options: readonly VariantOption[];
  /** ID seleccionado actualmente. */
  selected?: string;
  /** Labels i18n. */
  labels: ProductDetailVariantsLabels;
}

const { type, options, selected, labels } = Astro.props;
const isColor = type === 'color';
const legendLabel = isColor ? labels.colorLegend : labels.sizeLegend;
---

<fieldset
  class="flex flex-col gap-3"
  data-reveal
  data-variant-type={type}
>
  <legend class="text-sm font-bold text-slate-900">{legendLabel}</legend>

  <div
    class:list={[
      'flex flex-wrap gap-2.5',
      isColor && 'gap-3',
    ]}
    role={isColor ? 'radiogroup' : 'radiogroup'}
    aria-label={legendLabel}
  >
    {options.map((option) => {
      const isActive = option.id === selected;
      return (
        <button
          type="button"
          role="radio"
          aria-checked={isActive}
          aria-label={isColor ? option.label : undefined}
          data-variant-id={option.id}
          class:list={[
            'relative inline-flex items-center justify-center transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2',
            isColor
              ? 'h-11 w-11 rounded-full border border-black/10'
              : 'h-12 rounded-full border-2 px-5 text-sm font-semibold',
            !isColor && isActive && 'border-[var(--primary)] bg-[var(--primary)] text-white',
            !isColor && !isActive && 'border-slate-200 bg-white text-slate-700 hover:text-slate-900',
            isColor && isActive && 'scale-110 ring-2 ring-[var(--primary)] ring-offset-2',
            isColor && !isActive && 'hover:scale-105',
          ]}
          style={isColor && option.hex !== undefined ? `background-color: ${option.hex};` : undefined}
          title={option.label}
        >
          {!isColor && <span>{option.label}</span>}
        </button>
      );
    })}
  </div>
</fieldset>