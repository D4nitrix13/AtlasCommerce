---
/**
 * ProductDetailVariants — selector de COLOR (swatches) del detail v4.
 *
 * Decisiones de scope:
 *  - Este componente ahora SOLO renderiza variantes de color. El slot
 *    de tamaño se movió a `ProductSizeGrid` (grid 2-col estilo Nike)
 *    y el slot de condición a `ProductFitSelector` (segmented pill).
 *    Mantener `ProductDetailVariants` como swatches preserva la
 *    responsabilidad SRP y reduce la complejidad condicional.
 *
 * Diseño:
 *  - Colores como swatches redondos (44×44).
 *  - Activos = `scale-110 ring-[var(--primary)] ring-offset-2`.
 *  - Inactivos = `hover:scale-105` + border sutil.
 *  - Sin lógica de URL/form: el padre pasa `selected` y maneja
 *    cambios cuando llegue el cart store.
 *  - `<fieldset>` + `<legend>` para agrupamiento semántico + a11y.
 *  - `data-reveal` aplicado al wrapper raíz para coherencia con gallery.
 */

export interface VariantOption {
  /** ID estable para tracking. */
  id: string;
  /** Label localizado (ej. "Negro"). */
  label: string;
  /** Hex para el swatch. */
  hex?: string;
}

interface Props {
  /** Opciones de color disponibles. */
  options: readonly VariantOption[];
  /** ID seleccionado actualmente. */
  selected?: string;
  /** Label accesible del grupo. */
  legend: string;
  /** Ocultar el legend visible (mantiene aria-label para a11y). */
  hideLegend?: boolean;
}

const { options, selected, legend, hideLegend = false } = Astro.props;
---

<fieldset
  class="flex flex-col gap-3"
  data-reveal
  data-variant-type="color"
>
  {!hideLegend && <legend class="text-sm font-bold text-slate-900">{legend}</legend>}

  <div
    class="flex flex-wrap gap-3"
    role="radiogroup"
    aria-label={legend}
  >
    {options.map((option) => {
      const isActive = option.id === selected;
      return (
        <button
          type="button"
          role="radio"
          aria-checked={isActive}
          aria-label={option.label}
          data-variant-id={option.id}
          class:list={[
            'relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-black/10 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            isActive ? 'scale-110 ring-2 ring-[var(--primary,#475569)] ring-offset-2' : 'hover:scale-105',
          ]}
          style={option.hex !== undefined ? `background-color: ${option.hex};` : undefined}
          title={option.label}
        >
        </button>
      );
    })}
  </div>
</fieldset>