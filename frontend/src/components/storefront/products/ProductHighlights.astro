---
/**
 * ProductHighlights — tarjetas visuales con icono circular + label
 * (estilo Gibson, en español).
 *
 * Layout:
 *   - Card exterior `rounded-2xl border bg-white p-6 sm:p-8` que envuelve todo.
 *   - Heading "Características destacadas" (translation al español del original
 *     "Highlights" — single source of truth para el codebase es-MX).
 *   - Grid responsive 1-col (mobile) → 2-col (sm) → 4-col (lg) con cards
 *     individuales por highlight.
 *   - Cada card: icono SVG circular con fondo tintado en primary (h-12 w-12
 *     flex centrado) + label bold centrado debajo. Hover sutil: border
 *     primary + fondo blanco.
 *
 * Decisiones:
 *  - Sin JS, sin fetching — todos los iconos son inline SVG stroke-only.
 *  - Los iconos viven en un mapa local (`ICON_PATHS`) por simplicidad.
 *  - 6 iconos disponibles con keys en español (premio, destello, regla,
 *    escudo, estrella, musica) — autoexplicativos en mock data.
 *  - Sectioning con `<section aria-labelledby>` para lectores de pantalla.
 */
import type { ProductHighlightsItem } from './ProductHighlights.types';

interface Props {
  /** Heading del bloque (i18n). Default: "Características destacadas". */
  heading?: string;
  /** Subtítulo opcional debajo del heading. */
  subtitle?: string;
  /** Lista de highlights a renderizar. */
  items: readonly ProductHighlightsItem[];
}

const {
  heading = 'Características destacadas',
  subtitle,
  items,
} = Astro.props;
const hasItems = items.length > 0;
const headingId = 'product-highlights-heading';

/**
 * Paths SVG inline (24×24, stroke-only). Cada entrada es el `<path>`
 * interior; el componente lo envuelve en un `<svg>` común.
 */
const ICON_PATHS: Record<ProductHighlightsItem['icon'], string> = {
  // premio — copa / trofeo (cuerpo + base + asa lateral)
  premio: 'M8 21h8m-4-4v4M5 4h14v3a5 5 0 0 1-5 5h-4A5 5 0 0 1 5 7V4zM5 5H3a2 2 0 0 0 2 5M19 5h2a2 2 0 0 1-2 5',
  // destello — estrella de 4 puntas con destellos
  destello:
    'M12 3l1.8 5.4L19 10l-5.2 1.6L12 17l-1.8-5.4L5 10l5.2-1.6L12 3zM19 16l.6 1.8L21 18l-1.4.6L19 20l-.6-1.4L17 18l1.4-.6L19 16zM5 17l.4 1.2L6.6 19l-1.2.4L5 20.4 4.6 19l-1.2-.4 1.2-.6L5 17z',
  // regla — regla horizontal con marcas
  regla: 'M3 9.5L9.5 3l11.5 11.5L14.5 21 3 9.5zM6 9l2 2M9 6l2 2M12 9l2 2M15 12l2 2M9 12l2 2M12 15l2 2',
  // escudo — contorno de escudo
  escudo:
    'M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-.6-8-4.5-8-9V6l8-3zM9 12l2 2 4-4',
  // estrella — estrella clásica de 5 puntas (rating style)
  estrella: 'M12 3.5l2.6 5.4 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.8l5.9-.9L12 3.5z',
  // musica — corchea con plica y bandera
  musica:
    'M9 18V6l10-2v12M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM19 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
};
---

{
  hasItems && (
    <section
      aria-labelledby={headingId}
      class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"
    >
      <header class="mb-6 flex flex-col gap-1">
        <h2
          id={headingId}
          class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
        >
          {heading}
        </h2>
        {subtitle !== undefined && subtitle !== '' && (
          <p class="text-sm text-slate-600 sm:text-base">{subtitle}</p>
        )}
      </header>

      <ul
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4"
        role="list"
      >
        {items.map((item) => (
          <li class="group flex flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/50 p-5 text-center transition hover:border-[var(--primary,#475569)] hover:shadow-sm">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--primary,#475569)]/10 text-[var(--primary,#475569)] transition group-hover:bg-[var(--primary,#475569)] group-hover:text-white"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
              >
                <path d={ICON_PATHS[item.icon]} />
              </svg>
            </span>
            <p class="text-sm font-medium leading-snug text-slate-800 sm:text-base">
              {item.label}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}