---
/**
 * ProductSpecificationsByCategory — specs agrupadas por categoría
 * (estilo Gibson).
 *
 * Renderiza un `<details>` colapsable por categoría con sus filas
 * label/value dentro. Pensado para instrumentos donde las specs se
 * agrupan naturalmente (Cuerpo, Mástil, Electrónica, Hardware, etc.).
 *
 * Layout del body (patrón Gibson):
 *   - Cada fila muestra DOS pares label/value lado a lado (grid 4-col).
 *   - Si el grupo tiene items impares, la última fila muestra 1 solo par.
 *   - Filas separadas por border-b slate-100 sutiles.
 *
 * Decisiones:
 *  - Todos los `<details>` nacen colapsados por defecto — el comprador
 *    de instrumentos sabe qué sección abrir; no saturamos con todas
 *    abiertas a la vez.
 *  - Reutiliza el patrón chevron (`group-open:rotate-45`) del
 *    `ProductShippingAccordion` para coherencia visual.
 *  - El estado abierto/cerrado se hidrata en SSR desde la cookie
 *    `pdp-specs-expanded-<slug>` (la página padre la lee con
 *    `Astro.cookies.get()` y pasa los IDs por prop). El atributo
 *    `open` llega renderizado en el HTML inicial → sin flash de
 *    re-paint. El script inline solo persiste los toggles del
 *    usuario en esa misma cookie.
 */
import type {
  ProductSpecificationsByCategoryGroup,
} from './ProductSpecificationsByCategory.types';

interface Props {
  /** Heading del bloque (i18n). */
  heading: string;
  /** Grupos por categoría, cada uno con sus items label/value. */
  groups: readonly ProductSpecificationsByCategoryGroup[];
  /**
   * Spec IDs que deben renderizarse abiertos en el HTML inicial.
   * Leídos por la página padre desde la cookie
   * `pdp-specs-expanded-<slug>` para evitar el flash visual que se
   * produce si el cliente abre los `<details>` después del primer
   * paint. Default `[]` = todas las categorías cerradas.
   */
  expanded?: readonly string[];
}

const { heading, groups, expanded = [] } = Astro.props;
const hasGroups = groups.length > 0;
const headingId = 'product-specs-by-category-heading';
---

{
  hasGroups && (
    <section
      aria-labelledby={headingId}
      class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"
    >
      <h2
        id={headingId}
        class="mb-5 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        {heading}
      </h2>

      <div class="flex flex-col gap-4">
        {groups.map((group) => {
          const specId = group.category.toLowerCase().replace(/\s+/g, '-');
          return (
            <details
              class="group overflow-hidden rounded-2xl border border-slate-200 bg-white"
              data-spec-id={specId}
              open={expanded.includes(specId) ? '' : undefined}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-bold text-slate-900 transition hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
                <span>{group.category}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4 text-slate-400 transition group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>

              {group.items.length > 0 && (() => {
                // Agrupa items en filas de a 2 pares (4-col grid).
                // Si quedan items impares, la última fila tiene 1 solo par.
                const rows: { items: typeof group.items }[] = [];
                for (let i = 0; i < group.items.length; i += 2) {
                  rows.push({ items: group.items.slice(i, i + 2) });
                }
                return (
                  <dl class="grid grid-cols-[1fr_1.5fr_1fr_1.5fr] border-t border-slate-100 text-sm">
                    {rows.map((row, rowIdx) => {
                      const isLast = rowIdx === rows.length - 1;
                      const isOdd = row.items.length === 1;
                      return (
                        <Fragment>
                          {/* Fila completa (full-bleed via col-span-4 con borde) */}
                          <div
                            class:list={[
                              'col-span-4 grid grid-cols-subgrid border-b border-slate-100 px-5',
                              isLast && 'pb-4',
                            ]}
                          >
                            {row.items.map((item, idx) => (
                              <Fragment>
                                <dt class="py-2 pr-3 font-medium text-slate-500">{item.label}</dt>
                                <dd
                                  class:list={[
                                    'py-2 text-slate-900',
                                    isOdd && idx === 0 && 'col-span-1',
                                  ]}
                                >
                                  {item.value}
                                </dd>
                                {/* Si la fila está incompleta, deja el último par visualmente emparejado */}
                                {isOdd && idx === 0 && (
                                  <>
                                    <dt class="hidden py-2 md:block"></dt>
                                    <dd class="hidden py-2 md:block"></dd>
                                  </>
                                )}
                              </Fragment>
                            ))}
                          </div>
                        </Fragment>
                      );
                    })}
                  </dl>
                );
              })()}
            </details>
          );
        })}
      </div>
    </section>
  )
}

<script is:inline>
  /**
   * Persistencia del estado abierto/cerrado de las especificaciones
   * en una cookie (`pdp-specs-expanded-<slug>`) con `sessionStorage`
   * como redundancia. El render inicial ya viene con el atributo
   * `open` aplicado en SSR desde esa cookie (la página padre la lee
   * con `Astro.cookies.get()`); este script solo mantiene el set
   * sincronizado con los toggles del usuario, sin tocar el DOM.
   *
   * Por qué cookie PRIMARIO y sessionStorage BACKUP:
   *   - Cookie: la única fuente que el server (Astro SSR) puede leer
   *     y aplicar `open` en el HTML inicial → sin flash de re-paint.
   *   - sessionStorage: NO es legible desde SSR (es API de cliente),
   *     pero cubre el caso donde la cookie falla en el cliente
   *     (SameSite=Lax + cross-domain en dev con `.test`, browser
   *     con cookies deshabilitadas, third-party blocking, cookies
   *     expiradas o limpiadas entre reloads). Cada toggle se escribe
   *     a AMBAS; si la cookie falla, sessionStorage mantiene el set.
   *
   * Por qué sessionStorage y no localStorage: el estado de
   * "qué acordeón dejé abierto" es por-sesión de navegación, no
   * persistente entre visitas. sessionStorage se limpia al cerrar
   * la pestaña, lo que casa con el modelo mental del usuario.
   *
   * La clave es por-producto (slug) para que distintos productos
   * no compartan estado de specs.
   *
   * `is:inline` para que el script se ejecute INMEDIATAMENTE al
   * ser parseado (no se bundlea como module). Si el script se carga
   * tarde, un click rápido del usuario antes del primer toggle
   * disparado quedaría sin persistir.
   */
  (() => {
    const slug =
      document
        .querySelector('[data-product-slug]')
        ?.getAttribute('data-product-slug') ?? 'default';
    const COOKIE_NAME = `pdp-specs-expanded-${slug}`;
    const COOKIE_ATTRS = 'path=/; max-age=31536000; samesite=lax';

    // Regex escapada para tolerar slugs con caracteres especiales.
    const escapeRegex = (s) =>
      s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const cookieRegex = new RegExp(
      `(?:^|;\\s*)${escapeRegex(COOKIE_NAME)}=([^;]*)`
    );

    // Parsea un string JSON a string[], tolerando basura. Devuelve []
    // si la entrada es null/undefined o si JSON.parse falla.
    const parseSet = (raw) => {
      if (typeof raw !== 'string' || raw.length === 0) return [];
      try {
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((v) => typeof v === 'string');
      } catch {
        return [];
      }
    };

    // Lee el set persistido. Cookie es la fuente primaria; si no
    // existe (o falla), cae a sessionStorage. Esto cubre reloads
    // donde la cookie se perdió (bloqueo, política, etc.) pero el
    // tab aún conserva el state en su storage de sesión.
    const readPersisted = () => {
      const match = document.cookie.match(cookieRegex);
      const fromCookie =
        match !== null && match[1] !== undefined
          ? parseSet(decodeURIComponent(match[1]))
          : [];
      if (fromCookie.length > 0) return fromCookie;
      try {
        const ss = sessionStorage.getItem(COOKIE_NAME);
        if (ss !== null) return parseSet(ss);
      } catch {
        /* sessionStorage inaccesible (modo privado, quota) */
      }
      return [];
    };

    // Escribe el set a AMBAS fuentes. Cada fuente es try/catch'd
    // independiente: si cookie falla (bloqueada, quota) sessionStorage
    // sigue; si sessionStorage falla (quota, inaccesible) cookie sigue.
    const persistState = (state) => {
      const encoded = encodeURIComponent(JSON.stringify(state));
      try {
        document.cookie = `${COOKIE_NAME}=${encoded}; ${COOKIE_ATTRS}`;
      } catch {
        /* cookies deshabilitadas o quota */
      }
      try {
        sessionStorage.setItem(COOKIE_NAME, JSON.stringify(state));
      } catch {
        /* quota excedida o storage inaccesible */
      }
    };

    let expanded = readPersisted();

    // Sincronización defensiva: si el servidor aplicó `open` en SSR
    // (cookie presente), el set ya tiene esos IDs. Si por algún
    // motivo el server NO tuvo la cookie (cookie stale, race, etc.)
    // pero el HTML tiene `<details open>`, agregamos esos IDs al set
    // y los persistimos inmediatamente a cookie + sessionStorage.
    // Esto garantiza que:
    //   1. Cualquier toggle visible quede en el set en memoria.
    //   2. sessionStorage tenga el state desde el primer load
    //      (no solo después del primer toggle), así un reload
    //      inmediato tras el primer click persiste aún si cookie
    //      está bloqueada.
    document.querySelectorAll('details[data-spec-id]').forEach((el) => {
      if (el.hasAttribute('open')) {
        const id = el.getAttribute('data-spec-id');
        if (id !== null && !expanded.includes(id)) {
          expanded.push(id);
        }
      }
    });
    if (expanded.length > 0) persistState(expanded);

    // Persistir cada toggle (delegado en document para aguantar re-renders).
    document.addEventListener(
      'toggle',
      (event) => {
        const target = event.target;
        if (target === null) return;
        if (
          !(target instanceof HTMLDetailsElement) ||
          !target.hasAttribute('data-spec-id')
        )
          return;
        const id = target.getAttribute('data-spec-id');
        if (id === null) return;
        const current = new Set(expanded);
        if (target.open) current.add(id);
        else current.delete(id);
        expanded = Array.from(current);
        persistState(expanded);
      },
      true
    );
  })();
</script>