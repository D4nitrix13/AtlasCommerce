---
/**
 * ProductDetailsBlock — bloque de descripción larga del instrumento.
 *
 * Dos variantes (default `full`):
 *   - `full`: card con eyebrow + heading + intro HTML + toggle "Leer más/menos".
 *   - `inline`: fila compacta sin card ni heading, truncado a 80 chars
 *     en plano + toggle inline al final del texto (uso típico: aside de PDP).
 *
 * Layout full:
 *   - Card `rounded-2xl border bg-white p-6 sm:p-8` que envuelve todo.
 *   - Eyebrow + heading (título per-product).
 *   - Intro HTML con dos versiones:
 *       1. truncated (`data-short`, `line-clamp-3`) — primeras 3 líneas visibles.
 *       2. full (`data-full`, `hidden`) — todo el texto.
 *   - Toggle button al final (fuera del wrapper de texto) que switchea
 *     entre los dos estados.
 *
 * Layout inline:
 *   - Sin card wrapper, sin eyebrow ni heading.
 *   - Versión short a 80 chars de texto plano (HTML tags stripped).
 *   - Versión full en HTML (`set:html`).
 *   - Toggle button inline al final del texto.
 *
 * Decisiones:
 *  - Las specs se manejan aparte en `<ProductSpecificationsByCategory>`
 *    (acordeón agrupado por categoría) — no hay tabla plana acá.
 *  - Truncado full por CSS line-clamp (no JS para preview).
 *  - Truncado inline por JS sobre texto plano (evita cortar en medio de un tag).
 *  - Toggle compartido via `<script>` con selector `[data-toggle-description]`.
 *    El script busca `[data-collapsed-description]` con `closest` (caso
 *    inline: el botón vive dentro del wrapper) y cae a `parentElement.querySelector`
 *    (caso full: el botón es hermano del wrapper dentro del `<section>`).
 *  - El `data-mode` del wrapper diferencia el CSS expandido: `block` para
 *    full, `inline` para inline.
 *  - Si el intro es corto (< threshold), no se renderiza el toggle.
 */
interface Props {
  /** Variante del layout. `full` (default) = bloque de contenido. `inline` = fila compacta sin wrapper. */
  variant?: 'inline' | 'full';
  /**
   * Heading del bloque. Opcional: cuando el bloque vive dentro de un
   * tab que ya lo nombra (Descripción), el heading es redundante.
   */
  heading?: string;
  /** Párrafo introductorio (HTML, soporta links). */
  intro: string;
  /** Label del toggle cuando está colapsado (i18n). */
  moreLabel?: string;
  /** Label del toggle cuando está expandido (i18n). */
  lessLabel?: string;
}

const {
  variant = 'full',
  heading,
  intro,
  moreLabel = 'Leer más',
  lessLabel = 'Leer menos',
} = Astro.props;

const COLLAPSE_THRESHOLD_FULL = 240;
const COLLAPSE_THRESHOLD_INLINE = 80;
const threshold = variant === 'inline' ? COLLAPSE_THRESHOLD_INLINE : COLLAPSE_THRESHOLD_FULL;
const plainText = intro.replace(/<[^>]+>/g, '');
const canCollapse = plainText.length > threshold;
---

{variant === 'full' ? (
  <section
    aria-labelledby={heading !== undefined ? 'product-details-heading' : undefined}
    class="flex flex-col gap-3"
    data-reveal
  >
    {heading !== undefined && (
      <h2
        id="product-details-heading"
        class="text-2xl font-semibold tracking-tight text-[var(--ink,#1c1917)] sm:text-3xl"
      >
        {heading}
      </h2>
    )}

    <div
      class="max-w-none text-[var(--ink-soft,#57534e)] [&_p]:mb-3 [&_p]:leading-relaxed"
      data-collapsed-description
      data-mode="full"
    >
      <div data-short class:list={[canCollapse && 'line-clamp-3']}>
        <Fragment set:html={intro} />
      </div>
      <div data-full class="hidden">
        <Fragment set:html={intro} />
      </div>
    </div>

    {canCollapse && (
      <button
        type="button"
        data-toggle-description
        data-label-more={moreLabel}
        data-label-less={lessLabel}
        class="self-start text-sm font-semibold text-[var(--primary,#2D9D8E)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)] focus-visible:ring-offset-2"
      >
        {moreLabel}
      </button>
    )}
  </section>
) : (
  <div class="pt-4">
    <div
      class="text-sm leading-relaxed text-[var(--ink-soft,#57534e)]"
      data-collapsed-description
      data-mode="inline"
    >
      {canCollapse && (
        <>
          <span
            data-short
            class="block"
          >{`${plainText.slice(0, COLLAPSE_THRESHOLD_INLINE).trimEnd()}…`}</span>
          <span data-full class="hidden">
            <Fragment set:html={intro} />
          </span>
        </>
      )}
      {!canCollapse && <Fragment set:html={intro} />}
      {canCollapse && (
        <button
          type="button"
          data-toggle-description
          data-label-more={moreLabel}
          data-label-less={lessLabel}
          class="ml-1 inline font-semibold text-[var(--primary,#475569)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
        >
          {moreLabel}
        </button>
      )}
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-description]').forEach((btn) => {
    btn.addEventListener('click', () => {
      // En variant='inline' el botón vive DENTRO del wrapper [data-collapsed-description]
      // → `closest` lo encuentra. En variant='full' el botón es hermano del wrapper
      // dentro del <section> → caemos a `parentElement.querySelector`.
      const target =
        btn.closest<HTMLElement>('[data-collapsed-description]') ??
        btn.parentElement?.querySelector<HTMLElement>('[data-collapsed-description]');
      if (!target) return;
      const expanded = target.classList.toggle('is-expanded');
      btn.textContent = expanded
        ? (btn.dataset.labelLess ?? 'menos')
        : (btn.dataset.labelMore ?? 'más');
    });
  });
</script>

<style>
  [data-collapsed-description].is-expanded [data-short] {
    display: none;
  }
  [data-collapsed-description][data-mode='full'].is-expanded [data-full] {
    display: block;
  }
  [data-collapsed-description][data-mode='inline'].is-expanded [data-full] {
    display: inline;
  }
</style>
