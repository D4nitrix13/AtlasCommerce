---
/**
 * ProductSizeGrid — fila inline de pills de tamaño.
 *
 * Slots: pills compactas tipo Nike — CH M G XG lado a lado, label
 * centrado, pill activa = tinta llena con texto claro. En
 * guitarras/bajos el "tamaño" suele ser el cuerpo (4/4, 3/4, 1/2)
 * o el calibre de cuerdas; el componente es genérico y sólo pide
 * `id` + `label` por opción.
 *
 * Decisiones:
 *   - Fila `flex flex-wrap` de pills ~36px (`h-9 rounded-full`) que
 *     envuelve sola: aprovecha el ancho de la columna sin dominar el
 *     CTA de compra (el grid de botones grandes se va).
 *   - Botones `<button>` semánticos `role="radio"` con `aria-checked`
 *     para selección (mismo patrón que `ProductDetailVariants`).
 *   - Disabled state si la opción no aplica (`disabledIds`): muted +
 *     `line-through` + `aria-disabled`.
 *   - Hidden input con el valor seleccionado para que el form lo lea.
 *
 * Tokens:
 *   - Fila: `flex flex-wrap gap-2`.
 *   - Pill inactiva: `border border-slate-200 bg-white text-slate-900 hover:border-slate-400`.
 *   - Pill activa: `bg-slate-900 text-white border-slate-900`.
 *   - Pill disabled: `opacity-40 line-through cursor-not-allowed`.
 *   - Height pill: `h-9` (~36px, control silencioso).
 *   - Typography: `text-sm font-semibold`.
 */

export interface SizeGridOption {
  id: string;
  label: string;
}

interface Props {
  /** Label accesible del grupo. */
  legend: string;
  /** Opciones de pills (típicamente 4-8). */
  options: readonly SizeGridOption[];
  /** ID de la opción seleccionada. */
  selected?: string;
  /** Name para el `<input>` que el form leerá. */
  name: string;
  /** IDs que NO están disponibles (se renderizan deshabilitados). */
  disabledIds?: readonly string[];
}

const { legend, options, selected, name, disabledIds = [] } = Astro.props;

const disabledSet = new Set(disabledIds);
---

<fieldset class="flex flex-col gap-3">
  <legend class="text-sm font-bold text-slate-900">{legend}</legend>
  <div class="flex flex-wrap gap-2" role="radiogroup" aria-label={legend}>
    {options.map((option) => {
      const isActive = option.id === selected;
      const isDisabled = disabledSet.has(option.id);
      return (
        <button
          type="button"
          role="radio"
          aria-checked={isActive}
          aria-disabled={isDisabled || undefined}
          disabled={isDisabled}
          data-size-option={option.id}
          class:list={[
            'inline-flex h-9 items-center justify-center px-4 rounded-full border text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            isActive
              ? 'border-slate-900 bg-slate-900 text-white'
              : 'border-slate-200 bg-white text-slate-900 hover:border-slate-400',
            isDisabled && 'cursor-not-allowed opacity-40 line-through',
          ]}
        >
          {option.label}
        </button>
      );
    })}
  </div>
  {selected !== undefined && <input type="hidden" name={name} value={selected} />}
</fieldset>
