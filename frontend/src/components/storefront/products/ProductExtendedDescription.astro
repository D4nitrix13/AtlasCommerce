---
/**
 * ProductExtendedDescription — bloque(s) de descripción extendida
 * del producto en la PDP.
 *
 * Layout:
 *   - Primer bloque: card `rounded-2xl border bg-white p-6 sm:p-8`
 *     con heading + body en prosa (heading bold + body regular).
 *   - Bloques adicionales (si hay >1): cada uno dentro de un
 *     `<details>` colapsable con el `<summary>` mostrando el title.
 *     Esto evita saturar el primer paint con párrafos largos cuando
 *     hay varios bloques (ej. "The Les Paul, llevada al extremo"
 *     + "Historia de la línea Supreme" + "Setup recomendado").
 *
 * Decisiones:
 *  - Empty-safe: si `items` está vacío NO renderiza la sección.
 *  - Sin JS: el toggle del details es nativo del browser.
 *  - Reutiliza el patrón chevron (`group-open:rotate-45`) del
 *    `ProductSpecificationsByCategory` para coherencia visual.
 *  - El body del primer bloque se renderiza con `set:html`-equivalent
 *    preservando saltos de párrafo (split en \n\n → <p>).
 *
 * Por qué soportar múltiples bloques:
 *  - El backend Fase 8 (modelo `ProductExtendedDescription`) tiene
 *    posición por fila, lo que permite N bloques ordenados. Limitar
 *    a 1 sería desperdiciar el modelo de datos.
 *  - Gibson layout muestra bloques temáticos extensos; este patrón
 *    soporta esa realidad sin forzar a concatenar todo en un solo
 *    string (lo que rompería la posibilidad de headings por bloque).
 */
import type {
  ProductExtendedDescriptionItem,
  ProductExtendedDescriptionLabels,
} from './ProductExtendedDescription.types';

interface Props {
  /** Lista de bloques de descripción extendida. Vacío = no renderiza. */
  items: readonly ProductExtendedDescriptionItem[];
  /** Labels de i18n (heading principal). */
  labels: ProductExtendedDescriptionLabels;
}

const { items, labels } = Astro.props;
const hasItems = items.length > 0;
const headingId = 'product-extended-description-heading';

/**
 * Convierte un string con saltos de párrafo en HTML seguro.
 * El backend sirve texto plano (sin HTML) — separar en `<p>` evita
 * inyecciones y preserva la estructura visual.
 */
const paragraphsToHtml = (text: string): string =>
  text
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter((paragraph) => paragraph.length > 0)
    .map((paragraph) => `<p>${paragraph}</p>`)
    .join('');

const [primary, ...rest] = items;
---

{hasItems && primary !== undefined && (
  <section
    aria-labelledby={headingId}
    class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"
  >
    <header class="mb-4 flex flex-col gap-2">
      <h2
        id={headingId}
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        {labels.heading}
      </h2>
    </header>

    <article class="flex flex-col gap-6">
      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold text-slate-900">{primary.title}</h3>
        <div class="max-w-none text-slate-700 [&_p]:mb-3 [&_p]:leading-relaxed" set:html={paragraphsToHtml(primary.body)} />
      </div>

      {rest.map((block, index) => {
        const specId = `extended-description-${index + 1}`;
        return (
          <details
            id={specId}
            class="group overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/60"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-bold text-slate-900 transition hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
              <span>{block.title}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="h-4 w-4 text-slate-400 transition group-open:rotate-45"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="border-t border-slate-200 px-5 py-4 text-sm leading-relaxed text-slate-700 sm:text-base [&_p]:mb-3 [&_p]:leading-relaxed" set:html={paragraphsToHtml(block.body)} />
          </details>
        );
      })}
    </article>
  </section>
)}