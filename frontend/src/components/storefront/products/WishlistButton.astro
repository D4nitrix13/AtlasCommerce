---
/**
 * WishlistButton — toggle wishlist (corazón) en product detail.
 *
 * Consistente con el patrón del WishlistItem del account (F2.3):
 *  - Corazón filled cuando está en wishlist, outlined cuando no.
 *  - aria-pressed para lectores de pantalla.
 *  - Sin handlers: el click lleva al detail de login si no está
 *    logueado (o un modal en el futuro). En F4.2 es placeholder.
 *
 * Coherencia visual con `WishlistItem` (mismo outline, mismo hover
 * color primary).
 */

export interface WishlistButtonLabels {
  add: string;
  added: string;
  remove: string;
}

interface Props {
  labels: WishlistButtonLabels;
  /** Estado actual del wishlist (si está o no añadido). */
  isInWishlist?: boolean;
  /** Locale-prefixed href para login (cuando no está logueado). */
  loginHref?: string;
}

const { labels, isInWishlist = false, loginHref } = Astro.props;

const ariaLabel = isInWishlist ? labels.remove : labels.add;
const href = isInWishlist ? undefined : loginHref;
---

<a
  href={href}
  role="button"
  aria-pressed={isInWishlist}
  aria-label={ariaLabel}
  title={ariaLabel}
  data-wishlist-toggle={isInWishlist ? 'remove' : 'add'}
  class:list={[
    'inline-flex h-10 w-10 items-center justify-center rounded-full border transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2',
    isInWishlist
      ? 'border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100'
      : 'border-slate-200 bg-white text-slate-500 hover:border-rose-200 hover:text-rose-600',
  ]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill={isInWishlist ? 'currentColor' : 'none'}
    stroke="currentColor"
    stroke-width="1.8"
    class="h-5 w-5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
    />
  </svg>
</a>
