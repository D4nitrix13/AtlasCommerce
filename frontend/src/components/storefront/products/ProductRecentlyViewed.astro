---
/**
 * ProductRecentlyViewed — rail "Visto recientemente" del PDP.
 *
 * Fuente de verdad: el historial del backend (`GET
 * /storefront/recently-viewed`, persistido por usuario o por el guest
 * token `rv_guest` con ventana deslizante de 20). El componente lo
 * renderiza SERVER-SIDE — sin el hidden-hasta-hidratar del diseño
 * anterior.
 *
 * Fallback: cuando el fetch SSR falla (`useFallback`), la sección
 * arranca oculta y un `<script>` la puebla desde localStorage (la
 * misma cola que escribe el tracker en cada visita). Si la cola está
 * vacía, la sección sigue oculta.
 *
 * Decisiones:
 *   - El tracker localStorage se mantiene SIEMPRE (write-only) para
 *     que el fallback tenga datos frescos cuando el API esté caído.
 *   - Cada card usa la shape de `Product` (compatible con `ProductCard`).
 */
import type { Product } from '../../../types/catalog';
import { formatCurrency } from '../../../lib/formatters';
import { deriveProductCardSwap } from '../../../lib/product-card-swap';

/** Imagen de hover (rol BACK): campo explícito o `isHover` de la galería. */
function hoverImageOf(product: Product & { imageUrlSecondary?: string }): string | undefined {
  return product.imageUrlSecondary ?? deriveProductCardSwap(product).hoverImage?.url;
}

interface Props {
  /** Heading de la sección (i18n). */
  heading: string;
  /** Locale para links de producto y formato de precios. */
  locale: string;
  /** Productos ya resueltos en SSR (sin el producto actual). */
  products?: readonly (Product & { imageUrlSecondary?: string })[];
  /** Slug del producto actual — se excluye del fallback localStorage. */
  currentSlug?: string;
  /** true cuando el fetch del API falló: render oculto + localStorage. */
  useFallback?: boolean;
}

const {
  heading,
  locale,
  products = [],
  currentSlug = '',
  useFallback = false,
} = Astro.props;

const showServerGrid = !useFallback && products.length > 0;
---

{showServerGrid && (
  <section
    aria-labelledby="recently-viewed-heading"
    class="flex flex-col gap-4"
    data-recently-viewed
    data-product-slug={currentSlug}
    data-locale={locale}
  >
    <header class="flex items-center justify-between">
      <h2
        id="recently-viewed-heading"
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        {heading}
      </h2>
    </header>
    <ul
      class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
      role="list"
      aria-label={heading}
    >
      {products.map((product) => {
        const secondary = hoverImageOf(product);
        return (
          <li class="group flex h-full flex-col gap-2 rounded-xl border border-slate-200 bg-white p-3 transition hover:border-[var(--primary,#475569)] hover:shadow-sm">
            <a href={`/${locale}/products/${product.slug}`} class="card__media flex h-full flex-col gap-2">
              <span class="relative flex aspect-square items-center justify-center overflow-hidden rounded-lg bg-slate-50">
                <img
                  src={product.imageUrl}
                  alt={product.name}
                  loading="lazy"
                  decoding="async"
                  class="card__img--default h-full w-full object-cover"
                />
                {secondary !== undefined && (
                  <img
                    src={secondary}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                    data-role="back"
                    class="card__img--back absolute inset-0 h-full w-full object-cover"
                  />
                )}
              </span>
              <span class="text-xs font-medium text-slate-900 line-clamp-2">{product.name}</span>
              <span class="mt-auto text-sm font-bold tabular-nums text-slate-900">
                {formatCurrency(product.priceCents, product.currency ?? 'USD')}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}

{useFallback && (
  <section
    aria-labelledby="recently-viewed-heading"
    class="hidden flex flex-col gap-4"
    data-recently-viewed
    data-product-slug={currentSlug}
    data-locale={locale}
    data-fallback
  >
    <header class="flex items-center justify-between">
      <h2
        id="recently-viewed-heading"
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        {heading}
      </h2>
    </header>
    <ul
      class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
      role="list"
      aria-label={heading}
      data-recently-viewed-list
    ></ul>
  </section>
)}

<script>
  import { formatCurrency } from '../../../lib/formatters';

  interface RecentEntry {
    slug: string;
    name: string;
    imageUrl: string;
    /** Imagen de hover (rol BACK) — opcional; sin ella no hay swap. */
    imageUrlSecondary?: string;
    priceCents: number;
    currency: string;
    viewedAt: number;
  }

  const STORAGE_KEY = 'pdp-recently-viewed';
  const MAX_ENTRIES = 8;

  function readRecent(): RecentEntry[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw === null) return [];
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (entry): entry is RecentEntry =>
          typeof entry === 'object' &&
          entry !== null &&
          typeof (entry as RecentEntry).slug === 'string' &&
          typeof (entry as RecentEntry).viewedAt === 'number'
      );
    } catch {
      return [];
    }
  }

  function writeRecent(list: RecentEntry[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_ENTRIES)));
    } catch {
      /* ignorar */
    }
  }

  /**
   * Tracker write-only de la cola localStorage — es el insumo del
   * fallback cuando el API de vistos no responde. La meta del producto
   * viaja via `window.__PRODUCT_META__` (la inyecta el PDP).
   */
  function trackCurrentProduct(): void {
    const section = document.querySelector<HTMLElement>('[data-recently-viewed]');
    if (section === null) return;
    const slug = section.dataset.productSlug;
    if (slug === undefined || slug === '') return;

    interface ProductMeta {
      name: string;
      imageUrl: string;
      /** Imagen de hover (rol BACK) — viaja cuando el PDP la expone. */
      imageUrlSecondary?: string;
      priceCents: number;
      currency: string;
    }
    const meta = (window as unknown as { __PRODUCT_META__?: ProductMeta }).__PRODUCT_META__;
    if (meta === undefined) return;

    const list = readRecent().filter((entry) => entry.slug !== slug);
    list.unshift({
      slug,
      name: meta.name,
      imageUrl: meta.imageUrl,
      ...(meta.imageUrlSecondary !== undefined ? { imageUrlSecondary: meta.imageUrlSecondary } : {}),
      priceCents: meta.priceCents,
      currency: meta.currency,
      viewedAt: Date.now(),
    });
    writeRecent(list);
  }

  /** Render del fallback: sólo cuando el fetch SSR falló. */
  function renderRecentFallback(): void {
    const section = document.querySelector<HTMLElement>('[data-recently-viewed]');
    if (section === null) return;
    const listEl = section.querySelector<HTMLUListElement>('[data-recently-viewed-list]');
    if (listEl === null) return;

    const currentSlug = section.dataset.productSlug ?? '';
    const locale = section.dataset.locale ?? 'es';
    const entries = readRecent()
      .filter((entry) => entry.slug !== currentSlug)
      .slice(0, MAX_ENTRIES);

    if (entries.length === 0) {
      section.classList.add('hidden');
      return;
    }

    section.classList.remove('hidden');
    listEl.innerHTML = entries
      .map((entry) => {
        const hoverImg =
          entry.imageUrlSecondary !== undefined && entry.imageUrlSecondary !== ''
            ? `<img src="${entry.imageUrlSecondary}" alt="" loading="lazy" aria-hidden="true" data-role="back" class="card__img--back absolute inset-0 h-full w-full object-cover" />`
            : '';
        return `
        <li class="group flex h-full flex-col gap-2 rounded-xl border border-slate-200 bg-white p-3 transition hover:border-[var(--primary,#475569)] hover:shadow-sm">
          <a href="/${locale}/products/${entry.slug}" class="card__media flex h-full flex-col gap-2">
            <span class="relative flex aspect-square items-center justify-center overflow-hidden rounded-lg bg-slate-50">
              <img src="${entry.imageUrl}" alt="${entry.name}" loading="lazy" class="card__img--default h-full w-full object-cover" />
              ${hoverImg}
            </span>
            <span class="text-xs font-medium text-slate-900 line-clamp-2">${entry.name}</span>
            <span class="mt-auto text-sm font-bold tabular-nums text-slate-900">${formatCurrency(entry.priceCents, entry.currency)}</span>
          </a>
        </li>
      `;
      })
      .join('');
  }

  function hydrate(): void {
    const section = document.querySelector<HTMLElement>('[data-recently-viewed]');
    if (section === null) return;
    trackCurrentProduct();
    if (section.hasAttribute('data-fallback')) {
      renderRecentFallback();
    }
  }

  document.addEventListener('astro:page-load', hydrate);
  if (!document.body.hasAttribute('data-astro-page')) {
    document.addEventListener('DOMContentLoaded', hydrate);
  }
</script>

<style is:global>
  /* Hover → imagen trasera (T3.5) — mismo contrato que
     ProductCard.astro (cross-fade 250ms). Scoped a
     [data-recently-viewed] para no pisar el stack de variantes de
     ProductRelated. Sin imagen de hover no hay back en el DOM y nada
     cambia. */
  [data-recently-viewed] .card__img--default {
    opacity: 1;
    transition: opacity 250ms ease;
  }
  [data-recently-viewed] .card__img--back {
    opacity: 0;
    transition: opacity 250ms ease;
  }
  @media (hover: hover) {
    [data-recently-viewed] .card__media:hover .card__img--default {
      opacity: 0;
    }
    [data-recently-viewed] .card__media:hover .card__img--back {
      opacity: 1;
    }
  }
  [data-recently-viewed] .card__media:focus-within .card__img--default {
    opacity: 0;
  }
  [data-recently-viewed] .card__media:focus-within .card__img--back {
    opacity: 1;
  }
</style>
