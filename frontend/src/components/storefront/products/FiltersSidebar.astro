---
/**
 * FiltersSidebar — barra de filtros lateral para la página de catálogo.
 *
 * Compone los grupos de filtro del mockup Bonfire (vista 04): Categoría ·
 * Precio · Color · (Marca · Talla sólo en tenants de instrumentos).
 * Los filtros que recortan la grilla (categoría, precio, color) son
 * **links**: cada uno apunta a un href ya armado por la página con
 * `buildCatalogHref` (query string SSR). La página lee la URL, aplica los
 * filtros y marca el activo — sin JS y sin estado en este componente.
 *
 * Decisiones:
 *  - **Links en vez de inputs**: navegan como corresponde (botón atrás,
 *    link compartible) y funcionan sin hidratar nada. El activo se marca
 *    con `aria-current="true"` + el estilo que ya existía.
 *  - **Marca y talla quedan presentacionales**: `CatalogFilters` no las
 *    contempla (el listado mock no expone brand/size por producto), así
 *    que no generan hrefs ni recortan. Se muestran sólo en los tenants
 *    que los necesitan (La Voz) — el caller decide.
 *  - **Swatches y chips**: siguen siendo links redondos/cuadrados; el
 *    swatch sin texto conserva su `aria-label`.
 *  - **Sin animaciones costosas**: el sidebar es siempre visible a
 *    partir de `lg`. En mobile lo esconde un disclosure nativo
 *    (`FiltersDisclosure`, `<details>`); este componente sigue
 *    agnóstico al contexto responsive.
 *
 * Layout: una `<aside>` con `<h2>` "Filtros" + link "Limpiar", seguido
 * de los grupos envueltos en `<section aria-labelledby="...">`.
 */
export interface CategoryFilterOption {
  slug: string;
  label: string;
  count: number;
  /** Href de SSR (`buildCatalogHref`) que activa este filtro. */
  href: string;
}

export interface BrandFilterOption {
  slug: string;
  label: string;
  count: number;
}

export interface PriceFilterOption {
  slug: string;
  label: string;
  /** Href de SSR (`buildCatalogHref`) que activa este bucket de precio. */
  href: string;
}

export interface ColorFilterOption {
  slug: string;
  label: string;
  hex: string;
  count: number;
  /** Href de SSR (`buildCatalogHref`) que activa (o desactiva) el color. */
  href: string;
}

export interface SizeFilterOption {
  slug: string;
  label: string;
  count: number;
}

export interface FiltersSidebarLabels {
  heading: string;
  clear: string;
  categoryHeading: string;
  brandHeading: string;
  priceHeading: string;
  colorHeading: string;
  sizeHeading: string;
  colorSwatchAltTemplate: string;
}

interface Props {
  labels: FiltersSidebarLabels;
  categories: readonly CategoryFilterOption[];
  brands?: readonly BrandFilterOption[];
  prices: readonly PriceFilterOption[];
  colors: readonly ColorFilterOption[];
  sizes: readonly SizeFilterOption[];
  /** Href que limpia todos los filtros (link "Limpiar"). */
  clearHref: string;
  /** Slug actualmente activo (categoría). */
  activeCategory?: string | null;
  /** Slugs actualmente activos (marca). */
  activeBrands?: readonly string[];
  /** Slug actualmente activo (precio). */
  activePrice?: string | null;
  /** Slugs actualmente activos (color). */
  activeColors?: readonly string[];
  /** Slugs actualmente activos (talla). */
  activeSizes?: readonly string[];
  /**
   * Prefijo de los ids internos (headings `aria-labelledby`). Dos
   * instancias en el mismo documento (drawer móvil + panel desktop en
   * `FiltersDisclosure`) necesitan prefijos distintos para no duplicar
   * ids. Sin prefijo, el comportamiento es el de siempre.
   */
  idPrefix?: string;
}

const {
  labels,
  categories,
  brands = [],
  prices,
  colors,
  sizes,
  clearHref,
  activeCategory = null,
  activeBrands = [],
  activePrice = null,
  activeColors = [],
  activeSizes = [],
  idPrefix = '',
} = Astro.props;

const isCategoryActive = (slug: string): boolean => activeCategory === slug;
const isBrandActive = (slug: string): boolean => activeBrands.includes(slug);
const isPriceActive = (slug: string): boolean => activePrice === slug;
const isColorActive = (slug: string): boolean => activeColors.includes(slug);
const isSizeActive = (slug: string): boolean => activeSizes.includes(slug);
---

<aside class="flex flex-col gap-6" aria-label={labels.heading}>
  <header class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900">{labels.heading}</h2>
    <a
      href={clearHref}
      class="text-[13px] font-semibold text-[var(--primary,#475569)] transition hover:underline focus:outline-none focus-visible:underline"
    >
      {labels.clear}
    </a>
  </header>

  <section
    aria-labelledby={`${idPrefix}filter-category-heading`}
    class="flex flex-col gap-3 border-b border-slate-200 pb-6 last:border-b-0"
  >
    <h3 id={`${idPrefix}filter-category-heading`} class="text-sm font-bold text-slate-900">
      {labels.categoryHeading}
    </h3>
    <ul class="flex flex-col gap-2.5">
      {categories.map((category) => (
        <li>
          <a
            href={category.href}
            aria-current={isCategoryActive(category.slug) ? 'true' : undefined}
            class:list={[
              'flex items-center gap-2.5 text-sm transition hover:text-slate-900',
              isCategoryActive(category.slug) ? 'font-semibold text-slate-900' : 'text-slate-600',
            ]}
          >
            <span class="flex-1">{category.label}</span>
            <span class="text-[13px] text-slate-400">{category.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {brands.length > 0 && (
    <section
      aria-labelledby={`${idPrefix}filter-brand-heading`}
      class="flex flex-col gap-3 border-b border-slate-200 pb-6 last:border-b-0"
    >
      <h3 id={`${idPrefix}filter-brand-heading`} class="text-sm font-bold text-slate-900">
        {labels.brandHeading}
      </h3>
      <ul class="flex flex-col gap-2.5">
        {brands.map((brand) => (
          <li>
            <label
              class:list={[
                'flex cursor-pointer items-center gap-2.5 text-sm transition hover:text-slate-900',
                isBrandActive(brand.slug) ? 'font-semibold text-slate-900' : 'text-slate-600',
              ]}
            >
              <input
                type="checkbox"
                name="filter-brand"
                value={brand.slug}
                checked={isBrandActive(brand.slug)}
                class="h-4 w-4 cursor-pointer rounded border-slate-300 accent-[var(--primary,#475569)]"
              />
              <span class="flex-1">{brand.label}</span>
              <span class="text-[13px] text-slate-400">{brand.count}</span>
            </label>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section
    aria-labelledby={`${idPrefix}filter-price-heading`}
    class="flex flex-col gap-3 border-b border-slate-200 pb-6 last:border-b-0"
  >
    <h3 id={`${idPrefix}filter-price-heading`} class="text-sm font-bold text-slate-900">
      {labels.priceHeading}
    </h3>
    <ul class="flex flex-col gap-2.5">
      {prices.map((price) => (
        <li>
          <a
            href={price.href}
            aria-current={isPriceActive(price.slug) ? 'true' : undefined}
            class:list={[
              'flex items-center gap-2.5 text-sm transition hover:text-slate-900',
              isPriceActive(price.slug) ? 'font-semibold text-slate-900' : 'text-slate-600',
            ]}
          >
            <span class="flex-1">{price.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section
    aria-labelledby={`${idPrefix}filter-color-heading`}
    class="flex flex-col gap-3 border-b border-slate-200 pb-6 last:border-b-0"
  >
    <h3 id={`${idPrefix}filter-color-heading`} class="text-sm font-bold text-slate-900">
      {labels.colorHeading}
    </h3>
    <div role="group" aria-label={labels.colorHeading} class="flex flex-wrap gap-2">
      {colors.map((color) => (
        <a
          href={color.href}
          aria-label={labels.colorSwatchAltTemplate.replace('{name}', color.label)}
          aria-current={isColorActive(color.slug) ? 'true' : undefined}
          class:list={[
            'h-8 w-8 rounded-full transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            isColorActive(color.slug)
              ? 'ring-2 ring-[var(--primary,#475569)] ring-offset-2'
              : 'hover:scale-110',
          ]}
          style={`background:${color.hex};box-shadow:inset 0 0 0 1px rgba(0,0,0,.10);`}
        />
      ))}
    </div>
  </section>

  {sizes.length > 0 && (
  <section aria-labelledby={`${idPrefix}filter-size-heading`} class="flex flex-col gap-3 pb-2">
    <h3 id={`${idPrefix}filter-size-heading`} class="text-sm font-bold text-slate-900">
      {labels.sizeHeading}
    </h3>
    <div role="group" aria-label={labels.sizeHeading} class="flex flex-wrap gap-2">
      {sizes.map((size) => (
        <button
          type="button"
          aria-pressed={isSizeActive(size.slug)}
          class:list={[
            'inline-flex h-11 w-11 items-center justify-center rounded-xl text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            isSizeActive(size.slug)
              ? 'border border-[var(--primary,#475569)] bg-[var(--primary-soft,#F1F5F9)] text-[var(--primary,#475569)]'
              : 'border border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:text-slate-900',
          ]}
        >
          {size.label}
        </button>
      ))}
    </div>
  </section>
  )}
</aside>
