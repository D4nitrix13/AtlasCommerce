---
/**
 * Ficha corta del prototipo Panda.
 *
 * Foto grande, color, cantidad y un enlace al pedido por volumen.
 * No reutiliza la ficha de instrumentos: esa pide mano, tienda y
 * financiamiento, y acá no aplican.
 */
import type { Product } from '../../../types/catalog';
import { formatCurrency } from '../../../lib/formatters';
import AddToCart from '../cart/AddToCart';

interface Props {
  product: Product;
  locale: string;
  catalogHref: string;
  cartHref: string;
  bulkHref: string;
  breadcrumbHome: string;
  breadcrumbCatalog: string;
  colorLabel: string;
  quantityLabel: string;
  addToCartLabel: string;
  volumeNote: string;
  volumeCta: string;
  categoryLabel: string;
}

const {
  product,
  locale,
  catalogHref,
  bulkHref,
  breadcrumbHome,
  breadcrumbCatalog,
  colorLabel,
  quantityLabel,
  addToCartLabel,
  volumeNote,
  volumeCta,
  categoryLabel,
} = Astro.props;

const finishes = (product.variants ?? []).filter(
  (variant) => variant.finishHex !== null && variant.finishHex !== undefined && variant.finishHex !== '',
);
const price = formatCurrency(product.priceCents, product.currency ?? 'USD');
const cover = product.imageUrl;
const imageByVariant = new Map(
  (Array.isArray(product.images) ? product.images : [])
    .filter((image): image is Extract<typeof image, { url: string }> => typeof image !== 'string')
    .map((image) => [image.variantId, image.url]),
);

// Acabados para la isla: `image` alimenta `data-panda-finish`, el atributo
// que el script de preview de portada necesita para cambiar la foto.
const islandFinishes = finishes.map((finish) => ({
  slug: finish.finishSlug ?? finish.id,
  label: finish.finishLabel ?? finish.name ?? finish.finishSlug ?? finish.id,
  hex: finish.finishHex ?? '#cccccc',
  image: imageByVariant.get(finish.id) ?? cover,
}));
---

<main class="bg-[var(--paper,#f3efe8)]">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:py-14">
    <div>
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-[13px] text-[var(--ink-soft,#57534e)]">
          <li><a href={`/${locale}`} class="hover:text-[var(--ink,#1c1917)]">{breadcrumbHome}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={catalogHref} class="hover:text-[var(--ink,#1c1917)]">{breadcrumbCatalog}</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page" class="font-semibold text-[var(--ink,#1c1917)]">{product.name}</span></li>
        </ol>
      </nav>
      <div class="overflow-hidden rounded-3xl border border-[var(--line,#e7e5e4)] bg-[var(--paper,#f3efe8)]">
        <img data-panda-cover src={cover} alt={product.name} class="aspect-[4/5] w-full object-contain" />
      </div>
    </div>

    <aside class="flex flex-col gap-6 lg:pt-14">
      <header class="flex flex-col gap-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--primary,#1c6b63)]">
          {categoryLabel}
        </p>
        <h1 class="text-4xl text-[var(--ink,#1c1917)] sm:text-5xl">{product.name}</h1>
        <p class="text-2xl font-semibold text-[var(--ink,#1c1917)]">{price}</p>
        <p class="max-w-md text-sm leading-relaxed text-[var(--ink-soft,#57534e)]">{product.description}</p>
      </header>

      {/*
        La isla reemplaza los radios de acabado, el input de cantidad y el
        botón de compra. Los swatches conservan `data-panda-finish` con la
        foto del acabado para que el script de abajo siga cambiando la
        portada al elegir un color.
      */}
      <AddToCart
        client:visible
        mode="full"
        productSlug={product.slug}
        name={product.name}
        imageUrl={cover}
        priceCents={product.priceCents}
        currency={product.currency ?? 'USD'}
        finishes={islandFinishes}
        labels={{ add: addToCartLabel, added: 'Agregado', qty: quantityLabel, variant: colorLabel }}
      />

      <p class="text-sm text-[var(--ink-soft,#57534e)]">
        {volumeNote}{' '}
        <a href={`${bulkHref}?product=${product.slug}`} class="font-semibold text-[var(--primary,#1c6b63)] underline-offset-2 hover:underline">
          {volumeCta}
        </a>
      </p>
    </aside>
  </div>
</main>
<script>
  function bindFinishPreview(): void {
    const cover = document.querySelector('[data-panda-cover]');
    if (!(cover instanceof HTMLImageElement)) return;
    // Delegación en document: la isla AddToCart hidrata tarde
    // (client:visible), así sus swatches no existen cuando este módulo
    // corre. Un listener por evento los alcanza aunque aparezcan después.
    const applyFinish = (target: EventTarget | null): void => {
      if (!(target instanceof Element)) return;
      const source = target.closest('[data-panda-finish]');
      if (source === null) return;
      const next = source.getAttribute('data-panda-finish');
      if (next !== null && next !== '') cover.src = next;
    };
    document.addEventListener('click', (event) => applyFinish(event.target));
    document.addEventListener('change', (event) => applyFinish(event.target));
  }
  bindFinishPreview();
</script>
