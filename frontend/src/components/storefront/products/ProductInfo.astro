---
/**
 * ProductInfo — composición B2C estándar (badge + título + rating + precio).
 *
 * Wrapper que delega a los componentes específicos (`ProductHeader`,
 * `ProductPrice`, `ProductCTAs`). Mantener este wrapper permite que
 * páginas existentes (card detail, /[locale]/products/[slug]) sigan
 * consumiendo un solo componente sin acoplarse al detalle de cada
 * sub-pieza.
 *
 * Decisiones:
 *  - Rate moved out — el padre lo computa y lo pasa.
 *  - Stock check collapsed: el padre decide `inStock`.
 *  - Quantity selector y wishlist siguen siendo piezas separadas
 *    ya que no siempre se renderizan juntos (e.g. cards en grids).
 */

import ProductHeader from './ProductHeader.astro';
import ProductPrice from './ProductPrice.astro';
import ProductCTAs from './ProductCTAs.astro';
import Badge from '../../ui/Badge.astro';
import ProductQuantitySelector from './ProductQuantitySelector.astro';
import WishlistButton from './WishlistButton.astro';
import type { ProductBadge } from '../../../types/catalog';

export interface ProductInfoLabels {
  inStock: string;
  outOfStock: string;
  onlyLeft: string;
  addToCart: string;
  addingToCart: string;
  category: string;
  badgeNew: string;
  badgeSale: string;
  badgeLowStock: string;
  quantityLabel: string;
  quantityDecrement: string;
  quantityIncrement: string;
  wishlistAdd: string;
  wishlistAdded: string;
  wishlistRemove: string;
  highlyRated: string;
}

interface Props {
  labels: ProductInfoLabels;
  name: string;
  priceCents: number;
  compareAtPriceCents?: number;
  currencyCode: string;
  stock: number;
  badges: readonly ProductBadge[];
  categoryLabel?: string;
  hrefBase: string;
  rating?: { average: number; count: number };
  highlyRated?: boolean;
  isInWishlist?: boolean;
  loginHref?: string;
  quantity?: number;
  isAddingToCart?: boolean;
}

const {
  labels,
  name,
  priceCents,
  compareAtPriceCents,
  currencyCode,
  stock,
  badges,
  categoryLabel,
  rating,
  highlyRated = false,
  hrefBase,
  isInWishlist = false,
  loginHref,
  quantity = 1,
  isAddingToCart = false,
} = Astro.props;

const isOutOfStock = stock <= 0;

const badgeToLabel: Record<ProductBadge, keyof ProductInfoLabels> = {
  new: 'badgeNew',
  sale: 'badgeSale',
  low_stock: 'badgeLowStock',
};

const qtyLabels = {
  label: labels.quantityLabel,
  decrement: labels.quantityDecrement,
  increment: labels.quantityIncrement,
};

const wishlistLabels = {
  add: labels.wishlistAdd,
  added: labels.wishlistAdded,
  remove: labels.wishlistRemove,
};
---

<header class="flex flex-col gap-4">
  <ProductHeader
    eyebrow={categoryLabel}
    title={name}
    rating={rating}
    highlyRated={highlyRated}
    highlyRatedLabel={labels.highlyRated}
  />

  {badges.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {badges.map((badge) => (
        <Badge variant="neutral" label={labels[badgeToLabel[badge]]} />
      ))}
    </div>
  )}

  <ProductPrice
    currentCents={priceCents}
    compareAtCents={compareAtPriceCents}
    currency={currencyCode}
  />

  <div class="flex items-center gap-2">
    {isOutOfStock ? (
      <Badge variant="neutral" label={labels.outOfStock} />
    ) : (
      <Badge status="delivered" label={labels.inStock} />
    )}
  </div>

  <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end">
    <ProductQuantitySelector
      labels={qtyLabels}
      quantity={quantity}
      min={1}
      max={Math.max(1, stock)}
      hrefBase={hrefBase}
    />
    <ProductCTAs
      addToCartLabel={isOutOfStock ? labels.outOfStock : isAddingToCart ? labels.addingToCart : labels.addToCart}
      favoriteLabel={isInWishlist ? labels.wishlistAdded : labels.wishlistAdd}
      inStock={!isOutOfStock}
      isFavorite={isInWishlist}
    />
    <WishlistButton labels={wishlistLabels} isInWishlist={isInWishlist} loginHref={loginHref} />
  </div>
</header>
