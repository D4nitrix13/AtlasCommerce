---
/**
 * ProductDescription — tabs (description / specs / shipping).
 *
 * Patrón ARIA tabs (https://www.w3.org/WAI/ARIA/apg/patterns/tabs/):
 *  - role="tablist" + role="tab" + role="tabpanel".
 *  - Tab activo vía `?tab=` query param para que la URL sea
 *    shareable (Baymard: "permita que el usuario retome donde quedó").
 *  - Keyboard navigation: las tabs son `<a>` linkeables, lo que da
 *    navegación por teclado gratis (Tab + Enter).
 *  - Tabpanel se oculta si no está activa vía hidden attribute.
 *
 * Alternativa más liviana: usar `<details>` para cada tab — pero
 * eso pierde la metáfora de "tab panel" y los users no pueden
 * compartir el tab específico via URL. Decidimos por tabs ARIA.
 */
export interface ProductDescriptionLabels {
  description: string;
  specs: string;
  shipping: string;
  descriptionEmpty: string;
  specsHeading: string;
  specsSku: string;
  specsCategory: string;
  specsStock: string;
  specsWeight: string;
  specsDimensions: string;
  specsMaterial: string;
  shippingHeading: string;
  shippingReturnsShipping: string;
  shippingReturnsShippingBody: string;
  shippingReturnsReturns: string;
  shippingReturnsReturnsBody: string;
  shippingReturnsWarranty: string;
  shippingReturnsWarrantyBody: string;
}

interface Props {
  labels: ProductDescriptionLabels;
  /** Tab activa (description / specs / shipping). */
  activeTab: 'description' | 'specs' | 'shipping';
  /** Locale-prefixed href base. */
  hrefBase: string;
  /** Descripción larga del producto. */
  description: string;
  /** Especificaciones clave→valor. */
  specs: readonly { label: string; value: string }[];
}

const { labels, activeTab, hrefBase, description, specs } = Astro.props;

const tabs = [
  { id: 'description', label: labels.description },
  { id: 'specs', label: labels.specs },
  { id: 'shipping', label: labels.shipping },
] as const;

const tabHref = (id: typeof activeTab): string => `${hrefBase}?tab=${id}`;

const specsLabels: Record<string, string> = {
  SKU: labels.specsSku,
  Categoría: labels.specsCategory,
  'Stock disponible': labels.specsStock,
  Peso: labels.specsWeight,
  Dimensiones: labels.specsDimensions,
  Material: labels.specsMaterial,
};
---

<section aria-label="Product details" class="flex flex-col gap-4">
  {/* Tablist */}
  <div role="tablist" aria-label="Product details tabs" class="flex border-b border-slate-200">
    {tabs.map((tab) => {
      const isActive = tab.id === activeTab;
      return (
        <a
          href={tabHref(tab.id)}
          role="tab"
          aria-selected={isActive}
          aria-controls={`tabpanel-${tab.id}`}
          id={`tab-${tab.id}`}
          tabindex={isActive ? 0 : -1}
          class:list={[
            'relative -mb-px inline-flex h-10 items-center border-b-2 px-4 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
            isActive
              ? 'border-[var(--primary,#475569)] text-[var(--primary,#475569)]'
              : 'border-transparent text-slate-500 hover:text-slate-700',
          ]}
        >
          {tab.label}
        </a>
      );
    })}
  </div>

  {/* Tabpanels */}
  <div
    role="tabpanel"
    id="tabpanel-description"
    aria-labelledby="tab-description"
    hidden={activeTab !== 'description'}
    class="prose prose-slate max-w-none text-sm leading-relaxed text-slate-700"
  >
    {description !== '' ? (
      <p>{description}</p>
    ) : (
      <p class="italic text-slate-500">{labels.descriptionEmpty}</p>
    )}
  </div>

  <div
    role="tabpanel"
    id="tabpanel-specs"
    aria-labelledby="tab-specs"
    hidden={activeTab !== 'specs'}
    class="rounded-xl border border-slate-200 bg-white p-5"
  >
    <h3 class="mb-3 text-base font-semibold text-slate-900">{labels.specsHeading}</h3>
    <dl class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
      {specs.map((entry) => (
        <div class="flex items-baseline justify-between border-b border-slate-100 py-2 last:border-b-0">
          <dt class="text-sm font-medium text-slate-500">
            {specsLabels[entry.label] ?? entry.label}
          </dt>
          <dd class="text-sm font-semibold text-slate-900">{entry.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div
    role="tabpanel"
    id="tabpanel-shipping"
    aria-labelledby="tab-shipping"
    hidden={activeTab !== 'shipping'}
    class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5"
  >
    <h3 class="text-base font-semibold text-slate-900">{labels.shippingHeading}</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <article class="flex flex-col gap-1">
        <span class="flex items-center gap-2 text-sm font-semibold text-slate-900">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            class="h-5 w-5 text-[var(--primary,#475569)]"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H18.75m-7.5-3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9Z"
            />
          </svg>
          {labels.shippingReturnsShipping}
        </span>
        <p class="text-xs text-slate-600">{labels.shippingReturnsShippingBody}</p>
      </article>
      <article class="flex flex-col gap-1">
        <span class="flex items-center gap-2 text-sm font-semibold text-slate-900">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            class="h-5 w-5 text-[var(--primary,#475569)]"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
            />
          </svg>
          {labels.shippingReturnsReturns}
        </span>
        <p class="text-xs text-slate-600">{labels.shippingReturnsReturnsBody}</p>
      </article>
      <article class="flex flex-col gap-1">
        <span class="flex items-center gap-2 text-sm font-semibold text-slate-900">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            class="h-5 w-5 text-[var(--primary,#475569)]"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
            />
          </svg>
          {labels.shippingReturnsWarranty}
        </span>
        <p class="text-xs text-slate-600">{labels.shippingReturnsWarrantyBody}</p>
      </article>
    </div>
  </div>
</section>
