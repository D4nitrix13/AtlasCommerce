---
/**
 * ProductRelated — productos relacionados (recomendados por categoría).
 *
 * Layout: carousel horizontal con prev/next (≥4 productos).
 * Cada card sigue el patrón Gibson/Shopify-Dawn para "You may also like":
 *
 *   ┌─────────────────┐
 *   │                 │
 *   │   image 1:1     │   sin borde, bg neutro
 *   │                 │
 *   └─────────────────┘
 *   BADGE | BADGE     ← uppercase, gris oscuro
 *   Vendor           ← "Fender"
 *   Finish           ← "3-Color Sunburst" o "Ebony Black"
 *   Product Name      ← bold, line-clamp-2
 *   $X,XXX           ← tabular-nums, bold
 *   2 acabados        ← sólo si variantsCount > 1
 *
 * Regla (Oct 2026, confirmada por el user): "son el mismo modelo lo
 * que cambia es el acabado". Un model con varios finishes se renderiza
 * como 1 card con swatches adentro, NO como varias cards side-by-side.
 *
 * Variant preview: hover en un swatch cambia la imagen al color
 * correspondiente (cross-fade). Implementación: el card tiene un
 * `data-product-id` y se setea `data-active-variant="<id>"` en hover.
 * CSS hace match entre `article[data-active-variant="X"]` e
 * `img[data-variant-id="X"]` para mostrar ese variant.
 *
 * Por qué atributo data (no clase):
 *   - Single source of truth — múltiples reglas CSS reaccionan al
 *     mismo atributo sin duplicar lógica.
 *   - Reset trivial (delete article.dataset.activeVariant).
 *
 * Variants en el mock: el array `product.variants` (RelatedProduct
 * interface) tiene cada color con su imageUrl. Si NO hay variants,
 * se renderiza 1 imagen (la del product).
 */
import type { RelatedProduct } from '../../../data/product-detail-mock';
import { formatCurrency } from '../../../lib/formatters';

export interface ProductRelatedLabels {
  heading: string;
  empty: string;
  newBadge: string;
  saleBadge: string;
  lowStockBadge: string;
  /** Aria-label del botón prev (i18n). */
  prevLabel: string;
  /** Aria-label del botón next (i18n). */
  nextLabel: string;
  /** Label del variants count con `{count}` placeholder, ej. "{count} acabados". */
  variantsLabel: string;
}

interface Props {
  labels: ProductRelatedLabels;
  products: readonly RelatedProduct[];
  locale: string;
}

const { labels, products, locale } = Astro.props;

const hasProducts = products.length > 0;

const BADGE_LABEL: Record<NonNullable<RelatedProduct['badges']>[number], string> = {
  new: labels.newBadge,
  sale: labels.saleBadge,
  low_stock: labels.lowStockBadge,
};

/**
 * Reemplaza el placeholder `{count}` en variantsLabel. Si el producto
 * no tiene variantsCount definido (o no tiene sentido mostrarlo),
 * devuelve `null` para que el caller no lo renderice.
 */
function formatVariantsLabel(product: RelatedProduct, template: string): string | null {
  if (product.variantsCount === undefined || product.variantsCount <= 1) return null;
  return template.replace('{count}', String(product.variantsCount));
}

interface RenderableItem {
  product: RelatedProduct;
  variantsText: string | null;
  /** Lista de imágenes de variant (orden: primera = default). */
  variantImages: ReadonlyArray<{ id: string; imageUrl: string; label: string }>;
}

const items: RenderableItem[] = products.map((product) => {
  const variantsText = formatVariantsLabel(product, labels.variantsLabel);
  const variants = product.variants ?? [];
  const variantImages = variants
    .filter((v) => v.imageUrl !== undefined)
    .map((v) => ({ id: v.id, imageUrl: v.imageUrl as string, label: v.label }));
  // Si no hay variants con imageUrl, fallback al imageUrl del product
  if (variantImages.length === 0) {
    variantImages.push({ id: 'default', imageUrl: product.imageUrl, label: product.name });
  }
  return { product, variantsText, variantImages };
});
---

<section aria-labelledby="related-heading" class="flex flex-col gap-5">
  <header class="flex items-center justify-between">
    <h2 id="related-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      {labels.heading}
    </h2>
    {hasProducts && products.length > 3 && (
      <div class="hidden items-center gap-2 sm:flex">
        <button
          type="button"
          aria-label={labels.prevLabel}
          data-related-prev
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          aria-label={labels.nextLabel}
          data-related-next
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
    )}
  </header>

  {hasProducts ? (
    <ul
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      role="list"
      data-related-scroller
    >
      {items.map(({ product, variantsText, variantImages }) => (
        <li class="w-[260px] h-full shrink-0 snap-start sm:w-[300px]">
          <article
            data-product-id={product.id}
            class="group flex h-full flex-col rounded-2xl bg-white p-2 shadow-sm transition-shadow hover:shadow-md"
          >
            <a
              href={`/${locale}/products/${product.slug}`}
              class="relative block aspect-square overflow-hidden rounded-xl bg-slate-50"
              aria-label={product.name}
            >
              {/* Imagen default (primer variant o product.imageUrl).
                                Se muestra por default. */}
              <img
                src={variantImages[0]?.imageUrl}
                alt={product.name}
                loading="lazy"
                decoding="async"
                data-variant-id="default"
                class="card__img card__img--default absolute inset-0 h-full w-full object-cover"
              />
              {/* Variants siguientes como imágenes ocultas que se
                                muestran vía CSS cuando data-active-variant
                                coincide con su data-variant-id. */}
              {variantImages.slice(1).map((img) => (
                <img
                  src={img.imageUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                  data-variant-id={img.id}
                  class="card__img card__img--variant absolute inset-0 h-full w-full object-cover"
                />
              ))}
            </a>

            {/* Swatches: cuando hay 2+ variants, se muestran como
                            botones. Hover cambia la imagen via setupVariantPreview
                            (data-active-variant en el <article>). */}
            {variantImages.length > 1 && (
              <div
                class="mt-3 flex flex-wrap items-center gap-1.5"
                role="group"
                aria-label={`Variantes disponibles (${variantImages.length})`}
              >
                {variantImages.map((img) => (
                  <button
                    type="button"
                    data-variant-swatch={img.id}
                    title={img.label}
                    aria-label={img.label}
                    class="card__swatch inline-block h-6 w-6 rounded-full border-2 border-white shadow ring-1 ring-slate-300 transition-all duration-150 hover:scale-110 focus-visible:scale-110"
                    style={`background-color: ${product.variants?.find((v) => v.id === img.id)?.hex ?? '#888'};`}
                  />
                ))}
              </div>
            )}

            <div class="flex flex-1 flex-col gap-1.5 pt-3">
              {product.badges !== undefined && product.badges.length > 0 && (
                <div
                  class="flex flex-wrap items-center gap-x-2 text-[11px] font-bold uppercase tracking-wider text-slate-700"
                  aria-label="Etiquetas del producto"
                >
                  {product.badges.map((badge, idx) => (
                    <>
                      {idx > 0 && (
                        <span aria-hidden="true" class="text-slate-300">
                          |
                        </span>
                      )}
                      <span>{BADGE_LABEL[badge]}</span>
                    </>
                  ))}
                </div>
              )}

              <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-slate-900">
                <a
                  href={`/${locale}/products/${product.slug}`}
                  class="transition hover:text-[var(--primary,#475569)] focus:outline-none focus-visible:underline"
                >
                  {product.name}
                </a>
              </h3>

              {product.vendor !== undefined && (
                <div class="flex flex-col gap-0.5 text-xs leading-snug text-slate-500">
                  <span>{product.vendor}</span>
                  {product.finish !== undefined && <span>{product.finish}</span>}
                </div>
              )}

              <div class="mt-auto flex items-end justify-between gap-2 pt-2">
                <span class="text-base font-bold tabular-nums text-slate-900">
                  {formatCurrency(product.priceCents, product.currency ?? 'USD')}
                </span>
                {variantsText !== null && (
                  <span class="text-xs tabular-nums text-slate-500">{variantsText}</span>
                )}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-sm italic text-slate-500">{labels.empty}</p>
  )}
</section>

<style>
  /* El scroll horizontal usa las mismas reglas que ya teníamos:
     ocultar scrollbar en Webkit y Firefox. */
  .gallery-scroller::-webkit-scrollbar {
    display: none;
  }
  .gallery-scroller {
    scrollbar-width: none;
  }

  /* Variant preview:
     - .card__img--default: opacity 1 (default = primer variant).
     - .card__img--variant: opacity 0 (ocultas por default).
     - Cuando el JS setea data-active-variant en el <article>, el
       image matching (data-variant-id="X") hace fade-in. */
  .card__img--default {
    opacity: 1;
    transition: opacity 250ms ease;
  }
  .card__img--variant {
    opacity: 0;
    transition: opacity 250ms ease;
  }
  article[data-active-variant] .card__img--default {
    opacity: 0;
  }
  article[data-active-variant] .card__img--variant {
    opacity: 0;
  }
</style>

{/*
  Reglas CSS por variante — generadas dinámicamente para mostrar la
  imagen correcta cuando el JS setea [data-active-variant]. Usamos
  is:global + set:html para inyectar CSS crudo (Astro procesaría
  los selectores por atributo si fuera scoped y rompería el match).
*/}
{items.flatMap(({ variantImages }) =>
  variantImages
    .filter((v) => v.id !== 'default')
    .map((v) => (
      <style
        is:global
        set:html={`article[data-active-variant="${v.id}"] .card__img--variant[data-variant-id="${v.id}"] { opacity: 1; }`}
      />
    ))
)}

<script>
  /**
   * Scroll horizontal controlado por los botones prev/next.
   */
  function setupRelated(scroller: HTMLElement | null) {
    if (scroller === null) return;
    const section = scroller.closest('section');
    const prev = section?.querySelector<HTMLButtonElement>('[data-related-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-related-next]');

    const updateDisabled = (): void => {
      if (prev === null || prev === undefined) return;
      if (next === null || next === undefined) return;
      prev.disabled = scroller.scrollLeft <= 4;
      next.disabled = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
    };

    if (prev !== null && prev !== undefined) {
      prev.addEventListener('click', () => {
        scroller.scrollBy({ left: -scroller.clientWidth * 0.8, behavior: 'smooth' });
      });
    }
    if (next !== null && next !== undefined) {
      next.addEventListener('click', () => {
        scroller.scrollBy({ left: scroller.clientWidth * 0.8, behavior: 'smooth' });
      });
    }

    scroller.addEventListener('scroll', updateDisabled, { passive: true });
    updateDisabled();
  }

  document
    .querySelectorAll<HTMLElement>('[data-related-scroller]')
    .forEach((el) => setupRelated(el));
</script>

<script>
  /**
   * Variant preview — hover/focus sobre un swatch cambia la imagen
   * del card a la foto de ESA variante. El swatch es <button> (no
   * <span>) para que keyboard users puedan tabular y hacer focus.
   *
   * Implementación:
   *   - Cada swatch tiene `data-variant-swatch="<id>"`.
   *   - El image correspondiente tiene `data-variant-id="<id>"`.
   *   - En hover/focus del swatch, seteamos `data-active-variant="<id>"`
   *     en el <article> — atributo único por card, fuente única
   *     de verdad ("qué variante está activa").
   *   - Las reglas CSS generadas arriba hacen match entre
   *     `article[data-active-variant="X"]` e
   *     `img[data-variant-id="X"]` para mostrar esa imagen.
   *   - En mouse leave / blur, removemos el atributo → vuelve la
   *     imagen default.
   */
  function setupVariantPreview(swatch: HTMLElement): void {
    const article = swatch.closest('article');
    if (article === null) return;
    const variantId = swatch.dataset.variantSwatch;
    if (variantId === undefined || variantId === '') return;

    const activate = (): void => {
      article.dataset.activeVariant = variantId;
    };
    const deactivate = (): void => {
      // Solo limpiar si ESTE swatch es el que activó la variante.
      if (article.dataset.activeVariant === variantId) {
        delete article.dataset.activeVariant;
      }
    };

    swatch.addEventListener('mouseenter', activate);
    swatch.addEventListener('mouseleave', deactivate);
    swatch.addEventListener('focus', activate);
    swatch.addEventListener('blur', deactivate);
  }

  document
    .querySelectorAll<HTMLElement>('[data-variant-swatch]')
    .forEach((swatch) => setupVariantPreview(swatch));
</script>
