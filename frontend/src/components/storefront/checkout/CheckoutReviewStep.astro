---
/**
 * CheckoutReviewStep — Step 4 del checkout (final).
 *
 * Baymard §5.2 (review step):
 *  - Resumen del contacto, dirección de envío, método de envío,
 *    método de pago — cada uno con un link "Editar" que vuelve al
 *    step correspondiente (el padre pasa los hrefs).
 *  - Lista de items en el pedido.
 *  - Checkbox de términos.
 *  - CTA "Realizar pedido" — el submit final.
 */
import Button from '../../ui/Button.astro';
import CheckoutTermsCheckbox from './CheckoutTermsCheckbox.astro';
import type { CheckoutCartItem } from '../../../data/checkout-mock';
import { formatCurrency } from '../../../lib/formatters';

export interface CheckoutReviewLabels {
  heading: string;
  subtitle: string;
  contact: string;
  shippingAddress: string;
  shippingMethod: string;
  paymentMethod: string;
  edit: string;
  placeOrder: string;
  placingOrder: string;
  backToPayment: string;
  itemsHeading: string;
}

interface Props {
  labels: CheckoutReviewLabels;
  /** Strings para los términos (delegamos al TermsCheckbox). */
  termsLabels: {
    label: string;
    privacyLink: string;
    errorRequired: string;
  };
  /** Items en el carrito (reutiliza CheckoutCartItem del mock). */
  items: readonly CheckoutCartItem[];
  /** Locale-prefixed href al step de contacto. */
  contactEditHref: string;
  /** Locale-prefixed href al step de shipping. */
  shippingEditHref: string;
  /** Locale-prefixed href al step de payment. */
  paymentEditHref: string;
  /** Locale-prefixed href del back link. */
  backHref: string;
  /** Locale-prefixed href de la privacy policy. */
  termsHref: string;
  /** Resumen que el padre ya computó (strings). */
  contactSummary: string;
  shippingAddressSummary: string;
  shippingMethodSummary: string;
  paymentMethodSummary: string;
  /** Mostrar loading state en el CTA. */
  placingOrder?: boolean;
}

const {
  labels,
  termsLabels,
  items,
  contactEditHref,
  shippingEditHref,
  paymentEditHref,
  backHref,
  termsHref,
  contactSummary,
  shippingAddressSummary,
  shippingMethodSummary,
  paymentMethodSummary,
  placingOrder = false,
} = Astro.props;
---

<form
  method="post"
  action="/api/storefront/orders"
  class="flex flex-col gap-6"
  aria-label={labels.heading}
  data-checkout-step="review"
>
  <section class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <header class="flex flex-col gap-1">
      <h2 class="text-base font-semibold text-slate-900">{labels.heading}</h2>
      <p class="text-sm text-slate-500">{labels.subtitle}</p>
    </header>

    <dl class="divide-y divide-slate-100">
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="text-sm font-medium text-slate-700">{labels.contact}</dt>
        <dd class="flex flex-1 items-start justify-between gap-3 text-right">
          <span class="text-sm text-slate-900">{contactSummary}</span>
          <a href={contactEditHref} class="text-xs font-semibold text-[var(--primary,#475569)] hover:underline">
            {labels.edit}
          </a>
        </dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="text-sm font-medium text-slate-700">{labels.shippingAddress}</dt>
        <dd class="flex flex-1 items-start justify-between gap-3 text-right">
          <span class="text-sm text-slate-900">{shippingAddressSummary}</span>
          <a href={shippingEditHref} class="text-xs font-semibold text-[var(--primary,#475569)] hover:underline">
            {labels.edit}
          </a>
        </dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="text-sm font-medium text-slate-700">{labels.shippingMethod}</dt>
        <dd class="flex flex-1 items-start justify-between gap-3 text-right">
          <span class="text-sm text-slate-900">{shippingMethodSummary}</span>
          <a href={shippingEditHref} class="text-xs font-semibold text-[var(--primary,#475569)] hover:underline">
            {labels.edit}
          </a>
        </dd>
      </div>
      <div class="flex items-start justify-between gap-4 py-3">
        <dt class="text-sm font-medium text-slate-700">{labels.paymentMethod}</dt>
        <dd class="flex flex-1 items-start justify-between gap-3 text-right">
          <span class="text-sm text-slate-900">{paymentMethodSummary}</span>
          <a href={paymentEditHref} class="text-xs font-semibold text-[var(--primary,#475569)] hover:underline">
            {labels.edit}
          </a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-base font-semibold text-slate-900">{labels.itemsHeading}</h3>
    <ul class="flex list-none flex-col gap-2 p-0" role="list">
      {
        items.map((item) => {
          const lineTotal = item.priceCents * item.quantity;
          const lineFormatted = formatCurrency(lineTotal, item.currency);
          return (
            <li class="flex items-center gap-3 border-b border-slate-100 pb-2 last:border-b-0 last:pb-0">
              <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-md bg-slate-50">
                <img
                  src={item.imageUrl}
                  alt={item.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
                <span class="absolute -right-1 -top-1 inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-slate-700 px-1 text-[10px] font-semibold text-white">
                  {item.quantity}
                </span>
              </div>
              <div class="flex flex-1 flex-col">
                <span class="line-clamp-1 text-sm font-semibold text-slate-900">
                  {item.name}
                </span>
                <span class="text-xs text-slate-500">{item.slug}</span>
              </div>
              <span class="text-sm font-bold tabular-nums text-slate-900">
                {lineFormatted}
              </span>
            </li>
          );
        })
      }
    </ul>
  </section>

  <div class="flex flex-col gap-3">
    <CheckoutTermsCheckbox
      termsHref={termsHref}
      labels={termsLabels}
    />
  </div>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-between">
    <a
      href={backHref}
      class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
    >
      {labels.backToPayment}
    </a>
    <Button
      variant="primary"
      size="lg"
      type="submit"
      loading={placingOrder}
      fullWidth={true}
      class="sm:w-auto"
    >
      {placingOrder ? labels.placingOrder : labels.placeOrder}
    </Button>
  </div>
</form>
