---
/**
 * CheckoutSummary — sticky summary lateral con desglose + CTA.
 *
 * Patrón Baymard §5.2 (gold standard):
 *  - Sticky en desktop (sidebar derecho), expandible arriba en mobile
 *    con `<details>` para no robar viewport.
 *  - Items listados con thumb + nombre + qty.
 *  - Subtotal · descuento (opcional) · envío (placeholder si no
 *    eligió método) · impuestos (opcional) · total.
 *  - Slot `trust` permite inyectar CheckoutTrustBadges al pie.
 *
 * Single source of truth: NO recalcula totales. Recibe valores
 * pre-computados (esperaríamos que vengan del backend en el futuro).
 */
import { formatCurrency } from '../../../lib/formatters';
import CheckoutSummaryBody from './CheckoutSummaryBody.astro';

/** Item mostrado en el resumen (mínimo viable). */
export interface CheckoutSummaryItem {
  id: number;
  name: string;
  imageUrl: string;
  priceCents: number;
  currency: string;
  quantity: number;
}

/** Strings localizadas del summary. */
export interface CheckoutSummaryLabels {
  heading: string;
  subtotal: string;
  discount: string;
  shipping: string;
  shippingFree: string;
  shippingPending: string;
  tax: string;
  total: string;
  itemCount: string;
  expand: string;
  collapse: string;
}

interface Props {
  items: readonly CheckoutSummaryItem[];
  subtotalCents: number;
  currencyCode: string;
  discountCents?: number;
  /** `null` = aún no eligió método (mostramos "shippingPending"). */
  shippingCents?: number | null;
  taxCents?: number;
  labels: CheckoutSummaryLabels;
}

const {
  items,
  subtotalCents,
  currencyCode,
  discountCents = 0,
  shippingCents = null,
  taxCents = 0,
  labels,
} = Astro.props;

const subtotalFormatted = formatCurrency(subtotalCents, currencyCode);
const discountFormatted = discountCents > 0 ? formatCurrency(discountCents, currencyCode) : null;
const taxFormatted = taxCents > 0 ? formatCurrency(taxCents, currencyCode) : null;

const shippingDisplay =
  shippingCents === null
    ? labels.shippingPending
    : shippingCents === 0
      ? labels.shippingFree
      : formatCurrency(shippingCents, currencyCode);

const totalCents = Math.max(0, subtotalCents - discountCents + (shippingCents ?? 0) + taxCents);
const totalFormatted = formatCurrency(totalCents, currencyCode);
const totalQuantity = items.reduce((sum, item) => sum + item.quantity, 0);
const itemCountLabel = labels.itemCount.replace('{count}', String(totalQuantity));

const bodyProps = {
  items,
  currencyCode,
  subtotalFormatted,
  discountFormatted,
  shippingDisplay,
  taxFormatted,
  labels: {
    subtotal: labels.subtotal,
    discount: labels.discount,
    shipping: labels.shipping,
    tax: labels.tax,
  },
};
---

{/* Mobile: bloque expandible arriba */}
<details class="group rounded-xl border border-slate-200 bg-white shadow-sm lg:hidden">
  <summary class="flex cursor-pointer list-none items-center justify-between p-4">
    <span class="flex items-center gap-2 text-sm font-semibold text-slate-900">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="h-5 w-5 text-slate-500 transition group-open:rotate-180"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
      <span class="inline-flex items-center gap-1">
        <span>{labels.expand}</span>
        <span class="text-xs font-normal text-slate-500">— {itemCountLabel}</span>
      </span>
    </span>
    <span class="text-base font-bold tabular-nums text-slate-900">{totalFormatted}</span>
  </summary>
  <div class="border-t border-slate-200 p-4">
    <CheckoutSummaryBody {...bodyProps} />
    <div class="mt-4 border-t border-slate-200 pt-3">
      <div class="flex items-baseline justify-between">
        <dt class="text-base font-semibold text-slate-900">{labels.total}</dt>
        <dd class="text-lg font-bold tabular-nums text-slate-900">{totalFormatted}</dd>
      </div>
    </div>
  </div>
</details>

{/* Desktop: sidebar sticky */}
<aside
  aria-label={labels.heading}
  class="sticky top-6 hidden flex-col gap-4 self-start rounded-xl border border-slate-200 bg-white p-5 shadow-sm lg:flex"
>
  <h2 class="text-base font-semibold text-slate-900">{labels.heading}</h2>

  <CheckoutSummaryBody {...bodyProps} />

  <div class="mt-2 border-t border-slate-200 pt-3">
    <div class="flex items-baseline justify-between">
      <dt class="text-base font-semibold text-slate-900">{labels.total}</dt>
      <dd class="text-lg font-bold tabular-nums text-slate-900">{totalFormatted}</dd>
    </div>
  </div>

  <slot name="trust" />
</aside>
