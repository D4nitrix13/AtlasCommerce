---
/**
 * CheckoutPaymentStep — Step 3 del checkout.
 *
 * Baymard §5.2 + design-refs §7.3 (B2B NET 30):
 *  - Selector de método de pago (radio cards).
 *  - Card form visible SOLO si payment method = card.
 *  - NET 30 placeholder visible sólo si el usuario es B2B (futuro).
 *  - Checkbox "billing address same as shipping" (Baymard: pre-checked).
 */
import Input from '../../ui/Input.astro';
import Button from '../../ui/Button.astro';
import type { PaymentMethodOption } from '../../../data/checkout-mock';

export interface CheckoutPaymentLabels {
  heading: string;
  subtitle: string;
  methodCard: string;
  methodTransfer: string;
  methodCod: string;
  methodNet30: string;
  cardNumber: string;
  cardName: string;
  cardExpiry: string;
  cardCvc: string;
  billingSame: string;
  billingDifferent: string;
  net30Hint: string;
  continueToReview: string;
  backToShipping: string;
}

interface Props {
  labels: CheckoutPaymentLabels;
  /** Métodos de pago disponibles. */
  paymentMethods: readonly PaymentMethodOption[];
  /** Mostrar NET 30 (sólo cuando el usuario es B2B). */
  showNet30: boolean;
  /** Locale-prefixed href del back link. */
  backHref: string;
  /** Locale-prefixed href del continue submit. */
  continueHref: string;
}

const { labels, paymentMethods, showNet30, backHref, continueHref } = Astro.props;

const visibleMethods = showNet30
  ? paymentMethods
  : paymentMethods.filter((method) => method.id !== 'net30');

const methodLabelKey: Record<PaymentMethodOption['id'], keyof CheckoutPaymentLabels> = {
  card: 'methodCard',
  transfer: 'methodTransfer',
  cod: 'methodCod',
  net30: 'methodNet30',
};
---

<form
  method="get"
  action={continueHref}
  class="flex flex-col gap-6"
  aria-label={labels.heading}
  data-checkout-step="payment"
>
  <section class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <header class="flex flex-col gap-1">
      <h2 class="text-base font-semibold text-slate-900">{labels.heading}</h2>
      <p class="text-sm text-slate-500">{labels.subtitle}</p>
    </header>

    <div class="flex flex-col gap-2" role="radiogroup" aria-label={labels.heading}>
      {visibleMethods.map((method, index) => {
        const isNet30 = method.id === 'net30';
        return (
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 transition hover:border-[var(--primary,#475569)] hover:bg-slate-50 has-[:checked]:border-[var(--primary,#475569)] has-[:checked]:bg-violet-50">
            <input
              type="radio"
              name="paymentMethod"
              value={method.id}
              checked={index === 0}
              class="mt-1 h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
            />
            <span class="flex flex-1 flex-col gap-0.5">
              <span class="text-sm font-semibold text-slate-900">
                {labels[methodLabelKey[method.id]]}
              </span>
              {isNet30 && <span class="text-xs text-amber-700">{labels.net30Hint}</span>}
            </span>
          </label>
        );
      })}
    </div>

    {/* Card fields — visible sólo si method = card. Como esto es una
        Astro page estática (sin JS React), los campos se renderizan
        siempre — el padre puede filtrarlos visualmente con CSS o
        decidirá luego si los hace dinámicos. Para esta versión los
        mostramos siempre con un encabezado claro. */}
    <div class="flex flex-col gap-3 rounded-lg border border-slate-100 bg-slate-50 p-4">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Input
          name="cardNumber"
          label={labels.cardNumber}
          placeholder="1234 5678 9012 3456"
          autocomplete="cc-number"
          inputmode="numeric"
          class="sm:col-span-2"
        />
        <Input
          name="cardName"
          label={labels.cardName}
          autocomplete="cc-name"
          class="sm:col-span-2"
        />
        <Input
          name="cardExpiry"
          label={labels.cardExpiry}
          placeholder="MM/AA"
          autocomplete="cc-exp"
          inputmode="numeric"
        />
        <Input
          name="cardCvc"
          label={labels.cardCvc}
          placeholder="123"
          autocomplete="cc-csc"
          inputmode="numeric"
        />
      </div>
    </div>

    <fieldset class="flex flex-col gap-2">
      <legend class="sr-only">Billing address</legend>
      <label class="flex cursor-pointer items-center gap-2 rounded-md p-1 text-sm text-slate-700 transition hover:bg-slate-50">
        <input
          type="radio"
          name="billingAddress"
          value="same"
          checked
          class="h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
        />
        <span>{labels.billingSame}</span>
      </label>
      <label class="flex cursor-pointer items-center gap-2 rounded-md p-1 text-sm text-slate-700 transition hover:bg-slate-50">
        <input
          type="radio"
          name="billingAddress"
          value="different"
          class="h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
        />
        <span>{labels.billingDifferent}</span>
      </label>
    </fieldset>
  </section>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-between">
    <a
      href={backHref}
      class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
    >
      {labels.backToShipping}
    </a>
    <Button variant="primary" size="lg" type="submit" fullWidth={true} class="sm:w-auto">
      {labels.continueToReview}
    </Button>
  </div>
</form>
