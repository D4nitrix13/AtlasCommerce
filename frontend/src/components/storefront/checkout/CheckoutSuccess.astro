---
/**
 * CheckoutSuccess — confirmación post-pago.
 *
 * Baymard §5.2 (post-order confirmation):
 *  - Order number prominent + copiable.
 *  - Email confirmation note.
 *  - 2 CTAs: "Seguir comprando" (primary, mantiene el embudo) +
 *    "Ver mi pedido" (secondary, account engagement).
 *  - Soporte al pie — link a help si el usuario tiene dudas.
 */
import Button from '../../ui/Button.astro';

export interface CheckoutSuccessLabels {
  title: string;
  subtitle: string;
  orderNumber: string;
  confirmationEmail: string;
  continueShopping: string;
  viewOrder: string;
  help: string;
}

interface Props {
  labels: CheckoutSuccessLabels;
  /** Número de pedido asignado por backend (placeholder: timestamp). */
  orderNumber: string;
  /** Locale-prefixed href al catálogo. */
  catalogHref: string;
  /** Locale-prefixed href al detalle del pedido (account). */
  orderHref: string;
  /** Locale-prefixed href a la página de soporte. */
  helpHref: string;
}

const { labels, orderNumber, catalogHref, orderHref, helpHref } = Astro.props;
---

<section
  aria-labelledby="checkout-success-title"
  class="mx-auto flex max-w-xl flex-col items-center gap-4 rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm"
>
  {/* Check icon grande */}
  <div
    class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-8 w-8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
    </svg>
  </div>

  <div class="flex flex-col gap-2">
    <h1 id="checkout-success-title" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      {labels.title}
    </h1>
    <p class="text-sm text-slate-500 sm:text-base">{labels.subtitle}</p>
  </div>

  <div class="flex w-full flex-col gap-1 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4">
    <span class="text-xs font-medium uppercase tracking-wide text-slate-500">
      {labels.orderNumber}
    </span>
    <span class="font-mono text-lg font-bold text-slate-900">{orderNumber}</span>
    <span class="text-xs text-slate-500">{labels.confirmationEmail}</span>
  </div>

  <div class="flex w-full flex-col gap-2 pt-2 sm:flex-row sm:justify-center">
    <Button variant="primary" size="lg" href={catalogHref} fullWidth={true} class="sm:w-auto">
      {labels.continueShopping}
    </Button>
    <Button
      variant="secondary"
      size="lg"
      href={orderHref}
      fullWidth={true}
      class="sm:w-auto"
    >
      {labels.viewOrder}
    </Button>
  </div>

  <p class="pt-2 text-xs text-slate-500">
    {labels.help}{' '}
    <a
      href={helpHref}
      class="font-semibold text-[var(--primary,#475569)] underline-offset-2 hover:underline"
    >
      {helpHref}
    </a>
  </p>
</section>
