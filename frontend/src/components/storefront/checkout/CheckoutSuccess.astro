---
/**
 * CheckoutSuccess — confirmación post-pago.
 *
 * Baymard §5.2 (post-order confirmation):
 *  - Order number prominent + copiable.
 *  - Email confirmation note.
 *  - 2 CTAs: "Seguir comprando" (primary, mantiene el embudo) +
 *    "Ver mi pedido" (secondary, account engagement).
 *  - Soporte al pie — link a help si el usuario tiene dudas.
 *
 * Estilo boutique-recibo (`.interface-design/system.md`): check en
 * círculo `--primary-soft` con acento (nunca verde), heading Fraunces
 * y panel punteado tipo recibo con el número de pedido.
 */
import Button from '../../ui/Button.astro';

export interface CheckoutSuccessLabels {
  title: string;
  subtitle: string;
  orderNumber: string;
  confirmationEmail: string;
  continueShopping: string;
  viewOrder: string;
  help: string;
}

interface Props {
  labels: CheckoutSuccessLabels;
  /** Número de pedido asignado por backend (placeholder: timestamp). */
  orderNumber: string;
  /** Locale-prefixed href al catálogo. */
  catalogHref: string;
  /** Locale-prefixed href al detalle del pedido (account). */
  orderHref: string;
  /** Locale-prefixed href a la página de soporte. */
  helpHref: string;
}

const { labels, orderNumber, catalogHref, orderHref, helpHref } = Astro.props;
---

<section
  aria-labelledby="checkout-success-title"
  class="mx-auto flex max-w-xl flex-col items-center gap-5 rounded-2xl border border-[var(--line,#e7e5e4)] bg-white p-8 text-center shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)] sm:p-10"
>
  {/* Check icon en círculo soft con acento del tenant (nunca verde). */}
  <div
    class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-[var(--primary-soft,#e6f7f4)] text-[var(--primary,#475569)]"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      class="h-8 w-8"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
    </svg>
  </div>

  <div class="flex flex-col gap-2">
    <h1
      id="checkout-success-title"
      class="text-3xl tracking-tight text-[var(--ink,#1c1917)] sm:text-4xl"
    >
      {labels.title}
    </h1>
    <p class="text-sm text-[var(--ink,#1c1917)]/60 sm:text-base">{labels.subtitle}</p>
  </div>

  {/* Panel-recibo punteado con el número de pedido mock. */}
  <div
    class="flex w-full flex-col gap-1.5 rounded-lg border border-dashed border-[var(--line,#e7e5e4)] bg-[var(--paper,#f3efe8)]/60 p-5"
  >
    <span class="text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/60">
      {labels.orderNumber}
    </span>
    <span class="font-mono text-lg font-semibold tabular-nums text-[var(--ink,#1c1917)]">
      {orderNumber}
    </span>
    <span class="text-xs text-[var(--ink,#1c1917)]/60">{labels.confirmationEmail}</span>
  </div>

  <div class="flex w-full flex-col gap-2 pt-2 sm:flex-row sm:justify-center">
    <Button variant="primary" size="lg" href={catalogHref} fullWidth={true} class="sm:w-auto">
      {labels.continueShopping}
    </Button>
    <Button variant="secondary" size="lg" href={orderHref} fullWidth={true} class="sm:w-auto">
      {labels.viewOrder}
    </Button>
  </div>

  <p class="pt-2 text-xs text-[var(--ink,#1c1917)]/60">
    {labels.help}{' '}
    <a
      href={helpHref}
      class="font-semibold text-[var(--primary,#475569)] underline-offset-2 hover:underline"
    >
      {helpHref}
    </a>
  </p>
</section>
