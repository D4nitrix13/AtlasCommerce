---
/**
 * CheckoutShippingStep — Step 2 del checkout.
 *
 * Baymard §5.2 + design-refs §3.4 (multi-sucursal B2B):
 *  - Form de dirección completo (8 campos canónicos).
 *  - Si el usuario tiene saved addresses, los muestra arriba como
 *    radio cards clickeables (Baymard: "address book is fastest").
 *  - Selector de método de envío (radio cards) con precios + ETA.
 *  - Botón "Volver" + "Continuar a pago".
 */
import Input from '../../ui/Input.astro';
import Select from '../../ui/Select.astro';
import Button from '../../ui/Button.astro';
import type { SavedAddress, ShippingMethodOption } from '../../../data/checkout-mock';

export interface CheckoutShippingLabels {
  heading: string;
  subtitle: string;
  firstName: string;
  lastName: string;
  phone: string;
  country: string;
  department: string;
  municipality: string;
  address1: string;
  address2: string;
  reference: string;
  savedAddresses: string;
  useNewAddress: string;
  methodHeading: string;
  methodStandard: string;
  methodStandardHint: string;
  methodExpress: string;
  methodExpressHint: string;
  methodPickup: string;
  methodPickupHint: string;
  continueToPayment: string;
  backToContact: string;
}

interface Props {
  labels: CheckoutShippingLabels;
  /** Direcciones guardadas del usuario (puede ser array vacío). */
  savedAddresses: readonly SavedAddress[];
  /** Métodos de envío disponibles. */
  shippingMethods: readonly ShippingMethodOption[];
  /** Locale-prefixed href del back link. */
  backHref: string;
  /** Locale-prefixed href del continue submit. */
  continueHref: string;
}

const { labels, savedAddresses, shippingMethods, backHref, continueHref } = Astro.props;

const hasSavedAddresses = savedAddresses.length > 0;
---

<form
  method="get"
  action={continueHref}
  class="flex flex-col gap-6"
  aria-label={labels.heading}
  data-checkout-step="shipping"
>
  <section class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <header class="flex flex-col gap-1">
      <h2 class="text-base font-semibold text-slate-900">{labels.heading}</h2>
      <p class="text-sm text-slate-500">{labels.subtitle}</p>
    </header>

    {hasSavedAddresses && (
      <fieldset class="flex flex-col gap-2 rounded-lg border border-slate-200 p-3">
        <legend class="px-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
          {labels.savedAddresses}
        </legend>
        <div class="flex flex-col gap-2">
          {savedAddresses.map((address, index) => (
            <label class="flex cursor-pointer items-start gap-3 rounded-md border border-slate-200 p-3 transition hover:border-[var(--primary,#475569)] hover:bg-slate-50 has-[:checked]:border-[var(--primary,#475569)] has-[:checked]:bg-violet-50">
              <input
                type="radio"
                name="savedAddress"
                value={address.id}
                checked={index === 0}
                class="mt-1 h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
              />
              <span class="flex flex-1 flex-col gap-0.5">
                <span class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-slate-900">{address.label}</span>
                  {address.isDefault === true && (
                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-emerald-700">
                      ✓
                    </span>
                  )}
                </span>
                <span class="text-xs text-slate-600">
                  {address.recipient} · {address.phone}
                </span>
                <span class="text-xs text-slate-500">
                  {address.address1}
                  {address.address2 !== undefined && address.address2 !== ''
                    ? `, ${address.address2}`
                    : ''}
                  , {address.municipality}, {address.department}
                </span>
              </span>
            </label>
          ))}
          <label class="flex cursor-pointer items-center gap-3 rounded-md border border-dashed border-slate-300 p-3 transition hover:bg-slate-50">
            <input
              type="radio"
              name="savedAddress"
              value="new"
              class="h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
            />
            <span class="text-sm font-medium text-slate-700">{labels.useNewAddress}</span>
          </label>
        </div>
      </fieldset>
    )}

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <Input name="firstName" label={labels.firstName} required={true} autocomplete="given-name" />
      <Input name="lastName" label={labels.lastName} required={true} autocomplete="family-name" />
      <Input name="phone" type="tel" label={labels.phone} required={true} autocomplete="tel" />
      <Select
        name="country"
        label={labels.country}
        required={true}
        value="NI"
        options={[
          { value: 'NI', label: 'Nicaragua' },
          { value: 'CR', label: 'Costa Rica' },
          { value: 'GT', label: 'Guatemala' },
          { value: 'HN', label: 'Honduras' },
          { value: 'SV', label: 'El Salvador' },
          { value: 'PA', label: 'Panamá' },
        ]}
      />
      <Input
        name="department"
        label={labels.department}
        required={true}
        autocomplete="address-level1"
      />
      <Input
        name="municipality"
        label={labels.municipality}
        required={true}
        autocomplete="address-level2"
      />
      <Input
        name="address1"
        label={labels.address1}
        required={true}
        autocomplete="address-line1"
        class="sm:col-span-2"
      />
      <Input
        name="address2"
        label={labels.address2}
        autocomplete="address-line2"
        class="sm:col-span-2"
      />
      <Input
        name="reference"
        label={labels.reference}
        hint=""
        autocomplete="off"
        class="sm:col-span-2"
      />
    </div>
  </section>

  <section class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <header class="flex flex-col gap-1">
      <h2 class="text-base font-semibold text-slate-900">{labels.methodHeading}</h2>
    </header>
    <div class="flex flex-col gap-2" role="radiogroup" aria-label={labels.methodHeading}>
      {shippingMethods.map((method, index) => {
        const labelKey =
          method.id === 'standard'
            ? 'methodStandard'
            : method.id === 'express'
              ? 'methodExpress'
              : 'methodPickup';
        const hintKey =
          method.id === 'standard'
            ? 'methodStandardHint'
            : method.id === 'express'
              ? 'methodExpressHint'
              : 'methodPickupHint';
        return (
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 transition hover:border-[var(--primary,#475569)] hover:bg-slate-50 has-[:checked]:border-[var(--primary,#475569)] has-[:checked]:bg-violet-50">
            <input
              type="radio"
              name="shippingMethod"
              value={method.id}
              checked={index === 0}
              class="mt-1 h-4 w-4 shrink-0 border-slate-300 text-[var(--primary,#475569)] focus:ring-[var(--primary,#475569)]"
            />
            <span class="flex flex-1 flex-col gap-0.5">
              <span class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-slate-900">{labels[labelKey]}</span>
                <span class="text-sm font-bold tabular-nums text-slate-900">
                  {method.priceCents === 0
                    ? labels.methodPickupHint.includes('gratis')
                      ? 'Gratis'
                      : '—'
                    : new Intl.NumberFormat('es-NI', { style: 'currency', currency: 'USD' }).format(
                        method.priceCents / 100
                      )}
                </span>
              </span>
              <span class="text-xs text-slate-500">{labels[hintKey]}</span>
            </span>
          </label>
        );
      })}
    </div>
  </section>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-between">
    <a
      href={backHref}
      class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
    >
      {labels.backToContact}
    </a>
    <Button variant="primary" size="lg" type="submit" fullWidth={true} class="sm:w-auto">
      {labels.continueToPayment}
    </Button>
  </div>
</form>
