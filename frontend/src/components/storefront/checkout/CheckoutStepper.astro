---
/**
 * CheckoutStepper — indicador horizontal de los 4 pasos del checkout.
 *
 * Patrón Baymard §5.2 (gold standard checkout):
 *  - 4 steps: Contact / Shipping / Payment / Review.
 *  - Steps anteriores clickeables (editables), futuros deshabilitados.
 *  - Step actual = anillo coloreado (tenant primary).
 *  - Step completo = check + color slate (no se "destaca" para no
 *    confundir al usuario sobre dónde está).
 *  - Responsive: en mobile el stepper se transforma en barra compacta
 *    con solo "Step N of 4" + label del actual.
 *
 * Estado derivable: el padre (`checkout.astro`) sabe qué step está
 * activo vía `?step=` query param o estado interno. El componente
 * es presentacional — no maneja estado propio.
 */
export interface CheckoutStepperStep {
  id: string;
  label: string;
}

interface Props {
  steps: readonly CheckoutStepperStep[];
  /** ID del step activo (mismo que `steps[i].id`). */
  currentStepId: string;
  /** Locale-prefixed href base para volver a un step (ej. `/${locale}/checkout?step=contact`). */
  stepHrefBase: string;
}

const { steps, currentStepId, stepHrefBase } = Astro.props;

const currentIndex = steps.findIndex((entry) => entry.id === currentStepId);
const safeIndex = currentIndex >= 0 ? currentIndex : 0;

// href por step incluye el query param para que el padre pueda
// re-leerlo y renderear el step correcto.
const hrefForStep = (stepId: string): string => `${stepHrefBase}?step=${stepId}`;
---

<nav aria-label="Checkout progress" class="mb-8">
  {/* Mobile: barra compacta */}
  <p class="text-sm font-medium text-slate-600 sm:hidden">
    Paso {safeIndex + 1} de {steps.length}:
    <span class="font-semibold text-slate-900">{steps[safeIndex]?.label ?? ''}</span>
  </p>

  {/* Desktop: stepper horizontal con círculos + conectores */}
  <ol class="hidden list-none flex-row items-center gap-2 p-0 sm:flex" role="list">
    {steps.map((step, index) => {
      const isCompleted = index < safeIndex;
      const isCurrent = index === safeIndex;
      const isFuture = index > safeIndex;
      const isLast = index === steps.length - 1;
      // Connector entre steps: 2 casos — completado (primary) o pendiente (slate).
      const connectorClass = index < safeIndex ? 'bg-[var(--primary,#475569)]' : 'bg-slate-200';

      return (
        <li class="flex flex-1 items-center gap-2 last:flex-none">
          <a
            href={isFuture ? undefined : hrefForStep(step.id)}
            aria-current={isCurrent ? 'step' : undefined}
            aria-disabled={isFuture ? 'true' : undefined}
            class:list={[
              'group inline-flex items-center gap-2 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2',
              isFuture ? 'cursor-not-allowed' : '',
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                'inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 text-xs font-semibold transition',
                isCurrent
                  ? 'border-[var(--primary,#475569)] bg-[var(--primary,#475569)] text-white'
                  : isCompleted
                    ? 'border-[var(--primary,#475569)] bg-[var(--primary,#475569)] text-white'
                    : 'border-slate-300 bg-white text-slate-400',
              ]}
            >
              {isCompleted ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  class="h-4 w-4"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              ) : (
                <span>{index + 1}</span>
              )}
            </span>
            <span
              class:list={[
                'text-sm font-medium',
                isCurrent ? 'text-slate-900' : isCompleted ? 'text-slate-700' : 'text-slate-400',
              ]}
            >
              {step.label}
            </span>
          </a>
          {!isLast && (
            <span
              aria-hidden="true"
              class:list={['mx-1 h-0.5 flex-1 rounded-full', connectorClass]}
            />
          )}
        </li>
      );
    })}
  </ol>
</nav>
