---
/**
 * CheckoutReviewStepV3 — Step 3 (Revisión) del checkout V3.
 *
 * V3 replica el IA mockup `09-checkout.html`:
 *  - Listado de items con thumb + qty +/- + precio línea.
 *  - Subtotal debajo.
 *
 * Accesibilidad: cada item tiene un `<li>` (semántica de lista) y los
 * controles +/- son `<button>` reales (no divs clickeables). Los
 * controles +/- son puramente visuales (no hay backend que persista).
 */
import type { CheckoutSummaryV3Item } from './CheckoutSummaryV3.astro';
import { formatCurrency } from '../../../lib/formatters';

export interface CheckoutReviewStepV3Labels {
  qty: string;
  subtotal: string;
}

interface Props {
  labels: CheckoutReviewStepV3Labels;
  items: readonly CheckoutSummaryV3Item[];
  currencyCode: string;
}

const { labels, items, currencyCode } = Astro.props;
const subtotalCents = items.reduce((sum, item) => sum + item.priceCents * item.quantity, 0);
const subtotalFormatted = formatCurrency(subtotalCents, currencyCode);
---

<div class="flex flex-col gap-4">
  <ul class="flex list-none flex-col gap-3 p-0" role="list">
    {items.map((item, index) => {
      const lineTotal = item.priceCents * item.quantity;
      const lineFormatted = formatCurrency(lineTotal, currencyCode);
      return (
        <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
          <span class="relative h-14 w-12 shrink-0 overflow-hidden rounded-md bg-white">
            <img
              src={item.imageUrl}
              alt={item.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </span>
          <div class="flex flex-1 flex-col gap-0.5">
            <span class="text-[14px] font-semibold text-slate-900">{item.name}</span>
            <span class="text-[12px] text-slate-500">{labels.qty}: {item.quantity}</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="inline-flex items-center rounded-md border border-slate-300 bg-white">
              <button
                type="button"
                aria-label="−"
                class="px-2 py-1 text-slate-600 transition hover:text-slate-900"
              >
                −
              </button>
              <span class="min-w-[2rem] text-center text-sm font-medium tabular-nums text-slate-900">
                {item.quantity}
              </span>
              <button
                type="button"
                aria-label="+"
                class="px-2 py-1 text-slate-600 transition hover:text-slate-900"
              >
                +
              </button>
            </div>
            <input type="hidden" name={`qty-${index}`} value={item.quantity} />
          </div>
          <span class="min-w-[5rem] text-right text-[14px] font-bold tabular-nums text-slate-900">
            {lineFormatted}
          </span>
        </li>
      );
    })}
  </ul>

  <div class="flex items-center justify-between border-t border-slate-200 pt-4 text-sm">
    <span class="font-semibold text-slate-700">{labels.subtotal}</span>
    <span class="font-bold tabular-nums text-slate-900">{subtotalFormatted}</span>
  </div>
</div>
