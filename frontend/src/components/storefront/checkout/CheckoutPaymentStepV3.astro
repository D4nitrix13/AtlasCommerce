---
/**
 * CheckoutPaymentStepV3 — Step 2 (Pago) del checkout V3.
 *
 * V3 replica el IA mockup `09-checkout.html`:
 *  - Radio group con tres métodos: tarjeta, transferencia, contra-entrega.
 *  - Card details form (número, expiración, CVV, nombre) — siempre
 *    visible (mockup no esconde el form según la opción elegida; cuando
 *    exista la lógica de "show on card" se pasará por prop).
 *  - Inputs con focus `ring-2 ring-[var(--primary)]`.
 *
 * Decisión:
 *  - El radio es un `<fieldset role="radiogroup">` interno con
 *    `<legend>` (semántica correcta para agrupar opciones).
 *  - Cards de método: hover border primary, checked = soft bg primary.
 */
export interface CheckoutPaymentStepV3Labels {
  paymentHeading: string;
  paymentMethod: string;
  card: string;
  transfer: string;
  cod: string;
  cardDetails: string;
  cardNumber: string;
  expiry: string;
  cvv: string;
  cardName: string;
}

interface Props {
  labels: CheckoutPaymentStepV3Labels;
}

const { labels } = Astro.props;
---

<div class="flex flex-col gap-5">
  <fieldset role="radiogroup" aria-label={labels.paymentMethod} class="flex flex-col gap-3">
    <legend class="px-1 text-sm font-medium text-slate-700">{labels.paymentMethod}</legend>

    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-[var(--primary,#2D9D8E)] has-[:checked]:border-[var(--primary,#2D9D8E)] has-[:checked]:bg-[var(--primary-soft,#E6F7F4)]">
      <input
        type="radio"
        name="paymentMethod"
        value="card"
        checked
        class="mt-1 h-4 w-4 accent-[var(--primary,#2D9D8E)]"
      />
      <span class="flex flex-col gap-0.5">
        <span class="text-[15px] font-bold text-slate-900">{labels.card}</span>
      </span>
    </label>
    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-[var(--primary,#2D9D8E)] has-[:checked]:border-[var(--primary,#2D9D8E)] has-[:checked]:bg-[var(--primary-soft,#E6F7F4)]">
      <input
        type="radio"
        name="paymentMethod"
        value="transfer"
        class="mt-1 h-4 w-4 accent-[var(--primary,#2D9D8E)]"
      />
      <span class="flex flex-col gap-0.5">
        <span class="text-[15px] font-bold text-slate-900">{labels.transfer}</span>
      </span>
    </label>
    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-[var(--primary,#2D9D8E)] has-[:checked]:border-[var(--primary,#2D9D8E)] has-[:checked]:bg-[var(--primary-soft,#E6F7F4)]">
      <input
        type="radio"
        name="paymentMethod"
        value="cod"
        class="mt-1 h-4 w-4 accent-[var(--primary,#2D9D8E)]"
      />
      <span class="flex flex-col gap-0.5">
        <span class="text-[15px] font-bold text-slate-900">{labels.cod}</span>
      </span>
    </label>
  </fieldset>

  <fieldset
    class="flex flex-col gap-4 border-t border-slate-200 pt-5"
    aria-labelledby="v3-card-details-legend"
  >
    <legend id="v3-card-details-legend" class="px-1 text-sm font-bold text-slate-900">
      {labels.cardDetails}
    </legend>
    <div class="flex flex-col gap-1.5">
      <label for="v3-card-name" class="text-sm font-medium text-slate-700">
        {labels.cardName}
      </label>
      <input
        id="v3-card-name"
        name="cardName"
        type="text"
        autocomplete="cc-name"
        class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 transition placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2D9D8E)]"
      />
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="v3-card-number" class="text-sm font-medium text-slate-700">
        {labels.cardNumber}
      </label>
      <input
        id="v3-card-number"
        name="cardNumber"
        type="text"
        inputmode="numeric"
        autocomplete="cc-number"
        class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 transition placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2D9D8E)]"
      />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div class="flex flex-col gap-1.5">
        <label for="v3-card-expiry" class="text-sm font-medium text-slate-700">
          {labels.expiry}
        </label>
        <input
          id="v3-card-expiry"
          name="cardExpiry"
          type="text"
          inputmode="numeric"
          placeholder="MM/AA"
          autocomplete="cc-exp"
          class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 transition placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2D9D8E)]"
        />
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="v3-card-cvv" class="text-sm font-medium text-slate-700">
          {labels.cvv}
        </label>
        <input
          id="v3-card-cvv"
          name="cardCvv"
          type="text"
          inputmode="numeric"
          autocomplete="cc-csc"
          class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 transition placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2D9D8E)]"
        />
      </div>
    </div>
  </fieldset>
</div>
