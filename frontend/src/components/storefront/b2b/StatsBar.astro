---
/**
 * StatsBar — banda horizontal de estadísticas B2B para Panda Estampados.
 *
 * Patrón Bonfire-style de "cifras destacadas" (sustituye los bullets del
 * hero con datos cuantitativos que refuerzan la propuesta de valor:
 * empresas atendidas, unidades producidas, tiempo de respuesta, % a
 * tiempo). Aparece debajo del TenantHero y abre la composición con un
 * anclaje numérico antes de las categorías.
 *
 * Por qué los `stats` llegan como prop en lugar de hardcoded:
 *   Los números son MOck realistas pero deben reemplazarse cuando el
 *   backend exponga métricas reales (RF-CAT-130 analytics). Mantener
 *   la shape `{ value, label, iconKey }` por stat permite que la página
 *   consuma un fetch futuro sin tocar el componente.
 *
 * Por qué `iconKey: string` y no enum cerrado:
 *   Mismo criterio que `UseCases.astro` (ver doc del componente).
 *   `Icon.astro` fallback a `squares-2x2` para nombres desconocidos.
 *   Panda agrega icons específicos sin necesidad de refactor tipado.
 *
 * Empty-safe: si `stats.length === 0` no se renderiza nada — ni la banda
 * ni el heading. La página decide si mostrar u omitir pasando el array.
 *
 * Tenant-aware: cada stat lleva un color de icono que cae sobre
 * `--primary` (lo resuelve StorefrontLayout por tenant — Panda verde
 * teal #2D9D8E, Kitsune violeta, etc.).
 *
 * Enriquecimiento visual Bonfire (F4.x — sprint visual fidelity):
 *   1 Squiggle decorativa ámbar a la derecha de la banda y stats
 *   más grandes (los números suben a text-4xl/text-5xl en desktop)
 *   para acercarse a la escala tipográfica del sitio de Bonfire
 *   (H1 66-90px, H2 50px) que documenta design-references-bonfire §2.
 *
 * Accesibilidad:
 *   - <section> + aria-labelledby al h2.
 *   - Lista semántica <ul> con <li> por stat.
 *   - Iconos aria-hidden (el label ya transmite la métrica).
 *   - Cada stat usa <dl>/<dt>/<dd> para relacionar número ↔ descripción.
 */
import Icon from '../../ui/Icon.astro';
import Squiggle from '../../ui/Squiggle.astro';

export interface Stat {
  /** Valor numérico formateado (ej. "500+", "10.000+", "24 h", "98%"). */
  value: string;
  /** Etiqueta corta que describe la métrica. */
  label: string;
  /** Nombre que resuelve `Icon.astro`. Fallback: `squares-2x2`. */
  iconKey: string;
}

interface Props {
  heading: string;
  stats: readonly Stat[];
}

const { heading, stats } = Astro.props;
---

{stats.length > 0 && (
  <section
    aria-labelledby="b2b-stats-heading"
    class="relative overflow-hidden border-y border-slate-200 bg-slate-50/60"
  >
    <Squiggle
      variant="wave"
      color="#F6C36F"
      class="pointer-events-none absolute right-4 top-4 hidden h-5 w-40 opacity-30 sm:block"
    />
    <Squiggle
      variant="loop"
      color="#D1C59E"
      class="pointer-events-none absolute right-32 bottom-6 hidden h-10 w-12 opacity-25 md:block"
    />

    <div class="relative mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:py-16">
      <h2
        id="b2b-stats-heading"
        class="text-center text-lg font-semibold text-slate-700 sm:text-xl"
      >
        {heading}
      </h2>
      <ul class="mt-6 grid list-none grid-cols-2 gap-6 p-0 sm:grid-cols-4">
        {stats.map((stat) => (
          <li class="list-none">
            <dl class="flex flex-col items-center gap-2 text-center">
              <dt class="order-2 text-xs font-medium uppercase tracking-wide text-slate-600 sm:text-sm">
                {stat.label}
              </dt>
              <dd class="order-1 flex flex-col items-center gap-2">
                <span
                  aria-hidden="true"
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white shadow-sm sm:h-12 sm:w-12"
                  style="color: var(--primary, #475569);"
                >
                  <Icon name={stat.iconKey} class="h-5 w-5 sm:h-6 sm:w-6" />
                </span>
                <span class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
                  {stat.value}
                </span>
              </dd>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
