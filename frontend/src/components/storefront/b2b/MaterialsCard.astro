---
/**
 * MaterialsCard — card horizontal sobre materiales y tintas para Panda.
 *
 * Patrón Bonfire-style de "sustainability mission card" adaptado al
 * contexto estampado B2B: una card con eyebrow + H2 + body introductorio
 * + lista de 3 features con icono + label + descripción. La card es
 * horizontal a partir de tablet (texto + grid de features lado a lado).
 *
 * Por qué `features` llega como array tipado y no en i18n:
 *   Cada feature es (iconKey, label, description). Aunque las 3 se
 *   localizan, mantener la estructura como dato permite que cada feature
 *   se reuse en otra parte del sitio (ej. ficha de producto) sin tener
 *   que reescribirla como string suelto. La fuente de verdad única de
 *   la lista es el caller; i18n solo tiene las strings.
 *
 * Empty-safe: si features está vacío, no se renderiza la lista de
 * bullets (pero sí el body y el heading). Esto permite degradar la
 * card a una versión sin features si el caller está a media migración.
 *
 * Tenant-aware: el bloque lateral derecho usa un fondo tinte del
 * primary con 8 por ciento de opacidad para mantener el ritmo visual
 * sin competir con el TenantHero.
 *
 * Accesibilidad:
 *   - <section> + aria-labelledby al h2.
 *   - Lista semántica <ul> con <li> por feature (3 features = <li>).
 *   - Iconos aria-hidden (label + description ya transmiten semántica).
 *   - El eyebrow es un <p> con role=presentation o un span semántico.
 */
import Icon from '../../ui/Icon.astro';

export interface MaterialsFeature {
  /** Nombre que resuelve `Icon.astro`. Fallback: squares-2x2. */
  iconKey: string;
  /** Etiqueta del feature (título corto, 2-4 palabras). */
  label: string;
  /** Descripción del feature (1-2 frases). */
  description: string;
}

interface Props {
  heading: string;
  eyebrow: string;
  body: string;
  features: readonly MaterialsFeature[];
}

const { heading, eyebrow, body, features } = Astro.props;
---

<section aria-labelledby="b2b-materials-heading" class="border-t border-slate-200 bg-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-10 rounded-2xl border border-slate-200 bg-slate-50/40 p-6 shadow-sm sm:p-10 lg:grid-cols-5 lg:gap-12">
      <div class="flex flex-col gap-4 lg:col-span-2">
        <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-600 sm:text-sm">
          <span
            aria-hidden="true"
            class="inline-block h-1.5 w-1.5 rounded-full"
            style="background: var(--primary, #475569);"
          />
          {eyebrow}
        </p>
        <h2
          id="b2b-materials-heading"
          class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
        >
          {heading}
        </h2>
        <p class="text-base text-slate-600 sm:text-lg">{body}</p>
      </div>

      {features.length > 0 && (
        <ul class="flex flex-col gap-5 lg:col-span-3">
          {features.map((feature) => (
            <li class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <span
                aria-hidden="true"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                style="background: color-mix(in srgb, var(--primary, #475569) 10%, transparent); color: var(--primary, #475569);"
              >
                <Icon name={feature.iconKey} class="h-5 w-5" />
              </span>
              <div class="flex flex-1 flex-col gap-1">
                <span class="text-base font-semibold text-slate-900">{feature.label}</span>
                <span class="text-sm text-slate-600 sm:text-base">{feature.description}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
