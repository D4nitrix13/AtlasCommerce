---
/**
 * TenantHero — Hero B2B estilo Bonfire para Panda Estampados.
 *
 * Diferencia con HeroBanner (B2C Kitsune): copy B2B operativo, sin
 * emoción otaku. Accent usa `var(--primary)` que Panda resuelve a
 * teal #2D9D8E vía StorefrontLayout.
 *
 * Patrón Bonfire (design-references-bonfire §4):
 *   Fondo crema neutro en lugar de gradient emerald, H1 masivo
 *   centrado con tracking apretado y line-height 1.05, eyebrow pill
 *   oscuro a la izquierda de un trending link, subtítulo grande
 *   acotado a max-width 2xl, y decorativos del catálogo Bonfire — un
 *   Squiggle ámbar en la esquina superior izquierda, otro abajo a
 *   la derecha, dos Blobs (menta y melocotón) detrás del copy, y tres
 *   ProductMockup flotando alrededor del H1 con rotaciones del rango
 *   Bonfire (-8° a +12°). En mobile/tablet el hero es copy full-width
 *   sin decorativos ni mockups flotando para respetar mobile-first.
 *
 * API: la firma no cambia respecto al sprint anterior — recibe las
 * mismas props (eyebrow, title, subtitle, primaryCta, secondaryCta,
 * bullets) para no romper el contrato con index.astro. Las props
 * eyebrow y bullets no se renderizan: el H1 más los CTAs cubren el
 * espacio que antes ocupaban los bullets, y el eyebrow pill Bonfire
 * viene de la nueva clave i18n `exploreLabel`. Mantener las props
 * evita migración y deja la puerta abierta a cambios futuros.
 *
 * Accesibilidad:
 *  - <section> con aria-labelledby apuntando al H1.
 *  - Eyebrow pill es <span> decorativo con aria-hidden para no
 *    duplicar contenido (ya está implícito en el copy del H1).
 *  - Decorativos (Squiggle, Blob, ProductMockup) son aria-hidden
 *    en su primitive y pointer-events-none para no romper clicks.
 *  - El trending link es <a> real con href a /products, navegable
 *    con teclado y focus-visible destacado con el accent teal.
 */
import Blob from '../../ui/Blob.astro';
import Squiggle from '../../ui/Squiggle.astro';
import ProductMockup from '../../ui/ProductMockup.astro';
import { getServerDictionary } from '../../../i18n/server';

interface HeroBullet {
  /** Solo decorativo — no se renderiza en este sprint pero se conserva
   *  en la API para no romper el contrato con index.astro. */
  icon: string;
  text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  bullets: readonly HeroBullet[];
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);
const productsHref = `/${Astro.locals.locale}/products`;
const exploreLabel = t['storefront.b2b.home.hero.exploreLabel'];
const trendingLabel = t['storefront.b2b.home.hero.trendingLabel'];
---

<section
  aria-labelledby="tenant-hero-heading"
  class="shop-hero relative overflow-hidden py-16 sm:py-20 lg:py-28"
>
  {/* Decorativos detrás del copy — Solo desktop. Los primitives ya
      traen aria-hidden y pointer-events-none; el caller añade hidden
      lg:block para colapsarlos en mobile/tablet. */}
  <Squiggle
    variant="wave"
    class="absolute top-12 left-8 w-24 rotate-[-8deg] opacity-50 hidden lg:block"
  />
  <Squiggle
    variant="wave"
    class="absolute bottom-16 right-16 w-32 rotate-[12deg] opacity-50 hidden lg:block"
  />
  <Blob
    color="mint"
    class="absolute top-1/4 left-0 -translate-x-1/2 w-72 h-72 opacity-30 hidden lg:block"
  />
  <Blob
    color="peach"
    class="absolute bottom-0 right-0 translate-x-1/4 w-96 h-96 opacity-25 hidden lg:block"
  />

  {/* Container full-width con padding lateral progresivo (mismo ritmo
      que header/footer). relative para anclar los mockups flotantes. */}
  <div class="relative w-full px-4 sm:px-6 lg:px-10">
    {/* Bloque de copy: en desktop se centra el texto para que el H1
        masivo no pierda legibilidad por el ancho completo. */}
    <div class="lg:text-center">
      {/* Eyebrow pill + trending link. El pill es aria-hidden porque
          su contenido (Explorar) ya está implícito en el copy del H1
          y no aporta información nueva — es marca visual. */}
      <div class="flex items-center gap-3 flex-wrap lg:justify-center">
        <span
          aria-hidden="true"
          class="inline-flex items-center gap-2 rounded-full bg-slate-800 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-white"
        >
          {exploreLabel}
        </span>
        <a
          href={productsHref}
          class="inline-flex items-center gap-1 rounded-md text-sm font-medium text-slate-700 transition hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)] focus-visible:ring-offset-2"
        >
          {trendingLabel}
          <span aria-hidden="true">›</span>
        </a>
      </div>

      <h1
        id="tenant-hero-heading"
        class="mt-6 text-5xl leading-[1.02] sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-slate-600 sm:text-xl lg:mx-auto max-w-2xl">
        {subtitle}
      </p>

      {/* CTAs lado a lado. El primario usa el accent teal primario
          del tenant vía var(--primary); el secundario es un outline
          neutro slate para no competir visualmente. */}
      <div class="mt-8 flex flex-wrap items-center gap-3 lg:justify-center">
        <a
          href={primaryCta.href}
          class="inline-flex h-12 items-center justify-center rounded-lg bg-[var(--primary,#2D9D8E)] px-7 text-base font-semibold text-white transition hover:bg-[var(--primary-hover,#258777)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)] focus-visible:ring-offset-2"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex h-12 items-center justify-center rounded-lg border border-slate-300 bg-white px-7 text-base font-semibold text-slate-800 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>

    {/* Mockups flotando alrededor del copy. Solo desktop (lg+).
        Posicionados en los extremos del lienzo para emular el layout
        editorial Bonfire donde las fotos saturan los bordes laterales.
        Tamaño agrandado (h-72 a 80, w-56 a 72) para llenar más espacio. */}
    <ProductMockup
      variant="shirt"
      logoText="Panda"
      class="absolute left-2 top-24 h-72 w-60 rotate-[-8deg] hidden lg:block xl:left-10"
    />
    <ProductMockup
      variant="mug"
      logoText="Panda"
      class="absolute left-44 top-72 h-36 w-36 rotate-[-12deg] hidden lg:block"
    />
    <ProductMockup
      variant="shirt"
      logoText="Panda"
      class="absolute right-2 top-32 h-80 w-64 rotate-[12deg] hidden lg:block xl:right-10"
    />
  </div>
</section>
