---
/**
 * RFQStepper — Stepper horizontal persistente para el flujo RFQ.
 *
 * Patrón B2B (design-refs §7.3):
 *   "Stepper horizontal persistente en top de la página de la
 *    cotización, con tabs por sección."
 *
 * DIFERENCIA con un wizard genérico:
 *   - El stepper es SOLO informativo (los steps reales están abajo
 *     como secciones del form). No maneja estado interno — la página
 *     pasa `currentStep` y el componente solo renderiza.
 *   - Esto permite que el usuario scrollee entre steps sin perder
 *     el contexto de progreso.
 *
 * Estilo Bonfire v3 (mockup 06-rfq):
 *   - El número de steps se deriva de `labels.length` — el componente
 *     ya no está acoplado a un número fijo. Cada step es un círculo +
 *     label visible a la derecha (no debajo).
 *   - `current` / `done` → círculo filled `bg-[var(--primary)]`.
 *   - `upcoming` → círculo blanco con borde slate-300 + texto slate-400.
 *   - Connector horizontal entre steps; `--primary` cuando el step
 *     anterior está completado, slate-200 cuando no.
 *
 * Estados visuales (AGENTS §11):
 *   - current → fondo brand sólido.
 *   - done    → fondo brand sólido + check visible.
 *   - upcoming → gris, sin énfasis.
 *
 * Accesibilidad (AGENTS §17):
 *   - `<nav aria-label>`.
 *   - Estado actual via `aria-current="step"`.
 *   - Label asociado al círculo vía flex sibling.
 *
 * Los labels llegan ya localizados como props — el componente NO
 * consulta i18n. Esto evita acoplamiento y permite reusar el stepper
 * en otros flujos B2B sin tocar este archivo.
 */
interface Props {
  currentStep: number;
  labels: readonly string[];
}

const { currentStep, labels } = Astro.props;

const stepNumbers: readonly number[] = labels.map((_, index) => index + 1);

function isDone(stepNumber: number, current: number): boolean {
  return stepNumber < current;
}

function circleClasses(done: boolean, current: boolean): string {
  if (done || current) {
    return 'border-transparent bg-[var(--primary,#059669)] text-white';
  }
  return 'border-slate-300 bg-white text-slate-400';
}

function labelClasses(done: boolean, current: boolean): string {
  const base = 'hidden text-[15px] font-semibold sm:block';
  if (done) return `${base} text-slate-700`;
  if (current) return `${base} text-slate-900`;
  return `${base} text-slate-500`;
}

function connectorClasses(stepNumber: number, current: number): string {
  return stepNumber < current
    ? 'h-0.5 flex-1 rounded-full bg-[var(--primary,#059669)] transition'
    : 'h-0.5 flex-1 rounded-full bg-slate-200 transition';
}
---

<nav
  aria-label="Pasos de cotización"
  class="mb-8 flex flex-wrap items-center gap-3 sm:flex-nowrap sm:gap-6"
  data-reveal
>
  {stepNumbers.map((stepNumber, index) => {
    const done = isDone(stepNumber, currentStep);
    const current = stepNumber === currentStep;
    const label = labels[index] ?? '';
    const isLast = index === stepNumbers.length - 1;
    return (
      <>
        <div class="flex items-center gap-3">
          <span
            aria-current={current ? 'step' : undefined}
            class:list={[
              'flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 text-sm font-bold transition',
              circleClasses(done, current),
            ]}
          >
            {done ? '\u2713' : stepNumber}
          </span>
          <span class:list={[labelClasses(done, current)]}>{label}</span>
        </div>
        {!isLast && (
          <div
            aria-hidden="true"
            class:list={['h-0.5 flex-1 rounded-full', connectorClasses(stepNumber, currentStep)]}
          />
        )}
      </>
    );
  })}
</nav>