---
/**
 * TierComparator — Tabla comparativa de tiers de volumen (Bonfire mockup 07).
 *
 * Renderiza los 5 tiers canónicos F3.3 (10→0%, 25→5%, 50→12%, 100→20%
 * destacado, 500→35%) como cards lado a lado.
 *
 * Tokens del sistema (`.interface-design/system.md`):
 *   - Card base: `bg-white rounded-2xl border border-[var(--line)]`
 *     + lift whisper shadow + `hover:-translate-y-0.5`.
 *   - Highlight: `border-2 border-[var(--primary)]` + lift fuerte +
 *     badge superior + `lg:-mt-4`.
 *   - Discount badge: rounded-full `bg-[var(--primary-soft)]` en acento
 *     (nunca verde — "Gratis/éxito usa el acento").
 *   - CTA destacado: receta primaria `h-10`; el resto, receta secundaria.
 *   - `data-reveal-stagger` aplica el rise-in escalonado del CSS global.
 *
 * Accesibilidad (AGENTS §17): cada card es `<article>` con `<h3>`, el
 * badge "Más popular" se anuncia antes del título, los beneficios son
 * `<ul>` con `<li>`.
 */
import { formatCurrency } from '../../../lib/formatters';

interface TierFeature {
  /** Ténido un beneficio del tier, ej. "Tracking incluido". */
  label: string;
}

interface TierData {
  /** Cantidad mínima inclusiva del tier. */
  minQuantity: number;
  /** Descuento en porcentaje entero (0, 5, 12, 20, 35). */
  discountPercent: number;
  /** Etiqueta de cantidad, ej. "10+ unidades". */
  quantityLabel: string;
  /** Lista de beneficios incluidos. */
  features: readonly TierFeature[];
  /** Si es el tier destacado. */
  isPopular: boolean;
}

interface Props {
  /** Precio base de referencia para calcular el precio con descuento. */
  basePriceCents: number;
  /** Código de moneda ISO 4217. */
  currency: string;
  /** Etiqueta i18n para el badge del tier destacado. */
  popularBadge: string;
  /** Etiqueta i18n para "Incluye". */
  includesLabel: string;
  /** Etiqueta i18n del CTA de cada card. */
  ctaLabel: string;
  /** Etiqueta "por unidad" que aparece bajo el precio. */
  perUnitLabel: string;
  /** URL del CTA — usualmente /rfq con anchor al tier. */
  ctaHref: string;
  /** Etiqueta que aparece arriba de la grilla (eyebrow). */
  eyebrow: string;
  /** Tiers a renderizar. Si se omite, usa los 5 canónicos F3.3. */
  tiers?: readonly TierData[];
}

const DEFAULT_FEATURES_BASE = [
  { label: 'Producción estándar' },
  { label: 'Soporte por email' },
  { label: 'Pago contra entrega' },
] as const;

const DEFAULT_FEATURES_MID = [
  { label: 'Producción estándar' },
  { label: 'Soporte por email' },
  { label: 'Muestra digital gratis' },
] as const;

const DEFAULT_FEATURES_POPULAR = [
  { label: 'Producción prioritaria' },
  { label: 'Asesor de cuenta dedicado' },
  { label: 'Muestra física gratis' },
  { label: 'Tracking de envío' },
] as const;

const DEFAULT_FEATURES_TOP = [
  { label: 'Línea de producción dedicada' },
  { label: 'Asesor de cuenta dedicado' },
  { label: 'Muestra física gratis' },
  { label: 'NET 30 disponible' },
] as const;

const DEFAULT_TIERS: readonly TierData[] = [
  {
    minQuantity: 10,
    discountPercent: 0,
    quantityLabel: '10+ unidades',
    features: DEFAULT_FEATURES_BASE,
    isPopular: false,
  },
  {
    minQuantity: 25,
    discountPercent: 5,
    quantityLabel: '25+ unidades',
    features: DEFAULT_FEATURES_MID,
    isPopular: false,
  },
  {
    minQuantity: 50,
    discountPercent: 12,
    quantityLabel: '50+ unidades',
    features: DEFAULT_FEATURES_MID,
    isPopular: false,
  },
  {
    minQuantity: 100,
    discountPercent: 20,
    quantityLabel: '100+ unidades',
    features: DEFAULT_FEATURES_POPULAR,
    isPopular: true,
  },
  {
    minQuantity: 500,
    discountPercent: 35,
    quantityLabel: '500+ unidades',
    features: DEFAULT_FEATURES_TOP,
    isPopular: false,
  },
];

const CTA_PRIMARY =
  'inline-flex h-10 w-full items-center justify-center rounded-lg bg-[var(--primary,#2d9d8e)] px-4 text-sm font-semibold text-white transition-transform hover:bg-[var(--primary-hover,#258777)] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2d9d8e)] focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:active:scale-100';

const CTA_SECONDARY =
  'inline-flex h-10 w-full items-center justify-center rounded-lg border border-[var(--line,#e7e5e4)] bg-white text-sm font-semibold text-[var(--ink,#1c1917)] transition-colors hover:border-[var(--primary,#2d9d8e)] hover:text-[var(--primary,#2d9d8e)] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2d9d8e)] focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:active:scale-100';

const {
  basePriceCents,
  currency,
  popularBadge,
  includesLabel,
  ctaLabel,
  perUnitLabel,
  ctaHref,
  eyebrow,
  tiers = DEFAULT_TIERS,
} = Astro.props;

const tierCount = tiers.length;
---

<section aria-labelledby="tier-comparator-heading" class="relative">
  <p class="mx-auto mb-4 inline-flex items-center gap-1.5 rounded-full bg-[var(--ink,#1c1917)] px-3 py-1.5 text-[11px] font-bold uppercase tracking-wide text-white">
    <span aria-hidden="true">★</span>
    {eyebrow}
  </p>

  <h2 id="tier-comparator-heading" class="sr-only">
    Comparativa de tiers por volumen
  </h2>

  <div
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
    data-reveal-stagger
  >
    {tiers.map((tier) => {
      const discountedCents = Math.round(basePriceCents * (1 - tier.discountPercent / 100));
      const priceText = formatCurrency(discountedCents, currency);
      const showDiscountBadge = tier.discountPercent > 0;
      const discountBadgeText = `-${tier.discountPercent}%`;
      const anchorId = `tier-${tier.minQuantity}`;
      const cardHref = `${ctaHref}#${anchorId}`;
      return (
        <article
          id={anchorId}
          class:list={[
            'relative flex flex-col rounded-2xl bg-white p-5 transition-transform hover:-translate-y-0.5 sm:p-6',
            tier.isPopular
              ? 'border-2 border-[var(--primary,#2d9d8e)] shadow-[0_0_0_1px_rgba(45,157,142,0.18),0_2px_4px_-2px_rgba(28,25,23,0.07),0_10px_24px_-10px_rgba(28,25,23,0.12)] lg:-mt-4'
              : 'border border-[var(--line,#e7e5e4)] shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)]',
          ]}
        >
          {tier.isPopular && (
            <span
              class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[var(--primary,#2d9d8e)] px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)]"
              aria-label={popularBadge}
            >
              {popularBadge}
            </span>
          )}

          <header class="mb-4 text-center">
            <h3 class="text-base font-semibold text-[var(--ink,#1c1917)] sm:text-lg">
              {tier.quantityLabel}
            </h3>
            <p class="mt-1 text-[11px] font-medium uppercase tracking-[0.08em] text-[var(--ink,#1c1917)]/55">
              {perUnitLabel}
            </p>
          </header>

          <div class="mb-4 text-center">
            <p
              class:list={[
                'tabular-nums tracking-tight text-[var(--ink,#1c1917)]',
                tier.isPopular
                  ? 'text-3xl font-bold sm:text-4xl'
                  : 'text-2xl font-semibold sm:text-3xl',
              ]}
            >
              {priceText}
            </p>
            {showDiscountBadge ? (
              <span class="mt-2 inline-flex rounded-full bg-[var(--primary-soft,#e6f7f4)] px-2.5 py-0.5 text-xs font-semibold text-[var(--primary,#2d9d8e)]">
                {discountBadgeText}
              </span>
            ) : (
              <span class="mt-2 inline-flex rounded-full bg-[var(--paper-sunken,#e9e4db)] px-2.5 py-0.5 text-xs font-semibold text-[var(--ink,#1c1917)]/60">
                Base
              </span>
            )}
          </div>

          <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.08em] text-[var(--ink,#1c1917)]/55">
            {includesLabel}
          </p>
          <ul class="mb-6 flex-1 space-y-2 text-sm text-[var(--ink,#1c1917)]/75">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-[var(--primary,#2d9d8e)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{feature.label}</span>
              </li>
            ))}
          </ul>

          <a href={cardHref} class={tier.isPopular ? CTA_PRIMARY : CTA_SECONDARY}>
            {ctaLabel}
          </a>
        </article>
      );
    })}
  </div>

  <p class="sr-only">{tierCount} tiers disponibles.</p>
</section>
