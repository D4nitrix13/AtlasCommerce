---
/**
 * PricingCalculator — Calculadora interactiva de bulk order (Bonfire 07).
 *
 * Island de TS (`pricing-calculator.client.ts`) sin React: sincroniza
 * slider ↔ input y reescribe los `data-pricing-*` outputs. El `<form>`
 * lleva `<label for>` + `<output aria-live>` (AGENTS §17).
 * Cálculo (F3.3 v3): total = unit × qty × (1 − d/100); savings = unit ×
 * qty × (d/100). Datos y lógica intactos — solo se estiliza el template.
 *
 * Tokens (system.md): panel-recibo blanco con lift whisper shadow,
 * divisor punteado + total display Fraunces 32px, savings en acento
 * `--primary` (nunca verde).
 */
import { BULK_PRODUCTS, type BulkOrderProduct } from '../../../data/b2b-mock';
import { formatCurrency } from '../../../lib/formatters';

interface TierDiscount {
  /** Cantidad mínima inclusiva donde aplica este descuento. */
  minQuantity: number;
  /** Porcentaje de descuento entero. */
  discountPercent: number;
}

interface Props {
  /** Etiqueta i18n del heading. */
  heading: string;
  /** Etiqueta i18n del campo producto. */
  productLabel: string;
  /** Etiqueta i18n del campo cantidad. */
  quantityLabel: string;
  /** Etiqueta i18n del hint del slider (rango). */
  quantityHint: string;
  /** Etiqueta i18n del precio unitario. */
  unitPriceLabel: string;
  /** Etiqueta i18n del total. */
  totalLabel: string;
  /** Etiqueta i18n del ahorro. */
  savingsLabel: string;
  /** Template i18n del tier aplicado — usa {range} y {discount}. */
  tierLabelTemplate: string;
  /** Etiqueta i18n del CTA final. */
  ctaLabel: string;
  /** URL del CTA — usualmente /rfq. */
  ctaHref: string;
  /** Lista de descuentos. Si se omite, usa los 5 canónicos F3.3. */
  tiers?: readonly TierDiscount[];
  /** Cantidad inicial mostrada al cargar. */
  initialQuantity?: number;
  /** Catálogo a cotizar. Si falta, usa el mock B2B histórico. */
  products?: readonly BulkOrderProduct[];
}

const DEFAULT_TIERS: readonly TierDiscount[] = [
  { minQuantity: 10, discountPercent: 0 },
  { minQuantity: 25, discountPercent: 5 },
  { minQuantity: 50, discountPercent: 12 },
  { minQuantity: 100, discountPercent: 20 },
  { minQuantity: 500, discountPercent: 35 },
];

const QUANTITY_MIN = 10;
const QUANTITY_MAX = 1000;
const QUANTITY_STEP = 1;

function resolveDiscount(quantity: number, tiers: readonly TierDiscount[]): number {
  const matched = [...tiers].reverse().find((tier) => quantity >= tier.minQuantity);
  return matched?.discountPercent ?? 0;
}

function tierRangeLabel(quantity: number, tiers: readonly TierDiscount[]): string {
  const matched = [...tiers].reverse().find((tier) => quantity >= tier.minQuantity);
  if (matched === undefined) return `${QUANTITY_MIN}+`;
  if (matched.minQuantity === 500) return `${matched.minQuantity}+`;
  const next = tiers.find((t) => t.minQuantity > matched.minQuantity);
  if (next === undefined) return `${matched.minQuantity}+`;
  return `${matched.minQuantity}\u2013${next.minQuantity - 1}`;
}

const {
  heading,
  productLabel,
  quantityLabel,
  quantityHint,
  unitPriceLabel,
  totalLabel,
  savingsLabel,
  tierLabelTemplate,
  ctaLabel,
  ctaHref,
  tiers = DEFAULT_TIERS,
  initialQuantity = 50,
  products = BULK_PRODUCTS,
} = Astro.props;
const firstProduct: BulkOrderProduct | undefined = products[0];
if (firstProduct === undefined) {
  throw new Error('PricingCalculator requires at least one BULK_PRODUCTS entry.');
}

const initialUnitPrice = firstProduct.basePriceCents;
const initialDiscount = resolveDiscount(initialQuantity, tiers);
const initialTotal = Math.round(initialUnitPrice * initialQuantity * (1 - initialDiscount / 100));
const initialSavings = Math.round(initialUnitPrice * initialQuantity * (initialDiscount / 100));
const initialTierText = tierRangeLabel(initialQuantity, tiers);
const initialTierDiscountText = initialDiscount === 0 ? '0%' : `-${initialDiscount}%`;

const initialUnitPriceText = formatCurrency(initialUnitPrice, firstProduct.currency);
const initialTotalText = formatCurrency(initialTotal, firstProduct.currency);
const initialSavingsText = formatCurrency(initialSavings, firstProduct.currency);
const initialTierBadgeText = tierLabelTemplate
  .replace('{range}', initialTierText)
  .replace('{discount}', initialTierDiscountText);

const PANEL =
  'rounded-2xl border border-[var(--line,#e7e5e4)] bg-white p-6 shadow-[0_0_0_1px_rgba(0,0,0,0.05),0_1px_2px_-1px_rgba(0,0,0,0.06),0_2px_4px_rgba(0,0,0,0.04)] sm:p-8';
const LABEL = 'mb-1.5 block text-sm font-semibold text-[var(--ink,#1c1917)]';
const INPUT =
  'w-full rounded-lg border border-[var(--line,#e7e5e4)] bg-white px-3 py-2.5 text-sm text-[var(--ink,#1c1917)] focus:border-[var(--primary,#2d9d8e)] focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2d9d8e)]/25';
const CTA =
  'inline-flex h-12 w-full items-center justify-center rounded-lg bg-[var(--primary,#2d9d8e)] px-4 text-sm font-semibold text-white transition-transform hover:bg-[var(--primary-hover,#258777)] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2d9d8e)] focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:active:scale-100';
const VALUE = 'font-medium tabular-nums text-[var(--ink,#1c1917)]';
const SAVINGS = 'font-medium tabular-nums text-[var(--primary,#2d9d8e)]';
const TOTAL_ROW =
  'flex items-baseline justify-between gap-4 border-t border-dashed border-[var(--line,#e7e5e4)] pt-4';
const TOTAL_LABEL = 'text-xs font-medium uppercase tracking-wide text-[var(--ink,#1c1917)]/60';
const TOTAL_VALUE =
  'font-display text-[32px] font-semibold leading-none tracking-tight tabular-nums text-[var(--ink,#1c1917)]';
---

<section aria-labelledby="pricing-calculator-heading" class={PANEL}>
  <h2 id="pricing-calculator-heading" class="text-lg sm:text-xl">
    {heading}
  </h2>

  <form
    class="mt-6 space-y-6"
    data-pricing-calculator
    data-tiers={JSON.stringify(tiers)}
    novalidate
  >
    <div>
      <label for="bulk-product-select" class={LABEL}>
        {productLabel}
      </label>
      <select id="bulk-product-select" name="product" class={INPUT} data-pricing-product>
        {products.map((product) => (
          <option
            value={product.slug}
            data-base-price={product.basePriceCents}
            data-currency={product.currency}
            selected={product.slug === firstProduct.slug}
          >
            {product.name} — {formatCurrency(product.basePriceCents, product.currency)}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="bulk-quantity-slider" class={LABEL}>
        {quantityLabel}
      </label>
      <input
        id="bulk-quantity-slider"
        type="range"
        name="quantity"
        min={QUANTITY_MIN}
        max={QUANTITY_MAX}
        step={QUANTITY_STEP}
        value={initialQuantity}
        class="w-full cursor-pointer accent-[var(--primary,#2d9d8e)]"
        data-pricing-slider
        aria-valuemin={QUANTITY_MIN}
        aria-valuemax={QUANTITY_MAX}
        aria-valuenow={initialQuantity}
      />
      <div
        class="mt-1 flex items-center justify-between text-xs text-[var(--ink,#1c1917)]/45"
        aria-hidden="true"
      >
        <span>{QUANTITY_MIN}</span>
        <span>{QUANTITY_MAX}</span>
      </div>
      <p id="bulk-quantity-hint" class="mt-1 text-xs text-[var(--ink,#1c1917)]/55">
        {quantityHint}
      </p>
    </div>

    <div class="flex items-center gap-3">
      <label for="bulk-quantity-input" class="sr-only">
        {quantityLabel}
      </label>
      <input
        id="bulk-quantity-input"
        type="number"
        name="quantity-text"
        min={QUANTITY_MIN}
        max={QUANTITY_MAX}
        step={QUANTITY_STEP}
        value={initialQuantity}
        class={INPUT}
        data-pricing-input
      />
      <span
        class="shrink-0 rounded-full bg-[var(--primary-soft,#e6f7f4)] px-3 py-1 text-xs font-semibold text-[var(--primary,#2d9d8e)]"
        data-pricing-tier
      >
        {initialTierBadgeText}
      </span>
    </div>

    <dl class="mt-6 space-y-4 border-t border-[var(--line,#e7e5e4)] pt-5 text-sm">
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[var(--ink,#1c1917)]/55">{unitPriceLabel}</dt>
        <dd class={VALUE} data-pricing-unit>
          {initialUnitPriceText}
        </dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[var(--ink,#1c1917)]/55">{savingsLabel}</dt>
        <dd class={SAVINGS} data-pricing-savings>
          {initialSavingsText}
        </dd>
      </div>
      <div class={TOTAL_ROW}>
        <dt class={TOTAL_LABEL}>{totalLabel}</dt>
        <dd class={TOTAL_VALUE} data-pricing-total>
          {initialTotalText}
        </dd>
      </div>
    </dl>

    <output class="sr-only" data-pricing-output aria-live="polite">
      {quantityLabel}: {initialQuantity}. {unitPriceLabel}: {initialUnitPriceText}.{totalLabel}:{' '}
      {initialTotalText}.
    </output>

    <a href={ctaHref} class={CTA}>
      {ctaLabel}
    </a>
  </form>
</section>

<script>
  import '../../../scripts/pricing-calculator.client';
</script>
