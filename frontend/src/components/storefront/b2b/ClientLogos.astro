---
/**
 * ClientLogos — grilla B2B de clientes que estampan con Panda.
 *
 * Patrón Bonfire-style de "trusted by" pero con labels genéricos de
 * rubro en lugar de logos reales (decisión D4 — riesgo legal de usar
 * marcas registradas ajenas sin permiso). El diseño replica el badge
 * de marca de Bonfire: rectángulo blanco con border-radius 16 (r-card),
 * icono en un círculo pequeño en la esquina superior izquierda, label
 * prominente debajo, y sombra azul-fría de 3 capas.
 *
 * Por qué `iconKey: string` y no enum cerrado:
 *   Mismo criterio que StatsBar/ProcessSteps/UseCases. Icon.astro
 *   fallback a squares-2x2 si el nombre no existe, lo que permite
 *   agregar rubros sin refactor tipado.
 *
 * Por qué los logos son data del caller (no i18n): cada label es un
 * rubro genérico cuyo contenido vive mejor como array tipado que
 * como string suelto en el locale. En el futuro vendrá de un
 * endpoint /api/storefront/b2b/clients/featured con el mismo shape.
 *
 * Empty-safe: si logos está vacío no renderiza ni la sección ni el
 * heading. Permitiendo que la página oculte el bloque cuando no hay
 * clientes destacados sin tener que envolver en condicionales.
 *
 * Tenant-aware: el color del icono interior de cada tarjeta usa
 * var(--primary), igual que el resto de componentes b2b/.
 *
 * Accesibilidad:
 *   - <section> + aria-labelledby al h2.
 *   - Lista semántica <ul> con <li> por logo.
 *   - Si el logo tiene href, el <li> envuelve un <a>; si no, queda
 *     solo como card inerte.
 *   - Iconos aria-hidden (el label ya comunica el rubro).
 */
import Icon from '../../ui/Icon.astro';

export interface ClientLogo {
  /** Nombre que resuelve `Icon.astro`. Fallback: squares-2x2. */
  iconKey: string;
  /** Etiqueta de rubro del cliente (Restaurante, Escuela, etc). */
  label: string;
  /** Enlace opcional a landing del vertical o ancla. */
  href?: string;
}

interface Props {
  heading: string;
  subheading?: string;
  logos: readonly ClientLogo[];
}

const { heading, subheading, logos } = Astro.props;
---

{logos.length > 0 && (
  <section aria-labelledby="b2b-clients-heading" class="border-y border-slate-200 bg-white">
    <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
      <header class="mb-8 text-center sm:mb-10">
        <h2
          id="b2b-clients-heading"
          class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
        >
          {heading}
        </h2>
        {subheading && <p class="mt-2 text-base text-slate-600 sm:text-lg">{subheading}</p>}
      </header>

      <ul class="grid list-none grid-cols-2 gap-5 p-0 sm:grid-cols-3 lg:grid-cols-6">
        {logos.map((logo) => {
          // El badge Bonfire-style: rectángulo blanco, radius 16, sombra
          // azul-fría de 3 capas (replicada del design system del doc
          // design-references-bonfire §3) y un inset border slate-200.
          // El icono vive en un círculo 40x40 dentro del badge.
          const badgeContent = (
            <>
              <span
                aria-hidden="true"
                class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-slate-50"
                style="color: var(--primary, #475569);"
              >
                <Icon name={logo.iconKey} class="h-5 w-5" />
              </span>
              <span class="text-sm font-semibold text-slate-800">{logo.label}</span>
            </>
          );

          return (
            <li class="list-none">
              {logo.href ? (
                <a
                  href={logo.href}
                  class="group flex h-full flex-col items-start gap-3 rounded-2xl border border-slate-200 bg-white p-5 text-left transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
                  style="box-shadow: 1px 1px 4px 0 rgba(204,219,240,.2), 2px 2px 8px 0 rgba(204,219,240,.2), 4px 4px 16px 0 rgba(204,219,240,.2), inset 0 0 0 1px rgb(189,202,216);"
                >
                  {badgeContent}
                </a>
              ) : (
                <div
                  class="flex h-full flex-col items-start gap-3 rounded-2xl border border-slate-200 bg-white p-5 text-left"
                  style="box-shadow: 1px 1px 4px 0 rgba(204,219,240,.2), 2px 2px 8px 0 rgba(204,219,240,.2), 4px 4px 16px 0 rgba(204,219,240,.2), inset 0 0 0 1px rgb(189,202,216);"
                >
                  {badgeContent}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
