---
/**
 * MarqueePills — barra de pills animada estilo Bonfire.
 *
 * Replica el marquee horizontal del sitio Bonfire que muestra una
 * secuencia infinita de pills (FUNDRAISERS | CREATORS | SMALL
 * BUSINESSES | CHURCHES | NONPROFITS | ARTISTS | CREATORS | SCHOOLS |
 * POLITICAL MOVEMENTS | FUNDRAISERS | ...). Las pills se desplazan
 * horizontalmente con una animación CSS pura, sin JavaScript.
 *
 * Por qué CSS y no JS:
 *   - Mejor performance: animation-timeline no es necesaria aquí
 *     porque la animación es continua, no ligada al scroll.
 *   - Accesibilidad: prefers-reduced-motion desactiva la animación
 *     automáticamente.
 *   - Simpleza: keyframes CSS evitan requestAnimationFrame y
 *     setInterval.
 *
 * Accesibilidad:
 *   - aria-hidden porque es decorativo.
 *   - prefers-reduced-motion: animation: none.
 *   - role="marquee" para lectores de pantalla que lo entiendan.
 *
 * Props:
 *   - items: array de strings a mostrar. Se duplican para efecto
 *     continuo sin gaps.
 *   - duration: segundos del ciclo completo (default 30).
 *   - direction: 'left' | 'right' (default 'left').
 */
interface Props {
  items: readonly string[];
  duration?: number;
  direction?: 'left' | 'right';
  class?: string;
}

const { items, duration = 30, direction = 'left', class: className = '' } = Astro.props;
const directionKeyframe = direction === 'right' ? 'marquee-right' : 'marquee-left';
---

<div
  class={`relative overflow-hidden py-3 ${className}`}
  role="marquee"
  aria-hidden="true"
>
  <style is:inline>
    {`@keyframes ${directionKeyframe} {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none !important; }
    }
    .marquee-track {
      display: inline-flex;
      gap: 1rem;
      animation: ${directionKeyframe} ${duration}s linear infinite;
      will-change: transform;
    }
    .marquee-track > * { white-space: nowrap; }`}
  </style>
  <div class="marquee-track">
    {/* Duplicar el array para que el loop sea visualmente continuo */}
    {[...items, ...items].map((item) => (
      <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-medium uppercase tracking-wide text-emerald-700">
        {item}
      </span>
    ))}
  </div>
</div>
