---
/**
 * FaqAccordion — accordion accesible de preguntas frecuentes.
 *
 * Patrón Bonfire-style (design-references-bonfire §5): H2 + lista
 * vertical de Q&A colapsables. Usado tanto en la rama B2B Panda
 * (dudas operativas: MOQ, NET 30, lead time) como en futuras
 * composiciones B2C (envíos, devoluciones, garantías).
 *
 * Por qué reubicado a `components/storefront/FaqAccordion.astro`
 * (raíz de storefront) en lugar de quedarse en `b2b/`:
 *   El FAQ no es específico de B2B ni B2C — el patrón visual y la
 *   API son idénticos para cualquier vertical. Moverlo a la raíz
 *   marca el contrato de "componente compartido del storefront" y
 *   evita que la rama B2C duplique el código si quiere adoptarlo
 *   en una iteración futura.
 *
 * Por qué usa <details>/<summary> nativos y no un componente React:
 *   Cero JavaScript, accesibilidad heredada del navegador (focus,
 *   keyboard nav con Enter/Espacio, Escape para cerrar via prevent
 *   nativo del summary), screen reader announce automático. Esto
 *   mantiene la home 100% Astro estática (sin hidratación). Si en el
 *   futuro se necesita acordeón simultáneo (sólo uno abierto a la
 *   vez) o transiciones animadas, se cambia por un componente
 *   interactivo en una fase posterior.
 *
 * Empty-safe: si items está vacío no renderiza ni la sección ni el
 * heading. La página decide cuándo omitir pasando [].
 *
 * Tenant-aware: el botón + del summary usa un círculo slate-700
 * neutro (independiente del accent del tenant) que es el equivalente
 * funcional del teal #415F62 de Bonfire. La fuente queda neutral
 * slate-900 para no competir con el brand.
 *
 * Enriquecimiento visual Bonfire (F4.x — sprint visual fidelity):
 *   el `+` de expand/collapse se pinta en un círculo slate-700 y los
 *   dividers pasan a border-slate-200 para acercarse a la paleta
 *   cream de Bonfire sin abandonar las neutrales del storefront.
 *
 * Accesibilidad (HTML5 <details>/<summary> por defecto):
 *   - Toggle con Enter y Espacio heredado del navegador.
 *   - <summary> es interactivo y anunciable como botón.
 *   - Usamos <h2> para el heading y el id se deriva del prefijo
 *     neutral `faq-heading` (no `b2b-faq-heading`) porque el
 *     componente es shared.
 *   - El id del item se deriva del índice para anclar fragmentos
 *     (#faq-q-3).
 */
export interface FaqItem {
  /** Pregunta (heading interno). */
  question: string;
  /** Respuesta (puede tener saltos de línea). */
  answer: string;
}

interface Props {
  heading: string;
  items: readonly FaqItem[];
}

const { heading, items } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="faq-heading" class="border-t border-slate-200 bg-slate-50/60">
    <div class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
      <h2
        id="faq-heading"
        class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      >
        {heading}
      </h2>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10">
        {items.map((item, index) => (
          <details class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition open:border-slate-300 open:shadow-md">
            <summary
              id={`faq-q-${index}`}
              class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-semibold text-slate-900 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2 sm:px-6 sm:py-5 sm:text-lg"
            >
              <span class="flex-1">{item.question}</span>
              <span
                aria-hidden="true"
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-700 text-white shadow-sm transition group-open:rotate-45"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-3.5 w-3.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                </svg>
              </span>
            </summary>
            <div
              role="region"
              aria-labelledby={`faq-q-${index}`}
              class="border-t border-slate-200 px-5 py-4 text-sm leading-relaxed text-slate-700 sm:px-6 sm:py-5 sm:text-base"
            >
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
