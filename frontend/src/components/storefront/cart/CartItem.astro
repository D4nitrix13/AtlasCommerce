---
/**
 * CartItem — fila de un producto dentro del carrito.
 *
 * Layout B2C standard (Baymard §5.2): imagen cuadrada + título +
 * controles de cantidad + precio unitario + subtotal de la fila +
 * botón eliminar.
 *
 * Sin handlers: el botón "Eliminar" y los botones de cantidad son
 * placeholders hasta que se hidrate el cart store (out-of-scope F1.4).
 * El componente expone el `data-*` necesario para que el store
 * futuro pueda delegar sin cambiar este UI.
 *
 * Accesibilidad:
 *  - Inputs con label asociado (`aria-label`).
 *  - Botones reales con `type="button"` (no `<div onclick>`).
 *  - Cantidad anunciada a screen readers con `aria-live="polite"` en
 *    el readout.
 */
import { formatCurrency } from '../../../lib/formatters';

export interface CartItemData {
  id: number;
  slug: string;
  name: string;
  imageUrl: string;
  priceCents: number;
  currency?: string;
  quantity: number;
  maxQuantity?: number;
}

export interface CartItemLabels {
  remove: string;
  decrement: string;
  increment: string;
  qty: string;
}

interface Props {
  item: CartItemData;
  locale: string;
  labels: CartItemLabels;
}

const { item, locale, labels } = Astro.props;

const detailHref = `/${locale}/products/${item.slug}`;
const currencyCode = item.currency ?? 'USD';
const unitPriceFormatted = formatCurrency(item.priceCents, currencyCode);
const lineTotalCents = item.priceCents * item.quantity;
const lineTotalFormatted = formatCurrency(lineTotalCents, currencyCode);
const max = item.maxQuantity ?? 99;
const min = 1;
---

<article
  class="flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center"
  data-cart-item-id={item.id}
>
  <a
    href={detailHref}
    class="relative block h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-slate-50 sm:h-28 sm:w-28"
    aria-label={item.name}
  >
    <img
      src={item.imageUrl}
      alt={item.name}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  </a>

  <div class="flex flex-1 flex-col gap-1">
    <h3 class="text-sm font-semibold text-slate-900">
      <a
        href={detailHref}
        class="transition hover:text-[var(--primary,#475569)] focus:outline-none focus-visible:underline"
      >
        {item.name}
      </a>
    </h3>
    <p class="text-xs text-slate-500">{unitPriceFormatted}</p>

    <div class="mt-2 flex items-center gap-2">
      <span class="text-xs font-medium text-slate-600">{labels.qty}:</span>
      <div class="inline-flex items-center overflow-hidden rounded-lg border border-slate-200">
        <button
          type="button"
          aria-label={labels.decrement}
          data-cart-action="decrement"
          data-item-id={item.id}
          disabled={item.quantity <= min}
          class="flex h-8 w-8 items-center justify-center text-slate-600 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span aria-hidden="true">−</span>
        </button>
        <span
          class="flex h-8 min-w-[2.5rem] items-center justify-center border-x border-slate-200 px-2 text-sm font-medium tabular-nums text-slate-900"
          aria-live="polite"
          data-cart-qty={item.id}
        >
          {item.quantity}
        </span>
        <button
          type="button"
          aria-label={labels.increment}
          data-cart-action="increment"
          data-item-id={item.id}
          disabled={item.quantity >= max}
          class="flex h-8 w-8 items-center justify-center text-slate-600 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <span aria-hidden="true">+</span>
        </button>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between gap-3 sm:flex-col sm:items-end sm:justify-center">
    <span class="text-base font-bold tabular-nums text-slate-900">{lineTotalFormatted}</span>
    <button
      type="button"
      aria-label={labels.remove}
      data-cart-action="remove"
      data-item-id={item.id}
      class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium text-slate-500 transition hover:bg-red-50 hover:text-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400"
    >
      <span aria-hidden="true">×</span>
      <span>{labels.remove}</span>
    </button>
  </div>
</article>
