---
/**
 * CtaBanner — banda full-width de cierre de la composición B2C.
 *
 * Toma el rol de "banner de llamada a la acción" final que en la home
 * de Bonfire antecede al footer. Fondo accent del tenant (vía
 * `--primary`), texto blanco, H2 centrado y un único botón CTA.
 *
 * Por qué fondo accent sin prop de color:
 *   Mantiene el patrón tenant-aware del proyecto: el caller no elige
 *   color — lo resuelve `StorefrontLayout.astro` desde la config del
 *   tenant. Esto evita que una variante de tenant olvide pasar el
 *   accent y termine con un color por defecto inconsistente.
 *
 * Accesibilidad:
 *   - <section> + aria-labelledby al h2.
 *   - CTA es `<a>` (navegación), no `<button>`.
 *   - H2 mantiene la jerarquía semántica (h1 = hero, h2 = secciones).
 *   - Focus visible con outline que contrasta con el accent usando
 *     `outline-color: var(--primary)` y `outline` blanco externo para
 *     garantizar contraste AA sobre cualquier accent.
 */
interface Props {
  heading: string;
  ctaLabel: string;
  ctaHref: string;
}

const { heading, ctaLabel, ctaHref } = Astro.props;
---

<section
  aria-labelledby="cta-banner-heading"
  class="w-full"
  style="background: var(--primary, #475569);"
>
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-6 sm:py-16 lg:py-20">
    <h2
      id="cta-banner-heading"
      class="max-w-3xl text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl"
    >
      {heading}
    </h2>

    <a
      href={ctaHref}
      class="inline-flex h-12 items-center justify-center rounded-lg bg-white px-7 text-sm font-semibold text-slate-900 transition hover:bg-slate-100 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      {ctaLabel}
    </a>
  </div>
</section>