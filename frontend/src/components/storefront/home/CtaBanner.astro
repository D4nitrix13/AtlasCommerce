---
/**
 * CtaBanner — banda full-width de cierre de la composición B2C.
 *
 * Toma el rol de "banner de llamada a la acción" final que en la home
 * de Bonfire antecede al footer. Fondo oscuro derivado del accent del
 * tenant (color-mix sobre tinta), texto blanco, H2 centrado y un único
 * botón CTA outline blanco.
 *
 * Por qué un oscuro derivado del accent y no un charcoal fijo:
 *   La banda debe heredar el color de la tienda sin perder contraste
 *   AA con el texto blanco. Mezclar el accent con tinta (`#1c1917`)
 *   mantiene el fondo siempre oscuro, cualquiera sea el accent del
 *   tenant, y crea ritmo narrativo: dos pausas oscuras (DarkHeroCard a
 *   mitad de página + este banner al final) con secciones claras
 *   entremedias.
 *
 * Enriquecimiento visual Bonfire (sprint visual fidelity B2C):
 *   Squiggle ámbar decorativa flotando sobre la sección, mismo
 *   lenguaje que las otras secciones. Sin nuevos props: el Squiggle
 *   vive dentro del section.
 *
 * Accesibilidad:
 *   - <section> + aria-labelledby al h2.
 *   - CTA es `<a>` (navegación), no `<button>`.
 *   - H2 mantiene la jerarquía semántica (h1 = hero, h2 = secciones).
 *   - Focus visible con outline blanco externo para garantizar
 *     contraste AA sobre el fondo charcoal.
 *   - Squiggle decorativa con aria-hidden.
 */
import Squiggle from '../../ui/Squiggle.astro';

interface Props {
  heading: string;
  ctaLabel: string;
  ctaHref: string;
}

const { heading, ctaLabel, ctaHref } = Astro.props;
---

<section
  aria-labelledby="cta-banner-heading"
  class="relative w-full overflow-hidden bg-[color-mix(in_srgb,var(--primary)_30%,#1c1917)]"
>
  <Squiggle
    variant="loop"
    color="var(--primary-soft)"
    class="pointer-events-none absolute left-8 top-8 h-12 w-12 opacity-40"
  />
  <Squiggle
    variant="arc"
    color="var(--primary-soft)"
    class="pointer-events-none absolute bottom-10 right-12 hidden h-3 w-20 opacity-50 md:block"
  />

  <div class="relative flex w-full flex-col items-center gap-6 px-4 py-12 text-center sm:px-6 sm:py-16 lg:px-10 lg:py-20">
    <h2
      id="cta-banner-heading"
      class="max-w-3xl text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl"
    >
      {heading}
    </h2>

    <a
      href={ctaHref}
      class="inline-flex h-12 items-center justify-center rounded-2xl border-2 border-white bg-transparent px-7 text-sm font-semibold text-white transition hover:bg-white hover:text-slate-900 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      {ctaLabel}
    </a>
  </div>
</section>
