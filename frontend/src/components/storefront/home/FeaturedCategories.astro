---
/**
 * FeaturedCategories — grid de categorías destacadas para la home.
 *
 * Típico patrón home B2C (Baymard §5.2): 3-4 cards grandes con imagen
 * representativa + label. Sin carrusel (anti-pattern §8.1).
 *
 * Tenant-aware: el accent del hover usa `--primary`. El grid colapsa a
 * 2 cols en mobile, 4 en desktop.
 *
 * Enriquecimiento visual Bonfire (sprint visual fidelity B2C):
 *   - Sombra azul-fría de tres capas con inset, replicando la sombra
 *     custom de Bonfire (rgba 204,219,240,.2 + rgb 189,202,216). Se
 *     aplica via `style` inline porque Tailwind no mapea
 *     box-shadow tan específico.
 *   - Squiggle ámbar decorativa en la esquina superior derecha del
 *     header de sección, detrás del heading.
 *   - Mantiene API pública intacta: las sombras y el squiggle son
 *     aditivos, no rompen contratos.
 */
import type { Category } from '../../../types/catalog';
import Squiggle from '../../ui/Squiggle.astro';

interface Props {
  categories: readonly Category[];
  heading: string;
  viewAllLabel: string;
  viewAllHref: string;
}

const { categories, heading, viewAllLabel, viewAllHref } = Astro.props;
---

<section aria-label={heading} class="relative mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
  <header class="relative mb-8 flex items-end justify-between gap-4">
    <Squiggle
      variant="arc"
      color="#F6C36F"
      class="pointer-events-none absolute -right-2 -top-3 hidden h-3 w-14 opacity-70 sm:block"
    />
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{heading}</h2>
    <a
      href={viewAllHref}
      class="inline-flex items-center gap-1 text-sm font-medium text-[var(--primary,#475569)] transition hover:underline focus:outline-none focus-visible:underline"
    >
      {viewAllLabel}
      <span aria-hidden="true">→</span>
    </a>
  </header>

  <ul class="grid list-none grid-cols-2 gap-4 p-0 sm:grid-cols-3 lg:grid-cols-4">
    {categories.map((category) => (
      <li class="list-none">
        <a
          href={category.href}
          class="group relative flex aspect-square flex-col justify-end overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-slate-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2"
          style="box-shadow: 1px 1px 4px 0 rgba(204,219,240,.2), 2px 2px 8px 0 rgba(204,219,240,.2), 4px 4px 16px 0 rgba(204,219,240,.2), inset 0 0 0 1px rgb(189,202,216);"
        >
          <img
            src={category.imageUrl}
            alt=""
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-90 transition group-hover:scale-105 group-hover:opacity-100"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-slate-900/10 to-transparent" />
          <span class="relative z-10 p-4 text-base font-bold text-white sm:text-lg">
            {category.name}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
