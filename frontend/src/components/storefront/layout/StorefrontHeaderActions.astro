---
/**
 * StorefrontHeaderActions — cluster derecho del header (solo iconos +
 * una pill).
 *
 * Composición de izquierda a derecha: search pill (lg+; debajo de lg
 * se colapsa a un icono-link), CTA Cotizar (compacto, solo Panda),
 * iconos wishlist / cuenta / carrito (badge con `cartCount`), y el
 * toggle de locale `ES | EN`.
 *
 * El locale switcher es React (navegación dinámica); lo hidratamos
 * con `client:load`. El badge del carrito es server-rendered.
 */
import LanguageSwitcher from '../../ui/LanguageSwitcher';
import { getServerDictionary } from '../../../i18n/server';
import Icon from '../../ui/Icon.astro';

interface Props {
  searchHref: string;
  searchLabel: string;
  searchPlaceholder: string;
  accountHref: string;
  wishlistHref: string;
  wishlistLabel: string;
  cartHref: string;
  cartCount: number;
  rfqHref: string;
  rfqLabel: string;
  localeLabel: string;
  showQuote: boolean;
}

const {
  searchHref,
  searchLabel,
  searchPlaceholder,
  accountHref,
  wishlistHref,
  wishlistLabel,
  cartHref,
  cartCount,
  rfqHref,
  rfqLabel,
  localeLabel,
  showQuote,
} = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const hasItemsInCart = cartCount > 0;
const cartLabel = hasItemsInCart
  ? t['storefront.header.cartBadge'].replace('{count}', String(cartCount))
  : t['storefront.header.nav.cart'];
const accountLabel = t['storefront.header.nav.account'];

const iconLinkClasses =
  'inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 hover:text-[var(--primary,#2D9D8E)] active:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)]';
---

<div class="flex shrink-0 items-center gap-1 sm:gap-1.5">
  {/* Search pill (lg+): angosto, redondeado, lupa a la izquierda. */}
  <form action={searchHref} method="get" role="search" class="hidden lg:flex">
    <label class="relative block w-40 xl:w-64">
      <span class="sr-only">{searchLabel}</span>
      <Icon
        name="magnifying-glass"
        class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
      />
      <input
        name="q"
        type="search"
        autocomplete="off"
        placeholder={searchPlaceholder}
        class="h-10 w-full rounded-full border border-[var(--line,#e7e5e4)] bg-white/70 pl-10 pr-4 text-sm text-[var(--ink,#1c1917)] placeholder:text-stone-400 transition focus:border-transparent focus:bg-white focus:outline-none focus:ring-2 focus:ring-[var(--primary,#2D9D8E)]"
      />
    </label>
  </form>

  {/* Search como icono-link por debajo de lg (mobile y tablet). */}
  <a href={searchHref} aria-label={searchLabel} class={`${iconLinkClasses} lg:hidden`}>
    <Icon name="magnifying-glass" class="h-5 w-5" />
  </a>

  {/* CTA Cotizar (solo Panda): pill primaria compacta. */}
  {
    showQuote && (
      <a
        href={rfqHref}
        class="ml-1 hidden h-10 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-[var(--primary,#2D9D8E)] px-4 text-sm font-semibold text-white transition hover:bg-[var(--primary-hover,#258777)] active:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)] focus-visible:ring-offset-2 lg:inline-flex"
      >
        {rfqLabel}
      </a>
    )
  }

  <a
    href={wishlistHref}
    aria-label={wishlistLabel}
    class={`${iconLinkClasses} ml-1 hidden md:inline-flex`}
  >
    <Icon name="heart" class="h-5 w-5" />
  </a>

  <a href={accountHref} aria-label={accountLabel} class={`${iconLinkClasses} hidden md:inline-flex`}>
    <Icon name="user" class="h-5 w-5" />
  </a>

  <a href={cartHref} aria-label={cartLabel} class={`${iconLinkClasses} relative`}>
    <Icon name="shopping-bag" class="h-5 w-5" />
    {
      hasItemsInCart && (
        <span
          aria-hidden="true"
          class="absolute -right-0.5 -top-0.5 inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-[var(--primary,#2D9D8E)] px-1 text-[10px] font-semibold tabular-nums leading-none text-white"
        >
          {cartCount > 99 ? '99+' : cartCount}
        </span>
      )
    }
  </a>

  <div role="group" aria-label={localeLabel} class="hidden md:flex">
    <LanguageSwitcher client:load variant="compact" theme="light" />
  </div>
</div>
