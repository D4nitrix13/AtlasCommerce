---
/**
 * StorefrontFooterLegal — bloque legal inferior del footer.
 *
 * Copyright. El email de soporte vive en la columna de contacto del
 * footer; acá queda solo la línea legal. El año se computa en SSR
 * (`new Date()`) para que sea estable entre el server render y el
 * client render (sin mismatch de hidratación).
 *
 * El borde superior lo pone el contenedor del footer (`mt-8 border-t`),
 * no este componente, para no dibujar dos líneas seguidas.
 */
import type { StoreBrand } from '../../../config/stores';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  brand: StoreBrand;
  locale: string;
}

const { brand, locale } = Astro.props;
const t = getServerDictionary(locale);

const currentYear = new Date().getFullYear();
const copyright = t['storefront.footer.copyright']
  .replace('{year}', String(currentYear))
  .replace('{brand}', brand.name);
---

<p class="text-xs text-slate-500">{copyright}</p>
