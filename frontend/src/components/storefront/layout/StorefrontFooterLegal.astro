---
/**
 * StorefrontFooterLegal — bloque legal del footer.
 *
 * Copyright + email de soporte. El año se computa en SSR (`new Date()`)
 * para que sea estable entre el server render y el client render (sin
 * mismatch de hidratación).
 */
import type { StoreBrand } from '../../../config/stores';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  brand: StoreBrand;
  locale: string;
}

const { brand, locale } = Astro.props;
const t = getServerDictionary(locale);

const currentYear = new Date().getFullYear();
const copyright = t['storefront.footer.copyright']
  .replace('{year}', String(currentYear))
  .replace('{brand}', brand.name);
---

<div class="flex flex-col items-start justify-between gap-2 border-t border-slate-200 pt-6 sm:flex-row sm:items-center">
  <p class="text-xs text-slate-500">{copyright}</p>
  <a
    href={`mailto:${brand.supportEmail}`}
    class="text-xs text-slate-500 transition hover:text-[var(--primary,#1e293b)]"
  >
    {brand.supportEmail}
  </a>
</div>
