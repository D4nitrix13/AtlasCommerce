---
/**
 * StorefrontHeader — header principal de la tienda, estilo Nike.
 *
 * Fila única full-bleed (`w-full`, sin `max-w-*`): brand a la
 * izquierda, links de nav limpios al centro, y a la derecha search
 * pill + iconos (wishlist, cuenta, carrito) + toggle de locale.
 * Sticky, con borde inferior sutil. El accent del tenant (Panda teal,
 * Kitsune violeta, …) llega vía `var(--primary)` setteado por
 * StorefrontLayout.
 *
 * Mobile (< md): hamburguesa + iconos esenciales (search, carrito);
 * el resto (cuenta, wishlist, Cotizar, idioma) colapsa al menú.
 *
 * Accesibilidad:
 *  - <header> semántico.
 *  - Nav con aria-label="Principal".
 *  - Search input con <label class="sr-only">.
 *  - Icon-only links con aria-label descriptivo; badge del carrito
 *    anunciado vía `storefront.header.cartBadge` en el link.
 */
import type { StoreBrand } from '../../../config/stores';
import { getServerDictionary } from '../../../i18n/server';
import LanguageSwitcher from '../../ui/LanguageSwitcher';
import StorefrontHeaderBrand from './StorefrontHeaderBrand.astro';
import StorefrontHeaderNav from './StorefrontHeaderNav.astro';
import StorefrontHeaderActions from './StorefrontHeaderActions.astro';

interface Props {
  brand: StoreBrand;
  locale: string;
  cartCount: number;
}

const { brand, locale, cartCount } = Astro.props;
const t = getServerDictionary(locale);

const homeHref = `/${locale}`;
const productsHref = `/${locale}/products`;
const searchHref = `/${locale}/search`;
const rfqHref = `/${locale}/rfq`;
const accountHref = `/${locale}/account`;
const wishlistHref = `/${locale}/account/wishlist`;
const cartHref = `/${locale}/cart`;

const navLinks = [
  { labelKey: 'storefront.header.nav.home' as const, href: homeHref },
  {
    labelKey: 'storefront.header.nav.products' as const,
    href: productsHref,
    matchPrefix: productsHref,
  },
];

const showQuote = brand.slug === 'panda-estampados';
---

<header
  class="sticky top-0 z-30 w-full border-b border-[var(--line,#e7e5e4)] bg-[var(--paper,#f3efe8)]/90 backdrop-blur supports-[backdrop-filter]:bg-[var(--paper,#f3efe8)]/80"
>
  {/* Fila única: flex en mobile (hamburguesa pegada a las acciones) y
      grid 1fr/auto/1fr desde md para que el nav quede centrado de
      verdad, con brand al inicio y acciones al final. */}
  <div class="flex h-16 w-full flex-nowrap items-center gap-2 px-4 sm:px-6 md:grid md:grid-cols-[1fr_auto_1fr] lg:gap-6 lg:px-10">
    <StorefrontHeaderBrand brand={brand} homeHref={homeHref} />

    <StorefrontHeaderNav
      links={navLinks}
      openMenuLabel={t['storefront.header.openMenu']}
      closeMenuLabel={t['storefront.header.closeMenu']}
    >
      <Fragment slot="mobile-extras">
        <li class="mt-1 border-t border-[var(--line,#e7e5e4)] pt-1">
          <a
            href={accountHref}
            class="block rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-[var(--primary,#2D9D8E)]"
          >
            {t['storefront.header.nav.account']}
          </a>
        </li>
        <li>
          <a
            href={wishlistHref}
            class="block rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-[var(--primary,#2D9D8E)]"
          >
            {t['storefront.header.wishlistLabel']}
          </a>
        </li>
        {showQuote && (
          <li>
            <a
              href={rfqHref}
              class="block rounded-md px-3 py-2.5 text-sm font-semibold text-[var(--primary,#2D9D8E)] transition hover:bg-slate-100"
            >
              {t['storefront.header.ctaCotizar']}
            </a>
          </li>
        )}
        <li class="mt-1 border-t border-[var(--line,#e7e5e4)] px-3 py-2">
          <div role="group" aria-label={t['storefront.header.localeLabel']}>
            <LanguageSwitcher client:load variant="compact" theme="light" />
          </div>
        </li>
      </Fragment>
    </StorefrontHeaderNav>

    <StorefrontHeaderActions
      searchHref={searchHref}
      searchLabel={t['storefront.header.searchLabel']}
      searchPlaceholder={t['storefront.header.searchPlaceholder']}
      accountHref={accountHref}
      wishlistHref={wishlistHref}
      wishlistLabel={t['storefront.header.wishlistLabel']}
      cartHref={cartHref}
      cartCount={cartCount}
      rfqHref={rfqHref}
      rfqLabel={t['storefront.header.ctaCotizar']}
      localeLabel={t['storefront.header.localeLabel']}
      showQuote={showQuote}
    />
  </div>
</header>
