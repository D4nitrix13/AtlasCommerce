---
/**
 * StorefrontHeader — header principal de la tienda.
 *
 * Composición: brand (izquierda) + nav (centro) + actions (derecha).
 * Es sticky en top para mantener la nav visible al hacer scroll, y
 * aplica un borde sutil inferior para separarse del contenido.
 *
 * El header es tenant-aware: recibe `brand` del layout padre (que lo
 * resuelve vía `getBrandBySlug`). El cartCount también lo pasa el
 * layout (hoy hardcoded a 0; el estado del carrito se hidratará en F1.4).
 *
 * Accesibilidad:
 *  - `<header>` semántico.
 *  - nav con aria-label="Principal".
 *  - cart link con aria-label descriptivo cuando hay items.
 */
import type { StoreBrand } from '../../../config/stores';
import { getServerDictionary } from '../../../i18n/server';
import StorefrontHeaderBrand from './StorefrontHeaderBrand.astro';
import StorefrontHeaderNav from './StorefrontHeaderNav.astro';
import StorefrontHeaderActions from './StorefrontHeaderActions.astro';

interface Props {
  brand: StoreBrand;
  locale: string;
  cartCount: number;
}

const { brand, locale, cartCount } = Astro.props;
const t = getServerDictionary(locale);

const homeHref = `/${locale}`;
const productsHref = `/${locale}/products`;
const searchHref = `/${locale}/search`;
const accountHref = `/${locale}/account`;
const cartHref = `/${locale}/cart`;

const navLinks = [
  { labelKey: 'storefront.header.nav.home' as const, href: homeHref },
  { labelKey: 'storefront.header.nav.products' as const, href: productsHref, matchPrefix: productsHref },
  { labelKey: 'storefront.header.nav.search' as const, href: searchHref, matchPrefix: searchHref },
];
---

<header
  class="sticky top-0 z-30 w-full border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <StorefrontHeaderBrand brand={brand} homeHref={homeHref} />
      <StorefrontHeaderNav
        links={navLinks}
        openMenuLabel={t['storefront.header.openMenu']}
        closeMenuLabel={t['storefront.header.closeMenu']}
      />
    </div>

    <StorefrontHeaderActions
      cartHref={cartHref}
      accountHref={accountHref}
      cartCount={cartCount}
    />
  </div>
</header>
