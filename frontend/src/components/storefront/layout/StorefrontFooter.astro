---
/**
 * StorefrontFooter — footer principal de la tienda.
 *
 * Composición en grid de 3 columnas estilo Bonfire:
 *   - Columna izquierda: brand + tagline
 *   - Columna central: nav secundaria con los links legales / info
 *   - Columna derecha: contacto (soporte email + locale)
 *
 * El footer es semántico (`<footer>`) y vive dentro del `<body>` para
 * que los lectores de pantalla lo identifiquen como landmark "content
 * information". Tenant-aware: el color de hover sobre los links usa
 * `var(--primary)` del theme.
 */
import type { StoreBrand } from '../../../config/stores';
import StorefrontFooterNav from './StorefrontFooterNav.astro';
import StorefrontFooterLegal from './StorefrontFooterLegal.astro';
import SocialIcon from './SocialIcon.astro';

interface FooterLink {
  labelKey:
    | 'storefront.footer.about'
    | 'storefront.footer.terms'
    | 'storefront.footer.privacy'
    | 'storefront.footer.help'
    | 'storefront.footer.contact';
  href: string;
}

interface Props {
  brand: StoreBrand;
  locale: string;
  links?: FooterLink[];
}

const { brand, locale, links } = Astro.props;

const defaultLinks: FooterLink[] = [
  { labelKey: 'storefront.footer.about', href: '#' },
  { labelKey: 'storefront.footer.terms', href: '#' },
  { labelKey: 'storefront.footer.privacy', href: '#' },
  { labelKey: 'storefront.footer.help', href: '#' },
  { labelKey: 'storefront.footer.contact', href: '#' },
];

const navLinks = links ?? defaultLinks;
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto w-full max-w-[1280px] px-4 py-10 sm:px-6 lg:px-10">
    {/* Grid 3 columnas: brand | nav | contact. En mobile stack vertical. */}
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-12">
      {/* Columna 1: brand */}
      <div class="flex flex-col gap-2">
        <p class="text-base font-semibold tracking-tight text-slate-900">
          {brand.name}
        </p>
        <p class="text-sm text-slate-500">
          {brand.shortName} — hecho con cuidado.
        </p>
      </div>

      {/* Columna 2: nav links */}
      <div class="md:mx-auto">
        <StorefrontFooterNav links={navLinks} locale={locale} />
      </div>

      {/* Columna 3: contacto + locale */}
      <div class="flex flex-col gap-3 md:items-end md:text-right">
        <p class="text-xs uppercase tracking-wide text-slate-500">
          {locale === 'es' ? 'Español' : 'English'}
        </p>
        <div class="flex items-center gap-2 md:justify-end" aria-label="Redes sociales">
          <SocialIcon variant="facebook" />
          <SocialIcon variant="instagram" />
          <SocialIcon variant="tiktok" />
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-slate-200 pt-6">
      <StorefrontFooterLegal brand={brand} locale={locale} />
    </div>
  </div>
</footer>
