---
/**
 * StorefrontFooter — footer principal de la tienda.
 *
 * Full-bleed como el header: sin `mx-auto max-w-*`, con el mismo ritmo
 * de padding (`px-4 sm:px-6 lg:px-10`). El ancho extra de pantallas
 * anchas se reparte en el grid en vez de quedar como aire a los
 * costados de un contenedor centrado de 1280px.
 *
 * Columnas: brand + tagline | nav legal | contacto | redes + locale.
 * En mobile stack vertical, en md 2 columnas, en lg 4.
 *
 * El footer es semántico (`<footer>`) y vive dentro del `<body>` para
 * que los lectores de pantalla lo identifiquen como landmark "content
 * information". Tenant-aware: el color de hover sobre los links usa
 * `var(--primary)` del theme.
 */
import type { StoreBrand } from '../../../config/stores';
import LanguageSwitcher from '../../ui/LanguageSwitcher';
import StorefrontFooterNav from './StorefrontFooterNav.astro';
import StorefrontFooterLegal from './StorefrontFooterLegal.astro';
import SocialIcon from './SocialIcon.astro';

interface FooterLink {
  labelKey:
    | 'storefront.footer.about'
    | 'storefront.footer.terms'
    | 'storefront.footer.privacy'
    | 'storefront.footer.help'
    | 'storefront.footer.contact';
  href: string;
}

interface Props {
  brand: StoreBrand;
  locale: string;
  links?: FooterLink[];
}

const { brand, locale, links } = Astro.props;

const defaultLinks: FooterLink[] = [
  { labelKey: 'storefront.footer.about', href: '#' },
  { labelKey: 'storefront.footer.terms', href: '#' },
  { labelKey: 'storefront.footer.privacy', href: '#' },
  { labelKey: 'storefront.footer.help', href: '#' },
  { labelKey: 'storefront.footer.contact', href: '#' },
];

const navLinks = links ?? defaultLinks;
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="w-full px-4 py-10 sm:px-6 lg:px-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
      {/* Columna 1: brand */}
      <div class="flex flex-col gap-2">
        <p class="text-base font-semibold tracking-tight text-slate-900">{brand.name}</p>
        <p class="text-sm text-slate-500">{brand.shortName} — hecho con cuidado.</p>
      </div>

      {/* Columna 2: nav links */}
      <div>
        <StorefrontFooterNav links={navLinks} locale={locale} />
      </div>

      {/* Columna 3: contacto (email de soporte) */}
      <div class="flex flex-col gap-3">
        <a
          href={`mailto:${brand.supportEmail}`}
          class="text-xs text-slate-500 transition hover:text-[var(--primary,#1e293b)]"
        >
          {brand.supportEmail}
        </a>
      </div>

      {/* Columna 4: redes sociales + selector de locale. Sin href por
          ahora: T4 conecta las URLs desde la BD; mientras tanto los
          iconos quedan decorativos y no redirigen. */}
      <div class="flex flex-col gap-3 md:items-end md:text-right">
        <div class="flex items-center gap-2" aria-label="Redes sociales">
          <SocialIcon variant="facebook" />
          <SocialIcon variant="instagram" />
          <SocialIcon variant="tiktok" />
          <SocialIcon variant="whatsapp" />
        </div>
        <LanguageSwitcher client:visible variant="compact" theme="light" />
      </div>
    </div>

    <div class="mt-8 border-t border-slate-200 pt-6">
      <StorefrontFooterLegal brand={brand} locale={locale} />
    </div>
  </div>
</footer>
