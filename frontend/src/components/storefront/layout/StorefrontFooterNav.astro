---
/**
 * StorefrontFooterNav — bloque de navegación del footer.
 *
 * Grid responsivo de links secundarios (Acerca de, Términos, Privacidad,
 * Ayuda, Contacto). En mobile se apila vertical; en md+ se divide en
 * columnas. Vive en `<nav aria-label="Secundaria">`.
 *
 * Los hrefs son placeholders (`#`) — los consumers (pages F1.4) los
 * ajustarán cuando existan las páginas reales.
 */
import { getServerDictionary } from '../../../i18n/server';

interface FooterLink {
  labelKey:
    | 'storefront.footer.about'
    | 'storefront.footer.terms'
    | 'storefront.footer.privacy'
    | 'storefront.footer.help'
    | 'storefront.footer.contact';
  href: string;
}

interface Props {
  links: FooterLink[];
  locale: string;
}

const { links, locale } = Astro.props;
const t = getServerDictionary(locale);
---

<nav aria-label="Secundaria" class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3 md:grid-cols-5">
  {links.map((link) => (
    <a
      href={link.href}
      class="text-sm text-slate-600 transition hover:text-[var(--primary,#1e293b)] focus:outline-none focus-visible:underline"
    >
      {t[link.labelKey]}
    </a>
  ))}
</nav>
