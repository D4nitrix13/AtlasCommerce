---
/**
 * StorefrontFooterNav — bloque de navegación del footer.
 *
 * Links secundarios (Acerca de, Términos, Privacidad, Ayuda, Contacto)
 * en fila horizontal inline junto al copyright (estilo Nike). Si no
 * caben en una línea, envuelven a la siguiente fila.
 *
 * Los hrefs llegan por props y apuntan a las páginas reales
 * (`/{locale}/about`, `/terms`, …) — los defaults viven en
 * `StorefrontFooter.astro`.
 */
import { getServerDictionary } from '../../../i18n/server';

interface FooterLink {
  labelKey:
    | 'storefront.footer.about'
    | 'storefront.footer.terms'
    | 'storefront.footer.privacy'
    | 'storefront.footer.help'
    | 'storefront.footer.contact';
  href: string;
}

interface Props {
  links: FooterLink[];
  locale: string;
}

const { links, locale } = Astro.props;
const t = getServerDictionary(locale);
---

<nav aria-label="Secundaria" class="flex flex-wrap items-center gap-x-4 gap-y-2">
  {links.map((link) => (
    <a
      href={link.href}
      class="whitespace-nowrap text-sm text-slate-600 transition hover:text-[var(--primary,#1e293b)] focus:outline-none focus-visible:underline"
    >
      {t[link.labelKey]}
    </a>
  ))}
</nav>
