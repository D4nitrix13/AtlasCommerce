---
/**
 * StorefrontHeaderNav — navegación principal del header.
 *
 * Desktop (md+): links de texto limpios, centrados, sin carets ni
 * dropdowns. Hover y estado activo en el accent del tenant.
 * Mobile (< md): hamburguesa (`<details>` + `<summary>`) con los
 * mismos links; los ítems secundarios (cuenta, wishlist, idioma, CTA)
 * se proyectan vía el slot `mobile-extras`.
 *
 * El estado activo se marca comparando `Astro.url.pathname` con el
 * `href` del link (prefijo para secciones tipo /products/*).
 */
import { getServerDictionary } from '../../../i18n/server';
import Icon from '../../ui/Icon.astro';

interface NavLink {
  labelKey:
    | 'storefront.header.nav.home'
    | 'storefront.header.nav.products'
    | 'storefront.header.nav.search'
    | 'storefront.header.nav.cases';
  href: string;
  matchPrefix?: string;
}

interface Props {
  links: NavLink[];
  openMenuLabel: string;
  // Aceptado por compatibilidad con StorefrontHeader; el menú mobile
  // se cierra vía click handler sobre el link. Mantener el prop evita
  // romper el contrato hasta que se limpie la i18n key.
  closeMenuLabel?: string;
}

const { links, openMenuLabel, closeMenuLabel: _closeMenuLabel } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const pathname = Astro.url.pathname;
const isActive = (link: NavLink): boolean => {
  const comparePath = link.matchPrefix ?? link.href;
  return pathname === link.href || pathname.startsWith(`${comparePath}/`);
};
---

<div class="flex flex-1 items-center justify-end md:justify-center">
  <nav aria-label="Principal" class="hidden md:block">
    <ul class="flex items-center gap-1">
      {links.map((link) => {
        const active = isActive(link);
        return (
          <li>
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex h-10 items-center whitespace-nowrap rounded-full px-3 text-sm font-medium transition',
                'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)]',
                active
                  ? 'text-[var(--primary,#2D9D8E)]'
                  : 'text-slate-700 hover:text-[var(--primary,#2D9D8E)]',
              ]}
            >
              {t[link.labelKey]}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <details class="relative md:hidden">
    <summary
      class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 hover:text-[var(--primary,#2D9D8E)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#2D9D8E)] [&::-webkit-details-marker]:hidden"
    >
      <span class="sr-only">{openMenuLabel}</span>
      <Icon name="bars-3" class="h-5 w-5" />
    </summary>
    <nav
      aria-label="Principal (móvil)"
      class="absolute right-0 z-30 mt-2 w-64 rounded-xl border border-[var(--line,#e7e5e4)] bg-[var(--paper,#f3efe8)] p-2 shadow-lg"
    >
      <ul class="flex flex-col gap-1">
        {links.map((link) => {
          const active = isActive(link);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2.5 text-sm font-medium transition',
                  active
                    ? 'text-[var(--primary,#2D9D8E)]'
                    : 'text-slate-700 hover:bg-slate-100 hover:text-[var(--primary,#2D9D8E)]',
                ]}
              >
                {t[link.labelKey]}
              </a>
            </li>
          );
        })}
        <slot name="mobile-extras" />
      </ul>
    </nav>
  </details>
</div>

<script is:inline>
  // Cuando el usuario abre el menú mobile y luego toca un link, el
  // `<details>` queda abierto. Cerrarlo para no mostrar UI rota.
  document.querySelectorAll('details.md\\:hidden nav a').forEach((anchor) => {
    anchor.addEventListener('click', () => {
      const details = anchor.closest('details');
      if (details instanceof HTMLDetailsElement) {
        details.open = false;
      }
    });
  });
</script>
