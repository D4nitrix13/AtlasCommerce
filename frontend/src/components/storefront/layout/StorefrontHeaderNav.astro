---
/**
 * StorefrontHeaderNav — bloque de navegación principal del header.
 *
 * Compone la lista de links principales (Inicio, Productos, Buscar) en
 * desktop, y provee un `<details>` colapsable en mobile (toggle via
 * `<summary>`). La nav vive en `<nav aria-label="Principal">` para
 * lectores de pantalla.
 *
 * El estado activo se marca comparando `Astro.url.pathname` con el
 * `href` del link (prefijo para secciones tipo /products/*).
 */
import { getServerDictionary } from '../../../i18n/server';

interface NavLink {
  labelKey: 'storefront.header.nav.home' | 'storefront.header.nav.products' | 'storefront.header.nav.search';
  href: string;
  matchPrefix?: string;
}

interface Props {
  links: NavLink[];
  openMenuLabel: string;
  // Aceptado por compatibilidad con StorefrontHeader, pero el menu mobile
  // ya no necesita un label accesible para "cerrar" — el `<details>`
  // se cierra via click handler sobre el link. Mantener el prop evita
  // romper el contrato de la API hasta que se limpie la i18n key.
  closeMenuLabel?: string;
}

const { links, openMenuLabel, closeMenuLabel: _closeMenuLabel } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const pathname = Astro.url.pathname;
const isActive = (link: NavLink): boolean => {
  const comparePath = link.matchPrefix ?? link.href;
  return pathname === link.href || pathname.startsWith(`${comparePath}/`);
};
---

<nav aria-label="Principal" class="hidden md:block">
  <ul class="flex items-center gap-1">
    {
      links.map((link) => {
        const active = isActive(link);
        return (
          <li>
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition',
                'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)]',
                active
                  ? 'bg-slate-100 text-[var(--primary,#1e293b)]'
                  : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
              ]}
            >
              {t[link.labelKey]}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<details class="md:hidden relative">
  <summary
    class="flex cursor-pointer list-none items-center justify-center rounded-md p-2 text-slate-700 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] [&::-webkit-details-marker]:hidden"
  >
    <span class="sr-only">{openMenuLabel}</span>
    <span aria-hidden="true" class="text-lg">☰</span>
  </summary>
  <nav
    aria-label="Principal (móvil)"
    class="absolute left-0 right-0 z-30 mt-2 rounded-lg border border-slate-200 bg-white p-2 shadow-lg"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => {
          const active = isActive(link);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-md px-3 py-2 text-sm font-medium transition',
                  active
                    ? 'bg-slate-100 text-[var(--primary,#1e293b)]'
                    : 'text-slate-700 hover:bg-slate-100',
                ]}
              >
                {t[link.labelKey]}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</details>

<script is:inline>
  // Cuando el usuario abre el menú mobile y luego toca un link, el
  // `<details>` queda abierto. Cerrarlo para no mostrar UI rota.
  document.querySelectorAll('details.md\\:hidden nav a').forEach((anchor) => {
    anchor.addEventListener('click', () => {
      const details = anchor.closest('details');
      if (details instanceof HTMLDetailsElement) {
        details.open = false;
      }
    });
  });
</script>
