---
/**
 * SocialIcon — primitive de iconos sociales SVG inline.
 *
 * Primitive reutilizable para el footer del storefront. Cubre las 8
 * plataformas del enum de BD (`store_social_links`): facebook,
 * instagram, tiktok, whatsapp, youtube, x, linkedin y other. Los paths
 * viven en `components/ui/social-icon-paths.ts`, compartidos con los
 * iconos OAuth del login, para no duplicar glifos entre ambos.
 *
 * El color del icono se controla con `currentColor` y se setea via
 * Tailwind al `var(--primary)` del theme activo (Panda teal, Kitsune
 * violeta, etc.). Esto hace que los iconos se integren con la paleta
 * del tenant en lugar de usar los colores oficiales de cada red
 * (que rompen la coherencia visual del storefront).
 *
 * Href opcional. Si el caller no provee href el componente renderiza
 * un span en lugar de un anchor para que el icono se pueda mostrar
 * decorativo sin link hasta que se asignen las URLs reales.
 *
 * Accesibilidad:
 *   - aria-label en el link con la red social.
 *   - aria-hidden en el SVG.
 *   - focus-visible ring con var(--primary).
 */
import {
  SOCIAL_ICON_PATHS,
  type SocialPlatform,
} from '../../ui/social-icon-paths';

export type SocialVariant = SocialPlatform;

interface Props {
  variant: SocialVariant;
  /**
   * URL de la red social. Si esta vacia o ausente el icono se renderiza
   * como span sin link. Default: vacio (decorativo).
   */
  href?: string;
  /** Tamaño en píxeles. Default: 20. */
  size?: number;
  /** Etiqueta accesible. Default: nombre legible de la red. */
  label?: string;
  class?: string;
}

const { variant, href, size = 20, label, class: className = '' } = Astro.props;

const defaultLabels: Record<SocialVariant, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  whatsapp: 'WhatsApp',
  youtube: 'YouTube',
  x: 'X',
  linkedin: 'LinkedIn',
  other: 'Otro',
};

const ariaLabel = label ?? defaultLabels[variant];

const Tag = href ? 'a' : 'span';
const hrefAttrs = href
  ? {
      href,
      target: '_blank',
      rel: 'noopener noreferrer',
    }
  : {};
---

<Tag
  {...hrefAttrs}
  aria-label={ariaLabel}
  class={`inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-600 transition hover:bg-[var(--primary,#475569)] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#475569)] focus-visible:ring-offset-2 ${className}`}
>
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    set:html={SOCIAL_ICON_PATHS[variant]}
  ></svg>
</Tag>
