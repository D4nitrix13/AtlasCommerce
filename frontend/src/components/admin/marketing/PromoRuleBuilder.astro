---
/**
 * PromoRuleBuilder — Wizard de 3 pasos para crear una promoción.
 *
 * Steps:
 *   1. Tipo (BOGO / % descuento / Envío gratis)
 *   2. Reglas (campos condicionales según tipo)
 *   3. Vigencia (fechas + prioridad)
 *
 * Cada paso se muestra en una sección `<fieldset>` separada. La
 * navegación entre pasos es client-side (sin recargar) usando
 * `<input type="radio">` + CSS `:checked` siblings — patrón usado
 * por builders de Shopify Admin / BigCommerce sin JS de framework.
 *
 * **AGENTS.md §1**: ~140 líneas — wizard denso pero acotado.
 *
 * **i18n**: títulos + descripciones + labels localizadas.
 *
 * **Out-of-scope**: el submit es un stub UI. El endpoint real vive
 * en `/api/v1/admin/marketing/promotions` (sesión futura).
 */
import Button from '../../ui/Button.astro';
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);
---

<form id="promo-builder" class="space-y-6" novalidate>
  <header class="rounded-xl bg-gradient-to-br from-violet-50 to-sky-50 p-5">
    <h2 class="text-lg font-bold text-slate-900">
      {t['admin.marketing.promotions.builder.title']}
    </h2>
    <p class="mt-1 text-sm text-slate-600">
      Definí el tipo, las reglas y la vigencia. La promoción se evalúa en el carrito en orden de
      prioridad (menor = más prioritaria).
    </p>
  </header>

  <fieldset class="rounded-2xl border border-slate-200 bg-white p-5">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
      {t['admin.marketing.promotions.builder.step.kind']}
    </legend>

    <div class="mt-3 grid gap-3 md:grid-cols-3">
      <label class="group flex cursor-pointer flex-col gap-1 rounded-xl border border-slate-200 p-4 transition has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50/50">
        <input type="radio" name="promo-kind" value="bogo" class="sr-only" checked />
        <span class="text-sm font-bold text-slate-900">
          {t['admin.marketing.promotions.builder.kind.bogo.title']}
        </span>
        <span class="text-xs text-slate-600">
          {t['admin.marketing.promotions.builder.kind.bogo.description']}
        </span>
      </label>

      <label class="group flex cursor-pointer flex-col gap-1 rounded-xl border border-slate-200 p-4 transition has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50/50">
        <input type="radio" name="promo-kind" value="percent_off" class="sr-only" />
        <span class="text-sm font-bold text-slate-900">
          {t['admin.marketing.promotions.builder.kind.percent.title']}
        </span>
        <span class="text-xs text-slate-600">
          {t['admin.marketing.promotions.builder.kind.percent.description']}
        </span>
      </label>

      <label class="group flex cursor-pointer flex-col gap-1 rounded-xl border border-slate-200 p-4 transition has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50/50">
        <input type="radio" name="promo-kind" value="free_shipping" class="sr-only" />
        <span class="text-sm font-bold text-slate-900">
          {t['admin.marketing.promotions.builder.kind.freeShipping.title']}
        </span>
        <span class="text-xs text-slate-600">
          {t['admin.marketing.promotions.builder.kind.freeShipping.description']}
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset class="rounded-2xl border border-slate-200 bg-white p-5">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
      {t['admin.marketing.promotions.builder.step.rules']}
    </legend>

    <div class="mt-3 grid gap-4 md:grid-cols-2">
      <div data-rule-show="bogo">
        <label for="buy-qty" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.buyQuantity']}
        </label>
        <input
          id="buy-qty"
          name="buy-qty"
          type="number"
          min="1"
          value="1"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>
      <div data-rule-show="bogo">
        <label for="get-qty" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.getQuantity']}
        </label>
        <input
          id="get-qty"
          name="get-qty"
          type="number"
          min="1"
          value="1"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>

      <div data-rule-show="percent_off">
        <label for="percent-off" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.percentOff']}
        </label>
        <input
          id="percent-off"
          name="percent-off"
          type="number"
          min="1"
          max="100"
          value="15"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>

      <div data-rule-show="free_shipping">
        <label for="min-subtotal" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.minSubtotal']}
        </label>
        <input
          id="min-subtotal"
          name="min-subtotal"
          type="number"
          min="0"
          value="50"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>

      <div class="md:col-span-2">
        <label for="applies-to" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.appliesTo']}
        </label>
        <input
          id="applies-to"
          name="applies-to"
          type="text"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
          placeholder="Categoría o producto específico..."
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="rounded-2xl border border-slate-200 bg-white p-5">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
      {t['admin.marketing.promotions.builder.step.schedule']}
    </legend>

    <div class="mt-3 grid gap-4 md:grid-cols-3">
      <div>
        <label for="start-at" class="text-sm font-medium text-slate-700">
          Desde
        </label>
        <input
          id="start-at"
          name="start-at"
          type="date"
          required
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>
      <div>
        <label for="end-at" class="text-sm font-medium text-slate-700">
          Hasta
        </label>
        <input
          id="end-at"
          name="end-at"
          type="date"
          required
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>
      <div>
        <label for="priority" class="text-sm font-medium text-slate-700">
          {t['admin.marketing.promotions.builder.fields.priority']}
        </label>
        <input
          id="priority"
          name="priority"
          type="number"
          min="0"
          max="100"
          value="10"
          class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </div>
    </div>
  </fieldset>

  <div class="flex items-center justify-end gap-3">
    <Button variant="primary" type="submit">
      {t['admin.marketing.promotions.builder.create']}
    </Button>
  </div>
</form>

<script>
  /**
   * Show/hide campos condicionales según `promo-kind` seleccionado.
   *
   * Cada fieldset de reglas tiene un `data-rule-show="bogo"` etc. El
   * listener escucha `change` en el form y togglea `hidden`.
   */
  const form = document.getElementById('promo-builder');
  if (form instanceof HTMLFormElement) {
    const updateRules = (): void => {
      const selected =
        form.querySelector<HTMLInputElement>('input[name="promo-kind"]:checked')?.value ?? 'bogo';
      form.querySelectorAll<HTMLElement>('[data-rule-show]').forEach((el) => {
        const visible = el.dataset.ruleShow === selected;
        el.classList.toggle('hidden', !visible);
      });
    };
    form.addEventListener('change', updateRules);
    updateRules();
  }
</script>
