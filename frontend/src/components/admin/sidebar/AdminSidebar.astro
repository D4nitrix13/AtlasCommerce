---
/**
 * AdminSidebar — Menu lateral completo del panel admin.
 *
 * La estructura del menu (8 categorías, 24 items) vive en
 * `src/config/menu.ts` como single source of truth. Este componente
 * la consume vía `getAdminMenu(locale)` que resuelve los hrefs al
 * prefijo dinámico `/{locale}/admin/...` (RF-AUTH-008 §4).
 *
 * Para EXTENDER el menu (agregar item o categoría), editar el array
 * `RAW_MENU` en `src/config/menu.ts` — NUNCA duplicar acá.
 *
 * Items destacados:
 *   - Dashboard: vista principal con métricas del tenant
 *   - Órdenes: badge dinámico cargado en cliente vía
 *     `/api/v1/admin/orders/recent?limit=50` contando items con
 *     `status='pending'`. Si el fetch falla o devuelve 0, el badge
 *     se omite (no se muestra `0`).
 *
 * Multi-tenant:
 *   - El tenant se resuelve via middleware backend (`store.domain`),
 *     no acá. Cada ruta tiene su propio controller que respeta el
 *     tenant.
 *   - Los hrefs llevan prefijo de locale: sin esto, sites no-default-
 *     locale (`/en/admin/dashboard`) navegan al login del default
 *     locale (`/admin/dashboard`) → bug multi-tenant F6.1.
 *
 * **AGENTS.md §16**: este componente vive en `components/admin/sidebar/`
 * (subfolder permitido dentro de admin/).
 */
import AdminSidebarItem from './AdminSidebarItem.astro';
import AdminUserMenu from '../auth/AdminUserMenu';
import { getAdminMenu } from '../../../config/menu';
import Icon from '../../../ui/Icon.astro';

const locale = Astro.locals.locale ?? 'es';
const menu = getAdminMenu(locale);
const currentPath = Astro.url.pathname;

// `import.meta.env.PUBLIC_API_URL` solo es visible en SSR. Para que el
// script client-side pueda construir la URL absoluta del endpoint admin
// de orders, lo pasamos vía `define:vars` (Astro serializa las vars en
// el HTML inline). Fallback a `''` para Same-Origin (cuando el proxy
// inverso del tenant expone `/api` directamente).
const publicApiUrl = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
---

<style is:global>
  /* ── Label collapse: fade + width collapse, no deformation ── */
  .sidebar-label {
    overflow: hidden;
    white-space: nowrap;
    max-width: 300px;
    opacity: 1;
    transition:
      opacity 150ms ease,
      max-width 200ms ease;
  }

  aside[data-collapsed='true'] .sidebar-label {
    opacity: 0;
    max-width: 0;
    pointer-events: none;
  }

  /* ── Collapsed nav items: center icon, remove gap ── */
  aside[data-collapsed='true'] nav a {
    justify-content: center;
    gap: 0;
  }

  /* ── Collapsed header: center logo icon ── */
  aside[data-collapsed='true'] > div:first-child {
    justify-content: center;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  /* ── Pre-JS icon state: prevent flash on reload ── */
  @media (min-width: 1024px) {
    html.sidebar-collapsed-init [data-sidebar-toggle] [data-icon-expand] {
      display: block !important;
    }
    html.sidebar-collapsed-init [data-sidebar-toggle] [data-icon-collapse] {
      display: none !important;
    }
    html.sidebar-expanded-init [data-sidebar-toggle] [data-icon-expand] {
      display: none !important;
    }
    html.sidebar-expanded-init [data-sidebar-toggle] [data-icon-collapse] {
      display: block !important;
    }

    /* ── Pre-JS layout: prevent width/padding flash ── */
    html.sidebar-collapsed-init #admin-sidebar {
      width: 72px !important;
    }
    html.sidebar-collapsed-init #main-content {
      padding-left: 72px !important;
    }
    html.sidebar-expanded-init #admin-sidebar {
      width: 260px !important;
    }
    html.sidebar-expanded-init #main-content {
      padding-left: 260px !important;
    }
  }

  /* ── Pending orders badge: hidden hasta que el JS inyecte el valor ── */
  [data-badge='orders-pending'] {
    display: none;
  }
  [data-badge='orders-pending'][data-loaded='true'] {
    display: inline-flex;
  }
</style>

<div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"></div>

<aside
  id="admin-sidebar"
  data-collapsed="false"
  class="fixed inset-y-0 left-0 z-40 flex w-[260px] -translate-x-full lg:translate-x-0 flex-col overflow-hidden border-r border-white/10 bg-[#06110c] text-slate-300 transition-[width,transform] duration-200"
>
  <div class="flex h-16 shrink-0 items-center justify-between px-5">
    <div class="flex items-center gap-3">
      <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-emerald-500 text-white">
        ⚡
      </div>

      <div class="sidebar-label">
        <p class="text-sm font-bold text-white">Kitsune</p>
        <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">Panel de Control</p>
      </div>
    </div>
  </div>

  <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
    {
      menu.map((section) => (
        <div>
          <p class="sidebar-label mb-2 px-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600">
            {section.label}
          </p>

          <div class="space-y-1">
            {section.items.map((item) => {
              const href = item.href;
              const isActive = currentPath === href || currentPath.startsWith(href + '/');
              const activeClass = isActive
                ? 'bg-emerald-500/10 text-emerald-400'
                : 'text-slate-400 hover:bg-white/5 hover:text-white';
              const iconColorClass = isActive ? 'text-emerald-400' : 'text-slate-500 group-hover:text-slate-300';

              // Items con badge dinámico (orders-pending, etc.) se
              // renderizan inline para poder inyectar el `<span
              // data-badge>` que el script client-side va a llenar.
              // El resto usa el componente `AdminSidebarItem` normal.
              if (item.badge !== undefined) {
                return (
                  <a
                    href={href}
                    title={item.name}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition',
                      activeClass,
                    ]}
                  >
                    <Icon
                      name={item.icon}
                      class:list={['h-5 w-5 shrink-0 transition', iconColorClass]}
                    />
                    <span class="sidebar-label flex-1">{item.name}</span>
                    <span
                      data-badge={item.badge}
                      class="sidebar-label rounded-full bg-emerald-500/15 px-2 py-0.5 text-[11px] font-semibold text-emerald-400"
                    />
                  </a>
                );
              }

              return (
                <AdminSidebarItem
                  name={item.name}
                  href={href}
                  icon={item.icon}
                  active={isActive}
                />
              );
            })}
          </div>
        </div>
      ))
    }
  </nav>

  <div class="border-t border-white/10 p-4">
    <AdminUserMenu client:load />
  </div>
</aside>

{/*
  Bridge script: expone `window.__ATLAS_ADMIN_API_BASE__` con la URL
  base del backend al script TS de abajo (que Astro compila como
  módulo separado). Se necesita porque `define:vars` solo funciona
  en scripts `is:inline`, y el resto del sidebar usa TypeScript con
  helpers de tipo.
*/}
<script is:inline define:vars={{ publicApiUrl }}>
  window.__ATLAS_ADMIN_API_BASE__ = publicApiUrl;
</script>

<script>
  /**
   * Sidebar behavior — collapse persistence + dynamic badge fetching.
   *
   * El badge de órdenes pendientes se carga client-side porque el
   * `AdminSidebar` se monta en TODAS las páginas admin (vía
   * `AdminLayout`), así que hacer SSR-fetch del contador en cada
   * navegación sumaría N requests a un widget secundario. El fetch
   * client-side se dispara una vez por mount y cachea el resultado
   * en memoria hasta el próximo full reload.
   */
  (function () {
    const STORAGE_KEY = 'admin-sidebar-collapsed';
    const sidebar = document.getElementById('admin-sidebar') as HTMLElement | null;
    const overlay = document.getElementById('sidebar-overlay') as HTMLElement | null;
    const mainContent = document.getElementById('main-content') as HTMLElement | null;
    const toggleBtns = document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]');

    if (!sidebar || !overlay || !mainContent) return;

    const sidebarEl: HTMLElement = sidebar;
    const overlayEl: HTMLElement = overlay;
    const mainContentEl: HTMLElement = mainContent;

    function isDesktop(): boolean {
      return window.innerWidth >= 1024;
    }

    function getCollapsed(): boolean {
      return localStorage.getItem(STORAGE_KEY) === 'true';
    }

    function setCollapsed(value: boolean): void {
      localStorage.setItem(STORAGE_KEY, String(value));
    }

    function updateToggleIcons(collapsed: boolean): void {
      toggleBtns.forEach(function (btn: HTMLElement) {
        const expandIcon = btn.querySelector('[data-icon-expand]');
        const collapseIcon = btn.querySelector('[data-icon-collapse]');
        if (expandIcon && collapseIcon) {
          expandIcon.classList.toggle('hidden', !collapsed);
          collapseIcon.classList.toggle('hidden', collapsed);
        }
      });
    }

    function updateToggleTitle(collapsed: boolean): void {
      toggleBtns.forEach(function (btn: HTMLElement) {
        btn.setAttribute('title', collapsed ? 'Expandir menú' : 'Colapsar menú');
        btn.setAttribute('aria-label', collapsed ? 'Expandir menú' : 'Colapsar menú');
      });
    }

    function updateAriaState(expanded: boolean): void {
      toggleBtns.forEach(function (btn: HTMLElement) {
        btn.setAttribute('aria-expanded', String(expanded));
      });
    }

    function applyDesktopState(): void {
      const collapsed = getCollapsed();

      sidebarEl.setAttribute('data-collapsed', String(collapsed));

      if (collapsed) {
        sidebarEl.classList.add('w-[72px]');
        sidebarEl.classList.remove('w-[260px]');
        mainContentEl.classList.add('lg:pl-[72px]');
        mainContentEl.classList.remove('lg:pl-[260px]');
      } else {
        sidebarEl.classList.remove('w-[72px]');
        sidebarEl.classList.add('w-[260px]');
        mainContentEl.classList.remove('lg:pl-[72px]');
        mainContentEl.classList.add('lg:pl-[260px]');
      }

      updateToggleIcons(collapsed);
      updateToggleTitle(collapsed);
      updateAriaState(!collapsed);

      document.documentElement.classList.remove('sidebar-collapsed-init', 'sidebar-expanded-init');
    }

    function toggleSidebar(): void {
      if (isDesktop()) {
        setCollapsed(!getCollapsed());
        applyDesktopState();
      } else {
        const isHidden = sidebarEl.classList.contains('-translate-x-full');
        if (isHidden) {
          sidebarEl.classList.remove('-translate-x-full');
          overlayEl.classList.remove('hidden');
        } else {
          sidebarEl.classList.add('-translate-x-full');
          overlayEl.classList.add('hidden');
        }
        updateAriaState(isHidden);
      }
    }

    toggleBtns.forEach(function (btn: HTMLElement) {
      btn.addEventListener('click', toggleSidebar);
    });

    overlayEl.addEventListener('click', function () {
      if (!isDesktop()) {
        sidebar!.classList.add('-translate-x-full');
        overlay!.classList.add('hidden');
        updateAriaState(false);
      }
    });

    if (isDesktop()) {
      applyDesktopState();
    }

    /**
     * Carga el badge de órdenes pendientes.
     *
     * Endpoint: `GET /api/v1/admin/orders/recent?limit=50`
     *   - Devuelve hasta 50 orders recientes del tenant.
     *   - Contamos items con `status === 'pending'` (status string del
     *     backend, NO `payment_status` — orders 'pending' significa que
     *     requieren atención del admin).
     *   - El `RecentOrdersController` ya tiene scope multi-tenant via
     *     `store.domain` middleware; el browser envía credenciales con
     *     `credentials: 'include'` para que Sanctum reconozca la sesión.
     *
     * Si el endpoint falla (5xx, 401 sin sesión, network), ocultamos el
     * badge silenciosamente para no mostrar `0` falso. Log a consola
     * para que devs/debug noten el problema.
     */
    async function loadOrdersPendingBadge(): Promise<void> {
      const badgeEls = document.querySelectorAll<HTMLElement>('[data-badge="orders-pending"]');
      if (badgeEls.length === 0) return;

      // Bridge global seteado por el script is:inline de arriba.
      const apiBase = (window as unknown as { __ATLAS_ADMIN_API_BASE__?: string }).__ATLAS_ADMIN_API_BASE__ ?? '';

      try {
        const response = await fetch(`${apiBase}/api/v1/admin/orders/recent?limit=50`, {
          credentials: 'include',
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        const payload = (await response.json()) as { data?: Array<{ status?: string }> };
        const orders = Array.isArray(payload.data) ? payload.data : [];
        const pendingCount = orders.filter((order) => order.status === 'pending').length;

        if (pendingCount <= 0) return;

        const display = pendingCount > 99 ? '99+' : String(pendingCount);
        badgeEls.forEach((el) => {
          el.textContent = display;
          el.setAttribute('data-loaded', 'true');
          el.setAttribute('title', `${pendingCount} órdenes pendientes`);
          el.setAttribute('aria-label', `${pendingCount} órdenes pendientes`);
        });
      } catch (err) {
        // eslint-disable-next-line no-console
        console.warn('[AdminSidebar] No se pudo cargar badge de órdenes pendientes:', err);
      }
    }

    loadOrdersPendingBadge();
  })();
</script>
