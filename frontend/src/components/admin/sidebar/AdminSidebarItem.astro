---
/**
 * AdminSidebarItem — Item individual del AdminSidebar.
 *
 * Renderiza un `<a>` con icono + nombre + badge opcional. Estado
 * `active` se computa en el padre segun `Astro.url.pathname`.
 *
 * Ejemplo de uso:
 * ```astro
 * <AdminSidebarItem
 *   name="Dashboard"
 *   href="/admin/dashboard"
 *   icon="squares-2x2"
 *   active={currentPath === '/admin/dashboard'}
 * />
 * ```
 */
import Icon from '../../ui/Icon.astro';

/**
 * Props de AdminSidebarItem.
 *
 * @prop {string}    name      Label visible del item
 * @prop {string}    href      Ruta destino (sin locale prefix)
 * @prop {string}    [icon]    Nombre del icono lucide (opcional)
 * @prop {boolean}   [active]  Si está en la ruta actual (default false)
 * @prop {string}    [badge]   Texto del badge opcional (ej: "12" notificaciones)
 */
interface Props {
  name: string;
  href: string;
  icon?: string;
  active?: boolean;
  badge?: string;
}

const { name, href, icon, active = false, badge } = Astro.props;
---

<a
  href={href}
  title={name}
  class:list={[
    'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition',
    active
      ? 'bg-emerald-500/10 text-emerald-400'
      : 'text-slate-400 hover:bg-white/5 hover:text-white',
  ]}
>
  {
    icon && (
      <Icon
        name={icon}
        class:list={[
          'h-5 w-5 shrink-0 transition',
          active ? 'text-emerald-400' : 'text-slate-500 group-hover:text-slate-300',
        ]}
      />
    )
  }

  <span class="sidebar-label flex-1">{name}</span>

  {
    badge && (
      <span class="sidebar-label rounded-full bg-emerald-500/15 px-2 py-0.5 text-[11px] font-semibold text-emerald-400">
        {badge}
      </span>
    )
  }
</a>
