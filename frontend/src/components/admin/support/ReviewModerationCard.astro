---
/**
 * ReviewModerationCard — Card de moderación de reseñas.
 *
 * Renderiza una review pendiente con:
 *   - Emoji "imagen" placeholder del producto + nombre + rating (estrellas)
 *   - Título + body de la reseña
 *   - Autor + fecha
 *   - Botones de acción (aprobar / rechazar / responder)
 *   - Flag visual si la reseña fue marcada como sospechosa
 *
 * El toggle "responder" expande un `<textarea>` inline para que el
 * admin escriba una respuesta pública sin salir de la card (UX
 * típica de Trustpilot / Bazaarvoice).
 *
 * **AGENTS.md §1**: ~140 líneas — card densa con formulario inline.
 *
 * **i18n**: labels + placeholders localizados.
 *
 * **Out-of-scope**: los handlers de aprobar/rechazar/responder son
 * stubs (POST al endpoint real en sesión futura).
 */
import { getServerDictionary } from '../../../i18n/server';
import type { ProductReview } from '../../../data/support-mock';

interface Props {
  review: ProductReview;
}

const { review } = Astro.props;

const t = getServerDictionary(Astro.locals.locale);

const STARS = '★★★★★';
const starDisplay = STARS.slice(0, review.rating) + '☆☆☆☆☆'.slice(0, 5 - review.rating);

const formatDate = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-NI', { day: '2-digit', month: 'short', year: 'numeric' });
};

const initialsOf = (name: string): string => {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 0) return '?';
  if (parts.length === 1) return (parts[0] ?? '?').slice(0, 2).toUpperCase();
  return `${(parts[0] ?? '').charAt(0)}${(parts[1] ?? '').charAt(0)}`.toUpperCase();
};
---

<article
  class:list={[
    'rounded-2xl border bg-white shadow-sm',
    review.status === 'flagged' ? 'border-rose-200 ring-1 ring-rose-100' : 'border-slate-200',
  ]}
  data-review-id={review.id}
>
  {
    review.status === 'flagged' && (
      <div class="flex items-center gap-2 border-b border-rose-100 bg-rose-50 px-4 py-2 text-xs font-medium text-rose-700">
        <span aria-hidden="true">⚠</span>
        <span>{t['admin.support.reviews.card.flagReason']}</span>
      </div>
    )
  }

  <div class="flex gap-4 p-5">
    <div class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 text-3xl" aria-hidden="true">
      {review.productImage}
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-baseline justify-between gap-3">
        <p class="truncate text-sm font-semibold text-slate-900">{review.productName}</p>
        <span class="shrink-0 text-amber-500 tracking-tight" aria-label={`${review.rating} de 5 estrellas`}>
          {starDisplay}
        </span>
      </div>

      <h3 class="mt-1 text-base font-bold text-slate-950">{review.title}</h3>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-700">{review.body}</p>

      <div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
        <span class="grid h-5 w-5 place-items-center rounded-full bg-slate-200 text-[10px] font-bold text-slate-700">
          {initialsOf(review.customerName)}
        </span>
        <span class="font-medium text-slate-700">{review.customerName}</span>
        <span aria-hidden="true">·</span>
        <time datetime={review.createdAt}>
          {t['admin.support.reviews.card.postedOn']} {formatDate(review.createdAt)}
        </time>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-100 bg-slate-50/50 px-5 py-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-review-action="approve"
          class="inline-flex items-center gap-1.5 rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        >
          <span aria-hidden="true">✓</span>
          <span>{t['admin.support.reviews.card.approve']}</span>
        </button>
        <button
          type="button"
          data-review-action="reject"
          data-confirm={t['admin.support.reviews.card.rejectConfirm']}
          class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
        >
          <span aria-hidden="true">✕</span>
          <span>{t['admin.support.reviews.card.reject']}</span>
        </button>
      </div>
      <button
        type="button"
        data-toggle-reply={review.id}
        class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
      >
        <span aria-hidden="true">↩</span>
        <span>{t['admin.support.reviews.card.respond']}</span>
      </button>
    </div>

    <div data-reply-form={review.id} class="reply-form mt-3 hidden space-y-2">
      <textarea
        rows="3"
        placeholder={t['admin.support.reviews.card.replyPlaceholder']}
        class="block w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-200"
      ></textarea>
      <div class="flex justify-end">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white transition hover:bg-slate-800"
        >
          {t['admin.support.reviews.card.sendReply']}
        </button>
      </div>
    </div>
  </div>
</article>

<script>
  /**
   * Toggle del formulario inline de respuesta.
   */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const toggle = target.closest<HTMLElement>('[data-toggle-reply]');
    if (!toggle) return;
    const id = toggle.dataset.toggleReply;
    const form = document.querySelector<HTMLElement>(`[data-reply-form="${id}"]`);
    if (form) form.classList.toggle('hidden');
  });

  /**
   * Confirmación al rechazar (evita clicks accidentales).
   */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLElement>('[data-review-action="reject"]');
    if (!trigger) return;
    const message = trigger.dataset.confirm ?? '';
    if (message.length > 0 && !window.confirm(message)) {
      event.preventDefault();
      event.stopImmediatePropagation();
    }
  });
</script>
