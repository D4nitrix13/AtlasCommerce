---
/**
 * OrderCustomerCard — Card del cliente asociado a una order admin (F5.4).
 *
 * Muestra el resumen del customer (nombre + tipo + email + teléfono)
 * con un CTA "Ver perfil" que enlaza al detalle de customer admin.
 * Stats secundarios (orders count + lifetime value) en una fila de
 * KPI compactos. El tipo de cliente (`retail | wholesale | vip`)
 * se renderiza como Badge semántico para que el admin lo identifique
 * al pasar la vista por la lista de orders.
 *
 * Backend esperado (TODO migración):
 *   - `GET /api/v1/admin/customers/{id}` → devuelve shape completo
 *     incluyendo `lifetimeValueCents`, `ordersCount`, `type`. Cuando
 *     exista, este componente reemplaza el mock por `fetch()`.
 */
import type { AdminCustomerMock } from '../../../data/sales-mock';
import { formatCentsAsDecimal } from '../../../lib/formatters';

interface Props {
  customer: AdminCustomerMock;
  customerProfileHref: string;
  heading: string;
  labelPhone: string;
  labelType: string;
  labelOrdersCount: string;
  labelLifetimeValue: string;
  labelViewProfile: string;
  typeRetail: string;
  typeWholesale: string;
  typeVip: string;
}

const {
  customer,
  customerProfileHref,
  heading,
  labelPhone,
  labelType,
  labelOrdersCount,
  labelLifetimeValue,
  labelViewProfile,
  typeRetail,
  typeWholesale,
  typeVip,
} = Astro.props;

const TYPE_LABELS = {
  retail: typeRetail,
  wholesale: typeWholesale,
  vip: typeVip,
} as const;

const TYPE_BADGE: Record<AdminCustomerMock['type'], string> = {
  retail: 'bg-slate-100 text-slate-700',
  wholesale: 'bg-sky-100 text-sky-800',
  vip: 'bg-amber-100 text-amber-800',
};

const initials = customer.name
  .split(' ')
  .map((part) => part.charAt(0))
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<section
  aria-labelledby="order-customer-heading"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
>
  <header class="flex items-center justify-between gap-3">
    <h2 id="order-customer-heading" class="text-base font-semibold text-slate-900 sm:text-lg">
      {heading}
    </h2>
    <a
      href={customerProfileHref}
      class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
    >
      {labelViewProfile} ↗
    </a>
  </header>

  <div class="mt-4 flex items-center gap-3">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white"
      aria-hidden="true"
    >
      {initials || '·'}
    </div>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-semibold text-slate-900">{customer.name}</p>
      <p class="truncate text-xs text-slate-500">{customer.email}</p>
    </div>
    <span
      class:list={[
        'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
        TYPE_BADGE[customer.type],
      ]}
    >
      {TYPE_LABELS[customer.type]}
    </span>
  </div>

  <dl class="mt-4 grid grid-cols-1 gap-3 border-t border-slate-100 pt-4 text-sm sm:grid-cols-2">
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{labelPhone}</dt>
      <dd class="text-slate-900">{customer.phone}</dd>
    </div>
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{labelType}</dt>
      <dd class="text-slate-900">{TYPE_LABELS[customer.type]}</dd>
    </div>
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{labelOrdersCount}</dt>
      <dd class="font-semibold text-slate-900 tabular-nums">—</dd>
    </div>
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
        {labelLifetimeValue}
      </dt>
      <dd class="font-semibold text-slate-900 tabular-nums">
        {formatCentsAsDecimal(customer.lifetimeValueCents, 'USD')}
      </dd>
    </div>
  </dl>
</section>
