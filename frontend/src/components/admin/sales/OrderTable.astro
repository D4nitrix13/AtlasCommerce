---
/**
 * OrderTable — Tabla densa de orders admin (F5.4).
 *
 * Patrón Shopify Admin / Stripe (design-refs §7.2):
 *  - Selección múltiple con checkboxes en cada row (bulk actions).
 *  - Filas clickables para abrir el detalle, con la última columna
 *    dedicada a "Ver detalle" para tabular sin entrar a la fila.
 *  - Status pills semánticas (Badge primitive, §6.4).
 *  - Densidad alta: padding vertical 12px (en vez de 16px del account).
 *
 * Empty state separado (vía prop `showEmpty`) — el page decide cuándo
 * mostrarlo (cuando los filtros dejan 0 rows).
 *
 * AGENTS.md §11 (loading/error/empty): solo success + empty. SSR puro,
 * sin loading. Error se renderiza en el page cuando `dataSource='error'`.
 */
import Badge from '../../ui/Badge.astro';
import { formatCentsAsDecimal, formatDate } from '../../../lib/formatters';
import type { AdminOrderMock, AdminOrderStatus } from '../../../data/sales-mock';

interface Props {
  orders: readonly AdminOrderMock[];
  currencyCode: string;
  statusLabel: (status: AdminOrderStatus) => string;
  /** Locale-prefixed href builder para el detalle. */
  detailHrefFor: (orderId: string) => string;
  viewDetailLabel: string;
  /** Column headers visibles. */
  columnOrderNumber: string;
  columnCustomer: string;
  columnDate: string;
  columnStatus: string;
  columnItems: string;
  columnTotal: string;
  columnActions: string;
  /** Empty state. */
  showEmpty: boolean;
  emptyTitle: string;
  emptyHint: string;
  /** Form id del form de filtros del page (para reset al cambiar filters). */
  bulkFormName: string;
}

const {
  orders,
  currencyCode,
  statusLabel,
  detailHrefFor,
  viewDetailLabel,
  columnOrderNumber,
  columnCustomer,
  columnDate,
  columnStatus,
  columnItems,
  columnTotal,
  columnActions,
  showEmpty,
  emptyTitle,
  emptyHint,
  bulkFormName,
} = Astro.props;

function countItems(order: AdminOrderMock): number {
  return order.items.reduce((sum, item) => sum + item.quantity, 0);
}
---

{
  showEmpty ? (
    <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
      <div
        class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-2xl"
        aria-hidden="true"
      >
        📦
      </div>
      <p class="text-base font-semibold text-slate-900">{emptyTitle}</p>
      <p class="max-w-md text-sm text-slate-500">{emptyHint}</p>
    </div>
  ) : (
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full min-w-[820px] border-collapse text-left text-sm">
        <caption class="sr-only">Lista de orders admin</caption>
        <thead class="border-b border-slate-200 bg-slate-50/60 text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th scope="col" class="w-10 px-3 py-3">
              <span class="sr-only">Seleccionar</span>
            </th>
            <th scope="col" class="px-3 py-3 font-semibold">{columnOrderNumber}</th>
            <th scope="col" class="px-3 py-3 font-semibold">{columnCustomer}</th>
            <th scope="col" class="px-3 py-3 font-semibold">{columnDate}</th>
            <th scope="col" class="px-3 py-3 font-semibold">{columnStatus}</th>
            <th scope="col" class="px-3 py-3 text-right font-semibold">{columnItems}</th>
            <th scope="col" class="px-3 py-3 text-right font-semibold">{columnTotal}</th>
            <th scope="col" class="px-3 py-3 text-right font-semibold">{columnActions}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {orders.map((order) => {
            const detailHref = detailHrefFor(order.id);
            const status = statusLabel(order.status);
            const itemsTotal = countItems(order);
            const total = formatCentsAsDecimal(order.totalCents, currencyCode);
            const placedOn = formatDate(order.date);
            return (
              <tr
                class="group transition-colors hover:bg-slate-50/40"
                data-order-row={order.id}
              >
                <td class="px-3 py-3 align-middle">
                  <input
                    type="checkbox"
                    name="selectedOrders"
                    value={order.id}
                    form={bulkFormName}
                    aria-label={`Seleccionar ${order.number}`}
                    class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-2 focus:ring-slate-400"
                    data-order-checkbox
                  />
                </td>
                <td class="px-3 py-3 align-middle">
                  <a
                    href={detailHref}
                    class="font-mono text-xs font-medium text-slate-900 transition-colors group-hover:text-slate-700 focus-visible:outline-none focus-visible:underline"
                  >
                    {order.number}
                  </a>
                </td>
                <td class="px-3 py-3 align-middle">
                  <p class="font-medium text-slate-900">{order.customer.name}</p>
                  <p class="text-xs text-slate-500">{order.customer.email}</p>
                </td>
                <td class="px-3 py-3 align-middle text-slate-600">
                  <time datetime={order.date}>{placedOn}</time>
                </td>
                <td class="px-3 py-3 align-middle">
                  <Badge status={order.status} label={status} />
                </td>
                <td class="px-3 py-3 text-right align-middle tabular-nums text-slate-700">
                  {itemsTotal}
                </td>
                <td class="px-3 py-3 text-right align-middle font-semibold tabular-nums text-slate-900">
                  {total}
                </td>
                <td class="px-3 py-3 text-right align-middle">
                  <a
                    href={detailHref}
                    class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2"
                  >
                    {viewDetailLabel} ↗
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )
}