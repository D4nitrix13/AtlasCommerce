---
/**
 * OrderItemsTable — Tabla densa de líneas de orden admin (F5.4).
 *
 * Misma estructura que el table del account (`account/orders/OrderItemsList.astro`)
 * pero con columna SKU visible para que el admin pueda cross-check con
 * inventario. Subtotal = unitPrice * quantity (cents in, cents out).
 *
 * AGENTS.md §11 (loading/error/empty/success): si `items.length === 0`
 * se renderiza el empty state inline. Sin loading porque es SSR puro.
 */
import { formatCentsAsDecimal } from '../../../lib/formatters';
import type { AdminOrderItemMock } from '../../../data/sales-mock';

interface Props {
  items: readonly AdminOrderItemMock[];
  currencyCode: string;
  heading: string;
  columnProduct: string;
  columnSku: string;
  columnQuantity: string;
  columnUnitPrice: string;
  columnSubtotal: string;
  emptyLabel: string;
}

const {
  items,
  currencyCode,
  heading,
  columnProduct,
  columnSku,
  columnQuantity,
  columnUnitPrice,
  columnSubtotal,
  emptyLabel,
} = Astro.props;

const hasItems = items.length > 0;
---

<section
  aria-labelledby="order-items-heading"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
>
  <h2 id="order-items-heading" class="mb-4 text-base font-semibold text-slate-900 sm:text-lg">
    {heading}
  </h2>

  {hasItems ? (
    <div class="overflow-x-auto rounded-lg border border-slate-100">
      <table class="w-full min-w-[480px] border-collapse text-left text-sm">
        <thead class="bg-slate-50 text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr>
            <th scope="col" class="px-3 py-2 font-semibold">
              {columnProduct}
            </th>
            <th scope="col" class="px-3 py-2 font-semibold">
              {columnSku}
            </th>
            <th scope="col" class="px-3 py-2 text-right font-semibold">
              {columnQuantity}
            </th>
            <th scope="col" class="px-3 py-2 text-right font-semibold">
              {columnUnitPrice}
            </th>
            <th scope="col" class="px-3 py-2 text-right font-semibold">
              {columnSubtotal}
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {items.map((item) => {
            const subtotalCents = item.unitPriceCents * item.quantity;
            return (
              <tr class="hover:bg-slate-50/40">
                <td class="px-3 py-2 font-medium text-slate-900">{item.productName}</td>
                <td class="px-3 py-2 font-mono text-xs text-slate-500">{item.productSku}</td>
                <td class="px-3 py-2 text-right tabular-nums text-slate-700">{item.quantity}</td>
                <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                  {formatCentsAsDecimal(item.unitPriceCents, currencyCode)}
                </td>
                <td class="px-3 py-2 text-right font-semibold tabular-nums text-slate-900">
                  {formatCentsAsDecimal(subtotalCents, currencyCode)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="rounded-md border border-dashed border-slate-200 bg-slate-50 px-3 py-4 text-sm text-slate-500">
      {emptyLabel}
    </p>
  )}
</section>
