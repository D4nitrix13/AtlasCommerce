---
/**
 * AdminHeader — Sticky top header del shell del panel admin.
 *
 * Presente en TODAS las rutas `/admin/*`. Wrapper con comportamiento
 * acoplado:
 *   1. Sidebar toggle: `<button data-sidebar-toggle>` con `aria-expanded`
 *      manejado por JS global (ver `frontend/src/scripts/sidebar.ts`).
 *   2. Search input: placeholder ("Buscar productos, ordenes..."), sin
 *      handler — backend search no implementado todavia.
 *   3. Quick action button "Nueva orden": link directo a
 *      `/admin/sales/orders/new`.
 *   4. AdminUserMenu: avatar + nombre + dropdown logout (slot al final).
 *
 * **AGENTS.md §17** (a11y): usa `<button>` real con `aria-label` y
 * `aria-expanded`. aria-controls apunta a `admin-sidebar` (id).
 *
 * **Multi-tenant**: sin scope de tenant propio; el user authenticated
 * aplica en cualquier ruta admin via session Sanctum.
 *
 * **AGENTS.md §11** (UI states): solo datos del usuario (auth); no
 * loading/error explicito (la pagina padre renderiza skeleton si
 * todavia no cargo user).
 */
import Icon from '../../ui/Icon.astro';
---

<header class="sticky top-0 z-30 border-b border-slate-200/80 bg-[#f6f7f9]/90 backdrop-blur">
  <div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <button
        id="sidebar-toggle"
        data-sidebar-toggle
        class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-500 transition hover:bg-emerald-50 hover:text-emerald-600"
        title="Colapsar menú"
        aria-label="Colapsar menú"
        aria-expanded="false"
        aria-controls="admin-sidebar"
      >
        <span data-icon-expand>
          <Icon name="bars-3" class="h-5 w-5" />
        </span>
        <span data-icon-collapse class="hidden">
          <Icon name="chevron-left" class="h-5 w-5" />
        </span>
      </button>

      <div class="w-full max-w-sm">
        <label class="relative block">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
            <Icon name="magnifying-glass" class="h-5 w-5" />
          </span>

          <input
            type="search"
            placeholder="Buscar..."
            class="h-10 w-full rounded-xl border border-slate-200 bg-white pl-10 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-400 focus:ring-4 focus:ring-emerald-500/10"
          />
        </label>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/admin/sales/orders"
        class="hidden rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 sm:inline-flex"
      >
        <Icon name="plus" class="mr-1.5 h-4 w-4" />
        Nueva orden
      </a>

      <button class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-500 hover:text-slate-900">
        <Icon name="moon" class="h-5 w-5" />
      </button>

      <button class="relative grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-500 hover:text-slate-900">
        <Icon name="bell" class="h-5 w-5" />
        <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-red-500"></span>
      </button>

      <div class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700">
        AS
      </div>
    </div>
  </div>
</header>
