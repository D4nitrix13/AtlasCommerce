---
/**
 * CustomerAnalyticsCard — Segmentación de clientes del tenant admin.
 *
 * Widget del dashboard admin con:
 *   - 4 KPI cards (Total clientes, Nuevos este mes, Tasa retorno, Activos)
 *   - Pie/donut chart de segments (Frecuentes, Ocasionales, Nuevos, Inactivos)
 *
 * **MOCK DATA con fallback**: fetch a
 * `GET /api/v1/admin/metrics/customers/segments`. Fallback a MOCK data
 * si 404 / falla.
 *
 * **i18n**: heading + subtitle + 4 KPI labels + 4 segment labels + el
 * center label del donut se traducen via diccionario. Los segments
 * serializados al chart ya llevan el label traducido (Chart.js los usa
 * en tooltips aunque la legenda visual este oculta).
 */
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface CustomerStat {
  label: string;
  value: string;
  change: string;
  trend: 'up' | 'down';
}
interface CustomerSegment {
  label: string;
  value: number;
  color: string;
}
interface CustomerData {
  stats: CustomerStat[];
  segments: CustomerSegment[];
}

const MOCK_STATS: CustomerStat[] = [
  {
    label: t['admin.reports.customerAnalytics.metric.totalCustomers'],
    value: '2,847',
    change: '+8.2%',
    trend: 'up',
  },
  {
    label: t['admin.reports.customerAnalytics.metric.newThisMonth'],
    value: '142',
    change: '+15.3%',
    trend: 'up',
  },
  {
    label: t['admin.reports.customerAnalytics.metric.returnRate'],
    value: '34.2%',
    change: '+2.1%',
    trend: 'up',
  },
  {
    label: t['admin.reports.customerAnalytics.metric.activeCustomers'],
    value: '1,892',
    change: '-1.4%',
    trend: 'down',
  },
];

const MOCK_SEGMENTS: CustomerSegment[] = [
  { label: t['admin.reports.customerAnalytics.segment.frequent'], value: 34, color: '#059669' },
  { label: t['admin.reports.customerAnalytics.segment.occasional'], value: 28, color: '#0ea5e9' },
  { label: t['admin.reports.customerAnalytics.segment.new'], value: 22, color: '#8b5cf6' },
  { label: t['admin.reports.customerAnalytics.segment.inactive'], value: 16, color: '#94a3b8' },
];

let stats: CustomerStat[] = MOCK_STATS;
let segments: CustomerSegment[] = MOCK_SEGMENTS;
let dataSource: 'real' | 'mock' = 'mock';

try {
  const response = await Astro.fetch('/api/v1/admin/metrics/customers/segments', {
    credentials: 'include',
  });
  if (response.ok) {
    const payload = (await response.json()) as { data?: CustomerData };
    if (payload?.data?.stats && Array.isArray(payload.data.stats) && payload.data.stats.length > 0) {
      stats = payload.data.stats;
      segments = payload.data.segments;
      dataSource = 'real';
    }
  }
} catch {
  // Fallback silencioso
}

const chartId = `customer-analytics-${Math.random().toString(36).slice(2)}`;
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold text-slate-950">
        {t['admin.reports.customerAnalytics.heading']}
      </h2>
      <p class="text-sm text-slate-500">{t['admin.reports.customerAnalytics.subtitle']}</p>
    </div>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      stats.map((s) => (
        <div class="rounded-xl bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-500">{s.label}</p>
          <p class="mt-1 text-lg font-bold text-slate-950">{s.value}</p>
          <p
            class:list={[
              'mt-0.5 text-xs font-medium',
              s.trend === 'up' ? 'text-emerald-600' : 'text-rose-600',
            ]}
          >
            {s.trend === 'up' ? '↗' : '↘'} {s.change}
          </p>
        </div>
      ))
    }
  </div>

  <div class="flex items-center gap-6">
    <div class="relative h-40 w-40 shrink-0">
      <canvas id={chartId} data-segments={JSON.stringify(segments)}></canvas>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-xl font-bold text-slate-950">2,847</span>
        <span class="text-xs text-slate-500">
          {t['admin.reports.customerAnalytics.centerLabel.total']}
        </span>
      </div>
    </div>

    <div class="flex-1 space-y-3">
      {
        segments.map((s) => (
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`} />
              <span class="text-sm text-slate-600">{s.label}</span>
            </div>
            <span class="text-sm font-semibold text-slate-950">{s.value}%</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  document
    .querySelectorAll<HTMLCanvasElement>("canvas[id^='customer-analytics']")
    .forEach((canvas) => {
      const segments = JSON.parse(canvas.dataset.segments || '[]');

      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: segments.map((s: { label: string }) => s.label),
          datasets: [
            {
              data: segments.map((s: { value: number }) => s.value),
              backgroundColor: segments.map((s: { color: string }) => s.color),
              borderWidth: 0,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: '70%',
          plugins: {
            legend: { display: false },
            tooltip: { enabled: false },
          },
        },
      });
    });
</script>
