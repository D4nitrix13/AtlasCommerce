---
/**
 * SalesPerformanceCard — Métricas clave de ventas para el tenant admin.
 *
 * Widget del dashboard admin con:
 *   - 4 KPI cards (Total vendido, Ticket promedio, Tasa conv., Devoluciones)
 *   - 1 chart semanal (Lun-Dom con valores en currency cents format)
 *
 * **MOCK DATA con fallback**: server-side fetch via `Astro.fetch()` a
 * `GET /api/v1/admin/metrics/sales/performance`. Si 404 / falla,
 * fallback a MOCK data hardcoded. Mismo patron que RevenueOverviewCard.
 *
 * **Uso**: Dashboard admin + reports page.
 *
 * **i18n**: heading + subtitle + las 4 KPI labels + el dataset label
 * del chart (que aparece en el tooltip) se traducen via diccionario.
 * El label del dataset se serializa via `data-*` para el script cliente.
 */
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface SalesMetric {
  label: string;
  value: string;
  change: string;
  trend: 'up' | 'down';
}

interface SalesPerformanceData {
  metrics: SalesMetric[];
  days: string[];
  values: number[];
}

const MOCK_METRICS: SalesMetric[] = [
  {
    label: t['admin.reports.salesPerformance.metric.totalSold'],
    value: '$48,295',
    change: '+12.5%',
    trend: 'up',
  },
  {
    label: t['admin.reports.salesPerformance.metric.avgTicket'],
    value: '$34.20',
    change: '+5.3%',
    trend: 'up',
  },
  {
    label: t['admin.reports.salesPerformance.metric.conversionRate'],
    value: '3.8%',
    change: '-0.4%',
    trend: 'down',
  },
  {
    label: t['admin.reports.salesPerformance.metric.returns'],
    value: '2.1%',
    change: '-0.8%',
    trend: 'up',
  },
];

const MOCK_DAYS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const MOCK_VALUES = [4200, 3800, 5100, 4600, 6200, 7800, 5400];

let metrics: SalesMetric[] = MOCK_METRICS;
let days: string[] = MOCK_DAYS;
let values: number[] = MOCK_VALUES;

try {
  const response = await Astro.fetch('/api/v1/admin/metrics/sales/performance', {
    credentials: 'include',
  });
  if (response.ok) {
    const payload = (await response.json()) as { data?: SalesPerformanceData };
    if (payload?.data?.metrics && Array.isArray(payload.data.metrics) && payload.data.metrics.length > 0) {
      metrics = payload.data.metrics;
      days = payload.data.days;
      values = payload.data.values;
    }
  }
} catch {
  // Fallback silencioso a MOCK data
}

const chartId = `sales-performance-${Math.random().toString(36).slice(2)}`;
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold text-slate-950">
        {t['admin.reports.salesPerformance.heading']}
      </h2>
      <p class="text-sm text-slate-500">{t['admin.reports.salesPerformance.subtitle']}</p>
    </div>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      metrics.map((m) => (
        <div class="rounded-xl bg-slate-50 p-3">
          <p class="text-xs font-medium text-slate-500">{m.label}</p>
          <p class="mt-1 text-lg font-bold text-slate-950">{m.value}</p>
          <p
            class:list={[
              'mt-0.5 text-xs font-medium',
              m.trend === 'up' ? 'text-emerald-600' : 'text-rose-600',
            ]}
          >
            {m.trend === 'up' ? '↗' : '↘'} {m.change}
          </p>
        </div>
      ))
    }
  </div>

  <div class="h-[240px]">
    <canvas
      id={chartId}
      data-days={JSON.stringify(days)}
      data-values={JSON.stringify(values)}
      data-dataset-label={t['admin.reports.salesPerformance.datasetLabel.sales']}
    ></canvas>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  document
    .querySelectorAll<HTMLCanvasElement>("canvas[id^='sales-performance']")
    .forEach((canvas) => {
      const days = JSON.parse(canvas.dataset.days || '[]');
      const values = JSON.parse(canvas.dataset.values || '[]');
      const datasetLabel = canvas.dataset.datasetLabel ?? '';

      new Chart(canvas, {
        type: 'bar',
        data: {
          labels: days,
          datasets: [
            {
              label: datasetLabel,
              data: values,
              backgroundColor: '#059669',
              borderRadius: 8,
              barThickness: 32,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false,
            },
            tooltip: {
              callbacks: {
                label(context) {
                  const y = context.parsed.y ?? 0;
                  return '$' + y.toLocaleString();
                },
              },
            },
          },
          scales: {
            x: {
              grid: {
                display: false,
              },
              ticks: {
                color: '#64748b',
              },
            },
            y: {
              border: {
                display: false,
              },
              grid: {
                color: '#e5e7eb',
              },
              ticks: {
                color: '#64748b',
                callback(value) {
                  const n = typeof value === 'number' ? value : Number(value);
                  return '$' + Number(n / 1000) + 'k';
                },
              },
            },
          },
        },
      });
    });
</script>
