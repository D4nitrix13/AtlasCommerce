---
/**
 * RecentActivityCard — Lista de eventos recientes en el dashboard admin.
 *
 * MOCK data con 5 items fijos. Migrar a fetch a
 * `/api/v1/admin/metrics/activity/recent` en sesion futura.
 *
 * **i18n**: heading + subtitle + viewAll localizados. Los textos
 * individuales de cada actividad (`activities[].text`) NO se traducen
 * porque son contenido dinamico del backend (eventos especificos del
 * tenant: "Nueva orden #ORD-1042 recibida", etc).
 *
 * Decision consciente: NO traducimos las `activities[].text` MOCK. La
 * razon es que cuando se conecte al endpoint real, estos textos ya
 * vendran traducidos desde el backend (o seran templates tipo
 * "Nueva orden #{id} recibida" con `{id}` interpolado). Traducirlos
 * aca seria duplicar trabajo y asumir conocimiento que el backend
 * debe poseer.
 */
import Icon from '../../ui/Icon.astro';
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

const activities = [
  {
    icon: 'shopping-cart',
    text: 'Nueva orden #ORD-1042 recibida',
    time: 'Hace 5 min',
    color: 'bg-emerald-100 text-emerald-600',
  },
  {
    icon: 'user',
    text: 'Cliente registrado: María García',
    time: 'Hace 12 min',
    color: 'bg-sky-100 text-sky-600',
  },
  {
    icon: 'bolt',
    text: 'Pago de $125.00 confirmado',
    time: 'Hace 28 min',
    color: 'bg-amber-100 text-amber-600',
  },
  {
    icon: 'cube',
    text: 'Envío #SHP-892 entregado',
    time: 'Hace 1 h',
    color: 'bg-violet-100 text-violet-600',
  },
  {
    icon: 'star',
    text: 'Reseña 5★ en Camiseta Kitsune',
    time: 'Hace 2 h',
    color: 'bg-rose-100 text-rose-600',
  },
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-950">
        {t['admin.dashboard.recentActivity.heading']}
      </h2>
      <p class="text-sm text-slate-500">{t['admin.dashboard.recentActivity.subtitle']}</p>
    </div>
    <a href="#" class="text-sm font-medium text-emerald-600 hover:underline">
      {t['admin.dashboard.recentActivity.viewAll']}
    </a>
  </div>

  <div class="space-y-4">
    {activities.map((a) => (
      <div class="flex items-start gap-3">
        <div class:list={['mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg', a.color]}>
          <Icon name={a.icon} class="h-4 w-4" />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-sm text-slate-700">{a.text}</p>
          <p class="text-xs text-slate-400">{a.time}</p>
        </div>
      </div>
    ))}
  </div>
</section>
