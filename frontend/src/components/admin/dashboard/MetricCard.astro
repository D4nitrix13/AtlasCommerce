---
/**
 * MetricCard — Card individual de metric para dashboard + reports.
 *
 * Usado en /admin/dashboard (4 cards principales: Ventas, Visitas, etc)
 * y en /admin/reports (cards secundarios). 8+ instancias en el repo.
 *
 * Variantes por `accent`: emerald (default) | sky | amber | rose.
 * La accent mapea a color Tailwind del icon background (left circle).
 *
 * Variantes por `trend`: 'up' (verde, flecha ↗) | 'down' (rose, flecha ↘).
 *
 * **AGENTS.md §12** (validar datos): usar `?? 0` o `?? ''` para evitar
 * renders rotos cuando falta data.
 *
 * Ejemplo:
 * ```astro
 * <MetricCard
 *   title="Ventas"
 *   value="$2,540"
 *   change="+12%"
 *   trend="up"
 *   icon="chart-bar"
 *   accent="emerald"
 * />
 * ```
 */
import Icon from '../../ui/Icon.astro';

interface Props {
  /** Label descriptivo de la metrica (visible en H3) */
  title: string;
  /** Valor destacado formateado por caller (ej: '$2,540', '18,420') */
  value: string;
  /** Delta vs periodo anterior (ej: '+12%', '-5%') */
  change: string;
  /** Direccion del cambio — afecta color y flecha */
  trend?: 'up' | 'down';
  /** Nombre del icono lucide */
  icon?: string;
  /** Color de acento del icon background */
  accent?: 'emerald' | 'sky' | 'amber' | 'rose';
}

const { title, value, change, trend = 'up', icon = 'chart-bar', accent = 'emerald' } = Astro.props;

const accentClasses = {
  emerald: 'bg-emerald-50 text-emerald-600',
  sky: 'bg-sky-50 text-sky-600',
  amber: 'bg-amber-50 text-amber-600',
  rose: 'bg-rose-50 text-rose-600',
};
---

<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500">{title}</p>
      <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
        {value}
      </h3>
    </div>

    <div class:list={['grid h-11 w-11 place-items-center rounded-2xl', accentClasses[accent]]}>
      <Icon name={icon} class="h-5 w-5" />
    </div>
  </div>

  <div class="mt-3 flex items-center gap-1 text-sm">
    <span class={trend === 'up' ? 'text-emerald-600' : 'text-rose-600'}>
      {trend === 'up' ? '↗' : '↘'}
      {change}
    </span>

    <span class="text-slate-400">vs mes anterior</span>
  </div>

  <div class="mt-5 h-10">
    <svg viewBox="0 0 220 40" class="h-full w-full">
      <path
        d="M0 30 C20 20, 35 35, 55 24 C75 14, 90 28, 110 18 C135 5, 150 25, 170 13 C190 4, 205 11, 220 6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class={accent === 'emerald'
          ? 'text-emerald-500'
          : accent === 'sky'
            ? 'text-sky-500'
            : accent === 'amber'
              ? 'text-amber-500'
              : 'text-rose-500'}></path>
    </svg>
  </div>
</article>
