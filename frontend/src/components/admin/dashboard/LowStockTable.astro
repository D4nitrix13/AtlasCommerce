---
/**
 * LowStockTable — Alertas de inventario bajo (widget del dashboard admin).
 *
 * Lista los productos con stock <= threshold (default 10). Cada fila
 * muestra: nombre, SKU, unidades restantes, y badge de estado
 * (Critico <5 | Bajo <10 | Normal >=10).
 *
 * **MOCK DATA**: hardcoded con 4 productos placeholder. Pendiente
 * refactor: la fuente real es InventoryController del backend y un
 * endpoint dedicado (no existe hoy). Cuando se implemente:
 *   - GET /api/v1/admin/inventory/low-stock?threshold=10
 *   - Eager-loads product + variant (el stock puede ser variant-level)
 *   - Paginacion si hay mas de N alerts
 *
 * **Uso**: Dashboard admin (entre MetricCards principales y
 * RecentOrdersTable abajo).
 *
 * **AGENTS.md §11**: MOCK data estatico, no requiere loading/error.
 * **AGENTS.md §16**: vive en `components/admin/dashboard/`.
 */
const products = [
  {
    name: 'Camiseta Kitsune Edición Limitada',
    sku: 'KIT-CS-001',
    stock: 3,
    status: 'Crítico',
    statusColor: 'bg-rose-100 text-rose-700',
  },
  {
    name: 'Sudadera Negra Oversize',
    sku: 'KIT-SD-003',
    stock: 5,
    status: 'Bajo',
    statusColor: 'bg-amber-100 text-amber-700',
  },
  {
    name: 'Gorra Bordada Kitsune',
    sku: 'KIT-GO-002',
    stock: 8,
    status: 'Bajo',
    statusColor: 'bg-amber-100 text-amber-700',
  },
  {
    name: 'Taza Personalizada Logo',
    sku: 'KIT-TZ-001',
    stock: 12,
    status: 'Normal',
    statusColor: 'bg-emerald-100 text-emerald-700',
  },
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-950">Stock bajo</h2>
      <p class="text-sm text-slate-500">Productos que necesitan reposición</p>
    </div>
    <a href="/admin/inventory/stock" class="text-sm font-medium text-emerald-600 hover:underline">
      Ver todo →
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr
          class="border-b border-slate-100 text-xs font-medium uppercase tracking-wider text-slate-500"
        >
          <th class="pb-3 pr-4">Producto</th>
          <th class="pb-3 pr-4">SKU</th>
          <th class="pb-3 pr-4 text-center">Stock</th>
          <th class="pb-3">Estado</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        {
          products.map((p) => (
            <tr class="group hover:bg-slate-50/50">
              <td class="py-3 pr-4 font-medium text-slate-900">{p.name}</td>
              <td class="py-3 pr-4 font-mono text-xs text-slate-500">{p.sku}</td>
              <td class="py-3 pr-4 text-center font-semibold text-slate-950">{p.stock}</td>
              <td class="py-3">
                <span
                  class:list={[
                    'inline-block rounded-full px-2.5 py-0.5 text-xs font-medium',
                    p.statusColor,
                  ]}
                >
                  {p.status}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
