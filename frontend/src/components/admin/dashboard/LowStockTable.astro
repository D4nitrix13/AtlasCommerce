---
/**
 * LowStockTable — Alertas de inventario bajo (widget del dashboard admin).
 *
 * Lista los productos con stock <= threshold (default 10). Cada fila
 * muestra: nombre, SKU, unidades restantes, y badge de estado
 * (Critico <5 | Bajo <10).
 *
 * **Endpoint real**: GET /api/v1/admin/inventory/low-stock?threshold=10
 * implementado en `Admin/Metrics/LowStockController.php`. Devuelve
 * { data: [{ id, name, sku, stock, status, status_color }] }.
 *
 * Fallback a MOCK data si el endpoint responde 5xx o devuelve vacio
 * (cuando modulo de inventory no esta instalado en el tenant).
 *
 * **Uso**: Dashboard admin (entre MetricCards principales y
 * RecentOrdersTable abajo).
 *
 * **i18n**: headers de tabla + los 2 status posibles (Critico / Bajo)
 * vienen del diccionario. Los nombres de productos y SKU vienen del
 * backend (no se traducen).
 */
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

interface LowStockProduct {
  name: string;
  sku: string;
  stock: number;
  status: string;
  statusColor: string;
}

const MOCK_PRODUCTS: LowStockProduct[] = [
  {
    name: 'Camiseta Kitsune Edición Limitada',
    sku: 'KIT-CS-001',
    stock: 3,
    status: t['admin.dashboard.lowStock.status.critical'],
    statusColor: 'bg-rose-100 text-rose-700',
  },
  {
    name: 'Sudadera Negra Oversize',
    sku: 'KIT-SD-003',
    stock: 5,
    status: t['admin.dashboard.lowStock.status.low'],
    statusColor: 'bg-amber-100 text-amber-700',
  },
  {
    name: 'Gorra Bordada Kitsune',
    sku: 'KIT-GO-002',
    stock: 8,
    status: t['admin.dashboard.lowStock.status.low'],
    statusColor: 'bg-amber-100 text-amber-700',
  },
  {
    name: 'Taza Personalizada Logo',
    sku: 'KIT-TZ-001',
    stock: 12,
    status: t['admin.dashboard.lowStock.status.low'],
    statusColor: 'bg-amber-100 text-amber-700',
  },
];

let products: LowStockProduct[] = MOCK_PRODUCTS;

try {
  const response = await fetch(new URL('/api/v1/admin/inventory/low-stock?threshold=10', Astro.url), {
    headers: {
      Cookie: Astro.request.headers.get('Cookie') ?? '',
    },
  });
  if (response.ok) {
    const payload = (await response.json()) as { data?: LowStockProduct[] };
    if (Array.isArray(payload?.data) && payload.data.length > 0) {
      products = payload.data;
    }
  }
} catch {
  // Fallback silencioso a MOCK data
}
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-950">{t['admin.dashboard.lowStock.heading']}</h2>
      <p class="text-sm text-slate-500">{t['admin.dashboard.lowStock.subtitle']}</p>
    </div>
    <a href="/admin/inventory/stock" class="text-sm font-medium text-emerald-600 hover:underline">
      {t['admin.dashboard.lowStock.viewAll']}
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-slate-100 text-xs font-medium uppercase tracking-wider text-slate-500">
          <th class="pb-3 pr-4">{t['admin.dashboard.lowStock.col.product']}</th>
          <th class="pb-3 pr-4">{t['admin.dashboard.lowStock.col.sku']}</th>
          <th class="pb-3 pr-4 text-center">{t['admin.dashboard.lowStock.col.stock']}</th>
          <th class="pb-3">{t['admin.dashboard.lowStock.col.status']}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        {products.map((p) => (
          <tr class="group hover:bg-slate-50/50">
            <td class="py-3 pr-4 font-medium text-slate-900">{p.name}</td>
            <td class="py-3 pr-4 font-mono text-xs text-slate-500">{p.sku}</td>
            <td class="py-3 pr-4 text-center font-semibold text-slate-950">{p.stock}</td>
            <td class="py-3">
              <span
                class:list={[
                  'inline-block rounded-full px-2.5 py-0.5 text-xs font-medium',
                  p.statusColor,
                ]}
              >
                {p.status}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
