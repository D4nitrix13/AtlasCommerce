---
/**
 * KpiCardV3 — Tarjeta KPI para el dashboard v3 (Bonfire mockup 11).
 *
 * Una sola metrica: titulo eyebrow arriba, valor grande debajo, delta
 * pill arriba a la derecha (color segun trend), y contexto al pie.
 *
 * Tokens (replican el mockup 11 a 1:1):
 *   - Card: `bg-white rounded-2xl border border-slate-200 p-6`.
 *   - Eyebrow: `text-[13px] font-medium text-slate-500`.
 *   - Value: `text-3xl font-bold tabular-nums text-slate-900`
 *     (mockup usa `text-4xl` pero en una grilla de 4 columnas se
 *     romperia; validado visualmente con `text-3xl` y un maximo de
 *     ~8 chars).
 *   - Delta pill: `rounded-full px-2.5 py-0.5 text-xs font-semibold`
 *     con bg verde para up, bg rojo para down.
 *   - Contexto: `text-[13px] text-slate-400`.
 *
 * Datos: la card es **presentational**. El caller (composition del page)
 * le pasa los strings ya formateados. Esto evita acoplar la card al
 * formateador de moneda y permite usar el mismo componente para
 * conversiones, conteos, porcentajes — cualquier KPI.
 *
 * Accesibilidad (AGENTS.md §17):
 *   - `<article>` semantico (no `<div>`), sin enlace.
 *   - El delta es texto real (no icono solo) — lectores de pantalla
 *     lo anuncian y `aria-label` lo refuerza con el contexto.
 *   - El arrow character (`↗` / `↘`) es decorativo (`aria-hidden`).
 */
type Trend = 'up' | 'down' | 'flat';

interface Props {
  /** Etiqueta del KPI (ej: "Ingresos", "Pedidos"). */
  label: string;
  /** Valor ya formateado por el caller (ej: "$184.320", "1.247"). */
  value: string;
  /** Texto del delta (ej: "+12% vs mes anterior"). */
  delta: string;
  /** Direccion del delta. Cambia color y flecha. */
  trend?: Trend;
  /** Texto i18n del contexto al pie (ej: "vs periodo anterior"). */
  context: string;
  /** ID opcional para `data-testid`. */
  testId?: string;
}

const { label, value, delta, trend = 'up', context, testId } = Astro.props;

const TREND_DELTA_CLASSES: Record<Trend, string> = {
  up: 'bg-emerald-50 text-[var(--primary,#2d9d8e)]',
  down: 'bg-red-50 text-red-700',
  flat: 'bg-slate-100 text-slate-600',
};

const ARROW: Record<Trend, string> = {
  up: '\u2197', // ↗
  down: '\u2198', // ↘
  flat: '\u2192', // →
};

const deltaClass = TREND_DELTA_CLASSES[trend];
const arrow = ARROW[trend];
const ariaTrend = trend === 'down' ? 'cambio negativo' : 'cambio positivo';
---

<article
  data-testid={testId ?? 'kpi-card-v3'}
  class="rounded-2xl border border-slate-200 bg-white p-6"
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-[13px] font-medium text-slate-500">{label}</p>
    <span
      class:list={[
        'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold',
        deltaClass,
      ]}
      aria-label={`${ariaTrend}: ${delta}`}
    >
      <span aria-hidden="true">{arrow}</span>
      {delta}
    </span>
  </div>

  <p class="mt-3 text-3xl font-bold tabular-nums tracking-tight text-slate-900">{value}</p>

  <p class="mt-1.5 text-[13px] text-slate-400">{context}</p>
</article>
