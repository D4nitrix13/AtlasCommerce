---
/**
 * RecentOrdersTable — Tabla de orders recientes en el dashboard admin.
 *
 * **MOCK DATA**: el array `orders` está hardcoded con 6 orders de ejemplo
 * (cliente, ID, producto, status, amount, status color). NO está
 * conectado al backend todavía — pendiente para sesión futura migrarlo
 * a `fetch` de `frontend/src/lib/api.ts` con datos reales del tenant.
 *
 * **Uso**: Lives en `pages/[locale]/admin/dashboard.astro` como
 * widget secundario (debajo de metric cards + charts principales).
 *
 * **AGENTS.md §16**: este componente vive en `components/admin/dashboard/`.
 *
 * **AGENTS.md §11 — UI states**: NO implementa loading/error porque
 * son datos estáticos hardcoded. Cuando se conecte a la API, agregar:
 *   - skeleton mientras carga
 *   - banner error si fetch falla
 *   - empty state si array está vacío
 *   - "Ver más" link a `/admin/sales/orders` si hay más de N rows
 */
const orders = [
  {
    customer: 'Carlos López',
    id: '#ORD-1042',
    product: 'Camiseta Kitsune Edición Limitada',
    status: 'Pagado',
    amount: '$45.00',
    statusColor: 'bg-emerald-100 text-emerald-700',
  },
  {
    customer: 'Ana Martínez',
    id: '#ORD-1041',
    product: 'Taza personalizada Logo',
    status: 'Pendiente',
    amount: '$18.00',
    statusColor: 'bg-amber-100 text-amber-700',
  },
  {
    customer: 'Roberto Sánchez',
    id: '#ORD-1040',
    product: 'Sudadera Kitsune Negra',
    status: 'Enviado',
    amount: '$89.00',
    statusColor: 'bg-sky-100 text-sky-700',
  },
  {
    customer: 'Laura Díaz',
    id: '#ORD-1039',
    product: 'Gorra bordada',
    status: 'Pagado',
    amount: '$32.00',
    statusColor: 'bg-emerald-100 text-emerald-700',
  },
  {
    customer: 'Miguel Herrera',
    id: '#ORD-1038',
    product: 'Pack 3 playeras básicas',
    status: 'Entregado',
    amount: '$75.00',
    statusColor: 'bg-violet-100 text-violet-700',
  },
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-950">Órdenes recientes</h2>
      <p class="text-sm text-slate-500">Últimas transacciones de tu tienda</p>
    </div>
    <a href="/admin/sales/orders" class="text-sm font-medium text-emerald-600 hover:underline">
      Ver todo →
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr
          class="border-b border-slate-100 text-xs font-medium uppercase tracking-wider text-slate-500"
        >
          <th class="pb-3 pr-4">Cliente</th>
          <th class="pb-3 pr-4">Orden</th>
          <th class="pb-3 pr-4">Producto</th>
          <th class="pb-3 pr-4">Estado</th>
          <th class="pb-3 text-right">Monto</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        {
          orders.map((o) => (
            <tr class="group hover:bg-slate-50/50">
              <td class="py-3 pr-4 font-medium text-slate-900">{o.customer}</td>
              <td class="py-3 pr-4 text-slate-500">{o.id}</td>
              <td class="max-w-[200px] truncate py-3 pr-4 text-slate-600">{o.product}</td>
              <td class="py-3 pr-4">
                <span
                  class:list={[
                    'inline-block rounded-full px-2.5 py-0.5 text-xs font-medium',
                    o.statusColor,
                  ]}
                >
                  {o.status}
                </span>
              </td>
              <td class="py-3 text-right font-semibold text-slate-950">{o.amount}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
