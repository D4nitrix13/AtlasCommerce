---
/**
 * RevenueChart — Chart.js line chart de revenue mensual en el dashboard admin.
 *
 * Usa `<canvas>` con `data-labels` + `data-values` (JSON-encoded) como
 * DOM data attributes. El `<script>` al final del componente hidrata
 * el chart via Chart.js/auto (lazy import via Vite). Multi-tenant safe:
 * chartId random por instancia para evitar colisiones si hay multiples
 * charts en la misma page.
 *
 * **MOCK DATA**: `labels` (12 meses) + `values` (revenue por mes) hardcoded.
 * Migrar a `Astro.fetch('/api/v1/admin/metrics/revenue/monthly')` en sesion
 * futura. Mismo patron que RevenueOverviewCard (commit actual).
 *
 * **AGENTS.md §18** (performance): Chart.js dynamic import = codigo se
 * carga solo cuando el componente se monta (no en el bundle inicial).
 *
 * **Toggle UI** (Ingresos/Ordenes/Ganancia): los 3 botones existen pero
 * solo "Ingresos" renderiza datos reales. Los otros 2 son placeholder
 * para switch entre dataset del mismo endpoint o 3 endpoints distintos.
 *
 * **AGENTS.md §11**: NO implementa loading/error (MOCK data).
 *
 * **i18n**: todas las labels visibles vienen del diccionario del locale.
 * Los strings que necesita el script del cliente se serializan via
 * `data-*` desde el SSR para que Chart.js los reciba ya traducidos.
 */
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

const chartId = `revenue-chart-${Math.random().toString(36).slice(2)}`;

const labels = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
const values = [18000, 22000, 20000, 28000, 32000, 30000, 36000, 38000, 42000, 40000, 45000, 48000];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold text-slate-950">{t['admin.dashboard.revenueChart.heading']}</h2>
      <p class="text-sm text-slate-500">{t['admin.dashboard.revenueChart.subtitle']}</p>
    </div>

    <div class="flex rounded-xl bg-slate-100 p-1 text-xs font-medium">
      <button class="rounded-lg bg-white px-3 py-1.5 shadow-sm">
        {t['admin.dashboard.revenueChart.toggle.income']}
      </button>
      <button class="px-3 py-1.5 text-slate-500">
        {t['admin.dashboard.revenueChart.toggle.orders']}
      </button>
      <button class="px-3 py-1.5 text-slate-500">
        {t['admin.dashboard.revenueChart.toggle.profit']}
      </button>
    </div>
  </div>

  <div class="h-[360px]">
    <canvas
      id={chartId}
      data-labels={JSON.stringify(labels)}
      data-values={JSON.stringify(values)}
      data-dataset-label={t['admin.dashboard.revenueChart.datasetLabel.income']}
    ></canvas>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  document.querySelectorAll<HTMLCanvasElement>("canvas[id^='revenue-chart']").forEach((canvas) => {
    const labels = JSON.parse(canvas.dataset.labels || '[]');
    const values = JSON.parse(canvas.dataset.values || '[]');
    const datasetLabel = canvas.dataset.datasetLabel ?? '';

    new Chart(canvas, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: datasetLabel,
            data: values,
            fill: true,
            tension: 0.45,
            borderWidth: 2,
            pointRadius: 0,
            borderColor: '#059669',
            backgroundColor: 'rgba(5, 150, 105, 0.10)',
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false,
          },
        },
        scales: {
          x: {
            grid: {
              display: false,
            },
            ticks: {
              color: '#64748b',
            },
          },
          y: {
            border: {
              display: false,
            },
            grid: {
              color: '#e5e7eb',
            },
            ticks: {
              color: '#64748b',
              callback(value) {
                const n = typeof value === 'number' ? value : Number(value);
                return '$' + Number(n / 1000) + 'k';
              },
            },
          },
        },
      },
    });
  });
</script>
