---
/**
 * TopProductsV3 — Lista de los 5 productos mas vendidos para el dashboard v3.
 *
 * Replica la seccion "Top productos" del mockup Bonfire (vista 11):
 * avatar/icono + nombre + unidades vendidas + revenue por fila.
 *
 * Composicion:
 *   - Icono SVG decorativo en avatar `bg-[var(--primary-soft)]` (mismo
 *     patron que el mockup). El icono es estatico y solo decorativo
 *     (`aria-hidden`).
 *   - Datos vienen pre-formateados del caller.
 *
 * Datos:
 *   - `products` viene del caller. Por ahora son mock estaticos hasta
 *     que el endpoint de top products este disponible para v3.
 *
 * Accesibilidad:
 *   - Lista `<ul>/<li>` no semantica: usamos `<dl>` para cada fila
 *     (termino: nombre producto, definicion: unidades + revenue).
 *   - Cada fila es un bloque visual pero la info core vive en `<dt>`
 *     (screen readers leen "Playera Premium 342 unidades vendidas
 *     $6.148").
 */
interface ProductRow {
  /** Nombre del producto. */
  name: string;
  /** Unidades vendidas, ya formateado (ej "342", "1.2K"). */
  unitsLabel: string;
  /** Revenue, ya formateado (ej "$6.148", "$4.752"). */
  revenueLabel: string;
}

interface Props {
  /** Titulo i18n del bloque. */
  heading: string;
  /** Sufijo de unidades (e.g. "und. vendidas"). */
  unitsSuffix: string;
  /** Filas a renderizar. */
  products: readonly ProductRow[];
}

const { heading, unitsSuffix, products } = Astro.props;
---

<section
  aria-labelledby="top-products-v3-heading"
  class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7"
>
  <h2
    id="top-products-v3-heading"
    class="mb-5 text-lg font-bold text-slate-900 sm:text-xl"
  >
    {heading}
  </h2>

  <ul class="space-y-4">
    {
      products.map((product) => (
        <li class="flex items-center gap-4">
          <span
            class="grid h-11 w-11 shrink-0 place-items-center rounded-xl"
            style="background: var(--primary-soft, #e6f7f4)"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="var(--primary, #2d9d8e)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18" />
              <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
          </span>

          <div class="min-w-0 flex-1">
            <p class="truncate text-[14px] font-bold text-slate-900">{product.name}</p>
            <p class="text-[13px] text-slate-400">
              {product.unitsLabel} {unitsSuffix}
            </p>
          </div>

          <span class="text-[14px] font-bold tabular-nums text-slate-900">
            {product.revenueLabel}
          </span>
        </li>
      ))
    }
  </ul>
</section>
