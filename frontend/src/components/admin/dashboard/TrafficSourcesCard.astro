---
/**
 * TrafficSourcesCard — Donut chart de sources de trafico en dashboard admin.
 *
 * Variante small del `TrafficOverviewCard` (que vive en reports page).
 * Mismo shape de data (sources[]), distinta presentacion: solo el donut
 * con label center overlay ("Visitas: 284K"). NO reimplementa — viene
 * de la misma fuente eventual.
 *
 * **MOCK DATA**: hardcoded. Endpoint backend esperado cuando se
 * migre: mismo `GET /api/v1/admin/metrics/traffic/sources` que el
 * widget grande (TrafficOverviewCard).
 *
 * Diferencias con TrafficOverviewCard:
 *   - Sin lista de top 5 pages (solo donut + label center)
 *   - Sin leyenda lateral (la leyenda vive abajo del chart)
 *
 * **AGENTS.md §11**: MOCK data estatico.
 *
 * **i18n**: las 4 leyendas se traducen via keys `admin.dashboard.trafficSources.legend.*`
 * y se serializan al script del cliente via `data-*` para que el doughnut
 * reciba los labels ya localizados (Chart.js los muestra en tooltips).
 */
import { getServerDictionary } from '../../../i18n/server';

const t = getServerDictionary(Astro.locals.locale);

const chartId = `traffic-chart-${Math.random().toString(36).slice(2)}`;

const sources = [
  { value: 35, color: '#059669', legendKey: 'admin.dashboard.trafficSources.legend.direct' as const },
  { value: 28, color: '#0ea5e9', legendKey: 'admin.dashboard.trafficSources.legend.organic' as const },
  { value: 22, color: '#6366f1', legendKey: 'admin.dashboard.trafficSources.legend.referral' as const },
  { value: 15, color: '#f43f5e', legendKey: 'admin.dashboard.trafficSources.legend.social' as const },
].map((s) => ({ ...s, label: t[s.legendKey] }));
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="mb-1 text-lg font-bold text-slate-950">
    {t['admin.dashboard.trafficSources.heading']}
  </h2>
  <p class="mb-6 text-sm text-slate-500">{t['admin.dashboard.trafficSources.subtitle']}</p>

  <div class="flex items-center gap-6">
    <div class="relative h-44 w-44 shrink-0">
      <canvas id={chartId} data-sources={JSON.stringify(sources)}></canvas>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="text-2xl font-bold text-slate-950">284K</span>
        <span class="text-xs text-slate-500">
          {t['admin.dashboard.trafficSources.centerLabel.visits']}
        </span>
      </div>
    </div>

    <div class="flex-1 space-y-3">
      {
        sources.map((s) => (
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`} />
              <span class="text-sm text-slate-600">{s.label}</span>
            </div>
            <span class="text-sm font-semibold text-slate-950">{s.value}%</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  document.querySelectorAll<HTMLCanvasElement>("canvas[id^='traffic-chart']").forEach((canvas) => {
    const sources = JSON.parse(canvas.dataset.sources || '[]');

    new Chart(canvas, {
      type: 'doughnut',
      data: {
        labels: sources.map((s: { label: string }) => s.label),
        datasets: [
          {
            data: sources.map((s: { value: number }) => s.value),
            backgroundColor: sources.map((s: { color: string }) => s.color),
            borderWidth: 0,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '70%',
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false },
        },
      },
    });
  });
</script>
