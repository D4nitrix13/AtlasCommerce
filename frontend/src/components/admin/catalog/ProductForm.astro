---
/**
 * ProductForm — Form multi-sección para crear/editar producto.
 *
 * 5 secciones con tabs (Baymard / Shopify Admin pattern):
 *  - basics: nombre, descripción, categoría, marca, SKU, status
 *  - variants: lista de variantes (color/tamaño/stock/precio)
 *  - media: uploader múltiple con drag-drop
 *  - pricing: precio, compare-at, costo, peso
 *  - seo: título SEO, descripción SEO, slug
 *
 * El componente renderiza un nav de tabs sticky al top + el contenido
 * de cada tab en un panel. Sin JS de switching (los tabs son anchor
 * links que navegan a la misma página con `?tab=xxx`); cuando exista
 * el backend, el padre hidrata tabs client-side para mejor UX.
 *
 * AGENTS.md §1: este archivo orquesta los sub-componentes (basics /
 * variants / media / pricing / seo). Variants vive en
 * `ProductVariantsSection.astro` para mantener el archivo ~150 líneas.
 */
import Input from '../../ui/Input.astro';
import Textarea from '../../ui/Textarea.astro';
import Select from '../../ui/Select.astro';
import Button from '../../ui/Button.astro';
import MediaUploader from './MediaUploader.astro';
import ProductVariantsSection from './ProductVariantsSection.astro';
import {
  type ProductMock,
  type ProductStatus,
  BRANDS_MOCK,
  CATEGORIES_MOCK,
  getVariantsByProductId,
} from '../../../data/catalog-mock';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  /** Cuando se edita, el producto a popular. `null` para crear. */
  product?: ProductMock | null;
  /** Tab activo al renderizar (default: basics). */
  activeTab?: 'basics' | 'variants' | 'media' | 'pricing' | 'seo';
  /** Submit label (varía entre "Crear" y "Guardar cambios"). */
  submitLabel?: string;
}

const {
  product = null,
  activeTab = 'basics',
  submitLabel,
} = Astro.props;

const t = getServerDictionary(Astro.locals.locale);

const isEdit = product !== null;
const productVariants = isEdit ? getVariantsByProductId(product.id) : [];

const TABS = [
  { id: 'basics', label: t['admin.catalog.products.detail.tabs.basics'] },
  { id: 'variants', label: t['admin.catalog.products.detail.tabs.variants'] },
  { id: 'media', label: t['admin.catalog.products.detail.tabs.media'] },
  { id: 'pricing', label: t['admin.catalog.products.detail.tabs.pricing'] },
  { id: 'seo', label: t['admin.catalog.products.detail.tabs.seo'] },
] as const;

const STATUS_OPTIONS: { value: ProductStatus; label: string }[] = [
  { value: 'active', label: t['admin.catalog.products.status.active'] },
  { value: 'draft', label: t['admin.catalog.products.status.draft'] },
  { value: 'archived', label: t['admin.catalog.products.status.archived'] },
];

const categoryOptions = CATEGORIES_MOCK.map((c) => ({
  value: String(c.id),
  label: c.name,
}));

const brandOptions = BRANDS_MOCK.map((b) => ({
  value: String(b.id),
  label: b.name,
}));

const finalSubmitLabel =
  submitLabel ?? (isEdit ? t['admin.catalog.common.save'] : t['admin.catalog.products.create.submit']);

function formatCents(cents: number): string {
  return (cents / 100).toFixed(2);
}
---

<form
  method="post"
  class="space-y-6"
  data-product-form
  data-product-id={isEdit ? product!.id : ''}
  novalidate
>
  <nav
    aria-label={t['admin.catalog.products.detail.title']}
    class="sticky top-0 z-10 -mx-1 flex flex-wrap gap-1 rounded-lg border border-slate-200 bg-white px-1 py-1"
  >
    {
      TABS.map((tab) => {
        const isActive = tab.id === activeTab;
        return (
          <a
            href={`?tab=${tab.id}${isEdit ? `&id=${product!.id}` : ''}`}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-1.5 text-xs font-medium transition',
              isActive
                ? 'bg-violet-100 text-violet-800'
                : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
            ]}
          >
            {tab.label}
          </a>
        );
      })
    }
  </nav>

  {activeTab === 'basics' && (
    <section aria-labelledby="tab-basics" class="grid gap-5 sm:grid-cols-2">
      <h2 id="tab-basics" class="sr-only">{t['admin.catalog.products.detail.tabs.basics']}</h2>
      <div class="sm:col-span-2">
        <Input
          name="name"
          label={t['admin.catalog.products.form.name']}
          value={isEdit ? product!.name : ''}
          required
        />
      </div>
      <div class="sm:col-span-2">
        <Textarea
          name="description"
          label={t['admin.catalog.products.form.description']}
          value={isEdit ? product!.description : ''}
          rows={4}
        />
      </div>
      <Input
        name="sku"
        label={t['admin.catalog.products.form.sku']}
        value={isEdit ? product!.sku : ''}
        hint={t['admin.catalog.products.form.skuHelp']}
        required
      />
      <Select
        name="status"
        label={t['admin.catalog.products.form.status']}
        options={STATUS_OPTIONS}
        value={isEdit ? product!.status : 'active'}
      />
      <Select
        name="categoryId"
        label={t['admin.catalog.products.form.category']}
        options={categoryOptions}
        value={isEdit ? String(product!.categoryId) : undefined}
      />
      <Select
        name="brandId"
        label={t['admin.catalog.products.form.brand']}
        options={brandOptions}
        value={isEdit ? String(product!.brandId) : undefined}
      />
    </section>
  )}

  {activeTab === 'variants' && <ProductVariantsSection variants={productVariants} />}

  {activeTab === 'media' && (
    <section aria-labelledby="tab-media">
      <h2 id="tab-media" class="sr-only">{t['admin.catalog.products.detail.tabs.media']}</h2>
      <MediaUploader initialImages={isEdit ? [product!.imageUrl] : []} />
    </section>
  )}

  {activeTab === 'pricing' && (
    <section aria-labelledby="tab-pricing" class="grid gap-5 sm:grid-cols-2">
      <h2 id="tab-pricing" class="sr-only">{t['admin.catalog.products.detail.tabs.pricing']}</h2>
      <Input
        name="priceCents"
        type="number"
        label={t['admin.catalog.products.form.price']}
        value={isEdit ? formatCents(product!.priceCents) : '0.00'}
      />
      <Input
        name="compareAtPriceCents"
        type="number"
        label={t['admin.catalog.products.form.compareAtPrice']}
        value={isEdit && product!.compareAtPriceCents ? formatCents(product!.compareAtPriceCents) : ''}
        hint={t['admin.catalog.products.form.compareAtPriceHelp']}
      />
      <Input
        name="costCents"
        type="number"
        label={t['admin.catalog.products.form.cost']}
        value={isEdit ? formatCents(product!.costCents) : '0.00'}
      />
      <Input
        name="stock"
        type="number"
        label={t['admin.catalog.products.form.stock']}
        value={isEdit ? String(product!.stock) : '0'}
      />
      <Input
        name="weightKg"
        type="number"
        label={t['admin.catalog.products.form.weight']}
        value={isEdit ? String(product!.weightKg) : '0'}
      />
    </section>
  )}

  {activeTab === 'seo' && (
    <section aria-labelledby="tab-seo" class="grid gap-5 sm:grid-cols-2">
      <h2 id="tab-seo" class="sr-only">{t['admin.catalog.products.detail.tabs.seo']}</h2>
      <div class="sm:col-span-2">
        <Input
          name="seoTitle"
          label={t['admin.catalog.products.form.seoTitle']}
          value={isEdit ? product!.seoTitle : ''}
        />
      </div>
      <div class="sm:col-span-2">
        <Textarea
          name="seoDescription"
          label={t['admin.catalog.products.form.seoDescription']}
          value={isEdit ? product!.seoDescription : ''}
          rows={3}
        />
      </div>
      <Input
        name="slug"
        label={t['admin.catalog.products.form.seoSlug']}
        value={isEdit ? product!.slug : ''}
        hint="auto-generado si se deja vacío"
      />
    </section>
  )}

  <div class="flex items-center justify-end gap-2 border-t border-slate-200 pt-4">
    <Button variant="ghost" type="button">
      {t['admin.catalog.common.cancel']}
    </Button>
    <Button variant="primary" type="submit">
      {finalSubmitLabel}
    </Button>
  </div>
</form>