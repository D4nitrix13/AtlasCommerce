---
/**
 * BulkActionsBar — Top bar de acciones masivas para tablas admin.
 *
 * Patrón Baymard §7.2 / Shopify Admin: aparece cuando hay 1+ filas
 * seleccionadas, reemplaza el top bar normal. Acciones soportadas:
 * activate, deactivate, delete, export CSV.
 *
 * El componente NO es interactivo en este mock (solo se renderiza
 * condicionalmente según `count > 0`). El wiring real de bulk actions
 * se hace en la página padre vía JS cuando existan los endpoints
 * `POST /api/v1/admin/catalog/products/bulk`.
 *
 * AGENTS.md §1: ~80 líneas. Simple, sin lógica pesada.
 */
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  count: number;
  /** Entity type para los data-attrs (product, category, brand, variant). */
  entityType: 'product' | 'category' | 'brand' | 'variant';
}

const { count, entityType } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const isVisible = count > 0;
const countLabel = t['admin.catalog.bulk.actionsBar.count'].replace('{count}', String(count));
---

{isVisible && (
  <div
    role="region"
    aria-label={countLabel}
    data-bulk-bar
    data-entity-type={entityType}
    class:list={[
      'flex flex-wrap items-center justify-between gap-3 rounded-lg border border-violet-200 bg-violet-50 px-4 py-3',
    ]}
  >
    <div class="flex items-center gap-3">
      <span class="flex h-7 min-w-[28px] items-center justify-center rounded-full bg-violet-600 px-2 text-xs font-semibold text-white">
        {count}
      </span>
      <span class="text-sm font-medium text-slate-900">{countLabel}</span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-bulk-action="activate"
        class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        <span aria-hidden="true" class="text-emerald-600">
          ●
        </span>
        {t['admin.catalog.bulk.actions.activate']}
      </button>
      <button
        type="button"
        data-bulk-action="deactivate"
        class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        <span aria-hidden="true" class="text-slate-400">
          ●
        </span>
        {t['admin.catalog.bulk.actions.deactivate']}
      </button>
      <button
        type="button"
        data-bulk-action="export"
        class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        <span aria-hidden="true">↓</span>
        {t['admin.catalog.bulk.actions.export']}
      </button>
      <button
        type="button"
        data-bulk-action="delete"
        class="inline-flex items-center gap-1.5 rounded-md border border-red-200 bg-white px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
      >
        <span aria-hidden="true">🗑</span>
        {t['admin.catalog.bulk.actions.delete']}
      </button>
      <span class="mx-1 h-5 w-px bg-slate-300" aria-hidden="true" />
      <button
        type="button"
        data-bulk-clear
        class="text-xs font-medium text-slate-500 hover:text-slate-900 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500"
      >
        {t['admin.catalog.bulk.actionsBar.clear']}
      </button>
    </div>
  </div>
)}
