---
/**
 * ProductSpecsSection — Sección "Ficha técnica" del ProductForm.
 *
 * Wrapper Astro de la isla `ProductSpecsEditor`, que renderiza las
 * tablas editables de tallas/capacidades (product_sizes) y valores EAV
 * de atributos. El valor se formatea según el tipo del atributo en
 * `formatAttributeValue` (lib/product-specs).
 *
 * `productId === null` (alta de producto) deja la sección en solo
 * lectura: los endpoints de specs cuelgan de un producto existente.
 */
import ProductSpecsEditor from './ProductSpecsEditor';
import { type AttributeValueMock, type ProductSizeMock } from '../../../data/catalog-mock';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  /** Producto dueño de las specs; null en modo creación. */
  productId: number | null;
  sizes: readonly ProductSizeMock[];
  attributeValues: readonly AttributeValueMock[];
}

const { productId, sizes, attributeValues } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);
---

<section aria-labelledby="tab-specs" class="space-y-6">
  <h2 id="tab-specs" class="sr-only">
    {t['admin.catalog.products.detail.tabs.specs']}
  </h2>

  <ProductSpecsEditor
    client:visible
    productId={productId}
    initialSizes={sizes}
    initialAttributeValues={attributeValues}
  />
</section>
