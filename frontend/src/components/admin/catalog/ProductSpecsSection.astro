---
/**
 * ProductSpecsSection — Sección "Ficha técnica" del ProductForm.
 *
 * Dos tablas de solo lectura: tallas/capacidades (product_sizes) y
 * valores EAV de atributos. El valor se formatea según el tipo del
 * atributo en `formatAttributeValue` (lib/product-specs).
 *
 * AGENTS.md §1: ~110 líneas, mismo pattern visual que
 * `ProductVariantsSection.astro`.
 */
import { type AttributeValueMock, type ProductSizeMock } from '../../../data/catalog-mock';
import { SPECS_EMPTY_CELL, formatAttributeValue } from '../../../lib/product-specs';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  sizes: readonly ProductSizeMock[];
  attributeValues: readonly AttributeValueMock[];
}

const { sizes, attributeValues } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const hasSizes = sizes.length > 0;
const hasAttributes = attributeValues.length > 0;

const booleanLabels = {
  yes: t['admin.catalog.products.detail.specs.yes'],
  no: t['admin.catalog.products.detail.specs.no'],
};
---

<section aria-labelledby="tab-specs" class="space-y-6">
  <h2 id="tab-specs" class="sr-only">
    {t['admin.catalog.products.detail.tabs.specs']}
  </h2>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-slate-900">
      {t['admin.catalog.products.detail.specs.sizes']}
    </h3>
    {hasSizes ? (
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.slug']}</th>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.label']}</th>
              <th class="px-4 py-3 text-right font-medium">{t['admin.catalog.products.detail.specs.value']}</th>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.unit']}</th>
              <th class="px-4 py-3 text-right font-medium">{t['admin.catalog.products.detail.specs.position']}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {sizes.map((size) => (
              <tr class="hover:bg-slate-50/50">
                <td class="px-4 py-3 font-mono text-xs text-slate-600">{size.slug}</td>
                <td class="px-4 py-3 text-slate-700">{size.label}</td>
                <td class="px-4 py-3 text-right font-medium text-slate-900">
                  {size.value ?? SPECS_EMPTY_CELL}
                </td>
                <td class="px-4 py-3 text-slate-700">{size.unit ?? SPECS_EMPTY_CELL}</td>
                <td class="px-4 py-3 text-right text-slate-600">{size.position}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
        <p class="text-sm font-medium text-slate-700">
          {t['admin.catalog.products.detail.specs.emptySizes']}
        </p>
      </div>
    )}
  </div>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-slate-900">
      {t['admin.catalog.products.detail.specs.attributes']}
    </h3>
    {hasAttributes ? (
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.attribute']}</th>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.type']}</th>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.value']}</th>
              <th class="px-4 py-3 font-medium">{t['admin.catalog.products.detail.specs.unit']}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {attributeValues.map((attr) => (
              <tr class="hover:bg-slate-50/50">
                <td class="px-4 py-3 text-slate-700">{attr.label}</td>
                <td class="px-4 py-3 font-mono text-xs text-slate-600">{attr.type}</td>
                <td class="px-4 py-3 text-slate-900">
                  {formatAttributeValue(attr, booleanLabels)}
                </td>
                <td class="px-4 py-3 text-slate-700">{attr.unit ?? SPECS_EMPTY_CELL}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
        <p class="text-sm font-medium text-slate-700">
          {t['admin.catalog.products.detail.specs.emptyAttributes']}
        </p>
      </div>
    )}
  </div>
</section>
