---
/**
 * ProductVariantsSection — Sección "Variantes" del ProductForm.
 *
 * Tabla compacta de las variantes existentes del producto (SKU, color,
 * tamaño, stock, precio, estado). El CTA "Agregar variante" abre un
 * modal (no implementado en este mock — wired en F5.4 cuando exista
 * el endpoint POST /api/v1/admin/catalog/products/{id}/variants).
 *
 * AGENTS.md §1: ~80 líneas.
 */
import Badge from '../../ui/Badge.astro';
import Button from '../../ui/Button.astro';
import { type VariantMock } from '../../../data/catalog-mock';
import { getServerDictionary } from '../../../i18n/server';

interface Props {
  variants: readonly VariantMock[];
}

const { variants } = Astro.props;
const t = getServerDictionary(Astro.locals.locale);

const hasVariants = variants.length > 0;

function formatCents(cents: number): string {
  return (cents / 100).toFixed(2);
}
---

<section aria-labelledby="tab-variants" class="space-y-4">
  <h2 id="tab-variants" class="sr-only">
    {t['admin.catalog.products.detail.tabs.variants']}
  </h2>

  {hasVariants ? (
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3 font-medium">SKU</th>
            <th class="px-4 py-3 font-medium">Color</th>
            <th class="px-4 py-3 font-medium">Tamaño</th>
            <th class="px-4 py-3 text-right font-medium">Stock</th>
            <th class="px-4 py-3 text-right font-medium">Precio</th>
            <th class="px-4 py-3 font-medium">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {variants.map((variant) => (
            <tr class="hover:bg-slate-50/50">
              <td class="px-4 py-3 font-mono text-xs text-slate-600">{variant.sku}</td>
              <td class="px-4 py-3 text-slate-700">{variant.color}</td>
              <td class="px-4 py-3 text-slate-700">{variant.size}</td>
              <td class="px-4 py-3 text-right font-medium text-slate-900">{variant.stock}</td>
              <td class="px-4 py-3 text-right font-medium text-slate-900">
                ${formatCents(variant.priceCents)}
              </td>
              <td class="px-4 py-3">
                <Badge variant={variant.status === 'active' ? 'primary' : 'neutral'}>
                  {t[`admin.catalog.products.status.${variant.status}`]}
                </Badge>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
      <p class="text-sm font-medium text-slate-700">{t['admin.catalog.variants.emptyHint']}</p>
    </div>
  )}

  <Button variant="secondary" size="sm" type="button">
    {t['admin.catalog.variants.addVariant']}
  </Button>
</section>
