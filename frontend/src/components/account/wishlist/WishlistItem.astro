---
/**
 * WishlistItem — Card de "colección curada" (design-refs §6.2, ref Mejuri).
 *
 * Diferenciador crítico: este item NO es un ProductCard genérico.
 * Tiene contexto personal (cuándo se agregó, nota opcional) y
 * acciones contextuales (move to bag / remove / notify cuando vuelva
 * en stock).
 *
 * Sin handlers: las acciones son `<a>` (placeholder) + `<button>`
 * disabled placeholders hasta que el wishlist React island exista
 * en F5+ (out-of-scope F2.3). El componente es 100% presentacional.
 *
 * Layout:
 *   ┌──────────────────────────────────────────┐
 *   │  [ imagen ]                              │
 *   │  Nombre producto                         │
 *   │  $145.00                                 │
 *   │                                          │
 *   │  📅 guardada hace 14 días                │
 *   │  💬 Nota personal: "Para mi cumple"      │
 *   │                                          │
 *   │  [ Move to bag ] [ Remove ] [ Notify ]  │
 *   └──────────────────────────────────────────┘
 */
import { formatCurrency } from '../../../lib/formatters';

interface Props {
  /** Locale-prefixed href al detalle del producto. */
  productHref: string;
  productName: string;
  imageUrl: string;
  priceCents: number;
  currencyCode: string;
  addedDaysAgo: number;
  personalNote?: string;
  stock: number;
  notifyEnabled: boolean;
  /** Localized strings. */
  addedDaysAgoLabel: string;
  addedYesterdayLabel: string;
  addedTodayLabel: string;
  personalNoteLabel: string;
  outOfStockLabel: string;
  onlyLeftLabel: string;
  moveToBagLabel: string;
  removeLabel: string;
  notifyLabel: string;
}

const {
  productHref,
  productName,
  imageUrl,
  priceCents,
  currencyCode,
  addedDaysAgo,
  personalNote,
  stock,
  notifyEnabled,
  addedDaysAgoLabel,
  addedYesterdayLabel,
  addedTodayLabel,
  personalNoteLabel,
  outOfStockLabel,
  onlyLeftLabel,
  moveToBagLabel,
  removeLabel,
  notifyLabel,
} = Astro.props;

const priceFormatted = formatCurrency(priceCents, currencyCode);
const isOutOfStock = stock <= 0;
const isLowStock = !isOutOfStock && stock <= 3;

const addedLabel =
  addedDaysAgo === 0
    ? addedTodayLabel
    : addedDaysAgo === 1
      ? addedYesterdayLabel
      : addedDaysAgoLabel.replace('{days}', String(addedDaysAgo));
---

<article
  class="group flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md"
>
  <a
    href={productHref}
    class="relative block aspect-square overflow-hidden rounded-xl bg-slate-50"
    aria-label={productName}
  >
    <img
      src={imageUrl}
      alt={productName}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    {
      isOutOfStock && (
        <div class="absolute right-2 top-2 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">
          {outOfStockLabel}
        </div>
      )
    }
  </a>

  <div class="flex flex-col gap-1">
    <h3 class="line-clamp-2 text-sm font-semibold text-slate-900">
      <a
        href={productHref}
        class="transition hover:text-[var(--primary,#7c3aed)] focus-visible:outline-none focus-visible:underline"
      >
        {productName}
      </a>
    </h3>
    <p class="text-base font-bold tabular-nums text-slate-900">{priceFormatted}</p>
  </div>

  <div class="flex flex-col gap-1 border-t border-slate-100 pt-2 text-xs text-slate-500">
    <p>
      <span aria-hidden="true">📅</span>
      <span class="ml-1.5">{addedLabel}</span>
    </p>
    {
      personalNote !== undefined && personalNote !== '' && (
        <p class="flex items-start gap-1.5">
          <span aria-hidden="true" class="mt-0.5 shrink-0">
            💬
          </span>
          <span class="flex flex-col gap-0.5">
            <span class="font-medium uppercase tracking-wider text-slate-400">
              {personalNoteLabel}
            </span>
            <span class="italic text-slate-600">"{personalNote}"</span>
          </span>
        </p>
      )
    }
  </div>

  {
    isLowStock && (
      <p
        class="rounded-md bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800"
        role="status"
      >
        {onlyLeftLabel.replace('{count}', String(stock))}
      </p>
    )
  }

  <div class="mt-auto flex flex-col gap-2 pt-2">
    <a
      href={productHref}
      aria-disabled={isOutOfStock ? 'true' : undefined}
      class:list={[
        'inline-flex h-9 items-center justify-center gap-1 rounded-lg px-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2',
        isOutOfStock
          ? 'pointer-events-none cursor-not-allowed bg-slate-100 text-slate-400'
          : 'bg-[var(--primary,#7c3aed)] text-white shadow-sm hover:bg-[var(--primary-hover,#6d28d9)]',
      ]}
    >
      {moveToBagLabel}
    </a>
    <div class="flex items-center justify-between gap-2 text-xs">
      {
        isOutOfStock && notifyEnabled ? (
          <button
            type="button"
            disabled
            aria-label={`${notifyLabel}: ${productName}`}
            class="inline-flex flex-1 items-center justify-center rounded-md border border-slate-200 bg-white px-2 py-1.5 font-medium text-slate-600 transition hover:border-slate-300 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {notifyLabel}
          </button>
        ) : (
          <span class="flex-1" />
        )
      }
      <button
        type="button"
        disabled
        aria-label={`${removeLabel}: ${productName}`}
        class="inline-flex items-center justify-center rounded-md px-2 py-1.5 font-medium text-slate-500 transition hover:bg-red-50 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        {removeLabel}
      </button>
    </div>
  </div>
</article>
