---
/**
 * RecentOrdersTable — ledger de últimos trabajos (rediseño job-ticket).
 *
 * Checkpoint de diseño:
 *   Intent:   "qué pasó últimamente" en un ledger de taller: tickets,
 *             fechas, etapas con chips de tinta, piezas y totales.
 *   Hierarchy: tier 2 — debajo de la tira de producción; el heading
 *             es quieto y la tabla es densa (no cards).
 *   Palette:  papel levantado; chips de tinta semánticos; total en
 *             ink, no en color.
 *   Depth:    una hoja `paper-card` (sombras en capas, sin bordes
 *             duros); filas separadas por `--edge-soft`.
 *   Type:     micro-labels para columnas (11px tracked), 14px body,
 *             totales tabular-nums/600.
 *   Spacing:  denso: 16px celdas, 24px en el header de la sección.
 *
 * Empty-safe: sin tickets la sección entera no se renderiza (el vacío
 * diseñado vive en `StudioEmptyState`, dentro de ProductionStrip).
 */
import type { ProductionTicket } from '../../../types/dashboard-kpis';
import type { TranslationKey } from '../../../i18n/types';
import { formatDate } from '../../../lib/formatters';
import InkChip from './InkChip.astro';

interface Props {
  tickets: ProductionTicket[];
  localePrefix: string;
  t: Record<TranslationKey, string>;
}

const { tickets, localePrefix, t } = Astro.props;

const RECENT_LIMIT = 5;
const visibleTickets = tickets.slice(0, RECENT_LIMIT);
const hasTickets = visibleTickets.length > 0;
---

{hasTickets && (
  <section aria-labelledby="recent-orders-heading" data-testid="recent-orders-section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="recent-orders-heading" class="text-[22px]">
        {t['account.dashboard.ledger.heading']}
      </h2>
      <a
        href={`${localePrefix}/account/orders`}
        class="pressable inline-flex min-h-10 items-center gap-1.5 px-1 text-sm font-semibold text-[var(--primary)] hover:underline"
        data-testid="recent-orders-view-all"
      >
        {t['account.dashboard.ledger.viewAll']}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="paper-card mt-4 overflow-hidden" data-reveal>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left" data-testid="recent-orders-table">
          <thead>
            <tr class="border-b" style="border-color:var(--edge)">
              <th class="micro-label px-5 py-3.5 font-medium">
                {t['account.dashboard.ledger.column.ticket']}
              </th>
              <th class="micro-label px-5 py-3.5 font-medium">
                {t['account.dashboard.ledger.column.date']}
              </th>
              <th class="micro-label px-5 py-3.5 font-medium">
                {t['account.dashboard.ledger.column.stage']}
              </th>
              <th class="micro-label px-5 py-3.5 text-right font-medium">
                {t['account.dashboard.ledger.column.pieces']}
              </th>
              <th class="micro-label px-5 py-3.5 text-right font-medium">
                {t['account.dashboard.ledger.column.total']}
              </th>
            </tr>
          </thead>
          <tbody>
            {visibleTickets.map((ticket) => (
              <tr
                class="border-b transition-colors last:border-b-0 hover:bg-[var(--paper-sunken)]"
                style="border-color:var(--edge-soft)"
                data-order-id={ticket.orderId}
                data-testid="recent-orders-row"
              >
                <td class="px-5 py-4">
                  <a
                    href={`${localePrefix}/account/orders/${ticket.orderId}`}
                    class="pressable inline-flex min-h-10 items-center text-sm font-semibold text-[var(--ink)] hover:text-[var(--primary)] hover:underline"
                  >
                    #{ticket.orderId}
                  </a>
                </td>
                <td class="whitespace-nowrap px-5 py-4 text-sm text-[var(--ink-muted)]">
                  {formatDate(ticket.placedAt)}
                </td>
                <td class="whitespace-nowrap px-5 py-4">
                  <InkChip status={ticket.status} t={t} />
                </td>
                <td class="whitespace-nowrap px-5 py-4 text-right text-sm tabular-nums text-[var(--ink-muted)]">
                  {ticket.pieces}
                </td>
                <td class="whitespace-nowrap px-5 py-4 text-right text-sm font-semibold tabular-nums">
                  {ticket.totalLabel}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}
