---
/**
 * RecentOrdersTable — Tabla de últimas 5 órdenes (v3, Bonfire).
 *
 * Reemplaza al viejo `OrderStatusCard` (que mostraba cards 1-por-orden
 * en grid 3 cols) por una `<table>` semántica con scroll horizontal
 * en mobile. El mockup 03-account-dashboard v3 pide 4 columnas:
 * orden / fecha / estado (pill) / total.
 *
 * Diferencia con la v1:
 *   - Era 3 cards en grid, una por orden (limitación: la card "ganaba"
 *     mucho espacio y mostraba info redundante). La v3 es 1 tabla
 *     compacta de 5 órdenes → más densidad de información, mejor
 *     escaneabilidad de "qué pasó recientemente" (Baymard §2.6).
 *
 * Tokens:
 *   - Header row: `bg-[var(--primary-soft)]` para que la fila destaque
 *     contra el resto (mockup §3).
 *   - Body rows: hover con `bg-cream-100/60` (cream = fondo editorial
 *     del mockup, no slate).
 *   - Borders: `border-cream-300` (más cálido que slate-200, match con
 *     el resto del dashboard).
 *   - Status pill: reutilizamos los mismos tonos que `OrderStatusCard`
 *     para que el lenguaje sea consistente entre vistas.
 *
 * Empty-safe: si `orders` está vacío, no se renderiza la tabla; se
 * renderiza un mensaje de empty state.
 */
import type { OrderStatus, RecentOrderMock } from '../../../data/account-mock';
import type { TranslationKey } from '../../../i18n/types';
import { formatCurrency, formatDate } from '../../../lib/formatters';

interface Props {
  orders: RecentOrderMock[];
  localePrefix: string;
  currencyCode: string | null;
  t: Record<TranslationKey, string>;
}

const { orders, localePrefix, currencyCode, t } = Astro.props;

// Mostramos hasta 5 órdenes (spec v3). El padre puede pasar más — la
// tabla se recorta acá para mantener el contrato visual estable.
const RECENT_ORDERS_LIMIT = 5;
const visibleOrders = orders.slice(0, RECENT_ORDERS_LIMIT);

const hasOrders = visibleOrders.length > 0;

const statusColor: Record<OrderStatus, string> = {
  pending: 'bg-amber-50 text-amber-600',
  processing: 'bg-violet-100 text-violet-800',
  shipped: 'bg-cyan-100 text-cyan-800',
  delivered: 'bg-emerald-50 text-emerald-700',
  cancelled: 'bg-red-50 text-red-700',
};

const statusLabelKey: Record<OrderStatus, TranslationKey> = {
  pending: 'account.orderStatus.pending',
  processing: 'account.orderStatus.processing',
  shipped: 'account.orderStatus.shipped',
  delivered: 'account.orderStatus.delivered',
  cancelled: 'account.orderStatus.cancelled',
};
---

<section
  aria-labelledby="recent-orders-heading"
  data-testid="recent-orders-section"
  class="flex flex-col gap-4"
>
  <div class="flex items-end justify-between gap-4">
    <h2 id="recent-orders-heading" class="text-2xl font-bold tracking-tight text-slate-900">
      {t['account.dashboard.v3.recentOrders.heading']}
    </h2>
    {hasOrders && (
      <a
        href={`${localePrefix}/account/orders`}
        class="text-sm font-semibold text-[var(--primary,#2D9D8E)] hover:underline"
        data-testid="recent-orders-view-all"
      >
        {t['account.dashboard.v3.recentOrders.viewAll']}
      </a>
    )}
  </div>

  {hasOrders ? (
    <div
      data-reveal-stagger
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-sm" data-testid="recent-orders-table">
          <thead style="background:var(--primary-soft,#E6F7F4)">
            <tr>
              <th class="px-4 py-3 text-[12px] font-bold uppercase tracking-wide text-slate-600">
                {t['account.dashboard.recentOrdersTable.column.order']}
              </th>
              <th class="px-4 py-3 text-[12px] font-bold uppercase tracking-wide text-slate-600">
                {t['account.dashboard.recentOrdersTable.column.date']}
              </th>
              <th class="px-4 py-3 text-[12px] font-bold uppercase tracking-wide text-slate-600">
                {t['account.dashboard.recentOrdersTable.column.status']}
              </th>
              <th class="px-4 py-3 text-right text-[12px] font-bold uppercase tracking-wide text-slate-600">
                {t['account.dashboard.recentOrdersTable.column.total']}
              </th>
            </tr>
          </thead>
          <tbody>
            {visibleOrders.map((order) => (
              <tr
                class="border-t border-slate-200 transition hover:bg-slate-50"
                data-order-id={order.id}
                data-testid="recent-orders-row"
              >
                <td class="whitespace-nowrap px-4 py-4 font-semibold text-slate-900">
                  <a
                    href={`${localePrefix}/account/orders/${order.id}`}
                    class="hover:text-[var(--primary,#2D9D8E)] hover:underline"
                  >
                    #{order.id}
                  </a>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-slate-500">{formatDate(order.date)}</td>
                <td class="whitespace-nowrap px-4 py-4">
                  <span
                    class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide',
                      statusColor[order.status],
                    ]}
                  >
                    {t[statusLabelKey[order.status]]}
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right font-bold text-slate-900">
                  {formatCurrency(order.total, currencyCode)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <p
      class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-500"
      data-testid="recent-orders-empty"
    >
      {t['account.dashboard.v3.recentOrders.empty']}
    </p>
  )}
</section>
