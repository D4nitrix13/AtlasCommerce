---
/**
 * KpiGrid — Wrapper del top row de KPIs (F5.5).
 *
 * Layout responsive: 2 columnas en mobile (grid-cols-2), 4 columnas en
 * lg+. Replica el `.grid.grid-cols-2.lg:grid-cols-4.gap-4.mb-10.stagger`
 * del mockup 03-account-dashboard.
 *
 * Stagger animation: cada `KpiCard` recibe `data-reveal-stagger` para
 * integrarse con el sistema de scroll-driven animations ya presente
 * en storefront/home (ver commit previo `feat(frontend): data-reveal
 * IntersectionObserver`). Si el JS del observer no carga, los cards
 * siguen siendo visibles (fail-open).
 */
import type { DashboardKpi } from '../../../types/dashboard-kpis';
import type { TranslationKey } from '../../../i18n/types';
import KpiCard from './KpiCard.astro';

interface Props {
  kpis: DashboardKpi[];
  t: Record<TranslationKey, string>;
}

const { kpis, t } = Astro.props;
---

<section aria-label="Resumen del cliente" class="mb-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
  {kpis.map((kpi) => (
    <div data-reveal-stagger class="contents">
      <KpiCard kpi={kpi} t={t} />
    </div>
  ))}
</section>
