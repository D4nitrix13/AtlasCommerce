---
/**
 * AddressesSnapshot — Sección 6 del dashboard rediseñado (F2.2).
 *
 * Resumen compacto de las direcciones del cliente. Lista 1 dirección
 * primaria (default) + badge. Si hay 0 direcciones, el page NO
 * renderiza este componente (per spec §7) — el CTA "Agregar
 * primera dirección" vive en /account/addresses.
 *
 * Spec: `docs/frontend/account-dashboard-spec.md` §4.6.
 */
import type { AddressSnapshotItem } from '../../../lib/server/account';
import type { TranslationKey } from '../../../i18n/types';

interface Props {
  addresses: AddressSnapshotItem[];
  total: number;
  viewAllLabel: string;
  viewAllHref: string;
  t: Record<TranslationKey, string>;
}

const { addresses, total, viewAllLabel, viewAllHref, t } = Astro.props;

const primary = addresses.find((a) => a.isPrimary) ?? addresses[0] ?? null;
const countText = t['account.dashboard.addresses.count'].replace('{count}', String(total));
---

<section
  aria-labelledby="addresses-snapshot-heading"
  data-testid="addresses-snapshot"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
>
  <header class="flex items-center justify-between gap-2">
    <h2 id="addresses-snapshot-heading" class="text-base font-semibold text-slate-900">
      {t['account.dashboard.addresses.heading']}
      <span class="ml-1 text-sm font-normal text-slate-500">({countText})</span>
    </h2>
    <a
      href={viewAllHref}
      class="text-sm font-medium text-[var(--primary,#059669)] hover:underline"
    >
      {viewAllLabel} →
    </a>
  </header>

  {primary !== null && (
    <div class="mt-3 flex items-center gap-2">
      <span class="font-mono text-xs text-slate-500 uppercase">
        {primary.addressType}
      </span>
      <span class="text-sm text-slate-800">
        {primary.label}
      </span>
      {primary.isPrimary && (
        <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-800">
          {t['account.dashboard.addresses.default']}
        </span>
      )}
    </div>
  )}
</section>