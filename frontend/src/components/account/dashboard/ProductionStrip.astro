---
/**
 * ProductionStrip — la tira de producción: FOCAL del dashboard.
 *
 * Checkpoint de diseño:
 *   Intent:   "¿dónde está mi stuff?" — una orden de trabajo (job
 *             ticket) de taller de estampados: kraft header, rail de
 *             etapas, chips de tinta. Humano pero exacto.
 *   Hierarchy: ES el focal — gana por tamaño (paper-card-hero),
 *             contraste (banda kraft) y aire. Todo lo demás se demote.
 *   Palette:  papel levantado, banda kraft, tintas semánticas, y
 *             `--primary` solo en el anillo de etapa actual + CTA.
 *   Depth:    estrategia única de sombras en capas (`--lift-2`).
 *   Type:     eyebrow 11px tracked, orden en Fraunces 36-40px,
 *             total 28-32px tabular-nums.
 *   Spacing:  8px base; 24-40px padding; 32px entre bloques.
 *
 * Empty-safe: sin trabajos activos se renderiza `StudioEmptyState`
 * (variant 'idle' si hay historial, 'first' si nunca hubo pedidos).
 */
import type { ProductionTicket } from '../../../types/dashboard-kpis';
import type { TranslationKey } from '../../../i18n/types';
import { formatDate } from '../../../lib/formatters';
import InkChip from './InkChip.astro';
import ProductionRail from './ProductionRail.astro';
import RegistrationMarks from './RegistrationMarks.astro';
import StudioEmptyState from './StudioEmptyState.astro';

interface Props {
  tickets: ProductionTicket[];
  localePrefix: string;
  t: Record<TranslationKey, string>;
}

const { tickets, localePrefix, t } = Astro.props;

const isActiveTicket = (ticket: ProductionTicket): boolean =>
  ticket.stageIndex >= 0 && ticket.status !== 'delivered';
const activeTickets = tickets.filter(isActiveTicket);
const hero = activeTickets[0] ?? null;
const otherTickets = activeTickets.slice(1);
const lastTicket = tickets[0] ?? null;

const catalogHref = `${localePrefix}/products`;
const quoteHref = `${localePrefix}/rfq/new`;
const lastOrderLabel = lastTicket ? `#${lastTicket.orderId}` : '—';
const lastOrderHref = lastTicket
  ? `${localePrefix}/account/orders/${lastTicket.orderId}`
  : catalogHref;
---

<section aria-labelledby="production-strip-heading" data-testid="production-strip">
  <h2 id="production-strip-heading" class="sr-only">
    {t['account.dashboard.ticket.eyebrow']}
  </h2>

  {hero === null ? (
    <StudioEmptyState
      variant={lastTicket === null ? 'first' : 'idle'}
      t={t}
      catalogHref={catalogHref}
      quoteHref={quoteHref}
      lastOrderLabel={lastOrderLabel}
      reorderHref={lastOrderHref}
    />
  ) : (
    <div class="flex flex-col gap-6">
      <article
        class="paper-card-hero relative overflow-hidden"
        data-reveal
        data-testid="hero-ticket"
      >
        <RegistrationMarks />

        {/* Banda kraft — cabecera del orden de trabajo. */}
        <header class="kraft-band flex flex-wrap items-center justify-between gap-3 px-6 py-3 lg:px-10">
          <p class="micro-label" style="color:var(--ink-soft)">
            {t['account.dashboard.ticket.eyebrow']}
            <span aria-hidden="true" class="mx-1.5 text-[var(--ink-faint)]">
              ·
            </span>
            <span data-testid="hero-ticket-id">#{hero.orderId}</span>
          </p>
          <InkChip status={hero.status} t={t} />
        </header>

        <div class="flex flex-col gap-8 px-6 py-8 lg:px-10 lg:py-10">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="micro-label">{t['account.dashboard.ticket.open']}</p>
              <p
                class="mt-2 font-display text-4xl leading-none tracking-tight lg:text-[44px]"
                data-testid="hero-ticket-number"
              >
                #{hero.orderId}
              </p>
              <p class="mt-3 text-[13px] text-[var(--ink-muted)]">
                {t['account.dashboard.ticket.pieces'].replace('{count}', String(hero.pieces))}
                <span aria-hidden="true" class="mx-1.5 text-[var(--ink-faint)]">
                  ·
                </span>
                {t['account.dashboard.ticket.placedOn'].replace(
                  '{date}',
                  formatDate(hero.placedAt)
                )}
              </p>
            </div>
            <div class="text-right">
              <p class="micro-label">{t['account.dashboard.ledger.column.total']}</p>
              <p class="mt-2 text-3xl font-semibold tabular-nums lg:text-[32px]">
                {hero.totalLabel}
              </p>
            </div>
          </div>

          <ProductionRail stageIndex={hero.stageIndex} placedAt={hero.placedAt} t={t} />

          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`${localePrefix}/account/orders/${hero.orderId}`}
              class="pressable inline-flex min-h-10 items-center rounded-[10px] px-5 py-2.5 text-sm font-semibold text-white"
              style="background:var(--primary)"
              data-testid="hero-ticket-view"
            >
              {t['account.dashboard.ticket.view']}
            </a>
            <a
              href={catalogHref}
              class="pressable inline-flex min-h-10 items-center gap-2 rounded-[10px] border px-5 py-2.5 text-sm font-semibold text-[var(--ink)]"
              style="border-color:var(--edge-strong);background:var(--paper-raised)"
              data-testid="hero-ticket-reorder"
            >
              {t['account.dashboard.ticket.reorder']}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      {otherTickets.length > 0 && (
        <div data-testid="other-tickets">
          <p class="micro-label">{t['account.dashboard.ticket.more']}</p>
          <ul class="mt-3 flex flex-col gap-2" data-reveal-stagger>
            {otherTickets.map((ticket) => (
              <li class="paper-card flex flex-wrap items-center gap-x-5 gap-y-2 px-5 py-4">
                <a
                  href={`${localePrefix}/account/orders/${ticket.orderId}`}
                  class="pressable min-h-10 text-sm font-semibold text-[var(--ink)] hover:underline"
                >
                  #{ticket.orderId}
                </a>
                <p class="text-[13px] text-[var(--ink-muted)]">
                  {t['account.dashboard.ticket.pieces'].replace('{count}', String(ticket.pieces))}
                </p>
                <p class="text-[13px] text-[var(--ink-muted)]">{formatDate(ticket.placedAt)}</p>
                <span class="ml-auto flex items-center gap-4">
                  <InkChip status={ticket.status} t={t} />
                  <span class="text-sm font-semibold tabular-nums">{ticket.totalLabel}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</section>
