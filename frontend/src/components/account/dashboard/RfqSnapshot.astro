---
/**
 * RfqSnapshot — Sección 3 del dashboard rediseñado (F2.2).
 *
 * Sección B2B de cotizaciones pendientes de aprobación. Si
 * `pendingCount === 0` o `null` (endpoint no disponible), el page
 * NO renderiza este componente (per spec §7).
 *
 * Spec: `docs/frontend/account-dashboard-spec.md` §4.3.
 */
import type { TranslationKey } from '../../../i18n/types';

interface Props {
  pendingCount: number;
  viewAllLabel: string;
  viewAllHref: string;
  t: Record<TranslationKey, string>;
}

const { pendingCount, viewAllLabel, viewAllHref, t } = Astro.props;

const summaryText = t['account.dashboard.rfqs.summary'].replace('{count}', String(pendingCount));
---

<section
  aria-labelledby="rfqs-heading"
  data-testid="rfq-snapshot"
  class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5"
>
  <h2 id="rfqs-heading" class="text-sm font-semibold uppercase tracking-wide text-amber-900">
    {t['account.dashboard.rfqs.heading']}
  </h2>
  <p class="mt-2 text-base text-slate-800">
    {summaryText}
  </p>
  <a
    href={viewAllHref}
    class="mt-3 inline-flex text-sm font-medium text-amber-800 hover:underline"
  >
    {viewAllLabel} →
  </a>
</section>