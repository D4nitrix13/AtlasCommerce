---
/**
 * OrderStatusCard — Card de pedido en la sección hero del dashboard.
 *
 * Spec: `docs/frontend/account-dashboard-spec.md` §4.2. Una card por
 * pedido (máximo 3 en el hero del dashboard). Diseño compacto con
 * status pill, ETA, total, y acción primaria.
 */
import type { OrderStatus } from '../../../data/account-mock';
import type { TranslationKey } from '../../../i18n/types';

interface Props {
  orderId: string;
  status: OrderStatus;
  etaLabel: string;
  itemsCount: number;
  totalCents: number;
  currencyCode: string | null;
  localePrefix: string;
  t: Record<TranslationKey, string>;
}

const { orderId, status, etaLabel, itemsCount, totalCents, currencyCode, localePrefix, t } =
  Astro.props;

const orderHref = `${localePrefix}/account/orders/${orderId}`;

// Colores semánticos del status pill (sincronizado con design-refs §4.2).
const statusColor: Record<OrderStatus, string> = {
  pending: 'bg-amber-100 text-amber-800 border-amber-200',
  processing: 'bg-violet-100 text-violet-800 border-violet-200',
  shipped: 'bg-cyan-100 text-cyan-800 border-cyan-200',
  delivered: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  cancelled: 'bg-red-100 text-red-800 border-red-200',
};

const statusLabelKey: Record<OrderStatus, TranslationKey> = {
  pending: 'account.orderStatus.pending',
  processing: 'account.orderStatus.processing',
  shipped: 'account.orderStatus.shipped',
  delivered: 'account.orderStatus.delivered',
  cancelled: 'account.orderStatus.cancelled',
};

const formatter = new Intl.NumberFormat(currencyCode === 'NIO' ? 'es-NI' : 'en-US', {
  style: 'currency',
  currency: currencyCode ?? 'USD',
  maximumFractionDigits: 2,
});
const totalFormatted = formatter.format(totalCents / 100);
---

<article
  data-testid="order-status-card"
  data-order-id={orderId}
  class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300"
>
  <header class="flex items-start justify-between gap-2">
    <span class="font-mono text-xs font-medium text-slate-500">
      {t['account.dashboard.recentOrders.orderId'].replace('{id}', orderId)}
    </span>
    <span
      class:list={[
        'rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide',
        statusColor[status],
      ]}
    >
      {t[statusLabelKey[status]]}
    </span>
  </header>

  <div class="flex flex-col gap-1.5">
    <p class="text-sm text-slate-600">
      <span class="text-slate-500">{t['account.dashboard.orders.etaLabel']}:</span>{' '}
      <span class="font-medium text-slate-800">{etaLabel}</span>
    </p>
    <p class="text-sm text-slate-600">
      <span class="text-slate-500">
        {t['account.dashboard.recentOrders.itemsCount'].replace('{count}', String(itemsCount))}
      </span>
    </p>
  </div>

  <footer class="flex items-end justify-between gap-2 border-t border-slate-100 pt-3">
    <span class="text-lg font-bold text-slate-900">{totalFormatted}</span>
    <a href={orderHref} class="text-sm font-medium text-[var(--primary,#059669)] hover:underline">
      {t['account.dashboard.recentOrders.viewDetail']} →
    </a>
  </footer>
</article>
