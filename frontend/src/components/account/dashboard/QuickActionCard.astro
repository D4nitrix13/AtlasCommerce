---
/**
 * QuickActionCard — Card de atajo con ícono grande para el dashboard
 * del cliente (Baymard §6.1: icon-based dashboard).
 *
 * Solo el 19% de los sitios usa este patrón — oportunidad de
 * diferenciación. La card NO tienta a explorar (§2.6 #4 "returning
 * users are task-oriented"): es un `<a>` directo a una tarea.
 *
 * Patrón visual:
 *   ┌───────────────────────┐
 *   │ [icon grande en box]  │ ← ícono en cuadrado tinted del brand
 *   │ Label en semibold     │
 *   │ Description muted     │
 *   └───────────────────────┘
 *   Opcional: badge absoluto top-right (ej: "3" tickets pendientes).
 *
 * Accesibilidad:
 *   - `<a>` real (AGENTS §17), no `<div onclick>`.
 *   - El label va como texto visible Y en `aria-label` para SR
 *     (algunos lectores leen link text + descripción, evitamos ruido).
 *   - El ícono es `aria-hidden` porque el label ya lo describe.
 *
 * Theme:
 *   - El fondo del ícono usa `var(--primary)` con alpha calculado via
 *     `color-mix`. Si el navegador no lo soporta (Safari < 16.2), cae
 *     a `bg-violet-50` como fallback visual.
 */
import Icon from '../../ui/Icon.astro';

interface Props {
  label: string;
  description: string;
  href: string;
  iconName: string;
  badge?: number | string;
}

const { label, description, href, iconName, badge } = Astro.props;

const hasBadge = badge !== undefined && badge !== null && badge !== '';
const badgeText = typeof badge === 'number' ? String(badge) : String(badge);
---

<a
  href={href}
  aria-label={description ? `${label} — ${description}` : label}
  class:list={[
    'group relative flex flex-col items-start gap-3 rounded-2xl border border-slate-200 bg-white p-5 transition-all',
    'hover:border-[var(--primary,#7c3aed)] hover:shadow-md',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2',
  ]}
>
  {hasBadge && (
    <span
      aria-label={`${badgeText} pendientes`}
      class="absolute -right-2 -top-2 flex h-6 min-w-[24px] items-center justify-center rounded-full bg-[var(--primary,#7c3aed)] px-2 text-xs font-semibold text-white shadow-sm"
    >
      {badgeText}
    </span>
  )}

  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--primary,#7c3aed)_12%,white)] text-[var(--primary,#7c3aed)] transition-colors group-hover:bg-[color-mix(in_srgb,var(--primary,#7c3aed)_18%,white)]">
    <Icon name={iconName} class="h-6 w-6" />
  </div>

  <div class="flex flex-col gap-1">
    <span class="text-base font-semibold text-slate-900">{label}</span>
    <span class="text-sm text-slate-500">{description}</span>
  </div>
</a>
