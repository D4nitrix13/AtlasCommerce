---
/**
 * RecentOrdersList — Mini lista de últimos N pedidos del cliente.
 *
 * Es la pieza más densa del dashboard. Por eso va en su propio archivo:
 * - Maneja estados loading/empty/error explícitamente (AGENTS §11).
 * - El formateo monetario viene del backend (cents → formatCentsAsDecimal).
 * - Las pills de status usan el Badge primitive (variants semánticas
 *   del design-refs §6.4).
 *
 * Limit a 5 por defecto (Baymard no especifica pero 5 es lo común en
 * account dashboards state-of-the-art). El page pasa `heading` y el
 * link "Ver todos" opcional.
 *
 * Accesibilidad:
 *   - `<ol>` semántica (los pedidos tienen orden cronológico).
 *   - Cada item es `<a>` real hacia el detalle.
 *   - Status pill es decorativa: el link usa `aria-label` con el
 *     status localizado para que el SR lo lea antes del monto.
 */
import Badge from '../../ui/Badge.astro';
import { formatDate, formatCentsAsDecimal } from '../../../lib/formatters';
import type { OrderStatus, RecentOrderMock } from '../../../data/account-mock';

interface Props {
  orders: RecentOrderMock[];
  heading: string;
  viewAllLabel: string;
  viewAllHref?: string;
  orderIdLabel: (id: string) => string;
  itemsCountLabel: (count: number) => string;
  viewDetailLabel: string;
  statusLabel: (status: OrderStatus) => string;
  emptyTitle: string;
  emptyHint: string;
  loading?: boolean;
  error?: boolean;
  loadingLabel: string;
  errorLabel: string;
}

const {
  orders,
  heading,
  viewAllLabel,
  viewAllHref,
  orderIdLabel,
  itemsCountLabel,
  viewDetailLabel,
  statusLabel,
  emptyTitle,
  emptyHint,
  loading = false,
  error = false,
  loadingLabel,
  errorLabel,
} = Astro.props;

const hasOrders = !loading && !error && orders.length > 0;
---

<section
  aria-labelledby="recent-orders-heading"
  class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm"
>
  <header class="mb-4 flex items-center justify-between gap-3">
    <h2 id="recent-orders-heading" class="text-base font-semibold text-slate-900 sm:text-lg">
      {heading}
    </h2>
    {viewAllHref && (
      <a
        href={viewAllHref}
        class="text-sm font-medium text-[var(--primary,#7c3aed)] hover:underline"
      >
        {viewAllLabel}
      </a>
    )}
  </header>

  {loading && (
    <p class="py-8 text-center text-sm text-slate-500" role="status">
      {loadingLabel}
    </p>
  )}

  {error && !loading && (
    <p class="py-8 text-center text-sm text-red-600" role="alert">
      {errorLabel}
    </p>
  )}

  {hasOrders && (
    <ol class="divide-y divide-slate-100">
      {orders.map((order) => (
        <li>
          <a
            href={`${viewAllHref ?? ''}/${order.id}`}
            aria-label={`${orderIdLabel(order.id)} — ${statusLabel(order.status)} — ${formatCentsAsDecimal(order.total, 'USD')}`}
            class="group flex items-center gap-3 py-3 transition-colors hover:bg-slate-50/60 sm:gap-4"
          >
            <div class="flex min-w-0 flex-1 flex-col gap-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-medium text-slate-900 group-hover:text-[var(--primary,#7c3aed)]">
                  {orderIdLabel(order.id)}
                </span>
                <Badge status={order.status} label={statusLabel(order.status)} />
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <time datetime={order.date}>{formatDate(order.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{itemsCountLabel(order.items)}</span>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2 sm:gap-3">
              <span class="text-sm font-semibold text-slate-900 sm:text-base">
                {formatCentsAsDecimal(order.total, 'USD')}
              </span>
              <span class="hidden text-xs text-[var(--primary,#7c3aed)] sm:inline">
                {viewDetailLabel}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )}

  {!loading && !error && !hasOrders && (
    <div class="py-10 text-center">
      <p class="text-sm font-medium text-slate-900">{emptyTitle}</p>
      <p class="mt-1 text-xs text-slate-500">{emptyHint}</p>
    </div>
  )}
</section>
