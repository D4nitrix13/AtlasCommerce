---
/**
 * SecuritySnapshot — Sección 7 del dashboard rediseñado (F2.2).
 *
 * Snapshot inline de seguridad: status de 2FA + last login. Una sola
 * línea, no expandible (los detalles viven en /account/security).
 *
 * Spec: `docs/frontend/account-dashboard-spec.md` §4.7.
 */
import type { TranslationKey } from '../../../i18n/types';

interface Props {
  twoFactorEnabled: boolean;
  lastSignInLabel: string;
  viewDetailLabel: string;
  viewDetailHref: string;
  t: Record<TranslationKey, string>;
}

const {
  twoFactorEnabled,
  lastSignInLabel,
  viewDetailLabel,
  viewDetailHref,
  t,
} = Astro.props;
---

<section
  aria-labelledby="security-snapshot-heading"
  data-testid="security-snapshot"
  class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 shadow-sm"
>
  <h2 id="security-snapshot-heading" class="sr-only">
    {t['account.dashboard.security.heading']}
  </h2>

  <span
    data-testid="twofa-badge"
    class:list={[
      'rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
      twoFactorEnabled
        ? 'bg-emerald-100 text-emerald-800'
        : 'bg-amber-100 text-amber-800',
    ]}
  >
    {twoFactorEnabled
      ? t['account.dashboard.security.twofaActive']
      : t['account.dashboard.security.twofaInactive']}
  </span>

  <span class="text-sm text-slate-600">
    {t['account.dashboard.security.lastLogin'].replace('{time}', lastSignInLabel)}
  </span>

  <a
    href={viewDetailHref}
    class="ml-auto text-sm font-medium text-[var(--primary,#059669)] hover:underline"
  >
    {viewDetailLabel} →
  </a>
</section>