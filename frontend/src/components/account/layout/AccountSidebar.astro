---
/**
 * AccountSidebar — Nav lateral post-login para sección clientes.
 *
 * Es el shell de navegación de TODAS las páginas `/[locale]/account/*`
 * (dashboard, profile, orders, addresses, wishlist, security, tickets,
 * notifications, gdpr). Se compone dentro de `AccountLayout`.
 *
 * Items (todos en este slice, aunque las páginas internas se
 * implementan en F2):
 *   1. Dashboard  → /
 *   2. Profile    → /profile
 *   3. Orders     → /orders
 *   4. Addresses  → /addresses  (F1.1 + AddressesManager ya existe)
 *   5. Wishlist   → /wishlist
 *   6. Security   → /security
 *   7. Tickets    → /tickets
 *   8. Notifications → /notifications
 *   9. Privacy    → /privacy
 *
 * Accesibilidad:
 *   - `<nav aria-label="Account">` (Baymard §2.6 #5: nav obvia cada vez).
 *   - `<ul>` semántica, items con `aria-current="page"` cuando activos.
 *   - Iconos `aria-hidden="true"` (el label los describe).
 *
 * Visibilidad:
 *   - Desktop (lg+): sticky en sidebar izquierda, full visible.
 *   - Mobile (<lg): hidden. El page toma full width.
 *     El toggle mobile se implementa en F2 (no bloqueante para F1.3).
 *
 * Active detection:
 *   - `currentPath` se computa en el page (locale-prefixed) y se pasa
 *     al sidebar. Se compara con `path` (también locale-prefixed) y
 *     con `path + '/'` para que `/account/orders/123` marque "Orders".
 */
import Icon from '../../ui/Icon.astro';
import type { TranslationKey } from '../../../i18n/types';

interface NavItem {
  key: TranslationKey;
  label: string;
  path: string; // locale-prefixed
  iconName: string;
}

interface Props {
  title: string;
  navLabel: string;
  logoutLabel: string;
  items: NavItem[];
  currentPath: string;
  localePrefix: string; // ej: "/es"
}

const { title, navLabel, logoutLabel, items, currentPath, localePrefix } = Astro.props;

function isActive(itemPath: string, current: string): boolean {
  if (itemPath === current) return true;
  // Dashboard es exacto (no es prefijo de otras rutas).
  if (itemPath === `${localePrefix}/account`) {
    return current === itemPath;
  }
  return current.startsWith(itemPath + '/') || current === itemPath;
}

const logoutHref = `${localePrefix}/account/logout`;
---

<aside class="hidden w-full shrink-0 lg:w-64" aria-label={navLabel}>
  <div class="sticky top-6 flex flex-col gap-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{title}</p>
    </div>

    <nav aria-label={navLabel}>
      <ul class="flex flex-col gap-1">
        {items.map((item: NavItem) => {
          const active = isActive(item.path, currentPath);
          return (
            <li>
              <a
                href={item.path}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors',
                  active
                    ? 'bg-[color-mix(in_srgb,var(--primary,#7c3aed)_10%,white)] font-semibold text-[var(--primary,#7c3aed)]'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
                ]}
              >
                <Icon
                  name={item.iconName}
                  class:list={[
                    'h-5 w-5 shrink-0',
                    active
                      ? 'text-[var(--primary,#7c3aed)]'
                      : 'text-slate-400 group-hover:text-slate-600',
                  ]}
                />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a
      href={logoutHref}
      class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
    >
      <Icon name="arrow-right-on-rectangle" class="h-5 w-5 shrink-0 text-slate-400" />
      <span>{logoutLabel}</span>
    </a>
  </div>
</aside>
