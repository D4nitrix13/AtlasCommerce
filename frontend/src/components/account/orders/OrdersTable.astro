---
/**
 * OrdersTable — Tabla densa de pedidos (Baymard §5.1, ref Crate & Barrel).
 *
 * Filas = pedidos, columnas = "Pedido / Fecha / Estado / Productos /
 * Total / Acciones". Densidad alta para shoppers frecuentes (Baymard
 * §2.4: Walmart/B&H como referencia de "densa bien organizada").
 *
 * Estado del detail page:
 *  - Cada fila es `<a>` por ID (no `<button>`).
 *  - La columna Acciones además tiene un `<a>` dedicado (ver
 *    OrderRowActions) que apunta al mismo href, así se puede tabular
 *    sobre el botón sin entrar a la fila completa.
 *
 * Accesibilidad:
 *  - `<table>` semántica con `<thead>` + `<tbody>`.
 *  - `<caption>` sr-only porque el heading visual está arriba en el
 *    page (`orders/list.astro`).
 *  - Cada fila usa `aria-label` con id + status + total para que SR
 *    lea contexto útil.
 *  - Status = Badge semántico (design-refs §6.4).
 *
 * Vacío:
 *  - Si `orders.length === 0` (sin contar loading/error), el padre
 *    pasa `showEmpty=true` y rendereamos el mensaje dentro. Esto evita
 *    double-empty entre página y componente.
 */
import Badge from '../../ui/Badge.astro';
import { formatCentsAsDecimal, formatDate } from '../../../lib/formatters';
import type { OrderMock } from '../../../data/orders-mock';
import type { OrderStatus } from '../../../data/account-mock';
import OrderRowActions from './OrderRowActions.astro';

interface Props {
  orders: readonly OrderMock[];
  currencyCode: string;
  statusLabel: (status: OrderStatus) => string;
  orderIdLabel: (id: string) => string;
  itemsCountLabel: (count: number) => string;
  /** Locale-prefixed href builder para el detalle. */
  detailHrefFor: (orderId: string) => string;
  viewDetailLabel: string;
  /** Column headers visibles. */
  columnOrderNumber: string;
  columnDate: string;
  columnStatus: string;
  columnItems: string;
  columnTotal: string;
  columnActions: string;
  /** Cuando true, mostramos el bloque empty en lugar de tabla. */
  showEmpty: boolean;
  emptyTitle: string;
  emptyHint: string;
  emptyCtaLabel: string;
  emptyCtaHref: string;
}

const {
  orders,
  currencyCode,
  statusLabel,
  orderIdLabel,
  itemsCountLabel,
  detailHrefFor,
  viewDetailLabel,
  columnOrderNumber,
  columnDate,
  columnStatus,
  columnItems,
  columnTotal,
  columnActions,
  showEmpty,
  emptyTitle,
  emptyHint,
  emptyCtaLabel,
  emptyCtaHref,
} = Astro.props;

const orderIdTemplate = orderIdLabel('{id}');
---

{showEmpty ? (
  <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-2xl"
      aria-hidden="true"
    >
      📦
    </div>
    <p class="text-base font-semibold text-slate-900">{emptyTitle}</p>
    <p class="max-w-md text-sm text-slate-500">{emptyHint}</p>
    <a
      href={emptyCtaHref}
      class="mt-2 inline-flex items-center gap-1 rounded-lg bg-[var(--primary,#7c3aed)] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[var(--primary-hover,#6d28d9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2"
    >
      {emptyCtaLabel}
    </a>
  </div>
) : (
  <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <caption class="sr-only">{orderIdTemplate.replace('{id}', '')}</caption>
      <thead class="border-b border-slate-200 bg-slate-50/60 text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">
            {columnOrderNumber}
          </th>
          <th scope="col" class="px-4 py-3 font-semibold">
            {columnDate}
          </th>
          <th scope="col" class="px-4 py-3 font-semibold">
            {columnStatus}
          </th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">
            {columnItems}
          </th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">
            {columnTotal}
          </th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">
            {columnActions}
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {orders.map((order) => {
          const detailHref = detailHrefFor(order.id);
          const orderNumber = orderIdLabel(order.id);
          const status = statusLabel(order.status);
          const itemsTotal = order.items.reduce((sum, item) => sum + item.quantity, 0);
          const total = formatCentsAsDecimal(order.totalCents, currencyCode);
          const placedOn = formatDate(order.date);
          return (
            <tr class="group transition-colors hover:bg-slate-50/40">
              <td class="px-4 py-3">
                <a
                  href={detailHref}
                  class="font-medium text-slate-900 transition-colors group-hover:text-[var(--primary,#7c3aed)] focus-visible:outline-none focus-visible:underline"
                  aria-label={`${orderNumber} — ${status} — ${total}`}
                >
                  {orderNumber}
                </a>
              </td>
              <td class="px-4 py-3 text-slate-600">
                <time datetime={order.date}>{placedOn}</time>
              </td>
              <td class="px-4 py-3">
                <Badge status={order.status} label={status} />
              </td>
              <td class="px-4 py-3 text-right text-slate-600 tabular-nums">
                {itemsCountLabel(itemsTotal)}
              </td>
              <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-900">
                {total}
              </td>
              <td class="px-4 py-3 text-right">
                <OrderRowActions
                  orderId={order.id}
                  detailHref={detailHref}
                  viewDetailLabel={viewDetailLabel}
                  orderIdTemplate={orderIdTemplate}
                />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}
