---
/**
 * StatusFilter — pills de estado del ledger de órdenes (job-ticket).
 *
 * Checkpoint de diseño:
 *   Intent:   filtrar el ledger por etapa del trabajo sin salirse del
 *             lenguaje de taller: cada pill es una ficha de tinta con
 *             swatch semántico, no un botón SaaS.
 *   Hierarchy: tier 3 — vive sobre la hoja del ledger; el estado
 *             activo gana por anillo + tinta, no por relleno primario.
 *   Palette:  tintas semánticas (`--ink-*`) por estado; `--primary`
 *             queda reservado para acciones, no para filtros.
 *   Depth:    plano (sin lift) — es una barra de controles dentro de
 *             una hoja que ya eleva.
 *   Type:     12px/600 + swatch 8px; conteos en tabular-nums suaves.
 *   Spacing:  8px gap; pill 10px 14px; hit-area 40px.
 *
 * Filtrado real: cada pill es un `<a>` GET que arma la query string
 * (`?status=…`) con `buildOrdersHref` — el listado filtra en SSR.
 * Mismo patrón que la PLP (`lib/catalog-filters.ts`): sin islas, sin
 * estado en cliente.
 */
import type { OrderStatusFilterValue } from '../../../lib/orders-filters';

interface StatusFilterOption {
  value: OrderStatusFilterValue;
  label: string;
  count: number;
  href: string;
}

interface Props {
  current: OrderStatusFilterValue;
  options: readonly StatusFilterOption[];
  navLabel: string;
}

const { current, options, navLabel } = Astro.props;

const INK_COLOR: Record<OrderStatusFilterValue, string> = {
  all: 'var(--ink)',
  pending: 'var(--ink-received)',
  processing: 'var(--ink-press)',
  shipped: 'var(--ink-transit)',
  delivered: 'var(--ink-done)',
  cancelled: 'var(--ink-void)',
};

const SOFT_BG: Record<OrderStatusFilterValue, string> = {
  all: 'color-mix(in srgb, var(--ink) 7%, var(--paper))',
  pending: 'var(--ink-received-soft)',
  processing: 'var(--ink-press-soft)',
  shipped: 'var(--ink-transit-soft)',
  delivered: 'var(--ink-done-soft)',
  cancelled: 'var(--ink-void-soft)',
};
---

<nav aria-label={navLabel} class="flex flex-wrap gap-2">
  {options.map((option) => {
    const isActive = option.value === current;
    return (
      <a
        href={option.href}
        aria-current={isActive ? 'page' : undefined}
        class:list={[
          'pressable inline-flex min-h-10 items-center gap-2 rounded-[8px] border px-3.5 py-2',
          'text-[12px] font-semibold leading-none',
          'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2',
        ]}
        style={
          isActive
            ? `background:${SOFT_BG[option.value]};color:${INK_COLOR[option.value]};border-color:currentColor`
            : 'background:var(--paper-sunken);color:var(--ink-muted);border-color:var(--edge)'
        }
        data-status={option.value}
        data-testid="orders-status-filter"
      >
        <span
          class="ink-swatch"
          style={`background:${INK_COLOR[option.value]}`}
          aria-hidden="true"
        ></span>
        <span>{option.label}</span>
        <span class="text-[11px] tabular-nums opacity-70" aria-hidden="true">
          {option.count}
        </span>
      </a>
    );
  })}
</nav>
