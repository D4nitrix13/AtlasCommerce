---
/**
 * StatusFilter — Pills de filtro de status (Bonfire mockup 10 v3).
 *
 * Es una versión VISUAL de `StatusFilterPills.astro`: no hace filtering
 * en SSR (eso queda para una iteración posterior con JS). Los pills
 * son `<button type="button">` que el padre puede interceptar via
 * `data-status` para wiring futuro.
 *
 * Tokens (sincronizado con `docs/frontend/design-references-bonfire.md`):
 *  - Active: `bg-[var(--primary)] text-white` con sombra sutil.
 *  - Inactive: `bg-white border border-slate-200 text-slate-700` con
 *    hover que refuerza el border.
 *  - Forma: `rounded-full px-4 py-2 text-sm font-semibold` —
 *    coincide con la altura de los filter pills de catálogo.
 *
 * Accesibilidad:
 *  - Cada pill es un `<button>` real (no `<div>`).
 *  - El pill activo lleva `aria-pressed="true"` para SR.
 *  - El contenedor es un `<nav>` con `aria-label` localizado.
 *  - Estado actual expuesto via `data-status` en el contenedor
 *    padre para que un script de filtering pueda leerlo.
 */
export type OrderStatusFilterValue = 'all' | 'pending' | 'processing' | 'shipped' | 'delivered' | 'cancelled';

interface StatusFilterOption {
  value: OrderStatusFilterValue;
  label: string;
  count: number;
}

interface Props {
  current: OrderStatusFilterValue;
  options: readonly StatusFilterOption[];
  navLabel: string;
}

const { current, options, navLabel } = Astro.props;
---

<nav aria-label={navLabel} class="flex flex-wrap gap-2">
  {options.map((option) => {
    const isActive = option.value === current;
    return (
      <button
        type="button"
        data-status={option.value}
        aria-pressed={isActive ? 'true' : 'false'}
        class:list={[
          'inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition-colors',
          'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary,#7c3aed)] focus-visible:ring-offset-2',
          isActive
            ? 'border-transparent bg-[var(--primary,#7c3aed)] text-white shadow-sm'
            : 'border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50',
        ]}
      >
        <span>{option.label}</span>
        <span
          aria-hidden="true"
          class:list={[
            'inline-flex min-w-[1.5rem] justify-center rounded-full px-1.5 text-xs font-semibold',
            isActive ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-600',
          ]}
        >
          {option.count}
        </span>
      </button>
    );
  })}
</nav>
