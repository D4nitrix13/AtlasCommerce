---
/**
 * OrderRowActions — fila compacta de acciones de un ticket del ledger.
 *
 * Checkpoint de diseño:
 *   Intent:   "qué puedo hacer con este trabajo" en una fila de links
 *             silenciosa — nunca botones grandes que compitan con el
 *             rail de etapas (el focal del row).
 *   Hierarchy: tier 3 — links 12px muted; sólo "Volver a pedir" lleva
 *             acento `--primary` (la acción que trae plata).
 *   Palette:  ink-muted → hover primary. Sin fills, sin bordes.
 *   Depth:    plano.
 *   Type:     12px/500, hover subrayado.
 *   Spacing:  8px de separación; hit-area 40px por link.
 *
 * "Solicitar cambio" abre el mail del soporte del tenant (el flujo
 * in-app de solicitudes aún no existe — no se inventa backend).
 */
import type { TranslationKey } from '../../../i18n/types';

interface Props {
  requestChangeHref: string;
  trackHref?: string | null;
  reorderHref?: string | null;
  t: Record<TranslationKey, string>;
}

const { requestChangeHref, trackHref = null, reorderHref = null, t } = Astro.props;

const quietLink =
  'pressable inline-flex min-h-10 items-center text-[12px] font-medium text-[var(--ink-muted)] hover:text-[var(--primary)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2 rounded-[4px]';
const accentLink =
  'pressable inline-flex min-h-10 items-center text-[12px] font-semibold text-[var(--primary)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)] focus-visible:ring-offset-2 rounded-[4px]';
---

<div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1">
  <a href={requestChangeHref} class={quietLink} data-testid="order-request-change">
    {t['account.orders.action.requestChange']}
  </a>
  {trackHref !== null && (
    <a
      href={trackHref}
      target="_blank"
      rel="noopener noreferrer"
      class={quietLink}
      data-testid="order-track-shipment"
    >
      {t['storefront.account.orders.v3.trackShipment']}
    </a>
  )}
  {reorderHref !== null && (
    <a href={reorderHref} class={accentLink} data-testid="order-reorder">
      {t['account.orders.detail.reorder']}
      <span aria-hidden="true" class="ml-1">
        →
      </span>
    </a>
  )}
</div>
