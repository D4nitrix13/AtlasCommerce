---
/**
 * OrderTimeline — Timeline visual de 5 milestones (design-refs §6.3).
 *
 * Implementa el patrón Apple/Warby Parker (§5.1 #63-order-tracking-page)
 * con tono kitsune sutil: Recibido en el dojo / Preparando con cuidado /
 * En camino al viajero / Casi en tu santuario / Entregado.
 *
 * Reglas anti-patrón §8.2:
 *  - Solo 5 hitos (NO 15 — anti-pattern §8.1).
 *  - Los emojis son acentos culturales (sutiles), no decoración.
 *  - El estado cancelled se renderiza como banner lateral (no en el
 *    timeline), para distinguir visualmente "no progresó" de "llegó".
 *
 * Visual:
 *  - Línea vertical con dots de colores por estado:
 *    · gris (pendiente), brand-primary (en curso), verde (terminado).
 *  - El "current" recibe un ring pulsante sutil para que el ojo del
 *    shopper caiga en dónde está el pedido ahora.
 */
import type { OrderMilestoneMock, OrderMilestoneKey } from '../../../data/orders-mock';
import { formatDateTime } from '../../../lib/formatters';

interface MilestoneLabel {
  key: OrderMilestoneKey;
  title: string;
  description: string;
  icon: string;
}

interface Props {
  milestones: readonly OrderMilestoneMock[];
  /** Etiquetas localizadas por milestone. */
  labels: readonly MilestoneLabel[];
  /** Section heading. */
  heading: string;
}

const { milestones, labels, heading } = Astro.props;

const labelMap = new Map<OrderMilestoneKey, MilestoneLabel>(labels.map((l) => [l.key, l]));

interface ResolvedMilestone {
  key: OrderMilestoneKey;
  title: string;
  description: string;
  icon: string;
  timestamp: string | null;
  note?: string;
  state: 'done' | 'current' | 'pending';
}

const orderedKeys: readonly OrderMilestoneKey[] = [
  'received',
  'preparing',
  'shipped',
  'outForDelivery',
  'delivered',
];

// Encontrar primer milestone NO completado — ese es el "current".
const firstPendingIndex = milestones.findIndex((m) => m.timestamp === null);

const resolved: ResolvedMilestone[] = orderedKeys.map((key, idx) => {
  const data = milestones.find((m) => m.key === key);
  const label = labelMap.get(key);
  const timestamp = data?.timestamp ?? null;
  let state: ResolvedMilestone['state'];
  if (firstPendingIndex === -1) {
    state = 'done';
  } else if (idx < firstPendingIndex) {
    state = 'done';
  } else if (idx === firstPendingIndex) {
    state = 'current';
  } else {
    state = 'pending';
  }
  return {
    key,
    title: label?.title ?? key,
    description: label?.description ?? '',
    icon: label?.icon ?? '●',
    timestamp,
    note: data?.note,
    state,
  };
});

const hasAnyTimestamp = resolved.some((m) => m.timestamp !== null);
---

<section
  aria-labelledby="order-timeline-heading"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
>
  <h2 id="order-timeline-heading" class="mb-6 text-base font-semibold text-slate-900 sm:text-lg">
    {heading}
  </h2>

  {hasAnyTimestamp ? (
    <ol class="relative flex flex-col gap-6">
      {resolved.map((milestone, idx) => {
        const isLast = idx === resolved.length - 1;
        const dotClasses =
          milestone.state === 'done'
            ? 'bg-emerald-500 text-white'
            : milestone.state === 'current'
              ? 'bg-[var(--primary,#7c3aed)] text-white ring-4 ring-[color-mix(in_srgb,var(--primary,#7c3aed)_20%,white)]'
              : 'bg-slate-200 text-slate-400';
        const connectorColor = milestone.state === 'done' ? 'bg-emerald-300' : 'bg-slate-200';
        return (
          <li class="relative flex gap-4">
            <div class="flex flex-col items-center">
              <div
                class:list={[
                  'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-base font-semibold shadow-sm',
                  dotClasses,
                ]}
                aria-hidden="true"
              >
                {milestone.state === 'done' ? '✓' : milestone.icon}
              </div>
              {!isLast && (
                <span
                  aria-hidden="true"
                  class:list={['mt-1 h-full w-0.5 min-h-[24px] flex-1', connectorColor]}
                />
              )}
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-1 pb-2">
              <p
                class:list={[
                  'text-sm font-semibold',
                  milestone.state === 'pending' ? 'text-slate-400' : 'text-slate-900',
                ]}
              >
                {milestone.title}
              </p>
              <p
                class:list={[
                  'text-xs',
                  milestone.state === 'pending' ? 'text-slate-400' : 'text-slate-600',
                ]}
              >
                {milestone.state === 'pending' ? '—' : milestone.description}
              </p>
              {milestone.timestamp && (
                <p class="text-xs font-medium text-slate-500">
                  <time datetime={milestone.timestamp}>{formatDateTime(milestone.timestamp)}</time>
                </p>
              )}
              {milestone.note && (
                <p class="mt-1 rounded-md bg-slate-50 px-2 py-1 text-xs italic text-slate-500">
                  {milestone.note}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-500">
      — No hay eventos de seguimiento disponibles para este pedido.
    </p>
  )}
</section>
