---
/**
 * OrderPaymentSummary — Resumen de pago del pedido (F2.2).
 *
 * Muestra:
 *  - Método de pago (label localizado según tipo).
 *  - Subtotal (suma de items).
 *  - Shipping (gratis si subtotal = total).
 *  - Total (cents pre-calculados en backend).
 *
 * El subtotal y shipping se DERIVAn del total:
 *  - shippingCents = 0 (gratis en este mock; el backend tendría
 *    columna real en `orders.shipping_cents`).
 *  - subtotalCents = totalCents - shippingCents.
 *
 * NO recalculamos desde el cliente: el cálculo confiable viene
 * del backend (AGENTS §10). Mostramos los valores que el order trae.
 */
import { formatCurrency } from '../../../lib/formatters';
import type { OrderPaymentMock } from '../../../data/orders-mock';

interface Props {
  payment: OrderPaymentMock;
  totalCents: number;
  currencyCode: string;
  /** Localized strings. */
  heading: string;
  labelMethod: string;
  methodCard: string;
  methodTransfer: string;
  methodCod: string;
  labelSubtotal: string;
  labelShipping: string;
  shippingFree: string;
  labelTotal: string;
}

const {
  payment,
  totalCents,
  currencyCode,
  heading,
  labelMethod,
  methodCard,
  methodTransfer,
  methodCod,
  labelSubtotal,
  labelShipping,
  shippingFree,
  labelTotal,
} = Astro.props;

function resolveMethodLabel(): string {
  switch (payment.method) {
    case 'card':
      return methodCard;
    case 'transfer':
      return methodTransfer;
    case 'cash_on_delivery':
      return methodCod;
  }
}

const methodLabel = resolveMethodLabel();
const methodDetail =
  payment.method === 'card' && payment.brand && payment.last4
    ? `${payment.brand} · •••• ${payment.last4}`
    : null;

// Mock: shipping gratis cuando el total > 0 (cancelados muestran total=0).
const shippingCents = totalCents > 0 ? 0 : 0;
const subtotalCents = Math.max(0, totalCents - shippingCents);
const isShippingFree = shippingCents === 0;
---

<section
  aria-labelledby="order-payment-heading"
  class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
>
  <h2 id="order-payment-heading" class="mb-4 text-base font-semibold text-slate-900 sm:text-lg">
    {heading}
  </h2>

  <dl class="flex flex-col gap-1 text-sm">
    <div class="flex items-center justify-between text-slate-600">
      <dt>{labelMethod}</dt>
      <dd class="font-medium text-slate-900">
        {methodLabel}
        {methodDetail && <span class="text-slate-500"> · {methodDetail}</span>}
      </dd>
    </div>
  </dl>

  <div class="mt-4 border-t border-slate-100 pt-4">
    <dl class="flex flex-col gap-2 text-sm">
      <div class="flex items-center justify-between text-slate-600">
        <dt>{labelSubtotal}</dt>
        <dd class="tabular-nums">{formatCurrency(subtotalCents, currencyCode)}</dd>
      </div>
      <div class="flex items-center justify-between text-slate-600">
        <dt>{labelShipping}</dt>
        <dd class="tabular-nums">
          {isShippingFree ? shippingFree : formatCurrency(shippingCents, currencyCode)}
        </dd>
      </div>
      <div class="mt-2 flex items-center justify-between border-t border-slate-100 pt-3 text-base font-bold text-slate-900">
        <dt>{labelTotal}</dt>
        <dd class="tabular-nums">{formatCurrency(totalCents, currencyCode)}</dd>
      </div>
    </dl>
  </div>
</section>
