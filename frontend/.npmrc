# pnpm hoist config para compatibilidad con Storybook.
# Storybook internamente requiere dependencias hoisteadas (no strict).
# Ver https://storybook.js.org/docs/react/faq#using-strict-pnpm-workspaces
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
shamefully-hoist=true
