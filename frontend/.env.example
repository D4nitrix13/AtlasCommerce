# URL publica del backend, expuesta al cliente del browser.
# El frontend hace fetch desde el browser hacia esta URL.
PUBLIC_API_URL=http://localhost:8080/api
PUBLIC_APP_NAME="Kitsune Store"

# URL interna del backend, usada SOLO por el SSR de Astro (server-side).
# En dev local con Caddy: http://127.0.0.1:8080
# En Docker network: http://app:8000
# Si no se setea, default a PUBLIC_API_URL.
INTERNAL_API_URL=http://127.0.0.1:8080/api
