---
const chartId = `revenue-overview-${Math.random().toString(36).slice(2)}`;

const months = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
const currentYear = [18000, 22000, 20000, 28000, 32000, 30000, 36000, 38000, 42000, 40000, 45000, 48000];
const previousYear = [15000, 18000, 17000, 22000, 25000, 24000, 28000, 30000, 34000, 32000, 36000, 38000];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-bold text-slate-950">Resumen de ingresos</h2>
      <p class="text-sm text-slate-500">Comparativa anual de ingresos</p>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
        <span class="text-slate-500">2026</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
        <span class="text-slate-500">2025</span>
      </div>
    </div>
  </div>

  <div class="h-[320px]">
    <canvas
      id={chartId}
      data-months={JSON.stringify(months)}
      data-current={JSON.stringify(currentYear)}
      data-previous={JSON.stringify(previousYear)}
    ></canvas>
  </div>
</section>

<script>
  import Chart from "chart.js/auto";

  document.querySelectorAll<HTMLCanvasElement>("canvas[id^='revenue-overview']").forEach((canvas) => {
    const months = JSON.parse(canvas.dataset.months || "[]");
    const currentYear = JSON.parse(canvas.dataset.current || "[]");
    const previousYear = JSON.parse(canvas.dataset.previous || "[]");

    new Chart(canvas, {
      type: "line",
      data: {
        labels: months,
        datasets: [
          {
            label: "2026",
            data: currentYear,
            fill: true,
            tension: 0.45,
            borderWidth: 2,
            pointRadius: 0,
            borderColor: "#059669",
            backgroundColor: "rgba(5, 150, 105, 0.08)",
          },
          {
            label: "2025",
            data: previousYear,
            fill: false,
            tension: 0.45,
            borderWidth: 2,
            pointRadius: 0,
            borderColor: "#cbd5e1",
            backgroundColor: "transparent",
            borderDash: [5, 5],
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false,
          },
          tooltip: {
            mode: "index",
            intersect: false,
            callbacks: {
              label(context) {
                return context.dataset.label + ": $" + context.parsed.y.toLocaleString();
              },
            },
          },
        },
        interaction: {
          mode: "nearest",
          axis: "x",
          intersect: false,
        },
        scales: {
          x: {
            grid: {
              display: false,
            },
            ticks: {
              color: "#64748b",
            },
          },
          y: {
            border: {
              display: false,
            },
            grid: {
              color: "#e5e7eb",
            },
            ticks: {
              color: "#64748b",
              callback(value) {
                return "$" + Number(value / 1000) + "k";
              },
            },
          },
        },
      },
    });
  });
</script>
