---
const goals = [
  { label: "Ingresos mensuales", current: "$48,295", target: "$55,000", percent: 88, color: "bg-emerald-500" },
  { label: "Nuevos clientes", current: "847", target: "1,000", percent: 85, color: "bg-emerald-500" },
  { label: "Tasa de conversión", current: "3.8", target: "5", percent: 76, color: "bg-sky-500" },
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="mb-1 text-lg font-bold text-slate-950">Metas mensuales</h2>
  <p class="mb-5 text-sm text-slate-500">Seguimiento de objetivos</p>

  <div class="space-y-5">
    {goals.map((g) => (
      <div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-slate-700">{g.label}</span>
          <span class="font-semibold text-slate-950">{g.percent}%</span>
        </div>

        <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
          <div
            class:list={["h-full rounded-full transition-all", g.color]}
            style={`width:${g.percent}%`}
          ></div>
        </div>

        <div class="mt-1 flex justify-between text-xs text-slate-400">
          <span>{g.current}</span>
          <span>Meta: {g.target}</span>
        </div>
      </div>
    ))}
  </div>
</section>
