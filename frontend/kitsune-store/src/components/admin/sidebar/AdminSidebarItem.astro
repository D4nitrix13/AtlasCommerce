---
interface Props {
  name: string;
  href: string;
  icon?: string;
  active?: boolean;
  badge?: string;
}

const { name, href, active = false, badge } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition",
    active
      ? "bg-emerald-500/10 text-emerald-400"
      : "text-slate-400 hover:bg-white/5 hover:text-white",
  ]}
>
  <span class="grid h-5 w-5 place-items-center text-base">
    •
  </span>

  <span class="flex-1">{name}</span>

  {badge && (
    <span class="rounded-full bg-emerald-500/15 px-2 py-0.5 text-[11px] font-semibold text-emerald-400">
      {badge}
    </span>
  )}
</a>
