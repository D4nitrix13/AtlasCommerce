---
import "../styles/global.css";
import AdminSidebar from "../components/admin/sidebar/AdminSidebar.astro";
import AdminHeader from "../components/admin/header/AdminHeader.astro";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-[#f6f7f9] text-slate-900 antialiased">
    <div class="min-h-screen">
      <AdminSidebar />

      <div class="min-h-screen lg:pl-[260px]">
        <AdminHeader />

        <main class="px-4 py-6 sm:px-6 lg:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
