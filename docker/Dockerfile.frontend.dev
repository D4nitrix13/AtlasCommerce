# Imagen Docker del frontend Astro (desarrollo).
# Levanta `astro dev` con HMR. El código se monta como bind mount
# desde el host para iterar sin rebuild. Se usa desde
# `docker/dev/docker-compose.dev.yml`.

FROM node:22-alpine

WORKDIR /app

# Habilitar pnpm vía corepack con lockfile pinneado.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/pnpm-workspace.yaml ./
RUN corepack enable \
    && corepack prepare pnpm@9 --activate \
    && pnpm install --frozen-lockfile

# Variables de entorno: el dev server escucha en 0.0.0.0 para ser
# accesible desde Caddy del host o del contenedor vecino.
ENV HOST=0.0.0.0
ENV PORT=4321
ENV NODE_ENV=development
ENV ASTRO_TELEMETRY_DISABLED=1

EXPOSE 4321

# Healthcheck: en dev el server responde rápido.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD wget -q --spider http://localhost:4321/ || exit 1

CMD ["pnpm", "run", "dev"]