# Imagen Docker del frontend Astro (producción).
# Construye el bundle SSR de Astro que se sirve en cada instancia.

# ===========================================================================
# Stage 1: builder. Compila el bundle SSR.
# ===========================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Habilitar pnpm vía corepack, pineado por lockfile.
RUN corepack enable \
    && corepack prepare pnpm@9 --activate

# Layer de cache de dependencias: package.json + lockfile primero.
# `pnpm fetch` descarga las deps a un store local sin tocar el FS de la
# app, así el siguiente `COPY` (solo código fuente) no invalida este
# layer. Equivale a un --mount=type=cache pero portable.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/pnpm-workspace.yaml* ./
RUN pnpm fetch --frozen-lockfile \
    && pnpm install --frozen-lockfile --offline

# Build del bundle SSR. Solo después de instalar deps copiamos el
# resto del código — cualquier cambio en el código invalida SOLO este
# layer, no el de deps.
COPY frontend/ .
RUN pnpm run build \
    # Limpia el store de pnpm y los node_modules completos para que
    # la siguiente stage solo copie el bundle compilado. Reduce el
    # tamaño de la imagen runtime de ~600 MB a ~250 MB.
    && pnpm store prune \
    && rm -rf node_modules

# ===========================================================================
# Stage 2: runtime. Solo el bundle compilado + node runtime.
# ===========================================================================
FROM node:22-alpine

WORKDIR /app

# Solo el bundle compilado del builder (dist + package.json para
# que Astro sepa qué entrypoint usar). Sin node_modules de dev, sin
# código fuente, sin .git.
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# Variables de entorno agrupadas en un solo layer.
ENV HOST=0.0.0.0 \
    PORT=4321 \
    NODE_ENV=production

EXPOSE 4321

# Healthcheck: chequea que el server responda HTTP. Usa wget que
# viene en alpine, no agrega dependencia extra.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:4321/ || exit 1

CMD ["node", "./dist/server/entry.mjs"]
