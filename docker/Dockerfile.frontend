# Imagen Docker del frontend Astro
# Construye el bundle SSR de Astro que se sirve en cada instancia.

FROM node:22-alpine AS builder

WORKDIR /app

# Cache de layers: package.json primero
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@9 --activate
RUN pnpm install --frozen-lockfile

# Build del bundle SSR
COPY frontend/ .
RUN pnpm run build

# Imagen final de runtime
FROM node:22-alpine

WORKDIR /app

# Copiar el bundle compilado
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Variables de entorno requeridas
ENV HOST=0.0.0.0
ENV PORT=4321
ENV NODE_ENV=production

EXPOSE 4321

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD wget -q --spider http://localhost:4321/ || exit 1

CMD ["node", "./dist/server/entry.mjs"]
