# Imagen Docker del backend Laravel (producción).
# Construye la imagen core del backend que se usa en cada instancia.
# La configuración de PHP se monta vía COPY desde docker/conf/php/.

FROM php:8.4-fpm-alpine

# Extensiones PHP requeridas por Laravel + integraciones (S3, FTP, Redis, IMAP opcional).
RUN apk add --no-cache \
        postgresql-dev \
        postgresql-client \
        libzip-dev \
        libxml2-dev \
        oniguruma-dev \
        zip \
        unzip \
        git \
        icu-dev \
    && docker-php-ext-install \
        pdo_pgsql \
        pgsql \
        zip \
        intl \
        bcmath \
        opcache \
        ftp \
        exif \
        xml \
        mbstring \
    && docker-php-ext-enable opcache

# Composer (imagen multi-stage).
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Configuración de PHP: php.ini base + opcache.ini.
# El prefijo `zz-` en php.ini fuerza a que pise a los archivos por
# defecto de la imagen oficial (orden alfabético en conf.d).
COPY docker/conf/php/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/conf/php/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini

# Copiar composer files primero (cache de layers).
COPY backend/composer.json backend/composer.lock ./
# El plugin `d4nitrix13/ecommerce-plugin-erp` está declarado en
# composer.json como repositorio `path` apuntando a
# `packages/ecommerce-plugin-erp`. Durante `composer install`,
# composer resuelve ese path relativo al WORKDIR
# (`/var/www/html`). Si no lo copiamos, falla con "Source path
# is not found". Lo copiamos ANTES del install.
COPY backend/packages ./packages

RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist

# Copiar el resto del código.
COPY backend/ .

# Generar autoloader optimizado.
RUN composer dump-autoload --optimize --no-dev

# Permisos correctos.
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8000

# Script de entrypoint que corre migraciones y opcionalmente el bootstrap.
COPY docker/entrypoint-backend.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

CMD ["entrypoint"]