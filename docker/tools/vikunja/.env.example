# Environment example for Vikunja.
# Copy this file to .env and replace the example values.
#
# Command:
# cp .env.example .env

# PostgreSQL configuration.
POSTGRES_USER=vikunja

# Recommended command to generate a secure database password:
# openssl rand -base64 32
POSTGRES_PASSWORD=replace_with_generated_database_password

POSTGRES_DB=vikunja

# Vikunja service secret.
# Recommended command to generate a secure service secret:
# openssl rand -hex 64
VIKUNJA_SERVICE_SECRET=replace_with_generated_service_secret

# Public URL used by Vikunja.
# For local development, keep this value.
VIKUNJA_PUBLIC_URL=http://localhost:3456