# Imagen Docker del backend Laravel (desarrollo).
# Variante de Dockerfile.backend con xdebug, dev extensions y mounts
# pensados para iterar sin rebuilds. Se usa desde
# `docker/dev/docker-compose.dev.yml`.

FROM php:8.4-fpm-alpine

# Extensiones PHP de producción + debugging/development.
#
# Tres RUNs separados para que Docker pueda cachearlos de forma
# granular. Si solo cambia la lista de extensiones PHP, el `apk add`
# queda cacheado y no se re-descargan paquetes. Si cambia solo el
# `/usr/local/bin/docker-php-ext-enable`, no se re-compila nada. Si cambia solo la
# lista de pecl, se re-compila solo eso.

RUN /sbin/apk add --no-cache \
        postgresql-dev \
        postgresql-client \
        libzip-dev \
        libxml2-dev \
        oniguruma-dev \
        zip \
        unzip \
        git \
        icu-dev \
        linux-headers \
        $PHPIZE_DEPS

RUN /usr/local/bin/docker-php-ext-install \
        pdo_pgsql \
        pgsql \
        zip \
        intl \
        bcmath \
        opcache \
        ftp \
        exif \
        xml \
        mbstring

RUN /usr/local/bin/pecl install redis xdebug \
    && /usr/local/bin/docker-php-ext-enable redis xdebug opcache

# Composer.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Configuración PHP: dev (errores visibles + xdebug) + opcache off.
# Ojo: NO copiamos opcache.ini porque activaría OPcache en dev. La
# sección [opcache] de php.development.ini lo deja en `enable=0`.
COPY docker/instances/development/morales-store/conf/php/php.development.ini /usr/local/etc/php/conf.d/zz-app.ini

# Directorios de logs que xdebug y php_error.log esperan.
RUN /bin/mkdir -p /var/log/php && /bin/chown -R www-data:www-data /var/log/php

# Permisos para que el usuario www-data pueda escribir en storage.
RUN /bin/chown -R www-data:www-data /var/www/html

# Composer install con dev dependencies (Pint, PHPStan, IDE Helper).
COPY backend/composer.json backend/composer.lock ./
# El plugin `d4nitrix13/atlas-commerce-plugin-erp` está como repositorio
# `path` en composer.json → necesita `packages/atlas-commerce-plugin-erp`
# en el WORKDIR antes del install.
COPY backend/packages ./packages

RUN /usr/bin/composer install \
        --no-scripts \
        --no-autoloader \
        --prefer-dist

COPY backend/ .

RUN /usr/bin/composer dump-autoload --optimize

EXPOSE 8000

COPY docker/instances/development/morales-store/backend/entrypoint.development.sh /usr/local/bin/entrypoint
RUN /bin/chmod +x /usr/local/bin/entrypoint

# Drop privilegios: el contenedor corre como `www-data` (UID 33) en vez
# de root. La build necesita root (instalar paquetes del sistema,
# composer install global) pero el runtime solo necesita escribir en
# /var/www/html (que ya está chown'd a www-data en el layer anterior).
# El entrypoint hace `chown` condicional con `if [ "$(id -u)" = "0" ]`
# para tolerar este cambio.
USER www-data

CMD ["/usr/local/bin/entrypoint"]