# Imagen Docker del frontend Astro (desarrollo).
# Levanta `astro dev` con HMR. El código se monta como bind mount
# desde el host para iterar sin rebuild. Se usa desde
# `docker/dev/docker-compose.dev.yml`.

FROM oven/bun:1-alpine

# 'oven/bun:1-alpine' no incluye el user 'node' por default.
# Lo creamos via BusyBox (siempre presente en Alpine). Si
# adduser falla por tags raros de la imagen, los scripts
# de entrypoint hacen fallback a chown por UID 1000:1000.
RUN /bin/busybox addgroup -g 1000 -S node 2>/dev/null || true && \
    /bin/busybox adduser -u 1000 -S -G node -h /tmp node 2>/dev/null || true

WORKDIR /app

# Layer de cache de dependencias. bun install --frozen-lockfile lee
# bun.lock y desacopla el cache de deps del codigo fuente: cualquier
# cambio en `frontend/src/` no invalida este layer.
COPY frontend/package.json frontend/bun.lock ./
COPY frontend/packages/themes/ ./packages/themes/
RUN /usr/local/bin/bun install --frozen-lockfile

# Variables de entorno: el dev server escucha en 0.0.0.0 para ser
# accesible desde Caddy del host o del contenedor vecino.
ENV HOST=0.0.0.0 \
  PORT=4321 \
  NODE_ENV=development \
  ASTRO_TELEMETRY_DISABLED=1

EXPOSE 4321

# Healthcheck: en dev el server responde rápido.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD /usr/bin/wget -q --spider http://localhost:4321/ || exit 1

# Entrypoint: arregla ownership de los volumenes (node_modules,
# node_modules/.bun, .astro) que docker compose crea como root y
# que el usuario `node` (UID 1000) necesita escribir. Despues del
# chown, hace setpriv para correr bun como node (minimo privilegio).
COPY docker/instances/development/mm-boutique/frontend/entrypoint.development.sh /usr/local/bin/entrypoint
RUN /bin/chmod +x /usr/local/bin/entrypoint

# El entrypoint hace el drop de privilegios via setpriv, así que la
# imagen NO declara USER. Mantener root hasta el setpriv es necesario
# para que el chown funcione.
# USER node

ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD []
