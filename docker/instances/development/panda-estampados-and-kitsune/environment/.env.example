# ============================================================
# Variables de entorno — Entorno de desarrollo local
# ============================================================
# Lo lee `docker/dev/docker-compose.dev.yml`. NO commitear secretos:
# copialo a `.env` y editá los valores.
#
# ⚠  DESPUÉS DE EDITAR ESTE ARCHIVO, CORRÉ:
#     $ ./scripts/docker-stack.sh up development panda-estampados
#   NO uses `restart` — restart NO recarga variables del env_file.
#   Solo `up` (o `up -d --force-recreate`) detecta cambios en env_file
#   y recrea los containers para que las nuevas vars tengan efecto.
# ============================================================

# ---------- Postgres ----------
# Puertos shifted +1000 para no chocar con servicios del host
# (ej. un Postgres local en :5432). Cambialos si el shifted también
# está ocupado.
POSTGRES_USER=panda_estampados_and_kitsune
POSTGRES_PASSWORD=replace_with_generated_database_password
POSTGRES_DB=panda_estampados_and_kitsune
POSTGRES_PORT=6432

# ---------- Redis ----------
REDIS_PORT=7379

# ---------- Backend ----------
# Lo abrís en el browser como http://localhost:9000
BACKEND_PORT=9000

# ---------- Frontend ----------
# Lo abrís en el browser como http://localhost:5321
FRONTEND_PORT=5321

# ---------- FTP (uploads por tenant en dev) ----------
# Hostname del container FTP en la network Docker (default: ftp).
# El backend resuelve este nombre via Docker DNS dentro de la red
# panda-estampados-dev. No es localhost porque el backend corre en
# OTRO container.
FTP_HOST=ftp
FTP_USERNAME=dev-ftp
FTP_PASSWORD=replace_with_ftp_password
# Puerto del HOST donde se publica el FTP. Internamente el container
# sigue exponiendo :21, así que el backend (que habla al FTP por la red
# de docker) no se entera. Cliente FTP desde tu host: localhost:2121.
FTP_PORT=2121
FTP_PASV_ADDRESS=127.0.0.1

# ---------- Laravel ----------
# APP_KEY NO va acá — vive en backend/.env (bind-mount dentro del
# container, autogenerado por entrypoint.development.sh al primer
# arranque). Si lo ponés (aunque sea vacío), Dotenv considera la
# env var "definida" y no lee del .env del container.
# Para regenerarlo manualmente:
#   $ ./scripts/docker-stack.sh exec dev panda-estampados backend \
#         /usr/local/bin/php artisan key:generate --force
APP_NAME="AtlasCommerce Dev"
INSTANCE_NAME=dev

# Admin user del seed dev (ver docker/dev/seeds/dev.json).
DEV_ADMIN_PASSWORD=admin

# ---------- OAuth social login (Google + Facebook) ----------
# Configurar antes de mergear a producción. Runbook completo:
# docs/operations/oauth-providers.md (registro de redirect URIs por
# tenant, App Review de Facebook, rotación de credenciales).
# En dev se pueden dejar vacías: el redirect endpoint responde 503
# (oauth_provider_not_configured) sin tumbar el resto del flujo.
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
FACEBOOK_CLIENT_ID=your-facebook-app-id-here
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret-here

# ---------- OAuth callback base URL ----------
# Construye `{base}/api/auth/social/{provider}/callback`. Si queda vacío,
# el controller usa `$request->getSchemeAndHttpHost()` para mantener el
# host actual (multi-tenant: cada tenant registra su propia callback,
# p.ej. `https://panda-estampados.com/api/auth/social/google/callback`).
# Setear solo si la instancia está detrás de un reverse proxy donde
# `getSchemeAndHttpHost()` no refleja el host público.
OAUTH_REDIRECT_BASE_URL=

# ---------- Monitoring / debug UI (dev only) ----------
# pgAdmin: web UI para Postgres. Default email admin@panda-estampados-and-kitsune.test.
PGADMIN_EMAIL=admin@panda-estampados-and-kitsune.test
PGADMIN_PASSWORD=admin
# Puerto host expuesto (desplazado +1000 sobre default 5050 para correr las 3 dev en paralelo).
PGADMIN_PORT=6050

# Redis Insight: web UI oficial de Redis (keys, memory, commands).
# Puerto host desplazado +1000 sobre default 5540.
REDIS_INSIGHT_PORT=6540

# Filebrowser: web UI para inspeccionar el FTP del tenant.
# Lee el MISMO volume ftp_data que el container vsftpd (read-only).
# Puerto host desplazado +1000 sobre default 8080.
FILEBROWSER_PORT=9080
