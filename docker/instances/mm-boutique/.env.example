# ============================================================
# Variables de entorno — Instancia MM Boutique
# ============================================================
# Esta instancia sirve SOLO la tienda de tu mamá:
#   - MM Boutique (mm-boutique.com)
# Es un deployment independiente, sin Panda ni Kitsune.
# ============================================================

# ---------- Identidad de la instancia ----------
INSTANCE_NAME=mm-boutique

# ---------- App ----------
APP_NAME="MM Boutique"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mm-boutique.com

# Generar con: php artisan key:generate --show
APP_KEY=base64:GENERAR_CON_KEY:GENERATE

# ---------- Base de datos ----------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------- Storage (S3 / FTP) ----------
FILESYSTEM_DISK=local

# ---------- Sesiones y cache ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------- Frontend (Astro) ----------
PUBLIC_API_URL=http://app:8000/api
PUBLIC_APP_NAME="MM Boutique"

# ---------- Dominios para Sanctum (CORS) ----------
SANCTUM_STATEFUL_DOMAINS=mm-boutique.com,www.mm-boutique.com
SESSION_DOMAIN=.localhost

# ---------- Tenants bootstrap ----------
TENANTS_SEED_FILE=/tmp/seeds/mm-boutique.json

# ---------- Passwords de admin ----------
MM_ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---------- FTP (uploads por tenant) ----------
FTP_HOST=ftp
FTP_PORT=21
FTP_USERNAME=mmboutique-ftp
FTP_PASSWORD=CAMBIAR_PASSWORD_SEGURO
FTP_ROOT=/srv/ftp
FTP_PASSIVE=true
FTP_SSL=false
FTP_PASV_ADDRESS=127.0.0.1

# ---------- Redis ----------
# Driver cliente: predis (paquete PHP puro, sin extensión) o phpredis (ext).
# En Docker sin la ext de redis usamos predis para evitar instalar pecl.
REDIS_CLIENT=predis
