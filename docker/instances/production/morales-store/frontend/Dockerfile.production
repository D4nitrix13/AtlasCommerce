# Imagen Docker del frontend Astro (producción).
# Construye el bundle SSR de Astro que se sirve en cada instancia.

# ===========================================================================
# Stage 1: builder. Compila el bundle SSR.
# ===========================================================================
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Layer de cache de dependencias: package.json + lockfile primero.
# Usamos 'oven/bun:1-alpine' como base (bun pre-instalado, no corepack).
# bun lee bun.lock directamente; no requiere `fetch` separado.
COPY frontend/package.json frontend/bun.lock ./
COPY frontend/packages/themes/ ./packages/themes/
RUN /usr/local/bin/bun install --frozen-lockfile

# Build del bundle SSR. Solo después de instalar deps copiamos el
# resto del código — cualquier cambio en el código invalida SOLO este
# layer, no el de deps.
COPY frontend/ .
RUN /usr/local/bin/bun run build

# Limpia devDependencies dejando solo deps de produccion. Bun usa
# `--production` que respeta el lockfile y quita devDeps del arbol.
# El bundle SSR sigue funcionando porque los imports que hace
# apuntan a deps de prod (react, astro, etc.). `rm -rf node_modules`
# directo NO funciona: el bundle resuelve paquetes npm en runtime
# buscando en node_modules/.
RUN /usr/local/bin/bun install --production --frozen-lockfile

# ===========================================================================
# Stage 2: runtime. Solo el bundle compilado + deps de producción.
# ===========================================================================
FROM node:22-alpine

WORKDIR /app

# Solo el bundle compilado + node_modules con deps de produccion.
# Sin devDependencies (testing, linters, types), sin código fuente
# completo, sin .git.
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock ./

# Variables de entorno agrupadas en un solo layer.
ENV HOST=0.0.0.0 \
    PORT=4321 \
    NODE_ENV=production

EXPOSE 4321

# Healthcheck: chequea que el server responda HTTP. Usa wget que
# viene en alpine, no agrega dependencia extra.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD /usr/bin/wget -q --spider http://localhost:4321/ || exit 1

# Drop privilegios: el contenedor corre como `node` (UID 1000) en vez de
# root. La build necesita root (instalar paquetes, copiar archivos
# desde el stage builder) pero el runtime no — el bundle SSR solo lee
# archivos y escribe logs a stdout.
USER node

CMD ["/usr/local/bin/node", "./dist/server/entry.mjs"]
