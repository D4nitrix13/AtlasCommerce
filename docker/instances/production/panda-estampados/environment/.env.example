# ============================================================
# Variables de entorno — Instancia Panda + Kitsune
# ============================================================
# Esta instancia sirve las tiendas de tu cliente:
#   - Panda Estampados (panda-estampados.com)
#   - Kitsune Store (kitsune.com)
# Comparten la misma base de datos y deployment.
# ============================================================

# ---------- Identidad de la instancia ----------
INSTANCE_NAME=panda-estampados

# ---------- App ----------
APP_NAME="Panda + Kitsune"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://panda-estampados.com

# Generar con: php artisan key:generate --show
APP_KEY=base64:GENERAR_CON_KEY:GENERATE

# ---------- Base de datos ----------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------- Storage (S3 / FTP) ----------
FILESYSTEM_DISK=local

# ---------- Sesiones y cache ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------- Frontend (Astro) ----------
# URL pública del backend que el frontend consume.
# Si backend y frontend están en la misma network Docker, usar
# http://app:8000. Si el frontend hace fetch directo al host, usar
# la URL pública (con HTTPS en prod).
PUBLIC_API_URL=http://app:8000/api
PUBLIC_APP_NAME="Kitsune Store"

# ---------- Dominios para Sanctum (CORS) ----------
SANCTUM_STATEFUL_DOMAINS=panda-estampados.com,www.panda-estampados.com,kitsune.com,www.kitsune.com
SESSION_DOMAIN=.localhost

# ---------- Tenants bootstrap ----------
# Nombre del archivo de seed en docker/instances/panda-estampados/seeds/
# El entrypoint corre tenants:bootstrap con este archivo al primer arranque.
TENANTS_SEED_FILE=/tmp/seeds/panda.json

# ---------- Passwords de admin (uno por tienda) ----------
# Las lee el comando tenants:bootstrap. NO commitear valores reales.
PANDA_ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---------- FTP (uploads por tenant) ----------
# Servicio fauria/vsftpd que sirve uploads. La app Laravel consume
# vía `Storage::disk('ftp')`. Las variables FTP_USERNAME y FTP_PASSWORD
# se inyectan al contenedor FTP y también al backend para conectarse.
FTP_HOST=ftp
# Puerto del HOST (sólo aplica a instancias que публицan FTP al host,
# actualmente solo panda-estampados). Default 21 (default FTP). Si el
# host de deploy tiene otro servicio ocupando :21, cambiá a otro
# puerto (ej. 2121). El container FTP internamente sigue escuchando
# en :21, así que el backend (que habla al FTP por la red de docker)
# no se entera del cambio.
FTP_PORT=21
FTP_USERNAME=panda-ftp
FTP_PASSWORD=CAMBIAR_PASSWORD_SEGURO
FTP_ROOT=/srv/ftp
FTP_PASSIVE=true
FTP_SSL=false
# IP pública del host (para que los clientes PASV detrás de NAT
# alcancen al servidor). En single-host local usar 127.0.0.1.
FTP_PASV_ADDRESS=127.0.0.1

# ---------- Redis ----------
# Driver cliente: predis (paquete PHP puro, sin extensión) o phpredis (ext).
# En Docker sin la ext de redis usamos predis para evitar instalar pecl.
REDIS_CLIENT=predis

# ---------- OAuth social login (Google + Facebook) ----------
# Configurar antes de mergear a producción. Runbook completo:
# docs/operations/oauth-providers.md (registro de redirect URIs por
# tenant, App Review de Facebook, rotación de credenciales).
# En dev se pueden dejar vacías: el redirect endpoint responde 503
# (oauth_provider_not_configured) sin tumbar el resto del flujo.
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
FACEBOOK_CLIENT_ID=your-facebook-app-id-here
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret-here

# ---------- OAuth callback base URL ----------
# Construye `{base}/api/auth/social/{provider}/callback`. Si queda vacío,
# el controller usa `$request->getSchemeAndHttpHost()` para mantener el
# host actual (multi-tenant: cada tenant registra su propia callback,
# p.ej. `https://panda-estampados.com/api/auth/social/google/callback`).
# Setear solo si la instancia está detrás de un reverse proxy donde
# `getSchemeAndHttpHost()` no refleja el host público.
OAUTH_REDIRECT_BASE_URL=
