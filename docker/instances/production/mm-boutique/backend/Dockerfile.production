# Imagen Docker del backend Laravel (producción).
# Construye la imagen core del backend que se usa en cada instancia.
# La configuración de PHP se monta vía COPY desde docker/conf/production/php/.

FROM php:8.4-fpm-alpine

# Extensiones PHP requeridas por Laravel + integraciones (S3, FTP, Redis, IMAP opcional).
#
# Tres RUNs separados para que Docker pueda cachearlos de forma
# granular. Si solo cambia la lista de extensiones PHP, el `apk add`
# queda cacheado y no se re-descargan paquetes. Si cambia solo el
# `/usr/local/bin/docker-php-ext-enable`, no se re-compila nada.

# El paquete `redis` (apk) es solo para tener redis-cli dentro del
# container en sesiones de debug. El cliente PHP de la app es
# `predis/predis` (composer package), no la extensión PHP.
RUN /sbin/apk add --no-cache \
        libwebp-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        postgresql-dev \
        postgresql-client \
        libzip-dev \
        libxml2-dev \
        oniguruma-dev \
        redis \
        zip \
        unzip \
        git \
        icu-dev

RUN /usr/local/bin/docker-php-ext-configure gd --with-jpeg --with-freetype --with-webp \
    && /usr/local/bin/docker-php-ext-install -j"$(nproc)" gd

RUN /usr/local/bin/docker-php-ext-install \
        pdo_pgsql \
        pgsql \
        zip \
        intl \
        bcmath \
        opcache \
        ftp \
        exif \
        xml \
        mbstring

RUN /usr/local/bin/docker-php-ext-enable opcache

# Composer (imagen multi-stage).
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Configuración de PHP: php.ini base + opcache.ini.
# El prefijo `zz-` en php.ini fuerza a que pise a los archivos por
# defecto de la imagen oficial (orden alfabético en conf.d).
COPY docker/instances/production/mm-boutique/conf/php/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/instances/production/mm-boutique/conf/php/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini

# Copiar composer files primero (cache de layers).
COPY backend/composer.json backend/composer.lock ./
# El plugin `d4nitrix13/atlas-commerce-plugin-erp` está declarado en
# composer.json como repositorio `path` apuntando a
# `packages/atlas-commerce-plugin-erp`. Durante `composer install`,
# composer resuelve ese path relativo al WORKDIR
# (`/var/www/html`). Si no lo copiamos, falla con "Source path
# is not found". Lo copiamos ANTES del install.
COPY backend/packages ./packages

RUN /usr/bin/composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist

# Copiar el resto del código.
COPY backend/ .

# Generar autoloader optimizado.
RUN /usr/bin/composer dump-autoload --optimize --no-dev

# Permisos correctos.
RUN /bin/chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8000

# Script de entrypoint que corre migraciones y opcionalmente el bootstrap.
COPY docker/instances/production/mm-boutique/backend/entrypoint.production.sh /usr/local/bin/entrypoint
RUN /bin/chmod +x /usr/local/bin/entrypoint

# Drop privilegios: el contenedor corre como `www-data` (UID 33) en vez
# de root. La build necesita root (instalar paquetes del sistema,
# composer install, chowns) pero el runtime solo necesita escribir en
# storage/ y bootstrap/cache/ (que ya están chown'd a www-data en el
# layer anterior).
USER www-data

CMD ["/usr/local/bin/entrypoint"]