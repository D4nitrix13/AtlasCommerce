# ============================================================
# Variables de entorno — Instancia Morales Store
# ============================================================
# Esta instancia sirve SOLO la tienda de tu tía:
#   - Morales Store (morales-store.com)
# Es un deployment independiente, sin Panda ni Kitsune ni MM Boutique.
# ============================================================

# ---------- Identidad de la instancia ----------
INSTANCE_NAME=morales-store

# ---------- App ----------
APP_NAME="Morales Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://morales-store.com

# Generar con: php artisan key:generate --show
APP_KEY=base64:GENERAR_CON_KEY:GENERATE

# ---------- Base de datos ----------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------- Storage (S3 / FTP) ----------
FILESYSTEM_DISK=local

# ---------- Sesiones y cache ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------- Frontend (Astro) ----------
PUBLIC_API_URL=http://app:8000/api
PUBLIC_APP_NAME="Morales Store"

# ---------- Dominios para Sanctum (CORS) ----------
SANCTUM_STATEFUL_DOMAINS=morales-store.com,www.morales-store.com
SESSION_DOMAIN=.localhost

# ---------- Tenants bootstrap ----------
TENANTS_SEED_FILE=/tmp/seeds/morales-store.json

# ---------- Passwords de admin ----------
MORALES_ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEGURO
