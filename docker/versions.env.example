# ============================================================
# docker/versions.env.example — Versiones pineadas de imágenes
# ============================================================
# Copia este archivo a `docker/versions.env` y editalo solo cuando
# quieras bump versiones globalmente. El `.env` real es gitignored.
#
# Uso desde los compose files:
#   image: postgis/postgis:${POSTGRES_VERSION:-18-3.6}
#   image: redis:${REDIS_VERSION:-7-alpine}
#
# Si una variable no está definida, se usa el valor por defecto
# del `${VAR:-default}` embebido en el compose. Esto permite que
# cada compose siga funcionando aunque el .env no exista.
# ============================================================

# ---------- PHP (backend) ----------
# Imagen base de php:<VERSION>-fpm-alpine. Pinneada al último
# release estable de la rama 8.4 (requerida por symfony/* v8.1.0
# que está en composer.lock).
PHP_VERSION=8.4.0
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine

# ---------- Node (frontend) ----------
# node:<VERSION>-alpine para Astro dev/build.
NODE_VERSION=22.11.0
NODE_IMAGE=node:${NODE_VERSION}-alpine

# ---------- Postgres + PostGIS ----------
# Formato de la imagen postgis/postgis:<MAJOR>-<MINOR>
POSTGRES_VERSION=18-3.6
POSTGRES_IMAGE=postgis/postgis:${POSTGRES_VERSION}

# ---------- Redis ----------
REDIS_VERSION=7.4-alpine
REDIS_IMAGE=redis:${REDIS_VERSION}

# ---------- Caddy ----------
CADDY_VERSION=2.8
CADDY_IMAGE=caddy:${CADDY_VERSION}

# ---------- FTP (vsftpd via fauria) ----------
VSFTPD_IMAGE=fauria/vsftpd:latest

# ---------- Alpine (para PHP/Node base) ----------
ALPINE_VERSION=3.20