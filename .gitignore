*.txt
.env
.DS_Store
Thumbs.db
*.log
*.zip
*.tar.gz
*.bak
*.erm
.idea/
.vscode/
.phpunit.result.cache

# Backend test coverage artifacts (generated by composer test:coverage)
backend/backend/coverage/

# Python (Doorstop tooling under scripts/requirements/)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Doorstop HTML report output (regenerated by `doorstop publish all`)
scripts/requirements/docs/

# AI Tools
.playwright-cli/
.atl/
**/.atl/
.codegraph/

# SDD tooling artifacts (untracked by design — generated per session)
.atl/skill-registry.cache.json
openspec/specs/cache/

backend/backend/

# Root-level composer stubs (do NOT use — backend/ has the real setup).
# These show up as untracked noise from local tooling hooks.
/composer.json
/composer.lock

# Root-level vendor/ (local Composer autoload — not the backend's).
# Absolute path so backend/vendor/ stays unaffected.
/vendor/
