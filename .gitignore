*.txt
.env
.DS_Store
Thumbs.db
*.log
*.zip
*.tar.gz
*.bak
*.erm
.idea/
.vscode/
.phpunit.result.cache

# Backend test coverage artifacts (generated by composer test:coverage)
backend/backend/coverage/

# Python (Doorstop tooling under docs/requirements/)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Doorstop HTML report output (regenerated by `doorstop publish all`)
docs/requirements/docs/

# AI Tools
.playwright-cli/
.atl/
**/.atl/
.codegraph/

# SDD tooling artifacts (untracked by design — generated per session)
.atl/skill-registry.cache.json
openspec/specs/cache/

backend/backend/

# Root-level composer stubs (do NOT use — backend/ has the real setup).
# These show up as untracked noise from local tooling hooks.
/composer.json
/composer.lock

# Root-level vendor/ (local Composer autoload — not the backend's).
# Absolute path so backend/vendor/ stays unaffected.
/vendor/

# Generated artifacts (no commit)
.archify/
docs/uml/build/

# Gibson reference images are tracked via Git LFS (see .gitattributes).
# Images live in LFS storage, only pointers in the regular git tree.

# Node modules (bun manages workspaces, root + frontend)
node_modules/
**/node_modules/

# Bun binary lockfile (we keep the JSON-text bun.lock tracked; the
# binary bun.lockb is for tooling cache and is regenerable).
bun.lockb
**/bun.lockb

# Fuentes de imágenes del usuario y salidas de herramientas — trabajo,
# no fuente. Los WebP canónicos viven en assets/products/ (commiteado).
/imagenes-random-para-catalogo/
/incoming/
/output/
